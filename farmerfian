        or math.floor(stateNow.x) ~= gridAnchor.x
        or math.floor(stateNow.y - 0.475) ~= gridAnchor.y then
        return false, "Player moved"
    end

    -- Recheck after the speed delay. Only the final Collect priority
    -- tile may be placed while a world drop remains there.
    if not isFinalCollectPriorityTile(x, y) then
        local held = hasDropAtPlaceTile(x, y)
        if held == nil then return false, "Drop list unavailable" end
        if held then return false, "Drop still present" end
    end

    if countItem(id) <= 0 then
        return false, "Item habis"
    end

    local freshState = getState()

    if not freshState
        or not inRange(freshState, x, y)
