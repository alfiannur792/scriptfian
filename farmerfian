local statusLabel

local placeStatusLast=0
local placeStatusText=nil
local function setStatus(message)
    local now=os.clock()
    local frequent=string.sub(message,1,12)=="ON | Placed "
    if frequent and now-placeStatusLast<2 then return end
    if message==placeStatusText and now-placeStatusLast<5 then return end
