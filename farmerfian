        local started=os.clock()
        local last=started
        local waypoint=1
        local speed=tonumber(env.Fian792DirectSpeed) or directSpeed
        speed=math.clamp(speed,2,7.2)
        local routeLength=0
        local lastX,lastY=p.px,p.py
        for _,node in ipairs(path) do
            local dx,dy=node.x-lastX,node.y-lastY
            routeLength+=math.sqrt(dx*dx+dy*dy)
            lastX,lastY=node.x,node.y
        end
        local timeout=math.max(limit or 0,routeLength/speed+3)
        local arrived=false
        local lastProgress=started
        local best=math.huge
        local lastAction=0
        while touchLive(run) and os.clock()-started<timeout do
            -- Native place/punch calls are serviced while Direct Nav moves.
            -- No new world-wide scan occurs inside this movement loop.
            local actionNow=os.clock()
            -- v1.0.109: NO plant/harvest while Direct Nav is flying
            -- (gravity 0): those placements came back UNCONFIRMED. Work
            -- starts only after Direct is off and the avatar has landed.
            if env.Fian792DirectWork==true
                and moveFarmAction and (phase=="plant" or phase=="harvest")
                and not (rotation.enabled and rotation.mode~="farm")
                and env.Fian792DirectTestRun==nil
                and actionNow-lastAction>=0.08 then
                lastAction=actionNow
                local ok,err=pcall(moveFarmAction,run,true)
                if not ok and actionNow-phaseActionLast>5 then
                    phaseActionLast=actionNow
                    warn("[DIRECT WORK] Native action:",err)
                end
            end
            -- A native Plant/Harvest action can complete the goal BEFORE
            -- Direct Navigation reaches its old destination. Replan from
            -- the actual current position instead of walking there and back.
            if goalNeeded and not goalNeeded() then
                arrived=true
                break
            end
            if rotation.enabled and rotation.mode=="farm"
                and rotation.selectedBlock
                and countItem(rotation.selectedBlock)>=rotation.threshold then
                tractor.unequip("200 stock Direct Nav")
                break
            end
            local now=os.clock()
            local dt=math.min(0.05,now-last)
            last=now
            p.GRAV=0;p.SHORT_JUMP_GRAV=0
            local budget=speed*dt
            local transitions=0
            while budget>0.00001 and waypoint<=#path and transitions<12 do
                local node=path[waypoint]
                local dx,dy=node.x-p.px,node.y-p.py
                local remaining=math.sqrt(dx*dx+dy*dy)
                if remaining<0.035 then
                    p.px=node.x;p.py=node.y
                    waypoint+=1;transitions+=1
                else
                    local step=math.min(budget,remaining)
                    local nx=p.px+dx/remaining*step
                    local ny=p.py+dy/remaining*step
                    if not directSegment(p.px,p.py,nx,ny) then
                        budget=0
                        waypoint=-1
                        break
                    end
                    p.px=nx;p.py=ny
                    p.vx=0;p.vy=0
                    budget-=step
                    if step>=remaining-0.00001 then
                        waypoint+=1;transitions+=1
                    else break end
                end
            end
            if waypoint==-1 then break end
            p.vx=0;p.vy=0
            if waypoint>#path then arrived=true;break end
            local current=path[waypoint]
            local dx,dy=current.x-p.px,current.y-p.py
            local remain=math.sqrt(dx*dx+dy*dy)
            if remain<best-0.02 then best=remain;lastProgress=now end
            if now-lastProgress>1.4 then break end
            game:GetService("RunService").Heartbeat:Wait()
        end
        directRestore()
        return arrived
    end
