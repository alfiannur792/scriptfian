local function validPlace(fn)
    if type(fn) ~= "function" then
        return false
    end

    if debug and type(debug.info) == "function" then
        local ok, n, vararg = pcall(
            debug.info,
            fn,
            "a"
        )

        if not ok or n ~= 6 or vararg then
            return false
        end
    end

    local flags = {
        tile = false,
        send = false,
        layer = false,
        placedAt = false,
        flips = false
    }

    for _, c in pairs(constantsOf(fn)) do
        if c == "tile" or c == "SetTile" then
            flags.tile = true
        elseif type(c) == "string"
            and flags[c] ~= nil then
            flags[c] = true
        end
    end

    return flags.tile
        and flags.send
        and flags.layer
        and flags.placedAt
        and flags.flips
end

