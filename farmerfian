            for _,d in pairs(drops) do
                if type(d)=="table" and type(d.x)=="number"
                    and math.floor(d.x)==edge and touchDropPresent(d) 
                    and cropDrop(d) and not reservedAutoDropPile(d) then
                    still+=1
                end
            end
            if still>0 then
                -- Never hold movement OUTSIDE map bounds. A wall clamp
                -- causes apparent spinning/stuck movement with no pickup.
                -- The regular UID collector handles any leftover separately.
                touchRelease()
