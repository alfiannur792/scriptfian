                -- Zekio-style small jump: touch a drop floating one row up.
                touchInput.jump=true
                local t0=os.clock()
                local airborne=false
                while touchLive(run) and os.clock()-t0<1.35 do
                    local state=touchPosition()
                    if not state then break end
                    if state.grounded==false then
                        airborne=true
                        touchInput.jump=false
                    end
                    if airborne and state.grounded then break end
                    if not airborne and os.clock()-t0>0.4 then break end
                    task.wait(0.04)
                end
                touchRelease()
            end
        end
        local disappeared=not touchDropPresent(target)
        if disappeared then
            touchCount+=1
            local after=target.id and target.id~=112 and countItem(target.id) or nil
            print("[AUTO FARM TOUCH]",kind,"UID removed:",uid,
                "| item",target.id,"| bag",before or "-", "->",after or "-")
        end
        -- Do not return home after every touch; continue the collect sweep
        -- from the last drop. The old return-to-home caused back-and-forth.
        if ownRun==run then touchUnhook() end
        -- A leftover UID is revisited, not pursued while standing still.
        -- Keep a short cooldown so subsequent drops can be swept first.
        touchCooldown[uid]=os.clock()+(disappeared and 0.4 or 1.6)
        if not disappeared then
            print("[AUTO FARM TOUCH MISSED] UID",uid,
                "| still in native dropList; revisit on next pass")
        end
        return disappeared
    end

    local switching=false
    alive=function()
        local production=env.Fian792DirtProduction
        return env.Fian792FarmGeneration==gen
            and (active or (production and production.generation==gen and production.live())
                or (env.Fian792BuilderTravel and env.Fian792BuilderTravel.generation==gen
