    local function checkTreeTable(t,nonempty)
        if type(t)~="table" or t==world or rawget(t,"fg")~=nil
            or getmetatable(t)~=nil then return false end
        if nonempty and next(t)==nil then return false end
        local n=0
        for idx,e in pairs(t) do
            n+=1
            if n>10 then break end
            if type(idx)~="number" or idx<0 or idx>=world.w*world.h
                or type(e)~="table" or type(rawget(e,"p"))~="number" then
                return false
            end
        end
        return true
    end
    -- Zekio-style tree map discovery: the native table is sometimes hidden
    -- inside remote/render callbacks instead of World.tileChanged.
    local function treeShape(t)
        if type(t)~="table" or t==world or rawget(t,"fg")~=nil
            or getmetatable(t)~=nil then return nil end
        local W,H=world.w,world.h
        local now=workspace:GetServerTimeNow()
        local good,bad,mode,field=0,0,nil,nil
        local checked=0
        for k,v in pairs(t) do
            checked+=1
            if checked>12 then break end
            local x,y,e,m=nil,nil,nil,nil
            if type(k)=="number" and k%1==0 and k>=0 then
                if type(v)=="table" and k<H and
                    type(rawget(v,"p"))~="number" then
                    local cx,ce=next(v)
                    if type(cx)=="number" and cx>=0 and cx<W then
                        x,y,e,m=cx,k,ce,"rows"
                    end
                elseif k<W*H then
                    x,y,e,m=k%W,math.floor(k/W),v,"idx"
                end
            elseif type(k)=="string" then
                local cx,cy=k:match("^(%d+),(%d+)$")
                if cx then x,y,e,m=tonumber(cx),tonumber(cy),v,"xy" end
            end
            if not x or not y or x>=W or y>=H
                or (mode and mode~=m) then return nil end
            mode=m
            local stamp,key=nil,nil
            if type(e)=="number" then stamp,key=e,"p"
            elseif type(e)=="table" then
                stamp,key=rawget(e,"p"),"p"
                if type(stamp)~="number" then
                    for fk,fv in pairs(e) do
                        if type(fv)=="number" and math.abs(fv-now)<86400*90 then
                            stamp,key=fv,fk
                            break
                        end
                    end
                end
            end
            local id=tileAt("fg",x,y)
            local item=id and db[id]
            if type(stamp)=="number" and math.abs(stamp-now)<86400*90
                and item and item.kind=="seed" then
                good+=1
                field=key
            else bad+=1 end
        end
        if good==0 or bad>good then return nil end
        return mode,field or "p"
    end
    local function findTreesDeep()
        local queue,seenF,seenT={}, {}, {}
        local function addFn(fn)
            if type(fn)=="function" and not seenF[fn] then
                queue[#queue+1]=fn
            end
        end
        local function accept(t)
            if type(t)~="table" or seenT[t] then return false end
            seenT[t]=true
            local mode,key=treeShape(t)
            if mode then
                treeData,treeWorld=t,world
                treeMode,treeStampKey=mode,key
                print("[AUTO FARM TREE] Found",mode,"timestamp",key)
                return true
            end
            return false
        end
        for _,v in pairs(world) do
            if type(v)=="table" and accept(v) then return true end
            if type(v)=="function" then addFn(v) end
        end
        if type(getconnections)=="function" then
            local rs=game:GetService("ReplicatedStorage")
            local remotes=rs:FindFirstChild("WorldRemotes")
            if remotes then
                for _,ev in ipairs(remotes:GetChildren()) do
                    if ev:IsA("RemoteEvent") then
                        local ok,list=pcall(getconnections,ev.OnClientEvent)
                        if ok and type(list)=="table" then
                            for _,conn in ipairs(list) do
                                local okFn,fn=pcall(function() return conn.Function end)
                                if okFn then addFn(fn) end
                            end
                        end
                    end
                end
            end
            for _,name in ipairs({"RenderStepped","Heartbeat","Stepped"}) do
                local ok,sig=pcall(function() return RunService[name] end)
                if ok and sig then
                    local good,list=pcall(getconnections,sig)
                    if good and type(list)=="table" then
                        for _,conn in ipairs(list) do
                            local okFn,fn=pcall(function() return conn.Function end)
                            if okFn then addFn(fn) end
                        end
                    end
                end
            end
        end
        local i,visited=1,0
        while i<=#queue and visited<1100 do
            local fn=queue[i]
            i+=1
            if not seenF[fn] then
                seenF[fn]=true
                visited+=1
                for _,v in ipairs(getUpvaluesSafe(fn)) do
                    if type(v)=="table" then
                        if accept(v) then return true end
                    elseif type(v)=="function" then addFn(v) end
                end
                if visited%100==0 then task.wait() end
            end
        end
        -- Some builds expose native tree tables via getgc rather than the
        -- direct World/Render callbacks. Search bounded, validate by live seed.
        local inspected=0
        if type(getgc)=="function" then
            local ok,objects=pcall(getgc,true)
            if ok and type(objects)=="table" then
                for _,obj in pairs(objects) do
                    inspected+=1
                    if type(obj)=="table" and accept(obj) then
                        print("[AUTO FARM TREE] getgc table found at",inspected)
                        return true
                    end
                    if inspected%1400==0 then task.wait() end
                    if inspected>=10000 then break end
                end
            end
        end
        print("[AUTO FARM TREE] No map | callbacks",visited,
            "| getgc objects",inspected)
        return false
    end
    local function findTrees()
        hitchMark("findTrees")
        if treeData and treeWorld==world then return true end
        -- v1.0.30: native tree map lives in the shared state captured
        -- by world.treeLook. Find it directly before costly GC scanning.
        local look=rawget(world,"treeLook")
        if type(look)=="function" then
            for _,state in ipairs(getUpvaluesSafe(look)) do
                if type(state)=="table" then
                    local nativeTrees=rawget(state,"trees")
                    if checkTreeTable(nativeTrees,true) then
                        treeData,treeWorld=nativeTrees,world
                        treeMode,treeStampKey="idx","p"
                        print("[AUTO FARM TREE] Native treeLook state | idx timestamp p")
                        return true
                    end
                end
            end
        end
        if os.clock()<scanAfter then return false end
        scanAfter=os.clock()+9
        treeData=nil
        treeWorld=world
        for _,name in ipairs({"tileChanged","treeChanged","setTree"}) do
            local fn=rawget(world,name)
            if type(fn)=="function" then
                local ups=getUpvaluesSafe(fn)
                local roots={}
                for _,v in ipairs(ups) do
                    if type(v)=="table" and v~=world then roots[v]=true end
                end
                for _,g in ipairs(ups) do
                    if type(g)=="function" then
                        local hasW,nt,shared=false,0,{}
                        for _,v in ipairs(getUpvaluesSafe(g)) do
                            if rawequal(v,world) then hasW=true
                            elseif type(v)=="table" then
                                nt+=1
                                if roots[v] then shared[#shared+1]=v end
                            end
                        end
                        if hasW and nt<=3 and #shared==1
                            and checkTreeTable(shared[1],false) then
                            treeData,treeWorld=shared[1],world
                            treeMode,treeStampKey="idx","p"
                            print("[AUTO FARM TREE] Linked structural table")
                            return true
                        end
                    end
                end
                for t in pairs(roots) do
                    local m,key=treeShape(t)
                    if m then
                        treeData,treeWorld=t,world
                        treeMode,treeStampKey=m,key
                        print("[AUTO FARM TREE] Linked direct",m,key)
                        return true
                    end
                end
            end
        end
        return findTreesDeep()
    end
    -- One crop per Farm cycle. Existing trees and newly planted trees use
    -- the SAME selected seed ID and readiness evaluation.
    local function treeStatus(x,y)
        if not seedId then return "no-selection" end
        local id=tileAt("fg",x,y)
        if id~=seedId then return "other-seed" end
        local item=id and db[id]
        if type(item)~="table" or item.kind~="seed" then
            return "invalid-seed"
        end
        local plantedAt=nil
        if treeData and treeWorld==world then
            local e
            if treeMode=="xy" then
                e=treeData[tostring(x)..","..tostring(y)]
            elseif treeMode=="rows" then
                local row=treeData[y]
                e=type(row)=="table" and row[x] or nil
            else
                e=treeData[y*world.w+x]
            end
            if type(e)=="number" then plantedAt=e
            elseif type(e)=="table" then
                plantedAt=tonumber(e[treeStampKey] or e.p)
            end
        end
        if type(plantedAt)~="number" then
            local own=observedTrees[y*world.w+x]
            if own and own.id==id then plantedAt=own.p end
        end
        if type(plantedAt)~="number" then return "no-timestamp" end
        local grow=tonumber(item.grow)
        if not grow or grow<0 then return "no-grow-data" end
        local remaining=plantedAt+grow-workspace:GetServerTimeNow()
        return remaining<=0 and "ready" or "growing",math.max(0,remaining)
    end
    readyTree=function(x,y)
        local production=env.Fian792DirtProduction
        if production and production.row and (y~=production.row or x<2 or x>world.w-3) then return false end
        return treeStatus(x,y)=="ready"
    end
    -- Strict harvest cursor. A target is not discarded until its FG seed
    -- really disappears. Other ready trees cannot overtake this target.
    -- The entire world is only audited on startup, target completion,
    -- seed change, or the next scheduled maturity check.
    local function orderedHarvestTarget()
        hitchMark("orderedHarvestTarget")
        if harvestScanSeed~=seedId then
            harvestScanSeed=seedId
            orderedHarvestGoal=nil
            harvestScanAt=0
        end
        local locked=orderedHarvestGoal
        if locked and readyTree(locked.x,locked.y)
            and canBuild(locked.x,locked.y) then
            return locked
        end
        if locked then
            orderedHarvestGoal=nil
            harvestScanAt=0
        end
        local now=os.clock()
        if now<harvestScanAt then return nil end
        local nextMaturity=nil
        local selected,growing,unknown=0,0,0
        -- Bottom-most mature crop row wins. When already standing on that
        -- row, choose the closest still-ready crop in our current heading,
        -- instead of forcing travel back to the far edge after a level change.
        local _,px,py=touchPosition()
        px=px or 0
        local best,bestRow=nil,nil
        harvestSweep.serpBelow=false
        local rowDir=harvestSweep.serpDir or preferredDir
        local production=env.Fian792DirtProduction
        local onlyRow=production and production.row
        for y=onlyRow or world.h-2,onlyRow or 0,-1 do
            local row=world.fg[y]
            if type(row)=="table" then
                for x=0,world.w-1 do
                    if row[x]==seedId and (not onlyRow or (x>=2 and x<=world.w-3)) then
                        selected+=1
                        local state,remaining=treeStatus(x,y)
                        if state=="ready" and canBuild(x,y) then
                            -- Serpentine like Plant: rows below the current
                            -- pass row wait for the next pass (bottom -> up).
                            if harvestSweep.serpCeil and y>harvestSweep.serpCeil then
                                harvestSweep.serpBelow=true
                            elseif not bestRow or y>bestRow then
                                bestRow=y
                                best={x=x,y=y,seed=seedId}
                            elseif y==bestRow and
                                ((rowDir>0 and x<best.x)
                                    or (rowDir<0 and x>best.x)) then
                                best={x=x,y=y,seed=seedId}
                            end
                        elseif state=="growing" then
                            growing+=1
                            if type(remaining)=="number" and remaining>0 then
                                nextMaturity=math.min(nextMaturity or math.huge,remaining)
                            end
                        elseif state=="no-timestamp" or state=="no-grow-data" then
                            unknown+=1
                        end
                    end
                end
            end
        end
        if not best and harvestSweep.serpBelow then
            -- Pass finished upward; ready crops remain lower: new pass.
            harvestSweep.serpCeil=nil
            harvestSweep.serpRow=nil
            harvestSweep.serpDir=nil
            harvestScanAt=0
            print("[AUTO FARM HARVEST ORDER] pass complete | new pass from bottom")
            return orderedHarvestTarget()
        end
        if best and harvestSweep.serpRow~=best.y then
            -- New row: first row starts at the end nearest the player,
            -- every next row reverses direction (same serpentine as Plant).
            local row=world.fg[best.y]
            local left,right=nil,nil
            for xx=0,world.w-1 do
                if row[xx]==seedId and readyTree(xx,best.y)
                    and canBuild(xx,best.y) then
                    left=left or xx
                    right=xx
                end
            end
            if harvestSweep.serpRow==nil or harvestSweep.serpDir==nil then
                rowDir=(left and math.abs(px-left)<=math.abs(px-right)) and 1 or -1
            else
                rowDir=-harvestSweep.serpDir
            end
            harvestSweep.serpDir=rowDir
            harvestSweep.serpRow=best.y
            harvestSweep.serpCeil=best.y
            if left and right then
                best={x=rowDir>0 and left or right,y=best.y,seed=seedId}
            end
            print("[AUTO FARM HARVEST ROW] Y",best.y,"| sweep",
                rowDir>0 and "LEFT -> RIGHT" or "RIGHT -> LEFT","| X",left,"..",right)
        end
        if best then
            -- When landing on an active harvest row after going up/down,
            -- lock a forward crop first; only return for genuine leftovers.
            if py==best.y then
                local row=world.fg[best.y]
                local ahead,behind=nil,nil
                for xx=0,world.w-1 do
                    if row[xx]==seedId and readyTree(xx,best.y)
                        and canBuild(xx,best.y) then
                        local delta=(xx+0.5)-px
                        if delta*rowDir>=-0.35 then
                            if not ahead or math.abs(delta)<ahead.distance then
                                ahead={x=xx,distance=math.abs(delta)}
                            end
                        elseif not behind or math.abs(delta)<behind.distance then
                            behind={x=xx,distance=math.abs(delta)}
                        end
                    end
                end
                if ahead then
                    best={x=ahead.x,y=best.y,seed=seedId}
                elseif behind then
                    -- Leftover behind on this row: fetch it, but the NEXT row
                    -- still flips relative to the row's original heading.
                    rowDir=-rowDir
                    best={x=behind.x,y=best.y,seed=seedId}
                end
            -- Row start is chosen by the serpentine block above.
            elseif false then
                local row=world.fg[best.y]
                local left,right=nil,nil
                for xx=0,world.w-1 do
                    if row[xx]==seedId and readyTree(xx,best.y)
                        and canBuild(xx,best.y) then
                        left=left or xx
                        right=xx
                    end
                end
                if left and right then
                    rowDir=math.abs(px-left)<=math.abs(px-right) and 1 or -1
                    best={x=rowDir>0 and left or right,y=best.y,seed=seedId}
                end
            end
            preferredDir=rowDir
            orderedHarvestGoal=best
            harvestReadyFound=true
            harvestScanAt=now
            print("[AUTO FARM HARVEST ORDER] NEAREST ROW Y",best.y,
                "| X",best.x,"| heading",preferredDir)
            return best
        end
        harvestReadyFound=false
        harvestSweep.serpCeil=nil
        harvestSweep.serpRow=nil
        harvestSweep.serpDir=nil
        harvestScanAt=now+(unknown>0 and 2.5
            or nextMaturity and math.max(0.3,math.min(8,nextMaturity+0.15))
            or 8)
        if os.clock()-harvestAuditAt>5 then
            print("[AUTO FARM TREE SCHEDULE] selected",selected,
                "| growing",growing,"| next scan in",
                math.floor((harvestScanAt-now)*10)/10,"s")
            harvestAuditAt=os.clock()
        end
        return nil
    end
    -- In GrowBlox paired block/seed IDs are consecutive. Match names too
    -- to avoid classifying unrelated inventory items as the crop's block.
    cropBlockId=function()
        local selected=seedId and db[seedId]
        local candidate=seedId and db[seedId-1]
        if type(selected)~="table" or selected.kind~="seed"
            or type(candidate)~="table" or candidate.kind=="seed" then
            return nil
        end
        local function baseName(item)
            return tostring(item.name or ""):lower()
                :gsub("%s+seeds?$",""):gsub("%s+blocks?$","")
                :gsub("[^%w]","")
        end
        local a,b=baseName(selected),baseName(candidate)
        if a~="" and b~="" and a~=b then return nil end
        return seedId-1
    end
    cropDrop=function(d)
        if type(d)~="table" then return false end
        local production=env.Fian792DirtProduction
        if production and production.row then
            local y=tonumber(d.y)
            if not y or (math.floor(y)~=production.row and math.floor(y)~=production.row-1) then return false end
        end
        if farmBlockOnly then
            return d.id==112 or (farmBlockId and d.id==farmBlockId)
        end
        if not seedId then return false end
        if d.id==112 or d.id==seedId then return true end
        local block=cropBlockId()
        return block~=nil and d.id==block
    end
    local function seedInventory()
        local available={}
        local gameInv=getGameInventory()
        if not gameInv or type(gameInv.slots)~="table" then
            if type(inv)=="table" and type(inv.slots)=="table" then
                gameInv=inv
            end
        end
        if gameInv and type(gameInv.slots)=="table" then
            for key,slot in pairs(gameInv.slots) do
                local id,count=nil,nil
                if type(slot)=="table" then
                    id=tonumber(slot.id or slot.itemId or slot.itemID)
                    count=tonumber(slot.n or slot.count or slot.amount or slot.qty)
                elseif type(slot)=="number" then
                    id=tonumber(key)
                    count=slot
                end
                if id and count and count>0 and db[id]
                    and db[id].kind=="seed" then available[id]=true end
            end
        end
        -- Seeds stored at the explicitly saved Drop Seed point should also
        -- be selectable even if the inventory currently has ZERO of them.
        local cfg=env.Fian792SavedAutoDrop
        local point=type(cfg)=="table" and cfg.world==refs.worldKey()
            and cfg.points and cfg.points.seed
        local fn=rawget(world,"dropList")
        local stashX=type(point)=="table" and (point.dropX or point.x)
        local stashY=type(point)=="table" and (point.dropY or point.y)
        if type(stashX)=="number" and type(stashY)=="number"
            and type(fn)=="function" then
            local ok,drops=pcall(fn)
            if ok and type(drops)=="table" then
                for _,d in pairs(drops) do
                    if type(d)=="table" and type(d.id)=="number"
                        and type(d.x)=="number" and type(d.y)=="number"
                        and (tonumber(d.n) or 0)>0
                        and math.floor(d.x)==math.floor(stashX)
                        and math.floor(d.y)==math.floor(stashY)
                        and db[d.id] and db[d.id].kind=="seed" then
                        available[d.id]=true
                    end
                end
            end
        end
        local choices={}
        for id in pairs(available) do
            choices[#choices+1]=tostring(db[id].name or id).." ["..id.."]"
        end
        table.sort(choices)
        return choices
    end
    local function itemChoices(seeds,blocks,extra)
        local ids={}
        local gi=getGameInventory()
        if not gi or type(gi.slots)~="table" then gi=inv end
        if gi and type(gi.slots)=="table" then
            for k,slot in pairs(gi.slots) do
                local id,n
                if type(slot)=="table" then
                    id=tonumber(slot.id or slot.itemId or slot.itemID)
                    n=tonumber(slot.n or slot.count or slot.amount or slot.qty)
                elseif type(slot)=="number" then id=tonumber(k);n=slot end
                local item=id and db[id]
                if n and n>0 and type(item)=="table"
                    and not item.lock and not item.area and not item.vend
                    and not item.display and item.kind~="tool"
                    and item.kind~="cloth" and item.kind~="clothes"
                    and item.kind~="consumable"
                    and ((seeds and item.kind=="seed")
                    or (blocks and item.kind~="seed")) then ids[id]=true end
            end
        end
        if extra and db[extra] then ids[extra]=true end
        local list={}
        for id in pairs(ids) do
            list[#list+1]=tostring(db[id].name or id).." ["..id.."]"
        end
        table.sort(list)
        return list
    end
    local function nearby()
        local state=getState()
        local targets={}
        if not state then return targets end
        local px,py=math.floor(state.x),math.floor(state.y-0.475)
        for dy=-2,2 do
            for dx=-2,2 do
                local x,y=px+dx,py+dy
                if x>=0 and y>=0 and x<world.w and y+1<world.h
                    and inRange(state,x,y) then
                    targets[#targets+1]={x=x,y=y}
                end
            end
        end
        return targets
    end
    -- v1.0.150: Plant keeps 1 tile away from the saved seed/block drop
    -- pile; planting next to it picked the stack back up.
    local function nearDropPile(x,y)
        local cfg=env.Fian792SavedAutoDrop
        if type(cfg)=="table" and cfg.world==refs.worldKey() and type(cfg.points)=="table" then
            for _,name in ipairs({"seed","block"}) do
                local pt=cfg.points[name]
                local px,py=type(pt)=="table" and (pt.dropX or pt.x),type(pt)=="table" and (pt.dropY or pt.y)
                if type(px)=="number" and type(py)=="number"
                    and math.abs(x-math.floor(px))<=1 and math.abs(y-math.floor(py))<=1 then
                    return true
                end
            end
        end
        local reserved=env.Fian792ReservedDropTiles
        if type(reserved)=="table" then
            for dx=-1,1 do for dy=-1,1 do
                if reserved[(x+dx)..","..(y+dy)] then return true end
            end end
        end
        return false
    end
    local function plantSpot(x,y)
        if env.Fian792PileGuard~=false and nearDropPile(x,y) then return false end
        local production=env.Fian792DirtProduction
        if production and production.row and (y~=production.row or x<2 or x>world.w-3) then return false end
        -- A true planting spot must be empty, editable and have a physical,
        -- nonhazardous support tile. Don't interpret every empty map tile as farm.
        if x<0 or y<0 or x>=world.w or y+1>=world.h
            or tileAt("fg",x,y)~=0 then return false end
        local below=tileAt("fg",x,y+1)
        local item=below and db[below]
        if type(item)~="table" or below==0 or item.kind=="seed"
            or not (item.solid==true or item.platform==true)
            or item.deadly or item.hurts or item.laser
            or not canBuild(x,y) then return false end
        if type(world.builderOk)=="function" then
            local ok,allowed=pcall(world.builderOk,x,y,true)
            if not ok or allowed==false then return false end
        end
        return true
    end

    -- Serpentine planting sweep. One Y row is locked until all valid X spots
    -- on that row have been planted or safely skipped. Then choose the next
    -- higher row and reverse horizontal direction.
    local function resetPlantSweep()
        plantSweep.row=nil
        plantSweep.ceiling=world.h-1
        plantSweep.dir=1
        plantSweep.cursor=nil
        plantSweep.lo=nil
        plantSweep.hi=nil
        plantSweep.skipped={}
        plantSweep.missed={}
        plantSweep.quickRetries={}
        plantSweep.attempts=0
        plantSweep.doneRows=0
        plantSweep.auditWait=0
        plantSweep.auditAttempts=0
        plantSweep.inflight={}
        plantSweep.pending={}
    end
    local function pickPlantRow()
        local ceiling=plantSweep.ceiling or world.h-1
        local production=env.Fian792DirtProduction
        local onlyRow=production and production.row
        if onlyRow and ceiling<=onlyRow then return false end
        -- Start at the bottom buildable row; always progress upward.
        for y=onlyRow or math.min(world.h-2,ceiling-1),onlyRow or 0,-1 do
            local lo,hi=nil,nil
            for x=0,world.w-1 do
                local key=y*world.w+x
                if plantSpot(x,y) and not plantSweep.skipped[key]
                    and not routeSkipped(x,y) then
                    lo=lo and math.min(lo,x) or x
                    hi=hi and math.max(hi,x) or x
                end
            end
            if lo then
                if plantSweep.doneRows==0 then
                    local state=getState()
                    local px=state and state.x or lo
                    plantSweep.dir=math.abs(px-lo)<=math.abs(px-hi) and 1 or -1
                end
                plantSweep.row=y
                plantSweep.lo,plantSweep.hi=lo,hi
                plantSweep.cursor=plantSweep.dir>0 and lo or hi
                plantSweep.auditWait=0
                plantSweep.auditAttempts=0
                plantSweep.missed={}
                plantSweep.quickRetries={}
                preferredDir=plantSweep.dir
                print("[AUTO FARM PLANT ROW] Y",y,"| sweep",
                    plantSweep.dir>0 and "LEFT -> RIGHT" or "RIGHT -> LEFT",
                    "| X",lo,"..",hi)
                return true
            end
        end
        return false
    end
    -- Audit the whole CURRENT row before permitting any higher row.
    -- This includes the first/end tile after a fall or short walk: a
    -- temporary failed path is NOT proof that the tile was planted.
    local function auditPlantRow(y)
        local pending,first,last=0,nil,nil
        for x=0,world.w-1 do
            if plantSpot(x,y) then
                pending+=1
                first=first or x
                last=x
            end
        end
        return pending,first,last
    end
    local function nextPlantTarget()
        hitchMark("nextPlantTarget")
        local production=env.Fian792DirtProduction
        if production and production.cycle and
            (production.cycle.remaining<=0 or countItem(seedId)<=(production.reserveSeed or 0)) then return nil end
        if not plantOn or not seedId or countItem(seedId)<=0 then return nil end
        if plantSweep.row and os.clock()<(plantSweep.auditWait or 0) then
            return nil
        end
        for _=1,world.h do
            if not plantSweep.row and not pickPlantRow() then return nil end
            local y=plantSweep.row
            local dir=plantSweep.dir
            local stopX=dir>0 and plantSweep.hi or plantSweep.lo
            local x=plantSweep.cursor
            -- Preserve a single forward sweep. Failed/missed tiles stay
            -- recorded and are revisited by the bounded END-OF-ROW audit.
            -- Returning to old misses during the active lane caused a
            -- left/right ping-pong when moving Plant actions ran mid-route.
            while x and x>=0 and x<world.w
                and (dir>0 and x<=stopX or dir<0 and x>=stopX) do
                local key=y*world.w+x
                if not plantSweep.skipped[key] and not plantSweep.inflight[key]
                    and not routeSkipped(x,y) and plantSpot(x,y) then
                    plantSweep.cursor=x
                    return {x=x,y=y,key=key}
                end
                x+=dir
            end
            -- Placements still awaiting confirmation: decide after them.
            if next(plantSweep.inflight)~=nil then return nil end
            -- Crucial: never report Complete merely because the sweep cursor
            -- hit the edge. Check every real planting position in this row.
            local remaining,first,last=auditPlantRow(y)
            if remaining>0 then
                -- Respect the temporary path-failure cache. Never erase the
                -- cooldown during a row audit, or an unreachable compact row
                -- can trap Plant in the same route forever.
                local eligible=0
                for xx=first,last do
                    if plantSpot(xx,y) and not routeSkipped(xx,y) then
                        eligible+=1
                    end
                end
                if eligible==0 then
                    local resumeAt=math.huge
                    for xx=first,last do
                        if plantSpot(xx,y) then
                            local expires=math.max(unreachable.rows[y] or 0,
                                unreachable.tiles[y*world.w+xx] or 0)
                            if expires>os.clock() then
                                resumeAt=math.min(resumeAt,expires)
                            end
                        end
                    end
                    -- This is NOT a planted/complete row: just defer it while
                    -- searching other reachable Plant rows. It will be
                    -- revisited after cooldown on a later sweep.
                    print("[AUTO FARM PLANT ROW DEFER] Y",y,
                        "| missing",remaining,
                        "| all routes cooling",
                        "| retry after",
                        resumeAt<math.huge and math.ceil(resumeAt-os.clock()) or 0,"s")
                    plantSweep.ceiling=y
                    plantSweep.row=nil
                    plantSweep.cursor=nil
                    plantSweep.auditWait=0
                    plantSweep.auditAttempts=0
                    plantSweep.doneRows+=1
                    plantSweep.dir=-plantSweep.dir
                    return nextPlantTarget()
                end
                plantSweep.auditAttempts=(plantSweep.auditAttempts or 0)+1
                if plantSweep.auditAttempts>2 then
                    -- Two return passes failed: cool these tiles down and
                    -- move on instead of circling the same row.
                    for xx=first,last do
                        if plantSpot(xx,y) then
                            unreachable.tiles[y*world.w+xx]=os.clock()+30
                        end
                    end
                    print("[AUTO FARM PLANT ROW DEFER] Y",y,
                        "| missing",remaining,"| 2 return passes failed | 30s cooldown")
                    plantSweep.ceiling=y
                    plantSweep.row=nil
                    plantSweep.cursor=nil
                    plantSweep.auditWait=0
                    plantSweep.auditAttempts=0
                    plantSweep.doneRows+=1
                    plantSweep.dir=-plantSweep.dir
                    return nextPlantTarget()
                end
                -- Revisit the nearest remaining edge rather than jumping to
                -- another row. Expire only navigation-failure bookkeeping,
                -- never modify world tiles or fabricate a planted seed.
                local state=getState()
                local px=state and math.floor(state.x) or first
                local dirAgain=math.abs(px-first)<=math.abs(px-last) and 1 or -1
                plantSweep.dir=dirAgain
                plantSweep.lo,plantSweep.hi=first,last
                plantSweep.cursor=dirAgain>0 and first or last
                plantSweep.skipped={}
                plantSweep.missed={}
                plantSweep.quickRetries={}
                -- Keep route cooldowns until expiry; don't immediately
                -- retry a path already proven unreachable.
                -- Audit no-plant / missed spots again within one second;
                -- keep the route-failure cooldown so unreachable targets
                -- do not cause rapid backtracking or FPS-heavy path retries.
                local wait=0.3
                plantSweep.auditWait=os.clock()+wait
                print("[AUTO FARM PLANT ROW AUDIT] INCOMPLETE Y",y,
                    "| missing",remaining,"| range",first,last,
                    "| attempt",plantSweep.auditAttempts,
                    "| retry in",wait,"s")
                return nil -- stay on this row, do NOT advance phase
            end
            print("[AUTO FARM PLANT ROW AUDIT] COMPLETE Y",y,
                "| all buildable spots verified | planted",planted)
            plantSweep.ceiling=y
            plantSweep.row=nil
            plantSweep.cursor=nil
            plantSweep.auditWait=0
            plantSweep.auditAttempts=0
            plantSweep.doneRows+=1
            plantSweep.dir=-plantSweep.dir
        end
        return nil
    end
    -- Unlike nextPlantTarget(), this never advances the sweep cursor and
    -- still works when the bag has ZERO seeds.
    local function hasPlantWork(fullWorld)
        if not plantOn or not seedId then return false end
        local ceiling=fullWorld and (world.h-1) or
            (plantSweep.ceiling or world.h-1)
        if plantSweep.row and not fullWorld then
            local y=plantSweep.row
            local dir=plantSweep.dir
            local limit=dir>0 and plantSweep.hi or plantSweep.lo
            local x=plantSweep.cursor
            while x and (dir>0 and x<=limit or dir<0 and x>=limit) do
                if not plantSweep.skipped[y*world.w+x]
                    and not routeSkipped(x,y) and plantSpot(x,y) then
                    return true
                end
                x+=dir
            end
            ceiling=y
        end
        for y=math.min(world.h-2,ceiling-1),0,-1 do
            for x=0,world.w-1 do
                -- A failed route means temporarily unreachable, NOT planted.
                -- Full-world verification must inspect physical planting spots
                -- independently of route-failure cooldowns and old cursors.
                if (fullWorld or (not plantSweep.skipped[y*world.w+x]
                    and not routeSkipped(x,y)))
                    and plantSpot(x,y) then
                    return true
                end
            end
        end
        return false
    end
    -- Count physical planting spots in the WHOLE world (same predicate and
    -- rows as hasPlantWork(true)). Stops counting once `limit` is exceeded.
    -- Stored on `rotation` to avoid new locals in this large Farm proto.
    function rotation.countPlantSpots(limit)
        if not plantOn or not seedId then return 0 end
        local n=0
        for y=world.h-2,0,-1 do
            for x=0,world.w-1 do
                if plantSpot(x,y) then
                    n+=1
                    if n>limit then return n end
                end
            end
        end
        return n
    end
    -- Accept only the selected crop seed at/adjacent to the saved seed
    -- stash. Dropped items may settle one tile away from the saved marker.
    -- Never roam the entire world or take other items for a refill.
    local lastStashReport=0
    local function seedStashDrop()
        local config=env.Fian792SavedAutoDrop
        local point=type(config)=="table" and config.world==refs.worldKey()
            and config.points and config.points.seed
        if type(point)~="table" or
            type(point.dropX or point.x)~="number" or
            type(point.dropY or point.y)~="number" then
            return nil,"no Drop Seed point"
        end
        local fn=rawget(world,"dropList")
        if type(fn)~="function" then return nil,"no dropList" end
        local ok,list=pcall(fn)
        if not ok or type(list)~="table" then return nil,"dropList error" end
        local tx=math.floor(point.dropX or point.x)
        local ty=math.floor(point.dropY or point.y)
        local best,bestDist=nil,math.huge
        local cropSeen=0
        local nearSeen=0
        local nearest=""
        for _,d in pairs(list) do
            if type(d)=="table" and tonumber(d.id)==seedId
                and type(d.x)=="number" and type(d.y)=="number"
                and (tonumber(d.n) or 0)>0 then
                cropSeen+=1
                local x,y=math.floor(d.x),math.floor(d.y)
                local delta=math.abs(x-tx)+math.abs(y-ty)
                if nearest=="" or delta<bestDist then
                    nearest=("(%d,%d) n=%s"):format(x,y,tostring(d.n))
                end
                if math.abs(x-tx)<=1 and math.abs(y-ty)<=1 then
                    nearSeen+=1
                    if type(d.uid)=="number"
                        and d.armed~=false and not d.taking
                        and not d.pending and not d.display
                        and delta<bestDist then
                        best=d
                        bestDist=delta
                    end
                end
            end
        end
        if best then
            if bestDist>0 and os.clock()-lastStashReport>8 then
                lastStashReport=os.clock()
                print("[AUTO FARM REFILL] Stash seed settled adjacent",
                    tx,ty,"->",math.floor(best.x),math.floor(best.y),
                    "| ID",seedId,"| n",best.n)
            end
            return best
        end
        if os.clock()-lastStashReport>8 then
            lastStashReport=os.clock()
            print("[AUTO FARM REFILL DIAG] stash",tx,ty,"| seed",seedId,
                "| selected crop piles in world",cropSeen,
                "| around stash",nearSeen,"| candidate",nearest~="" and nearest or "none")
        end
        return nil,("no selected seed ID %s near Drop Seed (%d,%d)")
            :format(tostring(seedId),tx,ty)
    end

    local function finishPlantTarget(target,reason)
        if not target or target.y~=plantSweep.row then return end
        if reason=="planted" then
            plantSweep.missed[target.key]=nil
            plantSweep.quickRetries[target.key]=nil
        else
            plantSweep.missed[target.key]=target.x
            local tried=(plantSweep.quickRetries[target.key] or 0)+1
            plantSweep.quickRetries[target.key]=tried
            -- Mid-row QUICK RETURN removed (caused back-and-forth); the
            -- bounded end-of-row return pass revisits misses instead.
            if false then
                -- Immediate return for a missed tile. Do not allow the
                -- cursor to pass it, but bound retries to avoid a loop.
                plantSweep.skipped[target.key]=nil
                unreachable.tiles[target.key]=nil
                unreachable.rows[target.y]=nil
                roamCooldown["plant:"..tostring(target.key)]=nil
                navFailures["plant:"..tostring(target.key)]=nil
                plantSweep.cursor=target.x
                nextAction=os.clock()+0.25
                print("[AUTO FARM PLANT MISS] Y",target.y,"X",target.x,
                    "|",tostring(reason),"| QUICK RETURN",tried)
                return
            end
            plantSweep.skipped[target.key]=true
            plantSweep.attempts+=1
            print("[AUTO FARM PLANT DEFER] Y",target.y,"X",target.x,
                "| recorded for row audit after quick retry")
            local unreachableReason=reason=="no safe reachable standing path"
                or reason=="route retries exhausted"
            local nativeRejected=reason=="3 unconfirmed native placements"
                or reason=="native place rejected 3x"
            if unreachableReason or nativeRejected then
                -- A native Place which repeatedly left FG empty is not a
                -- successful planting opportunity for the next second.
                -- Keep it in row audit, but don't hammer it indefinitely.
                unreachable.tiles[target.key]=os.clock()+
                    (nativeRejected and 30 or 45)
                if nativeRejected then
                    print("[AUTO FARM PLANT COOLDOWN]",target.x,target.y,
                        "| 30s | native Place did not confirm FG")
                end
                -- A short isolated planting row (such as Y43 X0..4 in the
                -- logs) needn't spend several seconds retrying each tile.
                -- Skip ONLY this compact row briefly, not a large row.
                if plantSweep.lo and plantSweep.hi
                    and plantSweep.hi-plantSweep.lo<=4 then
                    unreachable.rows[target.y]=os.clock()+45
                    print("[AUTO FARM FAST SKIP] compact unreachable row",
                        target.y,"| temporary 45s cache")
                end
            end
            print("[AUTO FARM PLANT] Skip X",target.x,"Y",target.y,
                "|",tostring(reason))
        end
        plantSweep.cursor=target.x+plantSweep.dir
    end


    -- GrowBlox native place changes FG but does not always debit inventory.
    -- Reconcile exactly ONCE per confirmed plant tile, never per attempt.
    -- This is guarded by world and tile state and a session-local receipt.
    local debitedPlantTiles=setmetatable({}, {__mode="k"})
    local seedDebitLogN=0
    local function reconcilePlantSeed(id,before,x,y)
        local receipts=debitedPlantTiles[world]
        if not receipts then
            receipts={}
            debitedPlantTiles[world]=receipts
        end
        local key=tostring(x)..":"..tostring(y)..":"..tostring(id)
        if receipts[key] then return end
        if tileAt("fg",x,y)~=id then return end
        local current=countItem(id)
        if current<before then
            receipts[key]=true
            print("[AUTO FARM SEED NATIVE DEBIT]",id,
                before,"->",current,"|",x,y)
            return
        end
        if current>before then
            -- A pickup/refill raced with planting; never infer a debit.
            print("[AUTO FARM SEED DEBIT WAIT]",id,
                before,"->",current,"|",x,y)
            return
        end
        local bag=getGameInventory()
        if not bag or type(bag.remove)~="function" then
            warn("[AUTO FARM SEED] Native inventory:remove unavailable",id)
            return
        end
        -- Mark before invoking the native method to avoid re-entrant double
        -- removal. Receipt is cleared on failure for a future retry.
        receipts[key]=true
        local ok,err=pcall(function() bag:remove(id,1) end)
        if not ok then
            receipts[key]=nil
            warn("[AUTO FARM SEED] remove failed",id,err)
            return
        end
        refreshInventoryGui(bag)
        -- v1.0.146: one print per planted tile spammed the Delta console.
        seedDebitLogN+=1
        if env.Fian792Verbose or seedDebitLogN%10==1 then
            print("[AUTO FARM SEED CONFIRMED DEBIT]",id,
                before,"->",countItem(id),"|",x,y,"| #",seedDebitLogN)
        end
    end

    -- Nonblocking farming action pump. Native placement/punch is issued as
    -- the avatar moves; delayed world confirmation is checked on later ticks.
    -- No task.wait here, no click/tap spam, one action per live target.
    moveFarmAction=function(run,inMotion)
        hitchMark("moveFarmAction")
        if not alive() or ownRun~=run or dropPause or guardPaused
            or running or breakRunning then return false end
        local state,px,py=touchPosition()
        if not state or not state.grounded then return false end
        local production=env.Fian792DirtProduction
        if production and phase=="harvest" and countItem(production.material)>=production.goal then return false end
        local now=os.clock()
        if phase=="plant" and plantOn and seedId then
            -- Pipelined Plant: keep walking while earlier placements await
            -- native FG confirmation (max 3 in flight, 0.45s each). An
            -- unconfirmed tile is NOT retried in place; it is left for the
            -- bounded end-of-row return pass.
            local pend=plantSweep.pending
            local inflight=plantSweep.inflight
            local resolved=false
            for i=#pend,1,-1 do
                local p=pend[i]
                if now-p.at>=0.13 and tileAt("fg",p.x,p.y)==p.id then
                    -- Calibrate the confirm timeout from REAL latencies.
                    local lat=plantSweep.lat or {}
                    plantSweep.lat=lat
                    lat[#lat+1]=now-p.at
                    if #lat>30 then table.remove(lat,1) end
                    if #lat>=8 then
                        local sorted=table.clone(lat)
                        table.sort(sorted)
                        local p90=sorted[math.max(1,math.ceil(#sorted*0.9))]
                        plantSweep.timeout=math.clamp(p90*1.5+0.1,0.35,1.2)
                    end
                    plantSweep.confirms=(plantSweep.confirms or 0)+1
                    if plantSweep.confirms%25==0 then
                        print(("[AUTO FARM PLANT LATENCY] samples %d | last %.2fs | timeout %.2fs"):format(
                            #lat,now-p.at,plantSweep.timeout or 0.45))
                    end
                    table.remove(pend,i)
                    inflight[p.key]=nil
                    reconcilePlantSeed(p.id,p.stock,p.x,p.y)
                    if p.productionBudget and production and production.cycle then
                        production.cycle.remaining=math.max(0,production.cycle.remaining-1)
                        if production.saveCycle then production.saveCycle(false) end
                    end
                    observedTrees[p.y*world.w+p.x]={
                        id=p.id,p=workspace:GetServerTimeNow()
                    }
                    plantRetries[p.key]=nil
                    planted+=1
                    local _,hereX,hereY=touchPosition()
                    if hereX and hereY then
                        lastPlantLocation={x=hereX,y=hereY}
                    end
                    finishPlantTarget({x=p.x,y=p.y,key=p.key},"planted")
                    status("Plant moving | row "..p.y.." X "..p.x)
                    resolved=true
                elseif now-p.at>(plantSweep.timeout or 0.45) then
                    table.remove(pend,i)
                    inflight[p.key]=nil
                    local tried=(plantRetries[p.key] or 0)+1
                    plantRetries[p.key]=tried
                    if tried>=3 then
                        plantRetries[p.key]=nil
                        finishPlantTarget({x=p.x,y=p.y,key=p.key},
                            "3 unconfirmed native placements")
                        print("[AUTO FARM PLANT] Skip after retries",p.x,p.y,
                            "| FG",tileAt("fg",p.x,p.y),"| seed",countItem(p.id))
                    else
                        finishPlantTarget({x=p.x,y=p.y,key=p.key},"unconfirmed")
                        print("[AUTO FARM PLANT UNCONFIRMED]",tried,"/3 |",
                            p.x,p.y,"| left for end-of-row pass")
                    end
                    resolved=true
                end
            end
            -- Movement steering caps at the NEWEST in-flight tile (+0.7), so
            -- the avatar keeps walking while older placements confirm.
            plantPending=pend[#pend]
            if #pend>=3 then return resolved end
            if production and production.cycle and
                (production.cycle.remaining<=#pend
                    or countItem(seedId)-#pend<=(production.reserveSeed or 0)) then return resolved end
            if now<nextAction or countItem(seedId)-#pend<=0 then return resolved end
            local t=nextPlantTarget()
            if not t or t.y~=py or not plantSpot(t.x,t.y)
                or not inRange(state,t.x,t.y) then return resolved end
            -- Right after a Direct landing a tile 2 away was rejected:
            -- only plant adjacent tiles until the first one confirms.
            if now<(plantSweep.nearOnlyUntil or 0)
                and math.abs(t.x-px)>1 then return resolved end
            local stock=countItem(seedId)
            if stock<=0 then return resolved end
            local ok,ret=pcall(refs.place,"fg",t.x,t.y,seedId,false,false)
            if ok and ret~=false then
                pend[#pend+1]={x=t.x,y=t.y,key=t.key,id=seedId,stock=stock,at=now,
                    productionBudget=production and production.cycle~=nil}
                inflight[t.key]=true
                plantPending=pend[#pend]
                nextAction=now+plantMs/1000
                if inMotion and (not rotation.enabled or planted%12==0) then
                    print("[AUTO FARM MOVING PLANT] Y",t.y,"X",t.x)
                end
            else
                local failed=(plantRetries[t.key] or 0)+1
                plantRetries[t.key]=failed
                if failed>=3 then
                    finishPlantTarget(t,"native place rejected 3x")
                    plantRetries[t.key]=nil
                else
                    print("[AUTO FARM PLANT RETRY]",failed,"/3 |",t.x,t.y)
                end
                nextAction=now+0.30
            end
            return true
        elseif phase=="harvest" and harvestOn and type(punch)=="function" then
            if harvestPending then
                local p=harvestPending
                if tileAt("fg",p.x,p.y)==0 then
                    harvested+=1
                    observedTrees[p.y*world.w+p.x]=nil
                    local receipts=debitedPlantTiles[world]
                    if receipts then receipts[p.x..":"..p.y..":"..seedId]=nil end
                    -- Only invalidate the global target after a confirmed
                    -- removal. Do not rescan it during the active row sweep.
                    if not harvestSweep.active then
                        orderedHarvestGoal=nil
                        harvestScanAt=0
                    end
