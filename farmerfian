            if not desired then return nil end
            local last=px
            for step=1,math.min(20,math.abs(desired-px)+1) do
                local nx=px+step*direction
                if nx<0 or nx>=world.w or not touchStep(nx,py) then break end
                if touchGround(nx,py) then last=nx end
            end
            -- Same-tile loot is handled by touchOne; do not oscillate
            -- left/right merely to reach the current standing tile.
            return last~=px and last or nil
        end
        -- Continue forward on the current row; only reverse once forward
        -- loot is exhausted. Avoid back-and-forth per adjacent drop.
        local forward=preferredDir>=0 and 1 or -1
        local desired=forward>0 and rightMost or leftMost
        local edge=corridorEnd(forward,desired)
        if not edge then
            forward=-forward
            desired=forward>0 and rightMost or leftMost
            edge=corridorEnd(forward,desired)
        end
        if not edge then return false end
        local reachedDrop=false
        for _,d in pairs(drops) do
            if type(d)=="table" and type(d.x)=="number"
                and type(d.y)=="number" and type(d.uid)=="number"
                and (tonumber(d.n) or 0)>0
                and (touchCooldown[d.uid] or 0)<=now
                and (math.floor(d.y)==py or math.floor(d.y)==py-1)
                and cropDrop(d) and not reservedAutoDropPile(d) then
                local tx=math.floor(d.x)
                -- +1: loot ONE tile past the walkable end (wall / no
                -- ground at the row edge) is still inside pickup reach.
                if (tx-px)*forward>=0 and (tx-edge)*forward<=1
