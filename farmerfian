    -- v1.0.133: a miss used to re-walk the whole GC on EVERY gem pickup
    -- (freeze while harvesting). Retry at most once a minute.
    if os.clock() - gemUiMissAt < 60 then return nil end
    gemUiMissAt = os.clock()
    if type(getgc) ~= "function" then return nil end
    local ok, objs = pcall(getgc, true)
