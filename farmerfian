--==================================================
-- V68 PENJAGA: world-only detection, native pause & guarded return.
-- All existing PNB toggles and grids stay selected when suspended.
--==================================================
do
    env.Fian792GuardGeneration = (env.Fian792GuardGeneration or 0) + 1
    local gen = env.Fian792GuardGeneration
    local on, mode, who, action = false, "idle", "Staff (Mod/Dev)", "Pause"
    local autoResume, calmSeconds, backSeconds = true, 5, 60
    local allowed, alerted = {}, {}
    local currentWorld, backAt, safeAt = "", 0, nil
    local exitSeen,returnStarted,returnAttempts=false,0,0
    local others, roles, menu, lastScan, statusLabel = nil,nil,nil,-20,nil
    local function live() return env.Fian792GuardGeneration==gen end
    local function status(text)
        if statusLabel then pcall(function() statusLabel:SetDesc(text) end) end
    end
    local function report(text)
        print("[CHLISE GUARD]",text)
        status(text)
    end
    local function scan()
        if os.clock()-lastScan<5 then return end
        lastScan=os.clock()
        if not roles then
            local shared=game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
            local module=shared and shared:FindFirstChild("Roles")
            if module then
                local ok,object=pcall(require,module)
                if ok and type(object)=="table"
                    and type(rawget(object,"isDeveloper"))=="function"
                    and type(rawget(object,"isModerator"))=="function" then
                    roles=object
                    report("Roles module terhubung")
                end
            end
        end
        -- Keep the last valid runtime refs; do not scan the GC every 5 s
        -- once Roles, player list and world menu are already available.
        if roles and others and menu then return end
        if type(getgc)~="function" then return end
        local ok,items=pcall(getgc,true)
        if not ok or type(items)~="table" then return end
        local roleCandidate,roleMatches=nil,0
        for _,v in pairs(items) do
            if type(v)=="table" then
                if not roles
                    and type(rawget(v,"isDeveloper"))=="function"
                    and type(rawget(v,"isModerator"))=="function" then
                    roleMatches+=1
                    roleCandidate=v
                end
                if not others and type(rawget(v,"list"))=="function"
                    and type(rawget(v,"where"))=="function"
                    and type(rawget(v,"playerAt"))=="function" then others=v end
                if not menu and type(rawget(v,"openPicker"))=="function"
                    and type(rawget(v,"enter"))=="function" then menu=v end
            end
        end
        -- One verified scanner candidate; reject ambiguous candidates.
        if not roles and roleMatches==1 then
            roles=roleCandidate
            report("Roles runtime terhubung (getgc)")
        elseif not roles and roleMatches>1 then
            report("Roles runtime ambigu | "..roleMatches.." kandidat")
        end
    end
    local function roleOf(id)
        if not roles then return nil end
        if type(roles.isDeveloper)=="function" then
            local ok,v=pcall(roles.isDeveloper,id)
            if ok and v then return "Developer" end
        end
        if type(roles.isModerator)=="function" then
            local ok,v=pcall(roles.isModerator,id)
            if ok and v then return "Moderator" end
        end
        return nil
    end
    local function worldPlayers()
        if not others or type(rawget(others,"list"))~="function" then return nil end
        local ok,list=pcall(others.list)
        if not ok or type(list)~="table" then return nil end
        local result={}
        for _,p in pairs(list) do
            if type(p)=="table" then
                local id=tonumber(p[1] or p.userId)
                if id and id~=player.UserId then
                    result[#result+1]={id=id,name=tostring(p[2] or p.name or id),role=roleOf(id)}
                end
            end
        end
        return result
    end
    local function threats(players)
        local result={}
        for _,p in ipairs(players) do
            if p.role or (who=="Semua pemain" and not allowed[p.id]) then
                result[#result+1]=p
            end
        end
        return result
    end
    local function names(players)
        local result={}
        for i,p in ipairs(players) do
            if i>4 then result[#result+1]="+"..(#players-i+1).." lagi";break end
            result[#result+1]=p.name.." ("..(p.role or "pemain")..")"
        end
        return table.concat(result,", ")
    end
    local function worldName()
        local value=rawget(world,"name")
        return type(value)=="string" and value or ""
    end
    local function hold(reason)
        guardPaused=true
        local runtime=env.Fian792DropRuntime
        if runtime and type(runtime.hold)=="function" then pcall(runtime.hold) end
        report(reason)
    end
    local function release()
        guardPaused=false
        mode="idle";safeAt=nil
        report("Aman | aktivitas sebelumnya dilanjutkan")
    end
    local function leave()
        if menu and type(rawget(menu,"openPicker"))=="function" then
            local ok,result=pcall(menu.openPicker)
            if ok and result~=false then return true end
        end
        if type(rawget(world,"call"))=="function" then
            local ok,result=pcall(world.call,"LeaveWorld")
            if ok and result~=false then return true end
        end
        return false
    end
    local function enter(target)
        if target=="" then return false end
        -- Standalone verified menu.enter(target) actually re-enters GrowBlox;
        -- nil response means no exception, NOT proof the world loaded.
        if menu and type(rawget(menu,"enter"))=="function" then
            local ok,result=pcall(menu.enter,target)
            if ok and result~=false then return true end
            print("[CH RETURN ENTER] menu.enter failed",ok,tostring(result))
        end
        if type(rawget(world,"enter"))=="function" then
            local ok,result=pcall(world.enter,target)
            if ok and result~=false then return true end
            print("[CH RETURN ENTER] world.enter failed",ok,tostring(result))
        end
        return false
    end
    env.Fian792EnterPreviousWorld=function(target)
        scan()
        return enter(target)
    end
    local function startMonitor(value)
        on=value
        table.clear(allowed);table.clear(alerted)
        mode="idle";safeAt=nil
        exitSeen=false;returnStarted=0;returnAttempts=0
        if not value then
            guardPaused=false
            report("Penjaga OFF")
            return
        end
        scan()
        local already=worldPlayers()
        if already then
            for _,p in ipairs(already) do
                if not p.role then allowed[p.id]=true end
            end
            if who=="Staff (Mod/Dev)" and not roles then
                hold("Modul Roles belum ditemukan; deteksi staff belum siap")
            else
                release()
            end
        else
            hold("Daftar pemain world belum siap; aktivitas dijeda")
        end
    end

    env.Fian792GuardRuntime={stop=function() startMonitor(false) end}
    local okTab, tab=pcall(function()
        return Window:Tab({Title="Penjaga",Icon="shield"})
    end)
    if not okTab or not tab then
        warn("[CHLISE GUARD] Gagal buat tab Penjaga:",tostring(tab))
        tab=Window:Tab({Title="Penjaga"})
    end
    print("[CHLISE GUARD] Tab registered early")
    local controls=tab:Section({Title="Kontrol",Box=true,Opened=true})
    statusLabel=controls:Paragraph({Title="Status Penjaga",Desc="OFF"})
    controls:Toggle({Title="Aktifkan Penjaga",Desc="Deteksi pemain per 0,5 detik",
        Value=false,Callback=function(v) startMonitor(v) end})
    controls:Dropdown({Title="Yang dideteksi",
        Desc="Pemain yang sudah ada saat ON diabaikan; staff tidak",
        Values={"Staff (Mod/Dev)","Semua pemain"},Value="Staff (Mod/Dev)",
        Callback=function(v) who=v end})
    local responses=tab:Section({Title="Aksi saat terdeteksi",Box=true,Opened=true})
    responses:Dropdown({Title="Aksi",
        Desc="Jeda sementara atau keluar world",
        Values={"Pause","Keluar world"},Value="Pause",
        Callback=function(v) action=v end})
    responses:Toggle({Title="Auto Resume",
        Desc="Lanjutkan aktivitas yang masih ON setelah aman",
        Value=true,Callback=function(v) autoResume=v end})
    local timing=tab:Section({Title="Waktu",Box=true,Opened=false})
    timing:Slider({Title="Tunggu aman (detik)",Value={Min=2,Max=60,Default=5},
        Step=1,Callback=function(v) calmSeconds=math.floor(v) end})
    timing:Slider({Title="Masuk world lagi (detik)",Value={Min=20,Max=600,Default=60},
        Step=5,Callback=function(v) backSeconds=math.floor(v) end})
    local more=tab:Section({Title="Lainnya",Box=true,Opened=false})
    more:Button({Title="Abaikan pemain sekarang",
        Desc="Whitelist pemain biasa saja (bukan staff)",
        Callback=function()
            local list=worldPlayers()
            if not list then report("Daftar pemain belum tersedia");return end
            local count=0
            for _,p in ipairs(list) do
                if not p.role then allowed[p.id]=true;count+=1 end
            end
            report("Diabaikan: "..count.." pemain biasa")
        end})
    more:Button({Title="Batalkan Auto Resume",
        Desc="Tetap berhenti sampai Penjaga dimatikan",
        Callback=function()
            autoResume=false
            if mode=="away" then mode="out" end
            report("Auto Resume dibatalkan")
        end})

    task.spawn(function()
        while live() do
            task.wait(0.5)
            if not live() then break end
            if not on then continue end
            local ok,err=pcall(function()
                scan()
                if mode=="out" then
                    status("Keluar world | Auto Resume mati")
                    return
                end
                if mode=="away" then
                    if worldPickerVisible() then exitSeen=true end
                    if os.clock()<backAt then
                        status("Di luar world | masuk lagi dalam "..math.ceil(backAt-os.clock()).." detik")
                        return
                    end
                    if not exitSeen then
                        -- The leave command may be a no-op; don't send a
                        -- blind Enter while still in the original world.
                        backAt=os.clock()+3
                        report("Menunggu WorldPicker setelah Leave | cek menu")
                        return
                    end
                    if not enter(currentWorld) then
                        returnAttempts+=1
                        backAt=os.clock()+math.min(30,3+returnAttempts*3)
                        report("Masuk world gagal "..returnAttempts..
                            "x | retry "..math.ceil(backAt-os.clock()).."s")
                        return
                    end
                    mode="verify";returnStarted=os.clock();safeAt=nil
                    report("Enter "..currentWorld.." terkirim | cek WorldPicker tutup")
                    return
                end
                if mode=="verify" then
                    local state=getState()
                    local ready=currentWorld~="" and worldName()==currentWorld
                        and state and state.dead~=true and state.active~=false
                        and type(rawget(world,"fg"))=="table"
                        and type(rawget(world,"bg"))=="table"
                        and not worldPickerVisible()
                    if ready and exitSeen then
                        safeAt=safeAt or os.clock()
                        if os.clock()-safeAt>=1.5 then
                            mode="pause";safeAt=nil
                            returnAttempts=0
                            others=nil;lastScan=-20;scan()
                            report("World "..currentWorld..
                                " masuk lagi | verifikasi pemain aman")
                        end
                        return
                    end
                    safeAt=nil
                    if os.clock()-returnStarted>=12 then
                        returnAttempts+=1
                        backAt=os.clock()+math.min(30,3+returnAttempts*3)
                        mode="away"
                        report("Enter belum terverifikasi | retry "..
                            math.ceil(backAt-os.clock()).."s")
                    else
                        status("Menunggu WorldPicker tertutup dan player siap")
                    end
                    return
                end
                local list=worldPlayers()
                if not list then
                    guardPaused=true
                    status("Data pemain belum valid | aktivitas dijeda")
                    return
                end
                if who=="Staff (Mod/Dev)" and not roles then
                    guardPaused=true
                    status("Modul Roles tidak tersedia | aktivitas dijeda")
                    return
                end
                local visible={}
                for _,p in ipairs(list) do visible[p.id]=true end
                for id in pairs(alerted) do
                    if not visible[id] then alerted[id]=nil end
                end
                local bad=threats(list)
                if #bad>0 then
                    safeAt=nil
                    if mode=="idle" then
                        currentWorld=worldName()
                        hold("Terdeteksi: "..names(bad).." | dijeda")
                        if action=="Keluar world" then
                            exitSeen=false;returnAttempts=0
                            if leave() then
                                backAt=os.clock()+backSeconds
                                mode=autoResume and "away" or "out"
                                report("Keluar world "..currentWorld..
                                    " | Auto Return "..(autoResume and ("ON "..backSeconds.."s") or "OFF"))
                            else
                                mode="pause"
                                report("Gagal keluar world | tetap Pause")
                            end
                        else mode="pause" end
                    else
                        status("Dijeda: "..names(bad))
                    end
                    for _,p in ipairs(bad) do alerted[p.id]=true end
                    return
                end
                if guardPaused or mode=="pause" then
                    safeAt=safeAt or os.clock()
                    local remaining=calmSeconds-(os.clock()-safeAt)
                    if remaining>0 then
                        status("Aman | lanjut dalam "..math.ceil(remaining).." detik")
                    elseif autoResume then
                        release()
                    else
                        status("Aman | Auto Resume mati; tetap dijeda")
                    end
                else
                    status("Aman | monitoring aktif")
                end
            end)
            if not ok then
                guardPaused=true
                status("Penjaga error | aktivitas dijeda")
                warn("[CHLISE GUARD]",err)
            end
        end
    end)
    print("[CHLISE GUARD] Tab Penjaga siap | Pause / Leave / Resume")
end



