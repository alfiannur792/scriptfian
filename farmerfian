                                lastHit[key]=os.clock()
                                local ok,ret=pcall(refs.place,"fg",tx,ty,
                                    chosen,false,false)
                                if ok and ret~=false then
                                    task.wait(0.15)
                                    if tileAt("fg",tx,ty)==chosen then placed+=1 end
                                end
                            end
                        end
                    else
                        for dy=-2,2 do
                            for dx=-2,2 do
                                if not active or revision~=run then break end
                                local tx,ty=x+dx,y+dy
                                local id=tileAt("fg",tx,ty)
                                local key=tx..":"..ty
                                if safe(tx,ty,state) and breakable(id)
                                    and os.clock()-(lastHit[key] or 0)>=0.28 then
                                    lastHit[key]=os.clock()
                                    local ok=pcall(punch,tx,ty,true,nil)
                                    if ok then
                                        task.wait(0.16)
                                        if tileAt("fg",tx,ty)==0 then cleared+=1 end
                                    end
                                end
                            end
                            if not active or revision~=run then break end
                        end
                    end
                    if os.clock()-(builder.worldStatusAt or 0)>2.5 then
                        builder.worldStatusAt=os.clock()
                        tell("ON "..mode.." | placed "..placed..
                            " | cleared "..cleared.." | X"..x.." Y"..y)
                    end
                end
                task.wait(0.35)
            end
            if active and revision==run then stop("world changed") end
        end)
    end})
    group:Button({Title="Stop World Action",Callback=function()
        stop("manual")
    end})
    group:Paragraph({Title="Batas V1",
        Desc="Tidak ada auto-roam. Clear World hanya FG yang tidak dilindungi, bukan BG/lock. Farm memasang baris di atas karakter; tidak menggali atau mengedit inventory. Gunakan di world milik sendiri."})
end

