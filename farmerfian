local function simulatePlace(x, y, id, token)
    if dropPause or guardPaused then return false, "Auto Drop pause" end
    local item = db[id]

    if not item then
        return false, "Item invalid"
    end

    local layer = getLayer(id)

    local fg = tileAt("fg", x, y)
    local bg = tileAt("bg", x, y)

    if fg == nil or bg == nil then
        return false, "Outside world"
    end

    local current =
        layer == "bg" and bg or fg

    if current ~= 0 then
        return false, "Tile occupied"
    end

    -- Keep the original drop guard for all tiles EXCEPT the final
    -- explicitly selected Auto Collect priority tile.
    if not isFinalCollectPriorityTile(x, y) then
        local held = hasDropAtPlaceTile(x, y)
        if held == nil then return false, "Drop list unavailable" end
        if held then return false, "Drop still present" end
    end

    local stockBefore = countItem(id)

    if stockBefore <= 0 then
        return false, "Item habis"
    end

    local s = getState()

    if not s or not inRange(s, x, y) then
        return false, "Out of range"
    end

    if not canBuild(x, y) then
        return false, "Build not allowed"
    end

    local nextAllowedAt =
        lastPlaceAt + placeMs / 1000

    while os.clock() < nextAllowedAt do
        if not activeToken(token) then
            return false, "Stopped"
        end

        task.wait(
            math.min(
                0.05,
                math.max(0.001, nextAllowedAt - os.clock())
            )
        )
    end

    if not activeToken(token) then
        return false, "Stopped"
    end

    if tileAt(layer, x, y) ~= 0 then
        return false, "Tile changed"
