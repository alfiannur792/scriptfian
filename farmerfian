--==================================================
-- V1.0.5 | UNIVERSAL ACTIVITY WORLD RECOVERY + ANTI-AFK
-- Server disconnect/teleport is a separate feature, not auto enabled.
-- WorldClosed event + Keep-world fallback + verified re-entry.
--==================================================
do
    -- Isolate AFK/Return locals from the already-large main chunk.
    local function initializeAutoReturnV68()
    if env.Fian792AfkConnection then
        pcall(function() env.Fian792AfkConnection:Disconnect() end)
    end
    if env.Fian792WorldClosedConnection then
        pcall(function() env.Fian792WorldClosedConnection:Disconnect() end)
    end
    env.Fian792AntiAfkEnabled=true
    env.Fian792AutoReturnEnabled=true
    env.Fian792ReturnMoving=false
    local vu=game:GetService("VirtualUser")
    env.Fian792AfkConnection=player.Idled:Connect(function(seconds)
        if not env.Fian792AntiAfkEnabled then return end
        local ok,err=pcall(function()
            vu:CaptureController()
            vu:ClickButton2(Vector2.new(0,0))
        end)
        if not ok then warn("[CH AFK] Failed:",err)
        else print("[CH AFK] VirtualUser triggered",math.floor(tonumber(seconds) or 0)) end
    end)

    local tab=Window:Tab({Title="AFK & Return",Icon="rotate-ccw"})
    local sec=tab:Section({Title="Koneksi & Aktivitas",Box=true,Opened=true})
    sec:Toggle({Title="Anti AFK",Value=true,
        Desc="Roblox Idled -> VirtualUser; no heavy polling",
        Callback=function(v) env.Fian792AntiAfkEnabled=v end})
    sec:Toggle({Title="Universal Auto Return",Value=true,
        Desc="Farm/Rotation/PNB/Builder/World -> kembali ke posisi kerja, lanjut state yang masih ON",
        Callback=function(v) env.Fian792AutoReturnEnabled=v end})
    local info=sec:Paragraph({Title="Status Return",Desc="Siap | posisi config tetap; aktivitas ON menentukan titik kembali"})
    local function report(message)
        print("[CH RETURN]",message)
        pcall(function() info:SetDesc(message) end)
    end

    local revision=(env.Fian792ReturnRevision or 0)+1
    env.Fian792ReturnRevision=revision
    local function live() return env.Fian792ReturnRevision==revision end
    local stage="watch"
    local goneAt=nil
    local previousFG=nil
    local pickerConfirmed=false
    local verifyAt=0
    local nextTry=0
    local attempts=0
    local pauseOwned=false
    local eventExit=false
    local lastStatus=""
    local function display(msg)
        if msg~=lastStatus then lastStatus=msg;report(msg) end
    end
    local function isWorldReady(home)
        local s=getState()
        return s~=nil and s.dead~=true and s.active~=false
            and not worldPickerVisible()
            and rawget(world,"name")==home.world
            and type(rawget(world,"fg"))=="table"
            and type(rawget(world,"bg"))=="table",s
    end
    local function pause()
        if not pauseOwned then guardPaused=true;pauseOwned=true end
    end
    local function release()
        if pauseOwned then
            guardPaused=false;pauseOwned=false
        end
    end
    -- Settings already persist through Fian792 Config. Only transient
    -- activity identity and last safe working position are saved here.
    local home=nil
    local lastWork=nil
    local function activity()
        local activeNames={}
        local farm=env.Fian792FarmRuntime
        local builder=env.Fian792WorldBuilder
        local action=env.Fian792WorldAction
        local drop=env.Fian792DropRuntime
        if farm and type(farm.running)=="function" and farm.running() then
            activeNames[#activeNames+1]="Farm/Rotation"
        end
        if running then activeNames[#activeNames+1]="Auto Place" end
        if breakRunning then activeNames[#activeNames+1]="Auto Break" end
        if collectEnabled then activeNames[#activeNames+1]="Auto Collect" end
        if builder and type(builder.running)=="function" and builder.running() then
            activeNames[#activeNames+1]="World Builder"
        end
        if action and type(action.running)=="function" and action.running() then
            activeNames[#activeNames+1]="World Action"
        end
        if drop and type(drop.enabled)=="function" and drop.enabled() then
            activeNames[#activeNames+1]="Auto Drop"
        end
        return activeNames
    end
    local function observe()
        local names=activity()
        -- Universal Return must also work when the user manually leaves
        -- while idle (no Farm/PNB toggles), as demonstrated in standalone
        -- testing. The ON toggle explicitly opts into restoring that world.
        if #names==0 then names[1]="World (idle)" end
        local s=getState()
        local worldName=rawget(world,"name")
        if not s or s.dead or type(worldName)~="string"
            or worldName=="" then return nil end
        local x,y=math.floor(s.x),math.floor(s.y-0.475)
        if x<0 or x>=world.w or y<0 or y>=world.h then return nil end
        -- PNB-only resumes at its explicitly recorded Break location.
        -- Other running activities resume from their last live tile and
        -- preserve their internal phase/cursor instead of starting anew.
        local pnbOnly=#names==1 and breakRunning
        local saved=env.Fian792PNBHome
        if pnbOnly and type(saved)=="table"
            and saved.world==worldName then
            x,y=saved.x,saved.y
        end
        return {world=worldName,x=x,y=y,description=table.concat(names,", ")}
    end
    local function currentHome()
        return home or lastWork
    end
    local function beginReturn(reason)
        if not live() or not env.Fian792AutoReturnEnabled then return end
        if guardPaused and not pauseOwned then return end
        if stage~="watch" then return end
        home=observe() or lastWork
        if not home then return end
        previousFG=rawget(world,"fg")
        pickerConfirmed=worldPickerVisible()
        goneAt=os.clock()
        attempts=0
        nextTry=os.clock()+2
        pause()
        stage="enter"
        eventExit=true
        display(reason.." | Pause "..home.description.." | re-enter "..home.world)
    end

    -- Native ByteNet WorldClosed; only listen, never send packets.
    local hooked=false
    local rs=game:GetService("ReplicatedStorage")
    local shared=rs:FindFirstChild("Shared")
    local node=shared and shared:FindFirstChild("Net")
    if node and node:IsA("ModuleScript") then
        local ok,net=pcall(require,node)
        if ok and type(net)=="table" and type(net.on)=="function"
            and type(net.EVENTS)=="table" and net.EVENTS.WorldClosed then
            hooked=pcall(net.on,"WorldClosed",function()
                if live() then beginReturn("WorldClosed diterima") end
            end,function()
                return rawget(world,"name") or ""
            end)
        end
    end
    if not hooked then
        local remotes=rs:FindFirstChild("WorldRemotes")
        local closed=remotes and remotes:FindFirstChild("WorldClosed")
        if closed and closed:IsA("RemoteEvent") then
            env.Fian792WorldClosedConnection=closed.OnClientEvent:Connect(function()
                if live() then beginReturn("WorldClosed RemoteEvent") end
            end)
            hooked=true
        end
    end
    print("[CH RETURN] WorldClosed listener",hooked and "ON" or "unavailable (Keep fallback)")

    task.spawn(function()
        while live() do
            task.wait(0.5) -- Light two-property UI check; no getgc/route scan.
            if not live() then break end
            local pickerOpen=worldPickerVisible()
            if pickerOpen and stage~="watch" then pickerConfirmed=true end
            local observed=stage=="watch" and not guardPaused
                and not pickerOpen and observe() or nil
            if observed then lastWork=observed end
            local target=currentHome()
            if not env.Fian792AutoReturnEnabled
                or type(target)~="table" or target.world=="" then
                if stage=="moving" then
                    local nav=env.Fian792WorldBuilderNav
                    if nav and type(nav.cancel)=="function" then pcall(nav.cancel) end
                end
                release()
                stage="watch";home=nil;lastWork=nil
                goneAt=nil;eventExit=false;pickerConfirmed=false;attempts=0
                continue
            end
            if guardPaused and not pauseOwned then continue end
            local ready,s=isWorldReady(target)
            if stage=="watch" then
                if pickerOpen then
                    -- UI event tested: name and fg can both remain unchanged.
                    beginReturn("WorldPicker VISIBLE | LeaveWorld")
                elseif ready then
                    goneAt=nil
                else
                    goneAt=goneAt or os.clock()
                    if os.clock()-goneAt>=4 then
                        home=target
                        previousFG=rawget(world,"fg")
                        pause()
                        stage="enter"
                        nextTry=os.clock()+2.5
                        attempts=0
                        eventExit=false
                        display("Di luar world | Keep "..home.world.." | "..home.description)
                    end
                end
            elseif stage=="enter" then
                -- The old references may still look ready after WorldClosed;
                -- only accept a fresh world snapshot once enter was requested.
                if os.clock()<nextTry then continue end
                if attempts>=3 then
                    attempts=0
                    nextTry=os.clock()+15
                    display("Enter belum berhasil (3x) | retry otomatis 15s | PAUSE")
                    continue
                end
                attempts+=1
                local fn=env.Fian792EnterPreviousWorld
                local ok,result=false,false
                if type(fn)=="function" then ok,result=pcall(fn,target.world) end
                if ok and result==true then
                    stage="verify"
                    verifyAt=os.clock()
                    display("Enter "..target.world.." dikirim ("..attempts.."/3) | verifikasi")
                else
                    nextTry=os.clock()+10
                    display("Enter gagal ("..attempts.."/3) | retry 10 detik")
                end
            elseif stage=="verify" then
                -- Genta verifies world foreground refresh, not just pcall success.
                local refreshed=previousFG==nil or rawget(world,"fg")~=previousFG
                    or (pickerConfirmed and not pickerOpen)
                if ready and refreshed then
                    stage="settle";verifyAt=os.clock()
                    display("World "..target.world.." valid | tunggu spawn")
                elseif os.clock()-verifyAt>=8 then
                    stage="enter";nextTry=os.clock()+10
                    display("World belum terverifikasi | retry 10 detik")
                end
            elseif stage=="settle" then
                if not ready then stage="enter";nextTry=os.clock()+3
                elseif os.clock()-verifyAt>=1.5 then
                    if target.description=="World (idle)" then
                        -- No movement owner is active. Once the WorldPicker
                        -- has closed and the live state is ready, entering
                        -- the world is success: don't require BuilderNav.
                        release()
                        stage="watch";home=nil;goneAt=nil
                        attempts=0;previousFG=nil;pickerConfirmed=false
                        eventExit=false
                        display("AUTO RETURN SUCCESS | world "..target.world..
                            " | idle, no movement needed")
                    else
                        stage="return"
                        display("Kembali ke posisi kerja "..target.x..","..target.y)
                    end
                end
            elseif stage=="return" then
                if not ready then stage="enter";nextTry=os.clock()+3
                elseif os.clock()<nextTry then
                    continue
                else
                    local x,y=math.floor(s.x),math.floor(s.y-0.475)
                    if x==target.x and y==target.y then
                        local resumed=target.description
                        release();stage="watch";home=nil;goneAt=nil;eventExit=false
                        pickerConfirmed=false;attempts=0;previousFG=nil
                        display("Posisi kerja tercapai | resume "..resumed)
                    elseif env.Fian792FarmRuntime and type(env.Fian792FarmRuntime.isActive)=="function"
                        and env.Fian792FarmRuntime.isActive() then
                        -- v1.0.135: Auto Farm / Rotation is ON. Its own
                        -- navigator returns to the work (home / next row);
                        -- walking here was refused as "movement busy" and
                        -- kept everything paused (19:00:29 log).
                        local resumed=target.description
                        release();stage="watch";home=nil;goneAt=nil;eventExit=false
                        pickerConfirmed=false;attempts=0;previousFG=nil
                        display("World masuk | Farm/Rotasi lanjut sendiri | resume "..tostring(resumed))
                    else
                        local nav=env.Fian792WorldBuilderNav
                        if not nav or type(nav.walk)~="function" then
                            nextTry=os.clock()+10
                            display("World masuk | navigator belum siap | retry 10s")
                        else
                            stage="moving"
                            task.spawn(function()
                                env.Fian792ReturnMoving=true
                                local ok,done,why=pcall(nav.walk,target.x,target.y)
                                env.Fian792ReturnMoving=false
                                if not live() or stage~="moving" then return end
                                if not env.Fian792AutoReturnEnabled then
                                    stage="watch";return
                                end
                                if ok and done then stage="return"
                                else
                                    stage="return"
                                    nextTry=os.clock()+12
                                    display("Navigasi gagal: "..tostring(why or done)..
                                        " | retry 12s, aktivitas PAUSE")
                                end
                            end)
                        end
                    end
                end
            elseif stage=="moving" then
                if not ready then
                    local nav=env.Fian792WorldBuilderNav
                    if nav and type(nav.cancel)=="function" then pcall(nav.cancel) end
                    stage="enter";nextTry=os.clock()+3
                end
            end
        end
    end)
    print("[CH AFK RETURN] v1.0.6 ready | WorldPicker leave detection + menu.enter verified | live activity snapshot")
    end -- initializeAutoReturnV68
    initializeAutoReturnV68()
end

