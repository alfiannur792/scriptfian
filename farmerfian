end

local function startAuto()
    if running then return end

    local id = selectedId
    local item = id and db[id]

    if not item then
        setStatus("Pilih item dahulu")
        resetToggle()
        return
    end

    if selectedCount() == 0 then
        setStatus("Pilih grid dahulu")
        resetToggle()
        return
    end

    local stockAtStart = countItem(id)

    if stockAtStart <= 0 then
        setStatus("Item habis")
        resetToggle()
        return
    end

    local s = getState()

    if not s then
        setStatus("Player unavailable")
        resetToggle()
        return
    end

    local layer = getLayer(id)
    local selectedTiles = selectedTileSnapshot()
    if not selectedTiles or #selectedTiles == 0 then
        setStatus("Grid world belum disimpan; buka Pilih Grid")
        resetToggle()
        return
    end
    publishSelectedTiles()

    local targets = {}
    local targetOriginX, targetOriginY = nil, nil
    local function rebuildPlaceTargets()
        local tiles = selectedTileSnapshot()
        if not tiles then return false end
        if gridAnchor.x == targetOriginX and gridAnchor.y == targetOriginY then
            return true
        end
        targetOriginX, targetOriginY = gridAnchor.x, gridAnchor.y
        targets = {}
        for _, tile in ipairs(tiles) do
            local current = tileAt(layer, tile.x, tile.y)
            if current ~= nil then
                targets[#targets + 1] = {
                    x = tile.x, y = tile.y,
                    armed = current == 0 or current == id
                }
            end
        end
        print("[PLACE GRID MOVED]", targetOriginX, targetOriginY,
            "targets", #targets)
        -- Never reuse old world coordinates when the player moves.
        return #targets > 0
    end
    if not rebuildPlaceTargets() then
        setStatus("Target invalid")
        resetToggle()
        return
    end

    attempts = 0

    running = true
    if breakRunning then setPNBPhase("PLACE", "Auto Place enabled") end
    env.Fian792GridStop = false
    env.Fian792GridToken += 1

    local token = env.Fian792GridToken

    popup.Enabled = false

    setStatus(
        "ON | " .. item.name
        .. " | " .. placeMs .. "ms"
    )

    task.spawn(function()
        local reason = "Stopped"

        local okLoop, err = pcall(function()
            while activeToken(token) do
                if selectedId ~= id and selectedId and db[selectedId] then
                    id = selectedId
                    item = db[id]
                    layer = getLayer(id)
                    targetOriginX, targetOriginY = nil, nil
                    targets = {}
                    setStatus("Item diganti: " .. tostring(item.name) .. " | Grid tetap")
                    if breakRunning then setPNBPhase("PLACE", "item changed") end
                end
                if dropPause or guardPaused then
                    task.wait(0.07)
                    continue
                end
                local oldX, oldY = targetOriginX, targetOriginY
                if not rebuildPlaceTargets() then
                    task.wait(CHECK_DELAY)
                else
                if breakRunning and (oldX ~= targetOriginX or oldY ~= targetOriginY) then
                    setPNBPhase("PLACE", "player moved to another tile")
                end
                -- When Break is enabled, place only in PLACE phase.
                -- Once all selected Place tiles are filled, release Break.
                if breakRunning and pnbPhase ~= "PLACE" then
                    task.wait(CHECK_DELAY)
                else
                    local allPlaced = true
                    local allReadyForBreak = true
                    for _, target in ipairs(targets) do
                        if tileAt(layer, target.x, target.y) ~= id then
                            allPlaced = false
                            -- Earlier Collect priority tiles are held until
                            -- pickup clears them. Only the FINAL selected
                            -- priority tile is allowed to keep Place working.
                            local held = hasDropAtPlaceTile(target.x, target.y)
                            if held ~= true or isFinalCollectPriorityTile(target.x, target.y) then
                                allReadyForBreak = false
                            end
                        end
                    end
                    if allReadyForBreak and breakRunning then
                        setPNBPhase("BREAK", "Place tiles filled or temporarily held by drops")
                        task.wait(CHECK_DELAY)
                    else
                        if countItem(id) <= 0 and not allPlaced then
                            reason = "Stok lokal habis"
                            break
                        end
                        local acted = false

                for _, target in ipairs(targets) do
                    if not activeToken(token) or dropPause then
                        break
                    end
                    local livePos = getState()
                    if not livePos
                        or math.floor(livePos.x) ~= targetOriginX
                        or math.floor(livePos.y - 0.475) ~= targetOriginY then
                        -- Recompute target coordinates at the start of the next loop.
                        break
                    end

                    local current = tileAt(
                        layer,
                        target.x,
                        target.y
                    )

                    if current == id then
                        target.armed = true

                    elseif current == 0
                        and target.armed then

                        -- Earlier-priority tiles retain drop protection;
                        -- only the final Collect priority tile can bypass it.
                        local held = hasDropAtPlaceTile(target.x, target.y)
                        if held == true and not isFinalCollectPriorityTile(target.x, target.y) then
                            logPlaceDropSkip(target.x, target.y)
                            target.armed = true
                            continue
                        end
                        local now = getState()

                        if now
                            and inRange(
                                now,
                                target.x,
                                target.y
                            )
                            and canBuild(
                                target.x,
                                target.y
                            ) then

                            target.armed = false
                            attempts += 1
                            acted = true

                            local success, result =
                                simulatePlace(
                                    target.x,
                                    target.y,
                                    id,
                                    token
                                )

                            if not activeToken(token) then
                                break
                            end

                            if success then
                                target.armed = true

                                setStatus(
                                    "ON | Placed "
                                    .. item.name
                                    .. " | "
                                    .. placeMs .. "ms"
                                )
                            else
                                reason = tostring(result)
                                if reason == "Auto Drop pause"
                                    or reason == "Drop still present"
                                    or reason == "Drop list unavailable"
                                    or reason == "Player moved" then
                                    -- Skip/retry later; never stop Auto Place.
                                    target.armed = true
                                    if reason ~= "Player moved" then
                                        logPlaceDropSkip(target.x, target.y)
                                    end
                                else
                                    setStatus("Place gagal: " .. reason)
                                    stopAuto()
                                end
                            end

                            break
                        end

                    elseif current ~= 0 then
                        target.armed = false
                    end
                end

                        if not acted then
                            task.wait(CHECK_DELAY)
                        end
                    end
                end
                end -- valid player-relative targets
            end
        end)

        running = false

        if env.Fian792GridToken == token then
            env.Fian792GridStop = true
        end

        if not okLoop then
            reason = "Loop error"
            warn("[Fian792]", err)
        end

        setStatus("OFF | " .. reason)
        resetToggle()
    end)
end

