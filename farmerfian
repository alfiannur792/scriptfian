local inventoryLastScan = 0
local function getGameInventory(force)
    if inventorySelected and canAddInventory(inventorySelected) and not force then
        return inventorySelected, inventorySource
    end
    if not force and os.clock() - inventoryLastScan < 2 then
        return nil, "scan cooldown"
    end
    inventoryLastScan = os.clock()
    hitchMark("getGameInventory scan")
    local entries, known = {}, {}
    local function offer(obj, tag, bonus)
        if not canAddInventory(obj) then return end
        local score = bonus or 0
        if type(obj.count) == "function" then score += 10 end
        if type(obj.room) == "function" then score += 10 end
        if typeof(rawget(obj, "changed")) == "Instance" then score += 5 end
        if inventoryModule then
            local ok, match = pcall(function()
                return getmetatable(obj) == inventoryModule
            end)
            if ok and match then score += 120 end
        end
        if not known[obj] or score > known[obj].score then
            local e = {obj=obj, tag=tag, score=score}
            known[obj] = e
        end
    end
    -- This is the world-native reference path also used by ANCH.
    for _, name in ipairs({"backpackNow", "dropTaken"}) do
        for _, v in ipairs(getUpvaluesSafe(rawget(world, name))) do
            if type(v) == "table" then
                offer(v, "world."..name.." upvalue", name == "backpackNow" and 90 or 45)
            elseif type(v) == "function" and name == "dropTaken" then
                for _, nested in ipairs(getUpvaluesSafe(v)) do
                    if type(nested) == "table" then
                        offer(nested, "dropTaken nested upvalue", 50)
                    end
                end
            end
        end
    end
    offer(inv, "recovered getgc inventory", 12)
    offer(previousInv, "previous script inventory", 0)
    -- v1.0.143 FREEZE FIX: skip the full-heap getgc walk when the world's
    -- own references already gave a strong candidate (backpackNow etc.).
    local strong = false
    for _, e in pairs(known) do if e.score >= 45 then strong = true end end
    if not strong and type(getgc) == "function" then
        local ok, objects = pcall(getgc, true)
        if ok and type(objects) == "table" then
            for _, obj in pairs(objects) do
                if type(obj) == "table" then offer(obj, "getgc", 0) end
            end
        end
    end
    for _, e in pairs(known) do entries[#entries+1] = e end
    table.sort(entries, function(a,b) return a.score > b.score end)
    for i=1,math.min(5,#entries) do
        local e = entries[i]
        print("[INV V51 CANDIDATE]", i, e.tag, "score", e.score,
            "count", type(e.obj.count)=="function", "room", type(e.obj.room)=="function")
    end
    local best = entries[1]
    if best then
        inventorySelected, inventorySource = best.obj, best.tag
        inv, refs.inv = best.obj, best.obj
        return best.obj, best.tag
    end
    inventorySelected, inventorySource = nil, nil
    return nil, "no instance supporting add() and slots"
end

