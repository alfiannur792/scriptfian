    local function farmStraightSweep(run,plantTarget)
        hitchMark("farmStraightSweep")
        if not roamOn or not alive() or ownRun~=run
            or dropPause or guardPaused or running or breakRunning
            then return false end
        local state,x,y=touchPosition()
        if not state or not state.grounded then return false end
