-- Use the game's own drop-list updater, as k.lua does, whenever available.
-- Only accept a nested function that closes over the EXACT live drop list.
local nativeDropUpdater, nativeDropUpdaterList
local function findNativeDropUpdater(list)
    if nativeDropUpdaterList == list and nativeDropUpdater then return nativeDropUpdater end
    nativeDropUpdater, nativeDropUpdaterList = nil, list
    local dropTaken = rawget(world, "dropTaken")
    if type(dropTaken) ~= "function" or type(list) ~= "table" then return nil end
