    local function collectRowSweep(run)
        local state,px,py=touchPosition()
        if not state or not state.grounded then return false end
        local fn=rawget(world,"dropList")
        if type(fn)~="function" then return false end
        local ok,drops=pcall(fn)
        if not ok or type(drops)~="table" then return false end
        local rightMost,leftMost=nil,nil
        local live=0
        local now=os.clock()
        local stock={}
        for _,drop in pairs(drops) do
            if type(drop)=="table" and type(drop.uid)=="number"
                and type(drop.id)=="number" and type(drop.x)=="number"
                and type(drop.y)=="number" and (tonumber(drop.n) or 0)>0
                and drop.armed~=false and not drop.taking and not drop.pending
                and not drop.display and (touchCooldown[drop.uid] or 0)<=now
                and cropDrop(drop) and not reservedAutoDropPile(drop) then
                local tx,ty=math.floor(drop.x),math.floor(drop.y)
                if ty==py or (ty==py-1 and farmPassable(tx,ty)) then
                    local hasRoom=true
                    if drop.id~=112 then
                        if stock[drop.id]==nil then
                            stock[drop.id]=countItem(drop.id)<200
                        end
                        hasRoom=stock[drop.id]
                    end
                    if hasRoom and math.abs(tx-px)<=20 then
                        -- Reuse the ground check on each corridor cell below.
                        if tx>=px then
                            rightMost=rightMost and math.max(rightMost,tx) or tx
                        end
                        if tx<=px then
                            leftMost=leftMost and math.min(leftMost,tx) or tx
                        end
