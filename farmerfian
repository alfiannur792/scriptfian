    local function produceMaterialRow(request)
        if active or rotation.enabled or env.Fian792DirtProduction then
            return false,"Auto Farm / Rotation sedang memakai produksi"
        end
        local saved={seed=seedId,blockOnly=farmBlockOnly,block=farmBlockId,
            phase=phase,plant=plantOn,harvest=harvestOn,collect=collectOn,roam=roamOn,
            punch=punch,nextAction=nextAction,plantPending=plantPending,
            harvestPending=harvestPending,goal=orderedHarvestGoal,dir=preferredDir,
            plantSweep=table.clone(plantSweep),harvestSweep=table.clone(harvestSweep)}
        local productionWorld=refs.worldKey()
        ownRun+=1
        local run=ownRun
        local function live()
            return ownRun==run and env.Fian792FarmGeneration==gen
                and refs.worldKey()==productionWorld and request.live()
        end
        local session={run=run,live=live,generation=gen,material=request.material,
            goal=200}
        env.Fian792DirtProduction=session
        seedId=request.seedId;farmBlockOnly=false;farmBlockId=nil
        plantOn=true;harvestOn=true;collectOn=true;roamOn=true
        punch=request.punch or punch
        plantPending=nil;harvestPending=nil;orderedHarvestGoal=nil
        nextAction=0;harvestScanAt=0
        resetPlantSweep()
        harvestSweep.active=false;harvestSweep.row=nil
        harvestSweep.serpCeil=nil;harvestSweep.serpRow=nil;harvestSweep.serpDir=nil
        local ok,result,reason=pcall(function()
            local nav=env.Fian792WorldBuilderNav
            if not nav or type(nav.walk)~="function" then return false,"Navigator produksi belum tersedia" end
            if not seedId or not db[seedId] or db[seedId].kind~="seed"
                or cropBlockId()~=request.material then return false,"Seed pasangan material tidak sesuai" end
            local row=request.row
            if type(row)~="number" or row<0 or row>=world.h-1 then row=nil end
            if not row then
                local _,_,homeY=touchPosition()
                local bestScore=math.huge
                for y=0,world.h-2 do
                    local useful=0
                    for x=2,world.w-3 do
                        if touchGround(x,y) and (plantSpot(x,y) or tileAt("fg",x,y)==seedId) then useful+=1 end
                    end
                    if useful>0 and math.abs(y-(homeY or 0))<bestScore then
                        row,bestScore=y,math.abs(y-(homeY or 0))
                    end
                    if y%10==9 then task.wait() end
                end
            end
            if not row then return false,"Belum ada baris aman untuk produksi material" end
            session.row=row
            request.setRow(row)
            local function pause()
                request.wait()
                return live()
            end
            local function move(x,y)
                touchUnhook()
                if not pause() then return false end
                local moved=nav.walk(x,y,true)
                return moved and live()
            end
            local deferredLoot={}
            local function loot(stash)
                local cfg=env.Fian792SavedAutoDrop
                local point=cfg and cfg.world==productionWorld and cfg.points and cfg.points.seed
                local fetched,list=pcall(function() return world.dropList() end)
                local found={}
                if not fetched or type(list)~="table" then return found end
                for _,d in pairs(list) do
                    if type(d)=="table" and type(d.uid)=="number"
                        and type(d.x)=="number" and type(d.y)=="number"
                        and (tonumber(d.n) or 0)>0 and d.armed~=false
                        and not d.taking and not d.pending and not d.display
                        and (d.id==112 or countItem(d.id)<200) then
                        local allowed
                        if stash==true then
                            local sx=point and (point.dropX or point.x)
                            local sy=point and (point.dropY or point.y)
                            allowed=d.id==seedId and type(sx)=="number" and type(sy)=="number"
                                and math.abs(math.floor(d.x)-sx)<=1 and math.abs(math.floor(d.y)-sy)<=1
                        elseif stash=="world" then
                            allowed=d.id==request.material and not deferredLoot[d.uid]
                        else
                            allowed=cropDrop(d) and not reservedAutoDropPile(d)
                                and not deferredLoot[d.uid]
                        end
                        if allowed and not deferredLoot[d.uid] then found[#found+1]=d end
                    end
                end
                return found
            end
            -- World loot is collected in committed rows, bottom to top.
            -- X proximity alone can alternate between distant floors.
            local function collectWorldBlocks()
                phase="collect"
                touchUnhook()
                local lockedRow,direction=nil,1
                local activeUid,attemptSince=nil,0
                local deadline=os.clock()+90
                while pause() do
                    if countItem(request.material)>=200 then return true end
                    local list=loot("world")
                    if #list==0 then return true end
                    local landing={}
                    local lowest=nil
                    local rowCount=0
                    for _,d in ipairs(list) do
                        local dx=math.clamp(math.floor(d.x),0,world.w-1)
                        local dy=math.floor(d.y)
                        local stand
                        for y=dy,dy+1 do
                            for _,x in ipairs({dx,dx-1,dx+1}) do
                                if x>=0 and x<world.w and touchGround(x,y) then
                                    stand={x=x,y=y};break
                                end
                            end
                            if stand then break end
                        end
                        if stand then
                            landing[d.uid]=stand
                            lowest=math.max(lowest or stand.y,stand.y)
                            if stand.y==lockedRow then rowCount+=1 end
                        else
                            deferredLoot[d.uid]=true
                        end
                    end
                    if rowCount==0 then lockedRow=nil end
                    if not lowest then return true end
                    if not lockedRow then
                        lockedRow=lowest
                        local left,right=nil,nil
                        for _,d in ipairs(list) do
                            local at=landing[d.uid]
                            if at and at.y==lockedRow then
                                left=math.min(left or d.x,d.x)
                                right=math.max(right or d.x,d.x)
                            end
                        end
                        local _,px=touchPosition()
                        direction=math.abs((px or 0)-left)<=math.abs((px or 0)-right) and 1 or -1
                        request.status("COLLECT DIRT | baris Y"..lockedRow.." | "..(direction>0 and "KANAN" or "KIRI"))
                    end
                    local target
                    for _,d in ipairs(list) do
                        local at=landing[d.uid]
                        if at and at.y==lockedRow and not deferredLoot[d.uid]
                            and (not target or d.x*direction<target.x*direction
                                or (d.x==target.x and d.uid<target.uid)) then target=d end
                    end
                    if not target then lockedRow=nil;continue end
                    if os.clock()>deadline then
                        request.status("COLLECT DIRT | lanjut build; sisa drop dicek saat bahan habis")
                        return true
                    end
                    local at=landing[target.uid]
                    local before=countItem(request.material)
                    local _,px,py=touchPosition()
                    if px~=at.x or py~=at.y then
                        if not move(at.x,at.y) then
                            deferredLoot[target.uid]=true
                            continue
                        end
                    end
                    if activeUid~=target.uid then activeUid=target.uid;attemptSince=os.clock() end
                    if touchDropPresent(target) then touchOne(run,target) end
                    touchUnhook()
                    if not touchDropPresent(target) or countItem(request.material)>before then
                        activeUid=nil
                    elseif os.clock()-attemptSince>4 then
                        deferredLoot[target.uid]=true
                        activeUid=nil
                        request.status("COLLECT DIRT | UID "..target.uid.." belum terambil; lanjut dalam baris")
                    end
                    task.wait(0.12)
                end
                return false,"stopped"
            end
            local function collectLoot(stash)
                if stash=="world" then return collectWorldBlocks() end
                phase="collect"
                touchUnhook()
                local deadline=os.clock()+90
                local lastSignature,stalledAt=nil,os.clock()
                while pause() do
                    local list=loot(stash)
                    if #list==0 then return true end
                    -- Full stacks remain in the world; no pickup loop waits for room.
                    local signature=countItem(request.material)..":"..countItem(seedId)..":"..#list
                    for _,d in ipairs(list) do signature..=":"..d.uid.."/"..tostring(d.n) end
                    if signature~=lastSignature then lastSignature=signature;stalledAt=os.clock() end
                    if os.clock()>deadline then
                        request.status("COLLECT DF | batas perjalanan; sisa drop dicoba pada produksi berikutnya")
                        return true
                    end
                    if os.clock()-stalledAt>6 then
                        deferredLoot[list[1].uid]=true
                        request.status("COLLECT DF | drop UID "..list[1].uid.." belum terjangkau; lanjut drop lain")
                        stalledAt=os.clock()
                        continue
                    end
                    local swept=not stash and collectRowSweep(run)
                    local d=not stash and touchFind() or nil
                    if not swept and not d then
                        local _,px=touchPosition()
                        table.sort(list,function(a,b) return math.abs(a.x-(px or 0))<math.abs(b.x-(px or 0)) end)
                        d=list[1]
                        local x=math.clamp(math.floor(d.x),0,world.w-1)
                        local y=stash and math.floor(d.y) or row
                        if not touchGround(x,y) and touchGround(x,y+1) then y+=1 end
                        if not touchGround(x,y) or not move(x,y) then
                            deferredLoot[d.uid]=true
                            request.status("COLLECT DF | drop X"..x.." Y"..y.." belum ada jalur; lanjut")
                            continue
                        end
                    end
                    if d and touchDropPresent(d) then touchOne(run,d) end
                    touchUnhook()
                    if stash==true and countItem(seedId)>0 then return true end
                    task.wait(0.12)
                end
