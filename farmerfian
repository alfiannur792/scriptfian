local function onCollectArea(drop)
    local s = getState()
    if not s or type(drop.x) ~= "number" or type(drop.y) ~= "number" then return false end
    local px, py = math.floor(s.x), math.floor(s.y - 0.475)
    if math.abs(math.floor(drop.x) - px) > collectTiles
        or math.abs(math.floor(drop.y) - py) > collectTiles then return false end
    if #collectOrder == 0 then return true end
    local offset = collectOffsetKey(math.floor(drop.x) - px, math.floor(drop.y) - py)
    for _, point in ipairs(collectOrder) do
        if collectOffsetKey(point.dx, point.dy) == offset then return true end
    end
    return false
end

local function nearPlayer(drop)
    local s = getState()
    if not s or type(drop.x) ~= "number" or type(drop.y) ~= "number" then return false end
    local effectiveRadius = math.min(collectRadius, collectNativeCap)
    local dx = drop.x - s.x
    local dy = drop.y - (s.y - 0.475)
    if dx*dx + dy*dy <= effectiveRadius*effectiveRadius then return true end
    -- Dropped items are anchored to world tiles, but their reported positions
    -- may be at the left/top edge rather than the center. Comparing an edge
    -- point against a centered player falsely excludes the first far-side
    -- priority cell (e.g. offset -1,-1) while the opposite edge works.
    -- Test tile-center distance as a fallback; never bypass the 2-tile cap
    -- or the game's own native TakeDrop range/refusal response.
    local px,py=math.floor(s.x),math.floor(s.y-0.475)
    local tx,ty=math.floor(drop.x),math.floor(drop.y)
    local cx,cy=tx-px,ty-py
    return cx*cx+cy*cy <= effectiveRadius*effectiveRadius
end

