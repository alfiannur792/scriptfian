-- V46: Inventory source audit. A random `slots` table is not proof
-- of the actual game inventory. Multiple sources may exist in getgc.
local function slotItemCount(slots, id)
    if type(slots) ~= "table" then return nil end
    local total, found, schema = 0, false, nil
    for k, slot in pairs(slots) do
        if type(slot) == "table" then
            local sid = tonumber(slot.id or slot.itemId or slot.itemID)
            local n = tonumber(slot.n or slot.count or slot.amount or slot.qty)
            if sid == id and n then
                total += n
                found, schema = true, schema or "entry"
            end
        elseif (tonumber(k) == id) and type(slot) == "number" then
            total += slot
            found, schema = true, "keyed"
        end
    end
    return found and total or nil, schema
end

