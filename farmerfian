    group:Button({Title="Simpan Posisi Break",Desc="Titik kembali setelah drop",Callback=function() savePoint("breakPoint") end})

    local function availableDropOptions()
        local counts=inventoryCounts() or {}
        local options={}
        for id,n in pairs(counts) do
            if n>0 and category(id) then
                local item=rawget(db,id)
                local name=(type(item)=="table" and rawget(item,"name")) or ("Item "..id)
                options[#options+1]=tostring(name).." ["..id.."]"
            end
        end
        table.sort(options)
        return options
    end
    local function parseSelectedDrop(values)
        local chosen={}
        if type(values)=="string" then values={values} end
        if type(values)=="table" then
            for k,v in pairs(values) do
                local str
                if type(k)=="number" then str=v
                elseif v==true then str=k
                end
                local id=tonumber(tostring(str or ""):match("%[(%d+)%]$"))
                if id and category(id) then chosen[id]=true end
            end
        end
        selectedDropIds=chosen
        saveDropSettings()
        local count=0
        for _ in pairs(chosen) do count+=1 end
        statusUpdate("Item Auto Drop terpilih: "..count)
    end
    local initialOptions=availableDropOptions()
    local initialSelected={}
    for _,label in ipairs(initialOptions) do
        local id=tonumber(tostring(label):match("%[(%d+)%]$"))
        if id and selectedDropIds[id] then
            initialSelected[#initialSelected+1]=label
        end
    end
    local restoringDropUI=true
    local selectionDropdown=group:Dropdown({
        Title="Pilih Item Auto Drop",
        Desc="Multi-select | hanya item yang dipilih boleh dibuang",
        Values=initialOptions,
        Value=initialSelected,
        Multi=true,
        AllowNone=true,
        Callback=function(v)
            if not restoringDropUI then parseSelectedDrop(v) end
        end
    })
    restoringDropUI=false
    group:Button({Title="Refresh Daftar Item",Desc="Muat ulang item dari inventory",Callback=function()
        local opts=availableDropOptions()
        -- Different WindUI builds may use different dropdown refresh APIs.
        local ok=pcall(function() selectionDropdown:Refresh(opts) end)
        if not ok then ok=pcall(function() selectionDropdown:Refresh({Values=opts}) end) end
        if not ok then statusUpdate("Refresh tidak didukung WindUI ini; re-execute untuk daftar baru")
        else statusUpdate("Daftar item diperbarui") end
    end})
    group:Slider({
        Title="Jumlah Pemicu Auto Drop",
        Desc="Drop item terpilih saat mencapai batas ini (maksimal 200)",
        Value={Min=1,Max=200,Default=threshold},
        Step=1,
        Callback=function(v)
            threshold=math.clamp(math.floor(tonumber(v) or 199),1,200)
            saveDropSettings()
            statusUpdate("Batas Auto Drop: "..threshold.."/200 per item")
        end
    })
    control=group:Toggle({Title="Auto Drop",Desc="Pause Farm + PNB, drop item terpilih, kembali ke posisi Farm terakhir & resume",Value=enabled,
        Callback=function(on)
            toggleRevision+=1
            enabled=on
            saveDropSettings()
            if not on then
                dropRetryAt=0
                tripFailures=0
                pendingReturn=nil
                returningHome=false
                dropPause=false
                unhook()
                statusUpdate("OFF")
            else
                dropRetryAt=0
                tripFailures=0
                if next(selectedDropIds)==nil then
                    statusUpdate("ON (WAIT) | Pilih Seed/Block di dropdown")
                elseif not points.breakPoint and not
                    (env.Fian792FarmRuntime and env.Fian792FarmRuntime.running
                        and env.Fian792FarmRuntime.running()) then
                    statusUpdate("ON (WAIT) | Simpan Break atau mulai Farm")
                else
                    statusUpdate("ON | Drop Seed/Block terpilih saat >= "..threshold.."/200")
                end
            end
        end
    })
    status=group:Paragraph({Title="Status Auto Drop",
        Desc=enabled and "ON (restored) | Memantau seed/block terpilih"
            or "OFF | Atur Drop Seed/Block, pilih item; Farm menyimpan posisi pulang"})
    -- Build navigation only when a destination is used.
    task.spawn(function()
        local lastX,lastY=nil,nil
        while env.Fian792DropGeneration==generation do
            local x,y=pTile()
            if x and (x~=lastX or y~=lastY) then
                lastX,lastY=x,y
                pcall(function() currentPosition:SetDesc("X: "..x.." | Y: "..y) end)
            end
            task.wait(0.5)
        end
    end)
    task.spawn(function()
        while env.Fian792DropGeneration==generation do
            task.wait(dropPause and 0.12 or 0.35)
            if enabled and not busy and not guardPaused
                and not env.Fian792DirtProduction
                and not (env.Fian792WorldBuilder and env.Fian792WorldBuilder.running())
                and os.clock()>=dropRetryAt then
                local items,reason=findPending()
                -- A late native inventory update can complete a pending drop;
                -- still return to the original Farm point before resuming.
                if dropPause and not returningHome
                    and type(items)=="table" and #items==0
                    and anySelectedFull()==false then
                    if pendingReturn then
                        returningHome=true
                        print("[V68 AUTO DROP] Inventory reconciled | returning to saved Farm")
                    else
                        -- No Farm trip was active when the drop started.
                        -- A late inventory update must not leave the
                        -- next Auto Farm session permanently paused.
                        dropPause=false
                        tripFailures=0
                        dropRetryAt=os.clock()+1
                        statusUpdate("Inventory below threshold | stale pause cleared")
                    end
                end
                if returningHome then items={} end
                if not items then
                    -- Temporary inventory discovery failure must never
                    -- switch the user's Auto Drop toggle OFF.
                    if os.clock()-lastReadWarn>=8 then
                        lastReadWarn=os.clock()
                        statusUpdate(reason.." | retry")
                    end
                    dropRetryAt=os.clock()+3
                elseif #items>0 or returningHome then
                    busy=true
                    dropPause=true
                    local ownRevision=toggleRevision
                    local farm=env.Fian792FarmRuntime
                    local farmRunning=farm and type(farm.running)=="function" and farm.running()
                    local home=pendingReturn
                    if returningHome then
                        statusUpdate("RETURNING HOME | Farm remains PAUSED")
                    else
                        statusUpdate("PAUSE FARM/PNB | "..#items..
                            " selected item(s) >= "..threshold.."/200")
                    end
                    -- Wait for the farm's short movement hook to release. Farm
                    -- checks dropPause every step and will yield ownership.
                    local untilAt=os.clock()+3.5
                    while env.Fian792MovementOwner
                        and env.Fian792MovementOwner~=input
                        and os.clock()<untilAt and not guardPaused do
                        task.wait(0.07)
                    end
                    local free=not env.Fian792MovementOwner
                        or env.Fian792MovementOwner==input
                    -- Record the return point only AFTER the farm has released
                    -- movement and landed, avoiding an unreachable mid-air goal.
                    if free and farmRunning and not home and not guardPaused then
                        local landUntil=os.clock()+2.5
                        repeat
                            local hx,hy,body=pTile()
                            if hx and body and body.grounded then
                                home={x=hx,y=hy,world=refs.worldKey()}
                                pendingReturn=home
                                break
                            end
                            task.wait(0.07)
                        until os.clock()>=landUntil
                    end
                    local ok,done,why
                    if free and not guardPaused and enabled
                        and ownRevision==toggleRevision
                        and (not farmRunning or home or points.breakPoint) then
                        ok,done,why=pcall(runTrip,items,home)
                    else
                        ok,done,why=true,false,"Movement busy / not grounded / Guard active"
                    end
                    unhook()
                    busy=false
                    if not enabled or ownRevision~=toggleRevision then
                        -- The user switched OFF or changed toggle state
                        -- during route movement / inventory wait. The
                        -- completed coroutine must never re-enable pause.
                        dropPause=false
                        pendingReturn=nil
                        returningHome=false
                        dropRetryAt=0
                        print("[V68 AUTO DROP] CANCELED by toggle change | pause released")
                    else
                        if ok and done and anySelectedFull()~=false then
                            done=false
                            why="Selected inventory not confirmed below threshold"
                            returningHome=false
                        end
                        if ok and done then
                            tripFailures=0
                            dropRetryAt=os.clock()+1.5
                            pendingReturn=nil
                            returningHome=false
                            statusUpdate("Drop + return confirmed | RESUME FARM")
                            dropPause=false
                        else
                            -- Keep Farm stopped while a genuinely full
                            -- selected stack still needs a trip.
                            tripFailures+=1
                            dropRetryAt=os.clock()+math.min(45,5*tripFailures)
                            dropPause=true
                            statusUpdate((returningHome
                                and "RETURN HOME RETRY " or "AUTO DROP RETRY ")..
                                tripFailures.." | "..
                                tostring(guardPaused and "Dijeda Penjaga" or
                                    (ok and why or done))..
                                (returningHome and " | Drop sudah sukses, tanpa drop ulang"
                                    or " | Auto Drop tetap ON")..
                                " | coba lagi "..math.ceil(
                                    dropRetryAt-os.clock()).."s")
                        end
                    end
                end
            end
        end
        unhook()
    end)
    print("[V68] Auto Drop v1.0.30 | FULL WORLD MAP + cached shortest routes + PAUSE LOCK")
    end -- initializeAutoDropV68
    initializeAutoDropV68()
end


--==================================================
-- Visual Name Spoof (LOCAL ONLY, never sends network changes)
-- Separate function scope to limit Luau local registers.
--==================================================
do
    local function initializeNameSpoof()
        local service=game:GetService("TextService")
        local gui=playerGui
        local old=env.Fian792NameSpoof
        if type(old)=="table" and type(old.stop)=="function" then
            pcall(old.stop)
        end
        local prefs=env.Fian792NameSpoofSaved or {}
        local value=tostring(prefs.name or player.DisplayName or player.Name)
        value=value:sub(1,32)
        local active=prefs.enabled==true
        local session={}
        local holders={}
        local status
        -- Game native nametag renders glyph images (BitmapText).
        -- Arcade approximates the original pixel lettering in a TextLabel.
        local font=Enum.Font.Arcade
        local function glyphSignature(holder)
            local bitmap=holder and holder:FindFirstChild("BitmapText")
            if not bitmap then return nil end
            local glyphs={}
            for _,obj in ipairs(bitmap:GetChildren()) do
                if obj:IsA("ImageLabel") then
                    glyphs[#glyphs+1]=obj
                end
            end
            if #glyphs==0 then return nil end
            table.sort(glyphs,function(a,b)
                return a.Position.X.Offset<b.Position.X.Offset
            end)
            local id={}
            for _,g in ipairs(glyphs) do
                id[#id+1]=g.Image..":"..tostring(g.ImageRectOffset)
            end
            return table.concat(id,"|")
        end
        -- Cache expensive nametag scans; reduce GUI traversal load.
        local lastTagSearch=0
        local cachedTag=nil
        local function ownNameHolders()
            local chat=gui:FindFirstChild("ChatGui")
            -- 2026-11 build: the nametag is drawn by the renderer state's
            -- tagName object (ArmDiag: tagName.frame Instance, glyph atlas).
            local st=env.Fian792Animation and env.Fian792Animation.state
            local tn=type(st)=="table" and rawget(st,"tagName")
            local fr=type(tn)=="table" and rawget(tn,"frame")
            if typeof(fr)=="Instance" and fr:IsA("GuiObject") and fr.Parent then
                local hud0=chat and chat:FindFirstChild("HUD")
                local panel0=hud0 and hud0:FindFirstChild("PlayerPanel")
                return fr,panel0 and panel0:FindFirstChild("Name")
            end
            local hud=chat and chat:FindFirstChild("HUD")
            local panel=hud and hud:FindFirstChild("PlayerPanel")
            local panelName=panel and panel:FindFirstChild("Name")
            local gameGui=gui:FindFirstChild("GameGui")
            local gameWorld=gameGui and gameGui:FindFirstChild("World")
            local camera=gameWorld and gameWorld:FindFirstChild("Camera")
            local tag=camera and camera:FindFirstChild("NameTag")
            if tag and tag:FindFirstChild("BitmapText") then
                cachedTag=tag
                return tag,panelName
            end
            if cachedTag and cachedTag.Parent
                and cachedTag:FindFirstChild("BitmapText") then
                return cachedTag,panelName
            end
            if os.clock()-lastTagSearch<3 then return nil,panelName end
            lastTagSearch=os.clock()
            -- Some builds reparent the nametag beneath another Frame.
            -- Match its native glyph signature to OUR PlayerPanel Name.
            local signature=glyphSignature(panelName)
            if gameGui and signature then
                local found,seen=nil,0
                local visited=0
                for _,node in ipairs(gameGui:GetDescendants()) do
                    visited+=1
                    if visited>4500 then break end
                    if node:IsA("Frame") and node:FindFirstChild("BitmapText")
                        and node.AnchorPoint.X==0.5 and node.AnchorPoint.Y==1
                        and glyphSignature(node)==signature then
                        found=node
                        seen+=1
                        if seen>1 then break end
                    end
                end
                if seen==1 then tag=found end
            end
            cachedTag=tag
            return tag,panelName
        end
        local function restore(entry)
            if not entry then return end
            pcall(function() entry.label:Destroy() end)
            if entry.hiddenImgs then
                for d,t in pairs(entry.hiddenImgs) do
                    pcall(function() if d.Parent then d.ImageTransparency=t end end)
                end
                entry.hiddenImgs=nil
            end
            if entry.bitmap and entry.bitmap.Parent then
                pcall(function() entry.bitmap.Visible=entry.wasVisible end)
            end
            if entry.tag and entry.holder and entry.holder.Parent
                and entry.originalSize then
                pcall(function()
                    entry.holder.Size=entry.originalSize
                    local wr=entry.holder:FindFirstChild("Wrench")
                    if wr and entry.wrenchPosition then
                        wr.Position=entry.wrenchPosition
                    end
                end)
            end
        end
        local function stop()
            active=false
            for kind,entry in pairs(holders) do
                restore(entry)
                holders[kind]=nil
            end
        end
        session.stop=stop
        env.Fian792NameSpoof=session
        local function paint(kind,holder,isTag)
            local oldEntry=holders[kind]
            if oldEntry and (oldEntry.holder~=holder
                or not oldEntry.label.Parent) then
                restore(oldEntry)
                holders[kind]=nil
                oldEntry=nil
            end
            if not holder or not holder:IsA("GuiObject") then return end
            local bitmap=holder:FindFirstChild("BitmapText")
            -- 2026-11 build: glyph images sit straight in the frame. Use a
            -- stand-in so the rest of paint() works; glyphs hidden below.
            local glyphMode=false
            if not bitmap then
                glyphMode=true
                bitmap={Visible=false,Parent=holder}
            end
            local entry=oldEntry
            if not entry then
                local label=Instance.new("TextLabel")
                label.Name="Fian792VisualName"
                label.BackgroundTransparency=1
                label.Font=font
                label.TextColor3=Color3.new(1,1,1)
                label.TextStrokeTransparency=0.25
                label.TextStrokeColor3=Color3.fromRGB(16,18,25)
                label.ZIndex=1017
                label.Parent=holder
                entry={holder=holder,bitmap=bitmap,
                    wasVisible=bitmap.Visible,label=label,
                    tag=isTag,originalSize=holder.Size}
                local wr=holder:FindFirstChild("Wrench")
                entry.wrenchPosition=wr and wr.Position
                holders[kind]=entry
            end
            if entry.bitmap~=bitmap then
                if entry.bitmap and entry.bitmap.Parent then
                    pcall(function() entry.bitmap.Visible=entry.wasVisible end)
                end
                entry.bitmap=bitmap
                entry.wasVisible=bitmap.Visible
            end
            local changed=entry.label.Text~=value or entry.layoutReady~=true
            if changed then
                entry.label.Text=value
                if isTag then
                    local size=22
                    entry.label.TextSize=size
                    entry.label.TextScaled=false
                    entry.label.AnchorPoint=Vector2.new(0.5,0.5)
                    entry.label.Position=UDim2.fromScale(0.5,0.5)
                    local ok,w=pcall(function()
                        return service:GetTextSize(value,size,font,Vector2.new(2000,200)).X
                    end)
                    entry.width=math.clamp((ok and w or #value*size*0.6)+10,24,460)
                else
                    entry.label.TextSize=21
                    entry.label.TextScaled=true
                    entry.label.AnchorPoint=Vector2.new(0,0)
                    entry.label.Position=UDim2.fromOffset(2,0)
                    entry.label.Size=UDim2.new(1,-4,1,0)
                    entry.label.TextXAlignment=Enum.TextXAlignment.Left
                end
                entry.layoutReady=true
            end
            if isTag then
                local width=entry.width or 32
                local height=math.max(28,holder.Size.Y.Offset)
                if entry.label.Size.X.Offset~=width
                    or entry.label.Size.Y.Offset~=height then
                    entry.label.Size=UDim2.fromOffset(width,height)
                end
                if holder.Size.X.Offset~=width then
                    holder.Size=UDim2.fromOffset(width,holder.Size.Y.Offset)
                end
                local wrench=holder:FindFirstChild("Wrench")
                if wrench and wrench.Position.X.Offset~=width+4 then
                    wrench.Position=UDim2.fromOffset(width+4,wrench.Position.Y.Offset)
                end
            end
            if bitmap.Visible then bitmap.Visible=false end
            if glyphMode then
                entry.hiddenImgs=entry.hiddenImgs or {}
                local wrench=holder:FindFirstChild("Wrench")
                for _,d in ipairs(holder:GetDescendants()) do
                    if (d:IsA("ImageLabel") or d:IsA("ImageButton"))
                        and not (wrench and (d==wrench or d:IsDescendantOf(wrench))) then
                        if entry.hiddenImgs[d]==nil then entry.hiddenImgs[d]=d.ImageTransparency end
                        if d.ImageTransparency~=1 then d.ImageTransparency=1 end
                    end
                end
            end
        end
        -- 2026-11 build (NameDiag): the nametag is a glyph-atlas object
        -- state.tagName {text, redraw, frame, color, outlineColor, atlas}.
        -- Spoof NATIVELY: set .text and let the game redraw it with its own
        -- font, colour and outline; mirror the glyphs into PlayerPanel.Name.
        local native={}
        -- NameDiag2: tagName is a Shared.BitmapText object; its class method
        -- set(self,text) lays the glyphs out (redraw does not). Spoof by an
        -- instance-level set() wrapper so every native re-set keeps our text.
        local function tagObj()
            local st=env.Fian792Animation and env.Fian792Animation.state
            local tn=type(st)=="table" and rawget(st,"tagName")
            if type(tn)~="table" or typeof(rawget(tn,"frame"))~="Instance" then return nil end
            local mt=getmetatable(tn)
            local idx=type(mt)=="table" and (type(mt.__index)=="table" and mt.__index or mt)
            local set=idx and rawget(idx,"set")
            if type(set)~="function" then return nil end
            return tn,set
        end
        local function panelBitmap()
            local chat=gui:FindFirstChild("ChatGui")
            local hud=chat and chat:FindFirstChild("HUD")
            local panel=hud and hud:FindFirstChild("PlayerPanel")
            local nm=panel and panel:FindFirstChild("Name")
            return nm and nm:FindFirstChild("BitmapText")
        end
        local function mirrorPanel(src,dst)
            if src==dst then return end
            for _,c in ipairs(dst:GetChildren()) do
                if c:IsA("ImageLabel") then c:Destroy() end
            end
            for _,c in ipairs(src:GetChildren()) do
                if c:IsA("ImageLabel") then c:Clone().Parent=dst end
            end
            dst.Size=src.Size
        end
        local function nativeApply()
            local tn,classSet=tagObj()
            if not tn then return false end
            if native.tn~=tn then
                native.tn=tn
                native.classSet=classSet
                native.origText=rawget(tn,"text")
                if rawget(tn,"redraw") and debug and debug.info then
                    -- undo the v1.0.118 redraw wrapper if still installed
                    local ok,src=pcall(debug.info,tn.redraw,"s")
                    if ok and tostring(src):find("Fian792",1,true) and native.origRedraw then
                        tn.redraw=native.origRedraw
                    end
                end
                rawset(tn,"set",function(self,text,...)
                    if env.Fian792NameSpoof==session and active then text=value end
                    return classSet(self,text,...)
                end)
                native.drawn=nil
            end
            if native.drawn~=value or rawget(tn,"text")~=value then
                local ok,err=pcall(classSet,tn,value)
                if not ok then
                    warn("[CHLISE VISUAL SPOOF] set failed:",err)
                    return false
                end
                native.drawn=value
                local bt=panelBitmap()
                if bt and bt~=tn.frame then
                    if not native.panelSaved then
                        native.panelSaved={size=bt.Size,kids={}}
                        for _,c in ipairs(bt:GetChildren()) do
                            if c:IsA("ImageLabel") then
                                native.panelSaved.kids[#native.panelSaved.kids+1]=c:Clone()
                            end
                        end
                        native.panelBt=bt
                    end
                    pcall(mirrorPanel,tn.frame,bt)
                end
                if native.logged~=value then
                    native.logged=value
                    print("[CHLISE VISUAL SPOOF] native set |",value)
                end
            end
            -- the game can re-set the panel name on its own: re-mirror
            local bt=native.panelBt
            if bt and bt.Parent and tn.frame then
                local a1=bt:FindFirstChildOfClass("ImageLabel")
                local b1=tn.frame:FindFirstChildOfClass("ImageLabel")
                if a1 and b1 and (a1.ImageRectOffset~=b1.ImageRectOffset
                    or #bt:GetChildren()~=#tn.frame:GetChildren()) then
                    pcall(mirrorPanel,tn.frame,bt)
                end
            end
            return true
        end
        local function nativeRestore()
            local tn=native.tn
            if tn then
                pcall(function() rawset(tn,"set",nil) end)
                if native.classSet and native.origText then
                    pcall(native.classSet,tn,native.origText)
                end
            end
            local bt,sv=native.panelBt,native.panelSaved
            if bt and sv and bt.Parent then
                pcall(function()
                    for _,c in ipairs(bt:GetChildren()) do
                        if c:IsA("ImageLabel") then c:Destroy() end
                    end
                    for _,c in ipairs(sv.kids) do c:Clone().Parent=bt end
                    bt.Size=sv.size
                end)
            end
            native={}
        end
        local oldStop=session.stop
        session.stop=function() nativeRestore() oldStop() end
        local tab=Window:Tab({Title="Visual Spoof",Icon="user-round"})
        local box=tab:Section({Title="Local Name Spoof",Box=true,Opened=true})
        status=box:Paragraph({Title="Visual Spoof",Desc="Only visible on your client"})
        local function persist()
            env.Fian792NameSpoofSaved={enabled=active,name=value}
        end
        local function refreshStatus()
            pcall(function()
                status:SetDesc((active and "ON" or "OFF")..
                    " | "..value.." | Local display only")
            end)
        end
        box:Input({
            Title="Spoof Name",
            Desc="Name above character and in local player panel",
            Value=value,
            Placeholder="Type display name",
            Callback=function(name)
                local v=tostring(name or ""):gsub("^%s+",""):gsub("%s+$","")
                if v~="" then
                    value=v:sub(1,32)
                    persist()
                    refreshStatus()
                end
            end
        })
        box:Toggle({Title="Enable Visual Name Spoof",Value=active,
            Callback=function(on)
                active=on==true
                persist()
                if not active then
                    nativeRestore()
                    for kind,e in pairs(holders) do
                        restore(e)
                        holders[kind]=nil
                    end
                end
                refreshStatus()
            end
        })
        refreshStatus()
        task.spawn(function()
            while env.Fian792NameSpoof==session do
                if active then
                    if not nativeApply() then
                        local tag,panel=ownNameHolders()
                        paint("tag",tag,true)
                        paint("panel",panel,false)
                    end
                end
                task.wait(0.45)
            end
        end)
        print("[CHLISE VISUAL SPOOF] Ready | local name display only")
    end
    local ok,why=pcall(initializeNameSpoof)
    if not ok then warn("[CHLISE VISUAL SPOOF]",why) end
end

--==================================================
-- 9. GROW SCAN | READ-ONLY WORLD ITEM / TREE / DROP REPORT
-- Manual scan is coroutine-budgeted to avoid Farm FPS spikes.
--==================================================
do
    local tab=Window:Tab({Title="Grow Scan",Icon="scan-search"})
    local group=tab:Section({Title="World Scanner",Box=true,Opened=true})
    group:Paragraph({Title="Read-only scanner",
        Desc="World Trees (planted crops) and World Drops only. Reads existing world crops too; inventory is excluded."})
    local info=group:Paragraph({Title="Status",Desc="Ready | press Scan World"})
    local summary=group:Paragraph({Title="Summary",Desc="No scan yet"})
    local treeResult=group:Paragraph({Title="World Trees",Desc="No tree scan yet"})
    local result=group:Paragraph({Title="World Drops",Desc="No world drops scanned yet"})
    local filter=""
    local latest=nil
    local runningScan=false
    local scanThread
    env.Fian792ScanRuntime={stop=function()
        if scanThread and coroutine.status(scanThread)~="dead" then task.cancel(scanThread) end
        runningScan=false
    end}
    local lastFinished=0
    group:Input({Title="Item name or ID filter",Placeholder="Example: pepper / 1352",
        Value="",Callback=function(v)
            filter=tostring(v or "")
        end})
    local function treeName(id)
        local raw=type(db[id])=="table" and tostring(db[id].name or "")
            or ("Item "..tostring(id))
        -- The world FG uses the seed ID for an already-planted tree.
        -- Rename for DISPLAY only; never change the actual item ID.
        local trimmed=raw:gsub("%s+[Ss][Ee][Ee][Dd]$","")
        return trimmed.." Tree"
    end
    local function showResults()
        if not latest then return end
        local needle=filter:lower()
        local drops,trees={},{}
        for id,r in pairs(latest.items) do
            local name=type(db[id])=="table" and tostring(db[id].name or "")
                or ("Item "..tostring(id))
            local plantedName=treeName(id)
            local matches=needle=="" or name:lower():find(needle,1,true)
                or plantedName:lower():find(needle,1,true)
                or tostring(id):find(needle,1,true)
            if matches then
                if (r.drops or 0)>0 then
                    drops[#drops+1]={id=id,name=name,qty=r.drops}
                end
                if (r.seeds or 0)>0 then
                    trees[#trees+1]={id=id,name=plantedName,total=r.seeds,
                        ready=r.ready or 0,growing=r.growing or 0,
                        unknown=r.unknown or 0}
                end
            end
        end
        table.sort(drops,function(a,b)
            if a.qty==b.qty then return a.id<b.id end
            return a.qty>b.qty
        end)
        table.sort(trees,function(a,b)
            if a.total==b.total then return a.id<b.id end
            return a.total>b.total
        end)
        local dropLines={}
        for i=1,math.min(#drops,20) do
            local r=drops[i]
            dropLines[#dropLines+1]=("%s | %d"):format(r.name,r.qty)
        end
        local treeLines={}
        for i=1,math.min(#trees,20) do
            local r=trees[i]
            treeLines[#treeLines+1]=("%s | Total %d | Ready %d | Growing %d | Unknown %d")
                :format(r.name,r.total,r.ready,r.growing,r.unknown)
        end
        local dropDesc=#dropLines>0 and table.concat(dropLines,"\n")
            or "No world drops found"
        local treeDesc=#treeLines>0 and table.concat(treeLines,"\n")
            or "No planted trees found"
        if #drops>20 then dropDesc=dropDesc.."\n... more in console (Print All)" end
        if #trees>20 then treeDesc=treeDesc.."\n... more in console (Print All)" end
        pcall(function() result:SetDesc(dropDesc) end)
        pcall(function() treeResult:SetDesc(treeDesc) end)
        print("[GROW SCAN FILTER]",filter~="" and filter or "ALL",
            "| tree types",#trees,"| drop types",#drops)
    end
    local function scan()
        if runningScan then
            print("[GROW SCAN] Already scanning")
            return
        end
        if os.clock()-lastFinished<1 then return end
        runningScan=true
        scanThread=task.spawn(function()
            local started=os.clock()
            local ok,err=pcall(function()
                pcall(function() info:SetDesc("Scanning...") end)
                local w=refs.world
                if type(w)~="table" or type(w.w)~="number"
                    or type(w.h)~="number" then error("World not ready") end
                local stats={items={},fg=0,bg=0,drops=0,
                    trees=0,ready=0,growing=0,unknown=0}
                local function item(id)
                    id=tonumber(id)
                    if not id or id<=0 then return nil end
                    local r=stats.items[id]
                    if not r then
                        r={fg=0,bg=0,drops=0,seeds=0,
                            ready=0,growing=0,unknown=0}
                        stats.items[id]=r
                    end
                    return r
                end
                -- Prefer the same native timestamp map used by Auto Farm.
                -- No getgc scanning: it would stall the game.
                local trees
                local look=rawget(w,"treeLook")
                local getups=debug and debug.getupvalues
                if type(look)=="function" and type(getups)=="function" then
                    local okU,ups=pcall(getups,look)
                    if okU and type(ups)=="table" then
                        for _,up in pairs(ups) do
                            if type(up)=="table" then
                                local candidate=rawget(up,"trees")
                                if type(candidate)=="table" then
                                    trees=candidate;break
                                end
                            end
                        end
                    end
                end
                local serverNow=workspace:GetServerTimeNow()
                for y=0,w.h-1 do
                    local fg=type(w.fg)=="table" and w.fg[y]
                    local bg=type(w.bg)=="table" and w.bg[y]
                    for x=0,w.w-1 do
                        local id=type(fg)=="table" and tonumber(fg[x])
                        local entry=item(id)
                        if entry then
                            entry.fg+=1;stats.fg+=1
                            local meta=db[id]
                            if type(meta)=="table" and meta.kind=="seed" then
                                entry.seeds+=1;stats.trees+=1
                                local timestamp
                                if trees then
                                    local t=trees[y*w.w+x]
                                    if type(t)=="number" then timestamp=t
                                    elseif type(t)=="table" then
                                        timestamp=tonumber(t.p)
                                    end
                                end
                                local grow=type(meta)=="table" and tonumber(meta.grow)
                                if type(timestamp)=="number" and grow and grow>=0 then
                                    if timestamp+grow<=serverNow then
                                        entry.ready+=1;stats.ready+=1
                                    else
                                        entry.growing+=1;stats.growing+=1
                                    end
                                else
                                    entry.unknown+=1;stats.unknown+=1
                                end
                            end
                        end
                        local bId=type(bg)=="table" and tonumber(bg[x])
                        local bEntry=item(bId)
                        if bEntry then bEntry.bg+=1;stats.bg+=1 end
                    end
                    if y%4==3 then
                        if env.Fian792BootGuard
                            and env.Fian792BootGuard.version~=env.Fian792DisplayVersion then
                            error("Scanner session replaced")
                        end
                        task.wait()
                    end
                end
                local list=rawget(w,"dropList")
                if type(list)=="function" then
                    local okD,drops=pcall(list)
                    if okD and type(drops)=="table" then
                        local processed=0
                        for _,drop in pairs(drops) do
                            if type(drop)=="table" and (tonumber(drop.n) or 0)>0 then
                                local r=item(drop.id)
                                if r then
                                    r.drops+=(tonumber(drop.n) or 0)
                                    stats.drops+=(tonumber(drop.n) or 0)
                                end
                            end
                            processed+=1
                            if processed%350==0 then task.wait() end
                        end
                    end
                end
                latest=stats
                lastFinished=os.clock()
                local total=0
                for _ in pairs(stats.items) do total+=1 end
                local textLine=("World %s | %dx%d | Trees %d (ready %d, growing %d, unknown %d) | World Drops %d"):format(
                    tostring(rawget(w,"name") or "?"),w.w,w.h,
                    stats.trees,stats.ready,stats.growing,stats.unknown,stats.drops)
                pcall(function() summary:SetDesc(textLine) end)
                pcall(function() info:SetDesc(
                    ("Complete in %.2fs | %d item IDs"):format(os.clock()-started,total))
                end)
                print("[GROW SCAN SUMMARY]",textLine)
                showResults()
                print("[GROW SCAN] Ready. World Trees and World Drops are separate.")
            end)
            runningScan=false
            if not ok then
                warn("[GROW SCAN ERROR]",err)
                pcall(function() info:SetDesc("Scan failed: "..tostring(err)) end)
            end
        end)
    end
    group:Button({Title="Scan World",Callback=scan})
    group:Button({Title="Apply Filter",Callback=showResults})
    group:Button({Title="Print All to Console",Callback=function()
        if not latest then
            print("[GROW SCAN] Run Scan World first");return
        end
        local ids={}
        for id,r in pairs(latest.items) do
            if (r.drops or 0)>0 or (r.seeds or 0)>0 then
                ids[#ids+1]=id
            end
        end
        table.sort(ids)
        for _,id in ipairs(ids) do
            local r=latest.items[id]
            if (r.seeds or 0)>0 then
                print("[GROW SCAN TREE]",id,treeName(id),
                    "TOTAL",r.seeds,"READY",r.ready,
                    "GROWING",r.growing,"UNKNOWN",r.unknown)
            end
            if (r.drops or 0)>0 then
                local name=type(db[id])=="table" and tostring(db[id].name or "")
                    or ("Item "..id)
                print("[GROW SCAN DROP]",id,name,"QTY",r.drops)
            end
        end
        print("[GROW SCAN]",#ids,"tree/drop item IDs printed")
    end})
end

