local function make(class, props, parent)
    local object = Instance.new(class)

    for k, v in pairs(props) do
        object[k] = v
    end

    object.Parent = parent
    return object
end

-- Shared responsive sizing for every 5x5 modal. Scale the entire
-- existing grid (including footer controls) so hitboxes and spacing remain
-- aligned on portrait/landscape phones without changing tile order.
local function responsiveGridPopup(gui,window,baseW,baseH)
    local scale=Instance.new("UIScale")
    scale.Name="ChliseResponsiveGridScale"
    scale.Scale=1
    scale.Parent=window
    local input=game:GetService("UserInputService")
    if input.TouchEnabled then window.Draggable=false end
    local lastW,lastH=nil,nil
    local function resize()
        local camera=workspace.CurrentCamera
        if not camera then return end
        local viewport=camera.ViewportSize
        local vw,vh=viewport.X,viewport.Y
        if vw<=0 or vh<=0 or (vw==lastW and vh==lastH) then return end
        lastW,lastH=vw,vh
        -- 16px outer margin on both sides; allowance for mobile top/bottom.
        local marginX=math.min(18,math.max(8,vw*0.035))
        local marginY=math.min(32,math.max(12,vh*0.055))
        scale.Scale=math.min(1,(vw-2*marginX)/baseW,
            (vh-2*marginY)/baseH)
        -- Re-center a previously dragged window after rotation.
        window.Position=UDim2.fromScale(0.5,0.5)
    end
    resize()
    local cameraConnection=nil
    local camera=workspace.CurrentCamera
    if camera then
        cameraConnection=camera:GetPropertyChangedSignal("ViewportSize"):Connect(resize)
    end
    local cameraChanged=workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        if cameraConnection then cameraConnection:Disconnect() end
        local current=workspace.CurrentCamera
        if current then
            cameraConnection=current:GetPropertyChangedSignal("ViewportSize"):Connect(resize)
        end
        lastW,lastH=nil,nil
        resize()
    end)
    local enabledChanged=gui:GetPropertyChangedSignal("Enabled"):Connect(function()
        if gui.Enabled then lastW,lastH=nil,nil;resize() end
    end)
    gui.Destroying:Connect(function()
        if cameraConnection then cameraConnection:Disconnect() end
        cameraChanged:Disconnect()
        enabledChanged:Disconnect()
    end)
end

