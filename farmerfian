        input.active=true
        return true
    end

    local function fgItem(x,y)
        if x<0 or x>=world.w or y<0 or y>=world.h then return nil end
        local row=world.fg[y]
        local id=type(row)=="table" and row[x] or 0
        return rawget(db,id or 0)
    end
    local function solidAt(x,y)
        if x<0 or x>=world.w or y>=world.h then return true end
        if y<0 then return false end
        local it=fgItem(x,y)
        if not it then return false end
        if it.combiner then
            local fn=rawget(world,"combinerShut")
            if type(fn)~="function" then return true end
            local ok,shut=pcall(fn,x,y)
            return not ok or shut==true
        end
        if it.vip then
            local fn=rawget(world,"vipMay")
            if type(fn)~="function" then return true end
            local ok,allowed=pcall(fn,x,y)
            return not (ok and allowed)
        end
        if it.entrance or it.gate then
            local switches=rawget(world,"switches")
            local sw=type(switches)=="table" and switches[y*world.w+x]
            if it.gate then return not (sw and sw.off==true) end
            if sw and sw.public then return false end
            local ok,allowed=pcall(function()
                return world.areas.mayBuild(world.lock,x,y)
            end)
            return not (ok and allowed)
        end
        -- Platforms support the feet but are not full-height walls.
        -- Native movement can traverse seeds and one-way platforms.
        if rawget(it,"kind")=="seed" or it.platform==true then return false end
        return it.solid==true
    end
    local function hazardAt(x,y)
        local it=fgItem(x,y)
        return it~=nil and (it.deadly==true or it.hurts==true or it.laser==true)
    end
    local function openAt(x,y)
        return not solidAt(x,y) and not hazardAt(x,y)
    end
    local function supportAt(x,y)
        local it=fgItem(x,y+1)
        return not hazardAt(x,y+1) and (solidAt(x,y+1) or (it and it.platform==true))
    end
    local function standable(x,y)
        -- Match Auto Farm.touchGround: the game allows narrow tree rows
        -- where head-tile data is occupied but the avatar can still walk.
        -- Jump/gap/fall transitions still check their own clearance.
        return openAt(x,y) and supportAt(x,y)
    end
    -- v1.0.30 WORLD MAP: precompute every physically standable cell and
    -- directed walking/jumping/falling transitions. All saved Drop points
    -- share this map; reverse-Dijkstra builds a shortest-route field from
    -- EVERY connected world position to the chosen destination.
    -- v1.0.30: navigation has a separate proto to free local registers
    -- in initializeAutoDropV68. The old navigation implementation is intact.
    local navApi=(function()
    local worldNav=nil
    local navBuilding=false
    local navLastCheck=0

    local function buildWorldNav(force)
        while navBuilding do
            if env.Fian792DropGeneration~=generation then return nil,"stopped" end
            task.wait(0.04)
        end
        local now=os.clock()
        -- Cached map only rescans every 4s; forced rebuild is unchanged.
        if not force and worldNav and now-navLastCheck<4 then return worldNav end
        navBuilding=true
        local ok,result=pcall(function()
            local W,H=world.w,world.h
            local openMask,supportMask={},{}
            local changed=not worldNav or worldNav.world~=world
                or worldNav.w~=W or worldNav.h~=H
            for y=0,H-1 do
                for x=0,W-1 do
                    local idx=y*W+x
                    local op=openAt(x,y)
                    local sup=(y+1<H) and supportAt(x,y) or false
                    openMask[idx]=op
                    supportMask[idx]=sup
                    if not changed and (worldNav.openMask[idx]~=op
                        or worldNav.supportMask[idx]~=sup) then
                        changed=true
                    end
                end
                if y%12==11 then task.wait() end
            end
            navLastCheck=os.clock()
            if not changed then return worldNav end

            local nodes,reverse,edges={}, {}, 0
            local count=0
            local function open(x,y)
                return x>=0 and x<W and y>=0 and y<H
                    and openMask[y*W+x]==true
            end
            local function stand(x,y)
                return x>=0 and x<W and y>=0 and y<H-1
                    and openMask[y*W+x]==true
                    and supportMask[y*W+x]==true
            end
            for y=0,H-2 do
                for x=0,W-1 do
                    if stand(x,y) then
                        nodes[y*W+x]=true
                        count+=1
                    end
                end
            end
            local function edge(x,y,nx,ny,kind,cost)
                if not stand(nx,ny) then return end
                local from=y*W+x
                local to=ny*W+nx
                local arr=reverse[to]
                if not arr then arr={};reverse[to]=arr end
                arr[#arr+1]={
                    from=from,to=to,fx=x,fy=y,x=nx,y=ny,
                    kind=kind,cost=cost,
                    key=tostring(from)..">"..tostring(to)..":"..kind
                }
                edges+=1
            end

            -- TEST38 physical arc predicate for Auto Drop world navigation.
            local function longArc(x,y,bx,by)
                if bx<0 or bx>=W or by<0 or by>=H-1 then return false end
                if not stand(bx,by) or not open(bx,by-1) then return false end
                if not open(x,y-1) or not open(x,y-2) then return false end
                local dx,dy=bx-x,by-y
                local dist=math.abs(dx)
                if dist<2 or dist>5 or dy < -2 or dy>3 then return false end
                if dist==5 and dy<0 then return false end
                for step=1,15 do
                    local t=step/16
                    local tx=math.floor(x+0.5+dx*t)
                    local foot=math.floor(y+1+dy*t-3.35*4*t*(1-t)-0.475)
                    if not open(tx,foot) or not open(tx,foot-1) then return false end
                end
                return true
            end
            for y=0,H-2 do
                for x=0,W-1 do
                    if nodes[y*W+x] then
                        for _,dir in ipairs({-1,1}) do
                            local nx=x+dir
                            if stand(nx,y) then
                                edge(x,y,nx,y,"walk",1)
                            end
                            -- A tile-wide pit can usually be crossed without
                            -- jumping; let the game physics decide execution.
                            -- Native narrow-corridor walking uses body clearance,
                            -- rather than the head clearance needed for a jump arc.
                            if open(nx,y)
                                and not stand(nx,y)
                                and stand(x+2*dir,y) then
                                edge(x,y,x+2*dir,y,"walkGap",2.2)
                            end
                            -- Valid takeoff clearance + upper landing.
                            -- High ledges are marked costly and blacklisted
                            -- temporarily if native physics rejects them.
                            for rise=1,5 do
                                local ny=y-rise
                                if ny<0 then break end
                                local clear=true
                                for yy=y-1,ny-1,-1 do
                                    if not open(x,yy) then clear=false;break end
                                end
                                if not clear then break end
                                if stand(nx,ny) and open(nx,ny-1) then
                                    edge(x,y,nx,ny,"jump",
                                        2+rise+(rise>=4 and 3 or 0))
                                end
                                if rise>=3 and open(nx,ny)
                                    and open(nx,ny-1)
                                    and stand(x+dir*2,ny)
                                    and open(x+dir*2,ny-1) then
                                    edge(x,y,x+dir*2,ny,"jump",4+rise)
                                end
                            end
                            -- Reference TEST38 stair: tight ledge/corridor.
                            -- Do not require clear landing headroom: this is
                            -- precisely why it is separate from jump.
                            for rise=1,2 do
                                local ny=y-rise
                                if ny>=0 and open(x,y-1)
                                    and (rise==1 or open(x,y-2))
                                    and stand(nx,ny)
                                    and not (open(x,ny-1) and open(nx,ny-1))
                                then
                                    edge(x,y,nx,ny,"stair",4+1.6*rise)
                                end
                            end
                            -- Directed falling edges are NOT reversible.
                            if open(nx,y) then
                                for drop=1,40 do
                                    local ny=y+drop
                                    if ny>=H-1 then break end
                                    if not open(nx,ny) or not open(nx,ny-1) then
                                        break
                                    end
                                    if stand(nx,ny) then
                                        edge(x,y,nx,ny,"fall",1+drop)
                                        break
                                    end
                                end
                            end
                            -- Jump across multiple missing floor tiles.
                            if open(x,y-1) and open(x,y-2) then
                                for dist=2,4 do
                                    local clear=true
                                    for j=1,dist-1 do
                                        local cx=x+j*dir
                                        if not open(cx,y) or not open(cx,y-1)
                                            or not open(cx,y-2) then
                                            clear=false;break
                                        end
                                    end
                                    local landing=x+dist*dir
                                    if clear and stand(landing,y)
                                        and open(landing,y-2) then
                                        edge(x,y,landing,y,"gap",dist+1.5)
                                    end
                                end
                            end

                            for dist=2,5 do
                                local bx=x+dir*dist
                                for dy=-2,3 do
                                    local by=y+dy
                                    if longArc(x,y,bx,by) then
                                        edge(x,y,bx,by,"longjump",
                                            3+dist*0.65+math.abs(dy)*0.65)
                                    end
                                end
                            end
                        end
                    end
                end
                if y%10==9 then task.wait() end
            end
            local nextMap={
                world=world,w=W,h=H,openMask=openMask,
                supportMask=supportMask,nodes=nodes,reverse=reverse,
                routes={},blocked={},nodeCount=count,edgeCount=edges
            }
            print("[V68 WORLD MAP] BUILT",W,"x",H,
                "| standable",count,"| directed edges",edges)
            return nextMap
        end)
        navBuilding=false
        if not ok then
            warn("[V68 WORLD MAP] build error:",result)
            return nil,tostring(result)
        end
        worldNav=result
        return worldNav
    end

    local function routeField(gx,gy)
        local nav,err=buildWorldNav(false)
        if not nav then return nil,err end
        local W=nav.w
        if gx<0 or gx>=nav.w or gy<0 or gy>=nav.h then
            return nil,"Drop point outside world"
        end
        local target=gy*W+gx
        if not nav.nodes[target] then
            return nil,("Drop point (%d,%d) has no safe standing floor")
                :format(gx,gy)
        end
        local time=os.clock()
        local expired=false
        for k,t in pairs(nav.blocked) do
            if t<=time then nav.blocked[k]=nil;expired=true end
        end
        if expired then nav.routes={} end
        if nav.routes[target] then return nav.routes[target] end

        local heap,nHeap={},0
        local function push(id,d)
            nHeap+=1
            local i=nHeap
            while i>1 do
                local p=math.floor(i/2)
                if heap[p].d<=d then break end
                heap[i]=heap[p];i=p
            end
            heap[i]={id=id,d=d}
        end
        local function pop()
            if nHeap==0 then return nil end
            local top=heap[1]
            local last=heap[nHeap]
            heap[nHeap]=nil
            nHeap-=1
            if nHeap>0 then
                local i=1
                while i*2<=nHeap do
                    local c=i*2
                    if c<nHeap and heap[c+1].d<heap[c].d then c+=1 end
                    if heap[c].d>=last.d then break end
                    heap[i]=heap[c];i=c
                end
                heap[i]=last
            end
            return top
        end
        local dist={[target]=0}
        local nextHop={}
        local reachable=0
        push(target,0)
        while nHeap>0 do
            local top=pop()
            if top.d~=dist[top.id] then continue end
            reachable+=1
            for _,e in ipairs(nav.reverse[top.id] or {}) do
                local expiry=nav.blocked[e.key]
                if not expiry or expiry<=time then
                    local newCost=top.d+e.cost
                    if newCost<(dist[e.from] or math.huge) then
                        dist[e.from]=newCost
                        nextHop[e.from]=e
                        push(e.from,newCost)
                    end
                end
            end
            if reachable%500==0 then task.wait() end
        end
        local result={target=target,distance=dist,nextHop=nextHop,
            reachable=reachable}
        nav.routes[target]=result
        print("[V68 WORLD MAP] DESTINATION",gx,gy,
            "| reachable",reachable,"/",nav.nodeCount)
        return result
    end

    local function findPath(sx,sy,gx,gy)
        local nav,err=buildWorldNav(false)
        if not nav then return nil,err end
        local field,why=routeField(gx,gy)
        if not field then return nil,why end
        if sx<0 or sx>=nav.w or sy<0 or sy>=nav.h then
            return nil,"Avatar outside world grid"
        end
        local start=sy*nav.w+sx
        if not nav.nodes[start] then
            return nil,("Avatar (%d,%d) not on safe mapped floor"):format(sx,sy)
        end
        if start==field.target then return {} end
        if not field.nextHop[start] then
            print("[V68 WORLD MAP] UNREACHABLE",sx,sy,"->",gx,gy,
                "| destination reachable",field.reachable,
                "| total nodes",nav.nodeCount)
            return nil,("No physically mapped route (%d,%d)->(%d,%d)")
                :format(sx,sy,gx,gy)
        end
        local path,cur={},start
        for _=1,nav.w*nav.h do
            if cur==field.target then break end
            local e=field.nextHop[cur]
            if not e then return nil,"Mapped route interrupted" end
            path[#path+1]=e
            cur=e.to
        end
        if cur~=field.target then return nil,"Mapped route loop" end
        print("[V68 WORLD ROUTE]",sx,sy,"->",gx,gy,
            "| steps",#path,"| weight",math.floor(field.distance[start]*10)/10)
        return path
    end
    local function steer(state,target,tolerance)
        local dx=target-state.x
        local vx=state.vx or 0
        local decel=state.grounded and 48 or 17
        local dir=0
        if math.abs(dx)>(tolerance or 0.12) then
            dir=dx>0 and 1 or -1
            if vx*dir>0 and vx*vx/(2*decel)>=math.abs(dx)-(tolerance or 0.12)*0.5 then
                dir=0
            end
        end
        input.left=dir<0
        input.right=dir>0
    end
    local function walkSegment(tx,ty,liveFloor)
        local target=tx+0.5
        local started=os.clock()
        local startX=pTile()
        local maxSec=4+math.abs(target-(startX or target))*0.8
        local previousX,lastMove=nil,started
        while alive() and busy and os.clock()-started<maxSec do
            local _,currentY,s=pTile()
            if not s or s.dead or math.abs(currentY-ty)>1 then release();return false end
            if liveFloor then
                if currentY~=ty then release();return false end
                local column=math.floor(s.x)
                local direction=target>s.x and 1 or -1
                local nextColumn=math.abs(target-s.x)<0.5 and tx or column+direction
                if not standable(column,ty) or not standable(nextColumn,ty) then
                    release();return false
                end
            end
            steer(s,target,0.12)
            if math.abs(s.x-target)<0.26 and math.abs(s.vx or 0)<2.5 then
                release();return true
            end
            if previousX==nil or math.abs(previousX-s.x)>0.07 then
                previousX=s.x;lastMove=os.clock()
            end
            if os.clock()-lastMove>2 then break end
            task.wait(0.04)
        end
        release();return false
    end
    local function jumpStep(e)
        if not walkSegment(e.fx,e.fy) then return false end
        release();task.wait(0.08)
        local t0=os.clock()
        local airborne=false
        local target=e.x+0.5
        local climb=e.fy-e.y
        local top=e.y+1
        local steeringStarted=false
        input.jump=true
        while alive() and busy and os.clock()-t0<3.1 do
            local _,_,s=pTile()
            if not s or s.dead then break end
            if s.grounded==false then airborne=true end
            if airborne and (s.y<=top+0.02 or (s.vy or 0)>=0) then
                input.jump=false
            end
            -- Delay lateral steering until the avatar is above the
            -- platform's collision face. A taller ledge needs a small
            -- extra horizontal lead to reach its landing before descent.
            local approach=climb>=4 and 0.65 or 0.25
            if s.y<=top+approach then steeringStarted=true end
            if steeringStarted then
                steer(s,target,0.12)
            else
                steer(s,e.fx+0.5,0.15)
            end
            if airborne and s.grounded then
                local sy=math.floor(s.y-0.475)
                if sy==e.y and math.abs(s.x-target)<0.35 then
                    release()
                    return true
                end
                print("[V68 LEDGE] landed",math.floor(s.x),sy,
                    "| expected",e.x,e.y,"| climb",climb)
                break
            end
            task.wait(0.04)
        end
        release()
        return false
    end
    local function fallStep(e)
        local t0=os.clock()
        local airborne=false
        release()
        while alive() and busy and os.clock()-t0<3.5 do
            local _,currentY,s=pTile()
            if not s then break end
            steer(s,e.x+0.5,0.12)
            if s.grounded==false then airborne=true end
            if currentY==e.y and s.grounded then
                release()
                return walkSegment(e.x,e.y)
            end
            if airborne and s.grounded and currentY~=e.y then break end
            if currentY>e.y+1 then break end
            task.wait(0.04)
        end
        release();return false
    end
    local function gapStep(e)
        if not walkSegment(e.fx,e.fy) then return false end
        release();task.wait(0.08)
        local dir=e.x>e.fx and 1 or -1
        local takeoff=e.fx+0.5+dir*0.55
        local t0=os.clock()
        local jumped,airborne=false,false
        while alive() and busy and os.clock()-t0<3 do
            local _,_,s=pTile()
            if not s then break end
            if not jumped then
                steer(s,takeoff,0.03)
                if (s.x-takeoff)*dir>=0 then jumped=true;input.jump=true end
            else
                if s.grounded==false then airborne=true end
                if airborne and (s.vy or 0)>=0 then input.jump=false end
                steer(s,e.x+0.5,0.12)
                if airborne and s.grounded then
                    local y=math.floor(s.y-0.475)
                    local ok=y==e.y and math.abs(s.x-(e.x+0.5))<0.35
                    release();return ok
                end
            end
            task.wait(0.04)
        end
        release();return false
    end
    local function walkGapStep(e)
        -- Keep continuous horizontal input over a one-tile hole.
        -- Abort if the avatar falls below the intended landing level.
        local direction=e.x>e.fx and 1 or -1
        local started=os.clock()
        while alive() and busy and os.clock()-started<3 do
            local _,y,s=pTile()
            if not s or y>e.y+1 then break end
            input.left=direction<0
            input.right=direction>0
            input.jump=false
            if math.floor(s.x)==e.x and y==e.y and s.grounded then
                release()
                return true
            end
            task.wait(0.04)
        end
        release()
        return false
    end

    local function longJumpStep(e)
        if not walkSegment(e.fx,e.fy) then return false end
        release();task.wait(0.045)
        local _,_,origin=pTile()
        if not origin or not origin.grounded then return false end
        local startY=origin.y
        local dir=e.x>e.fx and 1 or -1
        local target=e.x+0.5
        local airborne=false
        input.jump=true
        local t0=os.clock()
        while alive() and busy and os.clock()-t0<2.6 do
            local x,y,s=pTile()
            if not s or s.dead then break end
            if not s.grounded then airborne=true end
            local clearance=e.y<=e.fy-2 and 1.10 or 0.72
            if airborne and startY-s.y>=clearance then
                local vx=s.vx or 0
                local dx=target-s.x
                local predicted=dx-vx*math.abs(vx)/95
                if math.abs(dx)<0.12 and math.abs(vx)<0.8 then
                    input.left=false;input.right=false
                elseif math.abs(vx)>1 and predicted*vx<0 then
                    input.left=vx>0;input.right=vx<0
                else
                    input.left=dir<0;input.right=dir>0
                end
            else
                input.left=false;input.right=false
            end
            if airborne and (s.vy or 0)>=0 then input.jump=false end
            if airborne and s.grounded then
                release()
                if x==e.x and y==e.y then return true end
                print("[V68 NAV] longjump landed",x,y,
                    "expected",e.x,e.y,"repath")
                return false
            end
            task.wait(0.025)
        end
        release()
        return false
    end

    local function stairStep(e)
        -- TEST38 reference stair/hug-wall movement; reuse existing
        -- Auto Drop native input owner rather than hooking a second time.
        local direction=e.x>e.fx and 1 or -1
        local hug=e.fx+0.5+direction*0.17
        for attempt=1,3 do
            if not alive() or not busy then return false end
            local sx,sy,state=pTile()
            if not state or state.dead then return false end
            if sx==e.x and sy==e.y and state.grounded then
                return walkSegment(e.x,e.y)
            end
            if sx~=e.fx or sy~=e.fy or not state.grounded then
                return false
            end
            local approach=os.clock()
            while alive() and busy and os.clock()-approach<1.05 do
                local _,_,s=pTile()
                if not s or s.dead or not s.grounded then break end
                steer(s,hug,0.035)
                if math.abs(s.x-hug)<0.07
                    and math.abs(s.vx or 0)<1.6 then break end
                task.wait(0.025)
            end
            release()
            task.wait(0.07)
            if not alive() or not busy then return false end
            input.jump=true
            local t0=os.clock()
            local airborne=false
            local landedX,landedY=nil,nil
            while alive() and busy and os.clock()-t0<2.15 do
                local x,y,s=pTile()
                if not s or s.dead then break end
                if not s.grounded then airborne=true end
                if airborne and (s.y<=e.y+0.92
                    or (s.vy or 0)>=0) then input.jump=false end
                local forward=airborne and
                    ((attempt==1 and s.y<=e.y+1.03)
                    or (attempt==2 and s.y<=e.fy+0.70)
                    or (attempt==3 and s.y<=e.fy+0.52))
                if forward then
                    input.left=direction<0
                    input.right=direction>0
                else
                    steer(s,hug,0.06)
                end
                if airborne and s.grounded then
                    landedX,landedY=x,y
                    break
                end
                if not airborne and os.clock()-t0>0.50 then break end
                task.wait(0.025)
            end
            release()
            if landedY==e.y then
                if landedX==e.x then return true end
                return walkSegment(e.x,e.y)
            end
            if not landedX or landedX~=e.fx or landedY~=e.fy then
                print("[V68 STAIR] landed elsewhere",
                    landedX,landedY,"expected",e.x,e.y)
                return false
            end
        end
        release()
        return false
    end
    local function executePath(path)
        local i=1
        while i<=#path and alive() and busy do
            local e=path[i]
            local ok=false
            if e.kind=="walk" then
                local last=i
                local dir=e.x-e.fx
                while path[last+1] and path[last+1].kind=="walk"
                    and path[last+1].x-path[last+1].fx==dir
                    and path[last+1].y==e.y do
                    last+=1
                end
                local final=path[last]
                print("[V68 WALK]",e.fx,"->",final.x,"Y",final.y)
                ok=walkSegment(final.x,final.y)
                i=last
            elseif e.kind=="walkGap" then
                print("[V68 WALK GAP]",e.fx,e.fy,"->",e.x,e.y)
                ok=walkGapStep(e)
            elseif e.kind=="jump" then
                print("[V68 JUMP]",e.fx,e.fy,"->",e.x,e.y,
                    "| rise",e.fy-e.y)
                ok=jumpStep(e)
            elseif e.kind=="fall" then
                print("[V68 FALL]",e.fx,e.fy,"->",e.x,e.y)
                ok=fallStep(e)
            elseif e.kind=="gap" then
                print("[V68 GAP]",e.fx,e.fy,"->",e.x,e.y)
                ok=gapStep(e)
            elseif e.kind=="longjump" then
                print("[V68 LONGJUMP]",e.fx,e.fy,"->",e.x,e.y)
                ok=longJumpStep(e)
            elseif e.kind=="stair" then
                print("[V68 STAIR]",e.fx,e.fy,"->",e.x,e.y)
                ok=stairStep(e)
            end
            if not ok then
                release()
                return false,path[i]
            end
            i+=1
        end
        release()
        return alive() and busy
    end
    -- If a fall/jump leaves the avatar physically off the A* floor map,
    -- wait for landing or walk to an adjacent real mapped floor.
    -- Never teleport or pretend the unmapped tile is traversable.
    local function recoverMappedStart()
        local nav,reason=buildWorldNav(true)
        if not nav then return false,reason end
        local untilAt=os.clock()+4.2
        while alive() and busy and os.clock()<untilAt do
            local x,y,body=pTile()
            if not x or not body or body.dead then
                release()
                return false,"Recovery: avatar unavailable"
            end
            if body.grounded and nav.nodes[y*nav.w+x] then
                release()
                print("[V68 RETURN RECOVERY] Landed on mapped tile",x,y)
                return true
            end
            if body.grounded then
                local target
                for radius=1,2 do
                    for _,dir in ipairs({-1,1}) do
                        local nx=x+radius*dir
                        if nx>=0 and nx<nav.w and nav.nodes[y*nav.w+nx] then
                            local clear=true
                            for step=1,radius do
                                if not openAt(x+dir*step,y) then clear=false;break end
                            end
                            if clear then target=nx+0.5;break end
                        end
                    end
                    if target then break end
                end
                if not target then
                    release()
                    return false,("Recovery: no adjacent mapped floor at (%d,%d)")
                        :format(x,y)
                end
                steer(body,target,0.1)
                task.wait(0.04)
            else
                release()
                task.wait(0.07)
            end
        end
        release()
        return false,"Recovery: landing timeout"
    end
    local function walkTo(tx,ty,fresh)
        local started=os.clock()
        local attempts=0
        local refreshed=false
        while alive() and busy and os.clock()-started<90 do
            local x,y=pTile()
            if not x then return false,"State karakter tidak tersedia" end
            if x==tx and y==ty then release();return true end
            -- Roof placement changes the map, but a level corridor can be
            -- verified directly from live tiles without rebuilding all edges.
            if y==ty then
                local clear=true
                local direction=tx>=x and 1 or -1
                for cx=x,tx,direction do
                    if not standable(cx,ty) then clear=false;break end
                end
                if clear then
                    if walkSegment(tx,ty,true) then return true end
                    if not alive() or not busy then return false,"Perjalanan dibatalkan" end
                    x,y=pTile()
                    if not x then return false,"State karakter tidak tersedia" end
                    fresh=true
                end
            end
            if fresh and not refreshed then
                local nav,err=buildWorldNav(true)
                if not nav then return false,err end
                refreshed=true
            end
            local path,why=findPath(x,y,tx,ty)
            if not path and not refreshed then
                local nav,err=buildWorldNav(true)
                if not nav then return false,err end
                refreshed=true
                path,why=findPath(x,y,tx,ty)
            end
            if not path and type(why)=="string"
                and why:find("not on safe mapped floor",1,true) then
                print("[V68 RETURN RECOVERY] Recovering actual position",x,y)
                local recovered,err=recoverMappedStart()
                if recovered then
                    release()
                    task.wait(0.08)
                    continue
                end
                return false,err or why
            end
            if not path then return false,why end
            print("[V68 PATH]",x,y,"->",tx,ty,"steps",#path)
            local ok,failed=executePath(path)
            if not busy then return false,"Perjalanan dibatalkan" end
            local xx,yy=pTile()
            if ok and xx==tx and yy==ty then release();return true end
            attempts+=1
            if not ok and failed and worldNav then
                -- Avoid repeating an impossible jump or blocked corridor.
                worldNav.blocked[failed.key]=os.clock()+20
                worldNav.routes={}
                print("[V68 WORLD ROUTE] blocked",failed.kind,
                    failed.fx,failed.fy,"->",failed.x,failed.y,
                    "| alternate route requested")
            end
            buildWorldNav(true)
            if attempts>=12 then return false,"Mapped movement failed 12 times" end
            release();task.wait(0.3)
        end
        release()
        return false,"Perjalanan dibatalkan/timeout"
    end
        return {
            walkTo=walkTo,
            buildWorldNav=buildWorldNav,
            routeField=routeField,
        }
    end)()

    -- Share the existing map-aware Auto Drop movement with World Builder.
    -- Exclusive owner: no second key interception or competing pathfinder.
    env.Fian792WorldBuilderNav={
        walk=function(x,y,fresh,onStep)
            if env.Fian792ReturnMoving and env.Fian792MovementOwner then
                -- a paused Farm may still own the touch hook: free it first
                local farm0=env.Fian792FarmRuntime
                if farm0 and type(farm0.releaseTouch)=="function" then farm0.releaseTouch() end
            end
            if builderNav or busy or (enabled and not env.Fian792ReturnMoving) or dropPause
                or (guardPaused and not env.Fian792ReturnMoving)
                or env.Fian792MovementOwner then
                return false,"movement busy"
            end
            local farm=env.Fian792FarmRuntime
            if not farm or type(farm.navigate)~="function" then return false,"Navigator rotasi belum tersedia" end
            builderNav=true
            busy=true
            -- DF uses the Rotation route planner and movement controller.
            local worker,watchdog,workerSince,workerError
            local workerDone=false
            local stepping=type(onStep)=="function"
            if stepping then
                worker=task.spawn(function()
                    while stepping and builderNav do
                        workerSince=os.clock()
                        local ok,done=pcall(onStep)
                        workerSince=nil
                        if not ok or done==false then
                            workerError=ok and "build pending" or tostring(done)
                            release()
                            builderNav=false
                            busy=false
                            break
                        end
                        task.wait(0.04)
                    end
                    workerDone=true
                end)
            end
            if worker then
                watchdog=task.spawn(function()
                    while stepping and builderNav do
                        if workerSince and os.clock()-workerSince>=3 then
                            workerError="Pemasangan timeout; posisi terakhir dipertahankan"
                            stepping=false;builderNav=false;busy=false
                            release()
                            pcall(task.cancel,worker)
                            workerDone=true
                            break
                        end
                        task.wait(0.1)
                    end
                end)
            end
            local ok,done,reason=pcall(farm.navigate,x,y,function()
                return builderNav and busy and env.Fian792DropGeneration==generation
            end,stepping)
            stepping=false
            release()
            if watchdog then pcall(task.cancel,watchdog) end
            if worker then
                local deadline=os.clock()+2
                while not workerDone and os.clock()<deadline do task.wait(0.02) end
                if not workerDone then
                    pcall(task.cancel,worker)
                    workerError="Pemasangan belum selesai; posisi terakhir dipertahankan"
                end
            end
            release();unhook()
            if workerError then done=false;reason=workerError end
            busy=false;builderNav=false
            if not ok then return false,tostring(done) end
            return done,reason
        end,
        cancel=function() builderNav=false;busy=false;release() end,
        busy=function() return builderNav end
    }

    local function inventoryCounts()
        local active=getGameInventory()
        if not active or type(active.slots)~="table" then return nil end
        local counts={}
        for k,slot in pairs(active.slots) do
            if type(slot)=="table" then
                local id=tonumber(slot.id or slot.itemId or slot.itemID)
                local n=tonumber(slot.n or slot.count or slot.amount or slot.qty)
                if id and n and n>0 then counts[id]=(counts[id] or 0)+n end
            elseif type(slot)=="number" and tonumber(k) and slot>0 then
                local id=tonumber(k)
                counts[id]=(counts[id] or 0)+slot
            end
        end
        return counts
    end
    local function category(id)
        local item=rawget(db,id)
        if type(item)~="table" then return nil end
        local kind=rawget(item,"kind")
        if kind=="seed" then return "seed" end
        if kind=="tool" or kind=="cloth" or kind=="clothes"
            or kind=="consumable" or rawget(item,"lock")
            or rawget(item,"area") or rawget(item,"vend")
            or rawget(item,"display") then return nil end
        return "block"
    end
    local dropRetryAfter = {} -- per-item cooldown prevents repeated rejected/returned drops
    local function findPending()
        local counts=inventoryCounts() or {}
        local pending={}
        local now=os.clock()
        local watch=now-lastDropWatch>=10
        -- Read APPROVED item IDs directly, including their native count().
        -- An item at 200 must not be missed because a slots enumeration was
        -- stale or the item was absent from the latest dropdown refresh.
        for id in pairs(selectedDropIds) do
            local kind=category(id)
            local bySlots=counts[id] or 0
            local byNative=countItem(id)
            local n=tonumber(byNative) or 0
            if n<=0 then n=bySlots
            elseif bySlots>0 then n=math.min(n,bySlots) end
            if watch then
                print("[AUTO DROP WATCH]",kind or "unsupported","ID",id,
                    "| slots",bySlots,"native",byNative,
                    "| threshold",threshold,
                    "| retry sec",math.max(0,math.ceil(
                        (dropRetryAfter[id] or 0)-now)))
            end
            if kind and n>=threshold and os.clock()>=(dropRetryAfter[id] or 0)
                and not (rotation.enabled and id==rotation.selectedBlock) then
                pending[#pending+1]={id=id,n=n,kind=kind}
            end
        end
        if watch then lastDropWatch=now end
        table.sort(pending,function(a,b) return a.id<b.id end)
        return pending
    end
    local function anySelectedFull()
        local counts=inventoryCounts()
        if type(counts)~="table" then return nil end
        for id in pairs(selectedDropIds) do
            if category(id) and not (rotation.enabled and id==rotation.selectedBlock) then
                local native=countItem(id)
                local n=tonumber(native) or 0
                if n<=0 then n=counts[id] or 0
                elseif (counts[id] or 0)>0 then
                    n=math.min(n,counts[id])
                end
                if n>=threshold then return true end
            end
        end
        return false
    end
    local function dropOne(hud,it)
        local fn=rawget(hud,"onDrop")
        local before=countItem(it.id)
        if before<=0 then return true end
        -- The threshold is a trigger, not a reserve quantity. When the
        -- selected item has 200 in inventory, send all 200 to native onDrop.
        -- Do not silently reserve 50 seeds: that caused 200 -> 150 drops.
        -- it.amount (Rotation low-soil drop) sends only the excess.
        local amount=math.min(before,it.amount or 200)
        if amount<=0 then return true end
        print("[AUTO DROP REQUEST]",it.kind,"ID",it.id,
            "| stock",before,"| requested",amount,"| threshold",threshold)
        local ok,err=pcall(fn,it.id,amount)
        if not ok then return false,"onDrop error: "..tostring(err) end
        -- Inventory updates may arrive well AFTER the native onDrop call.
        -- Wait for reconciliation instead of treating a delayed server ACK
        -- as a failed drop, which previously left Farm paused at 180/200.
        local after=countItem(it.id)
        local deadline=os.clock()+4
        while alive() and after>=before and os.clock()<deadline do
            task.wait(0.15)
            after=countItem(it.id)
        end
        if not alive() then
            return false,"Drop was interrupted by Auto Drop OFF"
        end
        if after>=before then
            -- The server did not confirm this drop. Retry later, but do
            -- not report success or issue duplicate drops on this trip.
            dropRetryAfter[it.id]=os.clock()+10
            statusUpdate("Drop ID "..it.id.." belum terkonfirmasi | Farm PAUSE")
            return false,"Drop not confirmed for ID "..it.id
        end
        -- Even if inventory decreased, give the server time to reconcile.
        -- Never endlessly retry on the same trip.
        local dropped=math.max(0,before-after)
        dropRetryAfter[it.id]=os.clock()+10
        statusUpdate("Drop ID "..it.id..": "..before.." -> "..after..
            " | actual "..dropped.."/"..amount)
        if dropped<amount then
            -- A partial response must never be described as 200 dropped.
            -- Do not resend immediately: the server may still reconcile.
            warn("[AUTO DROP PARTIAL] ID",it.id,
                "| requested",amount,"| confirmed",dropped,
                "| remaining",after,"| retry on next eligible trip")
        end
        return true
    end
    -- Target = ITEM tile; character stands one cell to either side.
    local function walkToDropTarget(point)
        local tx,ty=point.dropX,point.dropY
        if type(tx)~="number" or type(ty)~="number" then
            return nil,"Re-save Drop item tile"
        end
        -- Stand on the side the bot is approaching FROM, facing the drop
        -- tile, so it never walks across (and re-takes) the pile:
        -- coming from the right -> stand at tx+1 facing left (-1);
        -- coming from the left  -> stand at tx-1 facing right (+1).
        -- Same column: fall back to the facing saved with the point.
        local px=pTile()
        local preferred
        if px and px>tx then preferred=-1
        elseif px and px<tx then preferred=1
        else preferred=point.facing==-1 and -1 or 1 end
        print("[DROP STAND] target",tx,ty,"| from X",px or "-",
            "| stand X",tx-preferred,"facing",preferred<0 and "LEFT" or "RIGHT")
        local lastError="No adjacent route"
        for _,face in ipairs({preferred,-preferred}) do
            local standX=tx-face
            if standX>=0 and standX<world.w then
                local ok,reason=navApi.walkTo(standX,ty)
                if ok then
                    return {x=standX,y=ty,facing=face,
                        dropX=tx,dropY=ty}
                end
                lastError=reason or lastError
            end
        end
        return nil,lastError
    end
    -- A drop tile must be free: items dropped toward a solid tile spill
    -- onto the player's own tile and are picked up again on the next pass.
    env.Fian792DropRuntime.targetProblem=function(point)
        local x,y=point and point.dropX,point and point.dropY
        if type(x)~="number" or type(y)~="number" then return "Re-save Drop item tile" end
        if x<0 or y<0 or x>=world.w or y>=world.h then return "Posisi Drop di luar world" end
        -- Only a SOLID / harmful foreground blocks a drop. A planted seed or
        -- tree, door, sign etc. on the tile does not stop items landing.
        local row=type(world.fg)=="table" and world.fg[y]
        local fg=type(row)=="table" and row[x] or nil
        local item=type(fg)=="number" and fg~=0 and db[fg] or nil
        if type(item)=="table" and (item.solid or item.deadly
            or item.hurts or item.laser) then
            return "Tile Posisi Drop ("..x..","..y..") tertutup "..
                tostring(item.name or ("ID "..fg)).." (solid); pindahkan ke tile kosong"
        end
        return nil
    end
    -- Where did the stack actually land? Largest stack of `itemId`
    -- within 2 tiles of the target. Returns tileX, tileY, count.
    env.Fian792DropRuntime.findLanding=function(itemId,point)
        local fn=rawget(world,"dropList")
        if type(fn)~="function" then return nil end
        local ok,list=pcall(fn)
        if not ok or type(list)~="table" then return nil end
        local bx,by,bn
        for _,d in pairs(list) do
            if type(d)=="table" and d.id==itemId and type(d.x)=="number"
                and type(d.y)=="number" and (tonumber(d.n) or 0)>0
                and math.abs(math.floor(d.x)-point.dropX)<=2
                and math.abs(math.floor(d.y)-point.dropY)<=2
                and (not bn or d.n>bn) then
                bx,by,bn=math.floor(d.x),math.floor(d.y),d.n
            end
        end
        return bx,by,bn
    end
    local function faceDropTarget(stand)
        for _=1,8 do
            if not alive() or not busy then return false,"cancelled" end
            local x,y,state=pTile()
            if not state or x~=stand.x or y~=stand.y
                or not state.grounded then return false,"stand tile changed" end
            if type(state.facing)=="number" and state.facing*stand.facing>0 then
                release()
                return true
            end
            input.left=stand.facing<0
            input.right=stand.facing>0
            task.wait(0.03)
            release()
            task.wait(0.035)
        end
        return false,"facing could not be confirmed"
    end
    local function runTrip(items,returnPoint)
        local back=returnPoint or points.breakPoint
        if not back then return false,"Simpan posisi Break atau aktifkan Auto Farm" end
        if not returningHome then
            for _,it in ipairs(items) do
                if not points[it.kind] then return false,"Simpan posisi Drop "..it.kind end
            end
        end
        if type(back)=="table" and back.world and back.world~=refs.worldKey() then
            return false,"World berubah"
        end
        local enough=false
        for _,it in ipairs(items) do
            if countItem(it.id)>=threshold then enough=true;break end
        end
        if not enough and not returningHome then
            print("[DROP] WAIT, no item meets threshold")
            return true
        end
        -- A retry after confirmed drops is return-only: no HUD scan,
        -- no remote drop and no item travelling.
        local hud=nil
        if not returningHome then
            hud=findHud()
            if not hud then return false,"HUD.onDrop belum ditemukan/ambigu" end
        end
        local ok,why=bindInput()
        if not ok then return false,why end
        for _,it in ipairs(items) do
            if not alive() then return false,"Dibatalkan" end
            local point=points[it.kind]
            if not point or point.world~=refs.worldKey() then return false,"Posisi drop tidak valid" end
            if returningHome or countItem(it.id)<threshold then
                print("[DROP] Skip travel: below threshold / return-only",it.id)
                continue
            end
            local stand,reason=walkToDropTarget(point)
            if not stand then return false,reason end
            local faced,why=faceDropTarget(stand)
            if not faced then return false,why end
            release()
            if countItem(it.id)<threshold then
                print("[DROP] Skip drop: threshold no longer met",it.id)
                continue
            end
            print("[DROP TARGET] ITEM",point.dropX,point.dropY,
                "STAND",stand.x,stand.y,"FACING",stand.facing)
            local done,reason=dropOne(hud,it)
            if not done then return false,reason end
        end
        returningHome=true
        statusUpdate(returnPoint and "Kembali ke posisi Auto Farm" or "Kembali ke posisi Break")
        local arrived,reason=navApi.walkTo(back.x,back.y)
        if not arrived then return false,reason end
        -- Drops remaining in the world or inventory must NOT hold PNB.
        return true
    end

    -- Dedicated Rotation Seed Trip, independent of manual Auto Drop ON.
    -- Uses the same approved native HUD.onDrop and A* navigator.
    -- Return-only retries do not re-drop already confirmed seed.
    env.Fian792DropRuntime.rotationSeedReturning=function(itemId)
        return rotationSeedReturn~=nil
            and rotationSeedReturn.seed==itemId
    end
    env.Fian792DropRuntime.rotationSeedTrip=function(itemId,home,keep)
        -- `keep` seeds stay in the inventory for the remaining planting
        -- spots; only the excess is dropped. nil keeps the old behavior
        -- (drop a full 200 stack).
        local keepN=keep~=nil and math.max(0,math.floor(tonumber(keep) or 0)) or nil
        if not rotation.enabled or not rotation.selectedSeed
            or itemId~=rotation.selectedSeed then
            return false,"Rotation inactive / selected seed changed"
        end
        if busy or builderNav or guardPaused or dropPause then
            return false,"Movement busy or guarded"
        end
        local point=points.seed
        if not point or point.world~=refs.worldKey()
            or type(point.dropX)~="number" or type(point.dropY)~="number" then
            return false,"Simpan Posisi Drop Seed terlebih dahulu"
        end
        local problem=env.Fian792DropRuntime.targetProblem(point)
        if problem then return false,problem end
        local actualX,actualY,actual=pTile()
        if not actual or not actual.grounded then return false,"not grounded" end
        local limit=keepN or 199
        if not rotationSeedReturn and countItem(itemId)<=limit then return true end
        local back=rotationSeedReturn
        if not back then
            if not home or not home.x or not home.y then
                return false,"Farm home unavailable"
            end
            back={x=home.x,y=home.y,seed=itemId}
        end
        if env.Fian792MovementOwner and env.Fian792MovementOwner~=input then
            return false,"Farm movement still held"
        end
        busy=true
        rotationSeedBusy=true
        local ok,done,reason=pcall(function()
            local bound,why=bindInput()
            if not bound then return false,why end
            if not rotationSeedReturn then
                local hud=findHud()
                if not hud then return false,"HUD.onDrop unavailable" end
                local stand,why=walkToDropTarget(point)
                if not stand then return false,why end
                local faced,err=faceDropTarget(stand)
                if not faced then return false,err end
                release()
                local extra=countItem(itemId)-(keepN or 0)
                if countItem(itemId)>limit and extra>0 then
                    -- Use native drop implementation with inventory ACK.
                    local dropped,dropWhy=dropOne(hud,{
                        kind="seed",id=itemId,amount=extra
                    })
                    if not dropped then return false,dropWhy end
                    -- Report the real landing tile and protect it from the
                    -- PNB collector while Rotation runs.
                    task.wait(0.2)
                    local lx,ly,ln=env.Fian792DropRuntime.findLanding(itemId,point)
                    if lx then
                        local reserved=env.Fian792ReservedDropTiles
                        if type(reserved)=="table" then reserved[lx..","..ly]=true end
                        print("[ROTATION SEED DROP] landed",lx,ly,"| stack",ln,
                            "| target",point.dropX,point.dropY,"| stand",stand.x,stand.y)
                        if lx==stand.x and ly==stand.y then
                            warn("[ROTATION SEED DROP] stack landed on the STAND tile",
                                lx,ly,"| it will be picked up again; move Posisi Drop Seed")
                        end
                    else
                        warn("[ROTATION SEED DROP] landing tile not found near",
                            point.dropX,point.dropY)
                    end
                end
                rotationSeedReturn=back
                print("[ROTATION SEED DROP] confirmed | returning Farm",
                    back.x,back.y,"| stock",countItem(itemId))
            end
            -- A late update can leave inventory full: never falsely
            -- announce that the trip succeeded in this case.
            if countItem(itemId)>limit then
                rotationSeedReturn=nil
                return false,"Seed still above "..limit.."; awaiting inventory confirmation"
            end
            local arrived,why=navApi.walkTo(back.x,back.y)
            if not arrived then return false,why end
            rotationSeedReturn=nil
            print("[ROTATION SEED DROP] home reached",back.x,back.y)
            return true
        end)
        release()
        unhook()
        rotationSeedBusy=false
        busy=false
        if not ok then return false,tostring(done) end
        return done,reason
    end
