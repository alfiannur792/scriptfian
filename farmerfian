        -- TEST38 physical arc predicate for dynamically scanned world.
        local function longArc(x,y,bx,by)
            if bx<0 or bx>=W or by<0 or by>=H-1 then return false end
            if not stand(bx,by) or not open(bx,by-1) then return false end
            if not open(x,y-1) or not open(x,y-2) then return false end
            local dx,dy=bx-x,by-y
            local dist=math.abs(dx)
            if dist<2 or dist>5 or dy < -2 or dy>3 then return false end
            if dist==5 and dy<0 then return false end
            local arcRise=math.min(3.35,
                farmPhysics.JUMP*farmPhysics.JUMP/
                (2*math.max(1,farmPhysics.GRAV))-0.15)
            -- Sample spacing <=5/12 tile, overlapping native 0.6 body width.
            -- Halve costly ItemDB queries for each speculative long arc.
            for step=0,12 do
                local t=step/12
                local center=x+0.5+dx*t
                local feet=y+0.999+dy*t-arcRise*4*t*(1-t)
                local hw=farmPhysics.HW+0.035
                local top=math.floor(feet-farmPhysics.H-0.035+0.001)
                local bottom=math.floor(feet-0.001)
                for ty=top,bottom do
                    for tx=math.floor(center-hw),math.floor(center+hw) do
                        if not open(tx,ty) then return false end
                    end
                end
            end
            return true
        end
        -- Weighted Dijkstra. Movement costs prefer walking, then short jumps,
        -- before long falls/gaps; no teleport or automatic block placement.
        local heap,heapN={},0
        local function push(node,priority)
            heapN+=1
            local i=heapN
            while i>1 do
                local p=math.floor(i/2)
                if heap[p].cost<=priority then break end
                heap[i]=heap[p]
                i=p
            end
            heap[i]={id=node,cost=priority}
        end
        local function pop()
            if heapN==0 then return nil,nil end
            local top=heap[1]
            local tail=heap[heapN]
            heap[heapN]=nil
            heapN-=1
            if heapN>0 then
                local i=1
                while i*2<=heapN do
                    local child=i*2
                    if child+1<=heapN and heap[child+1].cost<heap[child].cost then
                        child+=1
                    end
                    if tail.cost<=heap[child].cost then break end
                    heap[i]=heap[child]
                    i=child
                end
                heap[i]=tail
            end
            return top.id,top.cost
        end
        local costs={[start]=0}
        local previous,edgeKind={},{}
        local settled={}
        local best,bestScore=nil,math.huge
        local expanded=0
        local maxExpand=math.min(W*H,4800) -- bound navigation CPU
        local function offer(x,y,from,kind,cost)
            if not stand(x,y) then return end
            local idx=y*W+x
            local edgeKey=tostring(from)..">"..tostring(idx)..":"..kind
            if (failedEdges[edgeKey] or 0)>os.clock() then return end
            local nextCost=costs[from]+cost
            if not settled[idx] and (costs[idx]==nil or nextCost<costs[idx]) then
                costs[idx]=nextCost
                previous[idx]=from
                edgeKind[idx]=kind
                push(idx,nextCost)
            end
        end
        push(start,0)
        while heapN>0 and expanded<maxExpand and current() do
            local idx,priority=pop()
            if not settled[idx] and priority==costs[idx] then
                settled[idx]=true
                if priority>bestScore then break end
                local goal=goals[idx]
                local x,y=idx%W,math.floor(idx/W)
                local reverseCost=(y==hy and (x-hx)*preferredDir<0) and 5 or 0
                if goal and priority+goal.penalty+reverseCost<bestScore then
                    best=idx
                    bestScore=priority+goal.penalty+reverseCost
                end
                for _,dir in ipairs({-1,1}) do
                    local nx=x+dir
                    if open(nx,y) then
                        if support(nx,y) then
                            offer(nx,y,idx,"walk",1)
                        else
                            -- One missing support tile: try straight traversal
                            -- before jumping. Real physics determines if it works.
                            local bx=x+2*dir
                            if open(nx,y) and open(bx,y) and support(bx,y)
                                and open(nx,y-1) and open(bx,y-1) then
                                offer(bx,y,idx,"walkGap",2.15)
                            end
                            -- Fall from a real ledge to the NEXT lower safe floor.
                            local fy=y+1
                            while fy<H-1 and fy-y<=40 and open(nx,fy)
                                and not support(nx,fy) do
                                fy+=1
                            end
                            if fy<H-1 and open(nx,fy) and support(nx,fy) then
                                offer(nx,fy,idx,"fall",1.5+0.55*(fy-y))
                            end
                            -- Jump over one or two missing floor tiles.
                            if open(x,y-1) and open(x,y-2) then
                                for dist=2,3 do
                                    local mx=x+dir*(dist-1)
                                    if not open(mx,y) or not open(mx,y-1)
                                        or not open(mx,y-2) then break end
                                    local bx=x+dir*dist
                                    if open(bx,y-1) and open(bx,y-2) then
                                        for down=0,2 do
                                            if not open(bx,y+down) then break end
                                            if support(bx,y+down) then
                                                offer(bx,y+down,idx,"gap",
                                                    3.5+down*0.75+dist*0.4)
                                                break
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                    -- Jump one to three tiles upward; check takeoff and landing headroom.
                    for up=1,3 do
                        if not open(x,y-up) then break end
                        if open(x,y-up-1) and open(nx,y-up)
                            and open(nx,y-up-1) and support(nx,y-up) then
                            offer(nx,y-up,idx,"jump",1.8+1.5*up)
                        end
                    end
                    -- Narrow stairs: standing clearance may be one tile; delay
                    -- horizontal movement until body rises (Zekio stair technique).
                    for up=1,2 do
                        if open(x,y-1) and (up==1 or open(x,y-2))
                            and open(nx,y-up) and support(nx,y-up)
                            and not (open(x,y-up-1) and open(nx,y-up-1)) then
                            offer(nx,y-up,idx,"stair",4+1.6*up)
                        end
                    end
                end

                -- Keep basic walk/jump routes, reduce expensive long arcs
                -- whenever both adjacent floor tiles are already traversable.
                if not (support(x-1,y) and support(x+1,y)) then
                for _,side in ipairs({-1,1}) do
                    for dist=2,5 do
                        local bx=x+side*dist
                        for dy=-2,3 do
                            local by=y+dy
                            if longArc(x,y,bx,by) then
                                offer(bx,by,idx,"longjump",
                                    3+dist*0.65+math.abs(dy)*0.65)
                            end
                        end
                    end
                end
                end
                expanded+=1
                -- Yield often so full-world route generation does not
                -- monopolize an entire render frame.
                if expanded%18==0 then
                    task.wait(0.025)
                end
            end
        end
        if not current() then return nil,"cancelled" end
        if not best then
            return nil,("no traversable route | harvest %d plant %d drop %d | visited %d"):format(
                counts.harvest,counts.plant,counts.drop,expanded)
        end
        local route={}
        local node=best
        while node~=start and #route<math.min(W*H,600) do
            local p=previous[node]
            if not p then return nil,"route reconstruction failed" end
            table.insert(route,1,{kind=edgeKind[node],fx=p%W,fy=math.floor(p/W),
                x=node%W,y=math.floor(node/W)})
            node=p
        end
        if node~=start then return nil,"route too long" end
        return route,goals[best],counts
    end
    local function roamSteer(state,target,tolerance)
        local dx=target-state.x
        local vx=state.vx or 0
        local decel=state.grounded and (farmPhysics.DECEL or 48)
            or (farmPhysics.AIR_DECEL or 17)
        -- Predict stopping point, then brake with opposite input instead of
        -- merely releasing the key (air friction is too weak for that).
        local predicted=state.x+vx*math.abs(vx)/(2*math.max(1,decel))
        local residual=target-predicted
        local dir=0
        if math.abs(dx)>(tolerance or 0.10) or math.abs(vx)>0.38 then
            if math.abs(residual)>0.06 then
                dir=residual>0 and 1 or -1
            elseif math.abs(vx)>0.38 then
                dir=vx>0 and -1 or 1
            end
        end
        touchInput.left=dir<0
        touchInput.right=dir>0
    end
    local function roamStepExec(e,run,physicalOnly)
        if not touchLive(run) then return false end
        local state,x,y=touchPosition()
        if not state or x~=e.fx or y~=e.fy or state.grounded==false then return false end
        if directPhysics and not physicalOnly then
            return directMoveTo(e.x+0.5,e.y+0.999,run,8,false)
        end
        if e.kind=="walk" then
            return standable(e.x,e.y)
                and touchMoveTo(e.x+0.5,e.y,run,
                    math.min(9,1.8+math.abs(e.x-e.fx)*0.35))
        elseif e.kind=="walkGap" then
            -- Traverse a one-tile hole without jump. If the avatar falls
            -- more than one row, abort and let the planner choose a jump.
            if not standable(e.x,e.y) or not clearAir(e.fx+(e.x>e.fx and 1 or -1),e.fy)
                then return false end
            local startedGap=os.clock()
            local direction=e.x>e.fx and 1 or -1
            while touchLive(run) and os.clock()-startedGap<2.8 do
                local state,px,py=touchPosition()
                if not state or py>e.fy+1 then break end
                touchInput.left=direction<0
                touchInput.right=direction>0
                touchInput.jump=false
                if px==e.x and py==e.y and state.grounded then
                    touchRelease()
                    return true
                end
                task.wait(0.04)
            end
            touchRelease()
            return false
        end
        -- Align the character at a stable takeoff point inside its source
        -- tile. Only jump after horizontal drift has settled.
        local function alignTakeoff(target,sourceY,timeout)
            local since=os.clock()
            local stableSince=nil
            local lastX=nil
            local stillSince=since
            while touchLive(run) and os.clock()-since<(timeout or 2.5) do
                local p,px,py=touchPosition()
                if not p or not p.grounded or py~=sourceY then break end
                local dx=target-p.x
                local vx=p.vx or 0
                -- Native physics: DECEL=48, ACCEL=36. To stop at the
                -- CENTER we must brake before arriving, not only check
                -- that math.floor(x) already equals the intended tile.
                local decel=math.max(1,farmPhysics.DECEL or 48)
                local brakingDistance=vx*math.abs(vx)/(2*decel)
                local predicted=dx-brakingDistance
                local centered=math.abs(dx)<=0.11
                    and math.abs(vx)<=0.45
                if centered then
                    touchInput.left=false
                    touchInput.right=false
                    stableSince=stableSince or os.clock()
                    if os.clock()-stableSince>=0.07 then
                        local final,fx,fy=touchPosition()
                        if final and final.grounded and fy==sourceY
                            and math.abs(final.x-target)<=0.11
                            and math.abs(final.vx or 0)<=0.45 then
                            touchRelease()
                            return true
                        end
                        stableSince=nil
                    end
                else
                    stableSince=nil
                    local dir=0
                    if math.abs(predicted)>0.12 then
                        dir=predicted>0 and 1 or -1
                    elseif math.abs(vx)>0.55 then
                        dir=vx>0 and -1 or 1
                    elseif math.abs(dx)>0.16 then
                        dir=dx>0 and 1 or -1
                    end
                    touchInput.left=dir<0
                    touchInput.right=dir>0
                end
                if not lastX or math.abs(p.x-lastX)>0.012 then
                    stillSince=os.clock()
                elseif os.clock()-stillSince>0.95 and math.abs(dx)>0.20 then
                    break
                end
                lastX=p.x
                task.wait(0.025)
            end
            touchRelease()
            return false
        end
        local started=os.clock()
        if e.kind=="jump" then
            if not standable(e.x,e.y) or not clearAir(e.fx,e.fy-1)
                or not clearAir(e.x,e.y-1) then return false end
            local dy=e.fy-e.y
            local direction=e.x>e.fx and 1 or -1
            -- Use actual destination ledge height, not a fixed timing offset.
            -- Keep an achievable margin while checking real collider ahead.
            local requiredFeet=e.y+1-0.020
            local maxRise=farmPhysics.JUMP*farmPhysics.JUMP/
                (2*math.max(1,farmPhysics.GRAV))
            if dy+0.07>maxRise then
                print("[AUTO FARM JUMP IMPOSSIBLE] rise",dy,
                    "| max",maxRise,"|",e.fx,e.fy,"->",e.x,e.y)
                return false
            end
            -- Re-attempt from the SAME ledge with alternate takeoff and
            -- steering timings. Do not immediately discard a route just
            -- because the avatar hit the ceiling on the first attempt.
            for attempt=1,3 do
                if not touchLive(run) then return false end
                local state,px,py=touchPosition()
                if not state then return false end
                if px==e.x and py==e.y and state.grounded then
                    touchRelease()
                    return true
                end
                if px~=e.fx or py~=e.fy or state.grounded==false then
                    touchRelease()
                    return false
                end
                -- All attempts start at the CENTER of the source tile.
                -- Varying offsets moved the body toward the collision edge.
                local takeoff=e.fx+0.5
                if not alignTakeoff(takeoff,e.fy,2.7) then
                    -- If the ledge still has our character, try a different
                    -- takeoff instead of blacklisting it instantly.
                    touchRelease()
                else
                    touchRelease()
                    -- Don't add an unobserved delay here: momentum can
                    -- drift after alignment. Verify actual native position.
