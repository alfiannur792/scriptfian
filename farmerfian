            do
                local row=world.fg[y]
                local far=nil
                if row then
                    for xx=x,edge,direction do
                        if row[xx]==seedId and readyTree(xx,y) then far=xx end
                    end
                end
                if far then
                    local stopAt=far+direction
                    if (stopAt-edge)*direction>0 then stopAt=edge end
                    if (stopAt-x)*direction>=1 then edge=stopAt end
                end
