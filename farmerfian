-- The anchor follows the player's tile. Fractional player movements
-- never change it; crossing into a NEW tile changes the target locations.
local function chooseGridAnchor()
    local s = getState()
    if not s then return false end
    local px, py = math.floor(s.x), math.floor(s.y - 0.475)
    local worldKey = refs.worldKey()
    local changed = not gridAnchor
        or gridAnchorWorld ~= worldKey
        or gridAnchor.x ~= px or gridAnchor.y ~= py
    if changed then
        gridAnchor = {x = px, y = py}
        gridAnchorWorld = worldKey
        print("[PLACE GRID FOLLOW PLAYER]", px, py)
    end
    return true, changed
end

local function selectedTileSnapshot()
    if not chooseGridAnchor() then return nil, nil end
    local tiles, lookup = {}, {}
    for _, offset in pairs(selectedOffsets) do
        local tx = gridAnchor.x + offset.dx
        local ty = gridAnchor.y + offset.dy
        tiles[#tiles + 1] = {x = tx, y = ty}
        lookup[key(tx, ty)] = true
    end
    table.sort(tiles, function(a, b)
        return a.y == b.y and a.x < b.x or a.y < b.y
    end)
    return tiles, lookup
end

local function savePlacePreset()
    if not chooseGridAnchor() then return end
    local offsets = {}
    for _, o in pairs(selectedOffsets) do
        offsets[#offsets+1] = {dx = o.dx, dy = o.dy}
    end
    table.sort(offsets, function(a,b)
        return a.dy == b.dy and a.dx < b.dx or a.dy < b.dy
    end)
    -- Anchor included for compatibility with the existing Copy-to-Break button.
    -- It is NOT used to lock Auto Place targets.
    savedPlaceGrid = {
        anchor = {x = gridAnchor.x, y = gridAnchor.y},
        offsets = offsets,
        relative = true
    }
    env.Fian792SavedPlaceGrid = savedPlaceGrid
    env.Fian792PlaceOffsets = offsets
    print("[PLACE GRID PRESET] Saved relative offsets", #offsets,
        "current player tile", gridAnchor.x, gridAnchor.y)
end

