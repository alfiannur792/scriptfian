-- Never assume the native call immediately updates local world data.
-- Breaking is counted only after foreground/background actually changes.
local function breakDiagnostic(tile, reason, extra)
    local key = tostring(tile.x)..","..tostring(tile.y)..":"..reason
    local now = os.clock()
    if now - (breakLastDiagnostics[key] or -100) < 2 then return end
    breakLastDiagnostics[key] = now
    local fg, bg = breakTileAt(tile.x, tile.y)
    print("[BREAK SKIP]", tile.x, tile.y, reason,
          "fg", tostring(fg), "bg", tostring(bg),
          "extra", tostring(extra or ""))
end

-- v1.0.147 POTASSIUM: the native punch lazily require()s game modules;
-- Potassium runs our thread at an identity that may not require them
-- ("Cannot require a non-RobloxScript module from a RobloxScript").
-- On that error, retry once at game-script identity (2) and remember.
local punchAsGame = env.Fian792PunchAsGame == true
local function callAsGame(fn, ...)
    local setId = setthreadidentity or set_thread_identity or setidentity
        or (syn and syn.set_thread_identity)
    local getId = getthreadidentity or get_thread_identity or getidentity
        or (syn and syn.get_thread_identity)
    if type(setId) ~= "function" then return pcall(fn, ...) end
    local old = type(getId) == "function" and select(2, pcall(getId)) or nil
    pcall(setId, 2)
    local res = table.pack(pcall(fn, ...))
    if type(old) == "number" then pcall(setId, old) end
    return table.unpack(res, 1, res.n)
end

local function breakOnce(tile, gen)
    if dropPause or guardPaused then return "paused" end
    local layer, before = breakLayerAt(tile.x,tile.y)
    if not layer then
        breakDiagnostic(tile, "not_breakable")
        return "empty"
    end
    if not breakWithinRange(tile.x,tile.y) then
        breakDiagnostic(tile, "out_of_range")
        return "out_of_range"
    end
    if not breakPunch then return "no_punch" end

    -- k.lua waits 0.32 seconds after placement: early punches may be ignored.
    local placed = env.Fian792PlaceAt
    if type(placed) == "table" then
        local at = placed[tostring(tile.x)..","..tostring(tile.y)]
        if type(at) == "number" then
            local remaining = 0.34 - (os.clock() - at)
            if remaining > 0 then task.wait(remaining) end
        end
    end
    if not breakAlive(gen) or dropPause then return "stopped" end
    -- Do not punch a stale world coordinate after the player moves.
    if not setBreakAnchor() or not breakAnchor
        or not breakSelected[tostring(tile.x - breakAnchor.x)
            .. "," .. tostring(tile.y - breakAnchor.y)]
        or not breakWithinRange(tile.x, tile.y) then
        return "moved"
    end

    breakPunchCalls += 1
    local callNumber = breakPunchCalls
    if callNumber <= 20 or callNumber % 10 == 0 then
        print("[BREAK HIT]", callNumber, "tile",tile.x,tile.y,
              "layer",layer,"id",before,"punch",tostring(breakPunch))
    end
    if dropPause or guardPaused then return "paused" end
    -- Try the verified renderer swing first. This game build did not
    -- expose its arm-action upvalue, so fall back to native local FX.
    if not Anim.fn then findArm() end
    local armPlayed=swing(tile.x,tile.y)
    if not armPlayed then fallbackActionFX(tile.x,tile.y,"Break") end
    -- Native hit signature is (x,y,mute,extra). With mute=false,
    -- let the game's own hit audio/visual pathway run when supported.
    -- This is still the SINGLE authoritative break call.
    local ok, result
    if punchAsGame then
        ok, result = callAsGame(breakPunch, tile.x, tile.y, false, nil)
    else
        ok, result = pcall(breakPunch, tile.x, tile.y, false, nil)
        if not ok and tostring(result):find("Cannot require", 1, true) then
            ok, result = callAsGame(breakPunch, tile.x, tile.y, false, nil)
            if ok then
                punchAsGame = true
                env.Fian792PunchAsGame = true
                print("[AUTO BREAK] punch needs game identity (Potassium) -> enabled")
            end
        end
    end
    if not ok then
        warn("[AUTO BREAK PUNCH ERROR]", result)
        return "error"
    end
    local deadline = os.clock() + math.min(0.26, math.max(0.08, breakSpeed / 1000 - 0.02))
    while breakAlive(gen) and os.clock() < deadline do
        local after = tileAt(layer, tile.x, tile.y)
        if after ~= before then
            print("[BREAK TILE CHANGE]", tile.x,tile.y,layer,
                  tostring(before),"->",tostring(after),
                  "result",tostring(result))
            -- A change to another nonzero ID can also be another script
            -- placing a new block; do not count that as a confirmed break.
            return after == 0 and "broke" or "changed"
        end
        task.wait(0.025)
    end
    if callNumber <= 20 or callNumber % 10 == 0 then
        print("[BREAK NO CHANGE]",callNumber,"tile",tile.x,tile.y,
              "layer",layer,"id",before,"return",tostring(result))
    end
    return "hit"
end

local function startBreak()
    if breakRunning then return end
    local tiles = breakList()
    if #tiles == 0 then
        breakStatusText("Pilih grid Auto Break dahulu")
        breakResetToggle()
        return
    end
    breakPunch, breakCandidateCount = detectNativePunch()
    print("[BREAK PUNCH DETECTION] candidates",breakCandidateCount,
          "selected",breakPunch ~= nil)
    if not breakPunch then
        breakStatusText("Native punch belum ditemukan ("..breakCandidateCount.." kandidat)")
        warn("[AUTO BREAK] Native hit function belum teridentifikasi secara unik")
        breakResetToggle()
        return
    end
    breakRunning = true
    do
        local s=getState()
        local name=type(rawget(world,"name"))=="string" and rawget(world,"name") or ""
        if s and name~="" then
            env.Fian792PNBHome={x=math.floor(s.x),y=math.floor(s.y-0.475),world=name}
            print("[CH RETURN] PNB home saved",name,env.Fian792PNBHome.x,env.Fian792PNBHome.y)
        end
    end
    if running then setPNBPhase("PLACE", "Auto Break enabled alongside Place") end
    env.Fian792BreakGeneration += 1
    local gen = env.Fian792BreakGeneration
    breakGui.Enabled = false
    breakStatusText("ON | "..#tiles.." tile | "..breakMode.." | "..breakSpeed.."ms")

    task.spawn(function()
        local idx = 1
        local failures = {}
        local lastBreak = {}
        local reason = "Stop"
        local ok, err = pcall(function()
            while breakAlive(gen) do
                if dropPause or guardPaused then
                    task.wait(0.07)
                    continue
                end
                -- Recompute absolute break tiles each pass, while preserving
                -- the user's selected relative offsets and active toggle.
                local oldX = breakAnchor and breakAnchor.x
                local oldY = breakAnchor and breakAnchor.y
                local oldWorld = breakAnchorWorld
                tiles = breakList()
                if breakAnchor and (oldX ~= breakAnchor.x
                    or oldY ~= breakAnchor.y or oldWorld ~= breakAnchorWorld) then
                    idx = 1
                    failures = {}
                    lastBreak = {}
                    breakStatusText("ON | Mengikuti karakter: "
                        .. breakAnchor.x .. "," .. breakAnchor.y)
                end
                if #tiles == 0 then
                    task.wait(0.1)
                elseif running and pnbPhase == "PLACE" then
                    -- Place is working. Do not punch newly placed tiles early.
                    task.wait(0.08)
                else
                local available = {}
                for _, tile in ipairs(tiles) do
                    if breakLayerAt(tile.x,tile.y) then
                        table.insert(available,tile)
                    end
                end
                if #available == 0 then
                    if running then
                        setPNBPhase("PLACE", "all Break grid tiles empty")
                    end
                    for _, tile in ipairs(tiles) do
                        breakDiagnostic(tile, "no_eligible_layer")
                    end
                    task.wait(0.15) -- may be re-planted by Auto Place
                else
                    if idx > #tiles then idx = 1 end
                    local tile = tiles[idx]
                    local k = tostring(tile.x)..","..tostring(tile.y)
                    local layer = breakLayerAt(tile.x,tile.y)
                    if not layer then
                        breakDiagnostic(tile, "not_breakable")
                        idx = idx % #tiles + 1
                    elseif not breakWithinRange(tile.x,tile.y) then
                        if not failures[k] or os.clock() - failures[k] > 2 then
                            print("[AUTO BREAK] out of range", k)
                            failures[k] = os.clock()
                        end
                        idx = idx % #tiles + 1
                        task.wait(0.1)
                    else
                        local t0 = os.clock()
                        local outcome = breakOnce(tile, gen)
                        if outcome == "broke" then
                            lastBreak[k] = os.clock()
                            -- The two UI sliders describe minimum intervals,
                            -- not two sequential waits added together.
                            print("[AUTO BREAK BROKE]", k)
                        elseif outcome == "changed" then
                            print("[BREAK UPDATED BY OTHER ACTION]",k)
                        elseif outcome == "error" or outcome == "no_punch" then
                            reason = outcome
                            breakStop()
                            break
                        end
                        local remaining = breakLayerAt(tile.x,tile.y)
                        if breakMode == "Bergantian" or not remaining then
                            idx = idx % #tiles + 1
                        end
                        local targetDelay = breakSpeed/1000
                        if outcome == "broke" then
                            targetDelay = math.max(targetDelay, breakAfter/1000)
                        end
                        local rest = targetDelay - (os.clock() - t0)
                        if rest > 0 then task.wait(rest) end
                    end
                end
                end -- gated BREAK phase
            end
        end)
        if not ok then reason = "Error: "..tostring(err); warn(reason) end
        if env.Fian792BreakGeneration == gen then breakRunning = false end
        breakStatusText("OFF | "..reason)
        breakResetToggle()
    end)
end

