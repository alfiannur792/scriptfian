            edge=direction>0 and plantSweep.hi or plantSweep.lo
        elseif phase=="harvest" and harvestOn then
            -- Restore the conservative forward-only harvest sweep.
            -- The 20-tile bidirectional corridor in v1.0.75 repeatedly
            -- reversed toward old targets, creating stop/go oscillation.
            -- Harvest sweep remains on the locked target's side, but
            -- continues until the actual end of a safe corridor. A fixed
            -- 24-tile limit forced touchRelease + full restart at X25/49/73.
            local target=orderedHarvestTarget()
            if not target or target.y~=y then return false end
            direction=target.x==x and preferredDir
                or (target.x>x and 1 or -1)
