    local function bottomPoint()
        local s=getState()
        if not s or not s.grounded then return nil end
        local floorY=math.floor(s.y+0.01)
        if floorY<1 or floorY>=world.h-1 then return nil end
        return {world=tostring(rawget(world,"name") or ""),
            x=math.floor(s.x),y=floorY}
    end
    local function stopBuilder(reason)
        if builder.active and builder.progressSave then pcall(builder.progressSave,true) end
        builder.rev+=1
        builder.active=false
        if builder.toggle then
            builder.syncing=true
            pcall(function() builder.toggle:Set(false) end)
            builder.syncing=false
        end
        local nav=env.Fian792WorldBuilderNav
        if nav and type(nav.cancel)=="function" then pcall(nav.cancel) end
        print("[WORLD BUILDER]",tostring(reason),"placed",builder.placed,
            "existing",builder.existing,"deferred",builder.deferred,
            "blocked",builder.blocked)
        tell("Builder OFF | "..tostring(reason).." | placed "..
            builder.placed.." | existing "..builder.existing..
            " | deferred "..builder.deferred.." | blocked "..builder.blocked)
    end
    env.Fian792WorldBuilder={
        stop=stopBuilder,running=function() return builder.active end
    }
    local function builderWalkable(x,y)
        if x<0 or x>=world.w or y<1 or y>=world.h-1 then return false end
        local id=tileAt("fg",x,y)
        local item=id and db[id]
        if type(item)=="table" and item.solid==true
            and item.platform~=true and item.kind~="seed" then return false end
        local below=db[tileAt("fg",x,y+1) or 0]
        return type(below)=="table"
            and (below.solid==true or below.platform==true)
            and not below.deadly and not below.hurts and not below.laser
    end
    local function builderRun()
        if builder.active or active or occupied() then
            tell("Builder WAIT | matikan Auto Farm / Rotation / Drop / World Action dahulu")
            return
        end
        if not chosen or countItem(chosen)<=0 then
            tell("Builder memerlukan material Dirt / Platform di inventory")
            return
        end
        local nav=env.Fian792WorldBuilderNav
        if not nav or type(nav.walk)~="function" then
            tell("Shared Safe Walk belum tersedia")
            return
        end
        local state=getState()
        if not state or not state.grounded then
            tell("Berdiri dulu sebelum Start Builder")
            return
        end
        builder.active=true
        builder.rev+=1
        builder.placed,builder.existing,builder.deferred,builder.blocked,builder.dug=0,0,0,0,0
        local rev=builder.rev
        local originalWorld=world
        local itemId=chosen
        local isDirt=tostring(db[itemId] and db[itemId].name or ""):lower()=="dirt"
        local breakNative=isDirt and detectNativePunch() or nil
        local remembered=builder.bottom
        local point=remembered and remembered.world==
            tostring(rawget(world,"name") or "") and remembered or bottomPoint()
        if not point then
            builder.active=false
            tell("Tidak ada bottom row: berdiri di atas lantai dasar dulu")
            return
        end
        -- GrowBlox Y grows DOWN. Start at the floor directly beneath the
        -- player (not playerY-1), then subtract gap for each higher row.
        local startX=math.clamp(point.x-2,0,world.w-1)
        local bottomY=point.y
        local lastX=math.min(world.w-1,startX+builder.width-1)
        local work={}
        print("[WORLD BUILDER BOTTOM] start",startX,bottomY,
            "| top",bottomY-(builder.rows-1)*builder.gap,
            "| anchor",remembered and "saved" or "current")
        -- Build ordered bottom-up, alternating direction to reduce travel.
        for rowIndex=0,builder.rows-1 do
            local y=bottomY-rowIndex*builder.gap
            if y>=0 and y<world.h-2 then
                local reverse=rowIndex%2==1
                for j=0,lastX-startX do
                    local x=reverse and lastX-j or startX+j
                    -- Alternate stair opening. Do not seal the only vertical
                    -- access at every completed row.
                    local stair=(rowIndex%2==0) and lastX or startX
                    if x~=stair then
                        local id=tileAt("fg",x,y)
                        if id==itemId then
                            builder.existing+=1
                        elseif (id==0 and canBuild(x,y))
                            or (isDirt and breakNative and type(db[id])=="table"
                                and ({dirt=true,rock=true,lava=true})[
                                    tostring(db[id].name or ""):lower()]
                                and not db[id].lock and not db[id].area
                                and not db[id].guildLock and not db[id].vend
                                and not db[id].display and not db[id].deadly
                                and not db[id].hurts and not db[id].laser) then
                            work[#work+1]={x=x,y=y}
                        else
                            builder.blocked+=1
                        end
                    end
                end
            end
        end
        print("[WORLD BUILDER SCAN] item",itemId,"bottom to top",bottomY,
            "->",bottomY-(builder.rows-1)*builder.gap,"| stair gaps alternating",
            "| terrain carve",isDirt and breakNative~=nil,"rows",builder.rows,
            "length",builder.width,"gap",builder.gap,
            "pending",#work,"existing",builder.existing,"blocked",builder.blocked)
        tell("Builder ON | pending "..#work.." | existing "..builder.existing)
        task.spawn(function()
            local ok,err=pcall(function()
              -- Pass 1 builds the queue; pass 2 retries tiles deferred in
              -- pass 1 (unreachable stand, nav or placement not confirmed).
              for pass=1,2 do
                local retry={}
                local deferredBefore=builder.deferred
                if pass==2 then
                    if #work==0 then break end
                    print("[WORLD BUILDER] retry pass | tiles",#work)
                    tell("Builder retry | "..#work.." tile tertunda")
                end
                -- `continue` skips the loop tail, so the previous tile's
                -- deferral is recorded at the start of the next iteration.
                local lastTile,lastDeferred=nil,builder.deferred
                for index,tile in ipairs(work) do
                    if lastTile and builder.deferred>lastDeferred then
                        retry[#retry+1]=lastTile
                    end
                    lastTile,lastDeferred=tile,builder.deferred
                    -- Universal Return pauses Builder without abandoning the
                    -- ordered build queue; manual Stop still cancels it.
                    while builder.active and builder.rev==rev
                        and (guardPaused or dropPause) do
                        task.wait(0.35)
                    end
                    if not builder.active or builder.rev~=rev
                        or world~=originalWorld then break end
                    if running or breakRunning or
                        (env.Fian792FarmRuntime and
                        env.Fian792FarmRuntime.running()) then
                        stopBuilder("other automation started");break
                    end
                    if tileAt("fg",tile.x,tile.y)==itemId then
                        builder.existing+=1
                        continue
                    end
                    local current=tileAt("fg",tile.x,tile.y)
                    local meta=db[current]
                    local carve=isDirt and breakNative and type(meta)=="table"
                        and ({dirt=true,rock=true,lava=true})[
                            tostring(meta.name or ""):lower()]
                        and not meta.lock and not meta.area and not meta.guildLock
                        and not meta.vend and not meta.display and not meta.deadly
                        and not meta.hurts and not meta.laser
                    if current~=0 and not carve then
                        builder.blocked+=1;continue
                    end
                    if current==0 and not canBuild(tile.x,tile.y) then
                        builder.blocked+=1;continue
                    end
                    if countItem(itemId)<=0 then
                        stopBuilder("material exhausted");break
                    end
                    local body=getState()
                    if not body then builder.deferred+=1;continue end
                    if not inRange(body,tile.x,tile.y) then
                        -- Prefer standing on the same row as target or one
                        -- row lower. A real support must exist at that tile.
                        local targetStand=nil
                        -- Stand anywhere within reach: on the row being
                        -- built (dy -1/0) down to the previous floor
                        -- (dy = gap-1). Only dy 0..1 used to be searched, so
                        -- with gap >= 3 upper rows found no stand at all.
                        for dy=-1,math.max(1,builder.gap-1) do
                            for dx=-2,2 do
                                local sx,sy=tile.x+dx,tile.y+dy
                                local cx,cy=(tile.x+0.5)-(sx+0.5),(tile.y+0.5)-(sy+0.5)
                                if cx*cx+cy*cy<=(MAX_RANGE-0.1)^2
                                    and builderWalkable(sx,sy)
                                    and canBuild(sx,sy) then
                                    local delta=(sx+0.5-body.x)^2
                                        +(sy+0.5-(body.y-0.475))^2
                                    if not targetStand or delta<targetStand.d then
                                        targetStand={x=sx,y=sy,d=delta}
                                    end
                                end
                            end
                        end
                        if not targetStand then
                            builder.deferred+=1
                            if builder.deferred<=5 then
                                print("[WORLD BUILDER DEFER] no safe stand",tile.x,tile.y)
                            end
                            continue
                        end
                        local reached,reason=false,"no navigator"
                        local farmRt=env.Fian792FarmRuntime
                        if type(farmRt)=="table" and type(farmRt.directTest)=="function" then
                            local okD,r1,r2=pcall(farmRt.directTest,targetStand.x,targetStand.y)
                            reached,reason=okD and r1==true,okD and r2 or tostring(r1)
                        end
                        if not reached then
                            reached,reason=nav.walk(targetStand.x,targetStand.y)
                        end
                        if not builder.active or builder.rev~=rev then break end
                        if not reached then
                            builder.deferred+=1
                            if builder.deferred<=5 then
                                print("[WORLD BUILDER DEFER] nav",tile.x,tile.y,reason)
                            end
                            continue
                        end
                        body=getState()
                    end
                    -- Carve only verified, ordinary terrain, never a lock or
                    -- a supporting tile directly under the standing player.
                    if body and carve and inRange(body,tile.x,tile.y)
                        and not (math.floor(body.x)==tile.x
                            and math.floor(body.y+0.01)==tile.y) then
                        local hits=0
                        while builder.active and builder.rev==rev and hits<24
                            and not guardPaused and not dropPause
                            and tileAt("fg",tile.x,tile.y)==current do
                            local okHit=pcall(breakNative,tile.x,tile.y,true,nil)
                            if not okHit then break end
                            hits+=1
                            task.wait(0.20)
                        end
                        if tileAt("fg",tile.x,tile.y)==0 then
                            builder.dug+=1
                        end
                        body=getState()
                    end
                    if body and inRange(body,tile.x,tile.y)
                        and tileAt("fg",tile.x,tile.y)==0
                        and canBuild(tile.x,tile.y) then
                        local didPlace=false
                        for attempt=1,2 do
                            if not builder.active or builder.rev~=rev then break end
                            local placedOk,result=pcall(refs.place,"fg",
                                tile.x,tile.y,itemId,false,false)
                            if placedOk and result~=false then
                                task.wait(0.20)
                                if tileAt("fg",tile.x,tile.y)==itemId then
                                    didPlace=true
                                    builder.placed+=1
                                    break
                                end
                            end
                            task.wait(0.20)
                        end
                        if not didPlace then builder.deferred+=1 end
                    else
                        builder.deferred+=1
                    end
                    if os.clock()-builder.progressAt>=2.5 then
                        builder.progressAt=os.clock()
                        tell("Builder "..index.."/"..#work.." | placed "..
                            builder.placed.." | existing "..builder.existing..
                            " | deferred "..builder.deferred)
                    end
                    -- No busy-loop world rescan and no WindUI update per tile.
                    task.wait(0.08)
                end
                if lastTile and builder.deferred>lastDeferred then
                    retry[#retry+1]=lastTile
                end
                if not builder.active or builder.rev~=rev then break end
                if pass==1 then
                    -- Count only final failures in the summary.
                    builder.deferred=deferredBefore
                end
                work=retry
              end
            end)
            if builder.active and builder.rev==rev then
                stopBuilder(ok and "selesai"
                    or ("error: "..tostring(err)))
            end
        end)
    end
    -- Auto Dirt Farm (reference layout): from the row the player stands in,
    -- alternate GAP rows (dug clear, fg + bg) and FLOOR rows (solid; empty
    -- tiles filled with the Farm Material) down to bedrock, full world width.
    -- Each floor has a stair hole at the far end, alternating sides.
    -- Movement follows Clear World: column by column with the shared
    -- navigator, digging/placing everything in reach before each step.
    -- Stored on `builder` (no new local in this scope).
    function builder.dirtRun()
        if builder.active or active or occupied() then
            tell("Dirt Farm WAIT | matikan Auto Farm / Rotation / Drop / World Action dahulu")
            return
        end
        if not chosen then
            tell("Pilih Farm Material dahulu")
            return
        end
        local nav=env.Fian792WorldBuilderNav
        if not nav or type(nav.walk)~="function" then
            tell("Navigator belum tersedia");return
        end
        local punchFn=detectNativePunch()
        if type(punchFn)~="function" then
            tell("Native punch belum ditemukan");return
        end
        local s0=getState()
        if not s0 or s0.dead or not s0.grounded then
            tell("Berdiri di lantai dulu");return
        end
        builder.active=true
        builder.rev+=1
        builder.progressSave=nil
        builder.placed,builder.existing,builder.deferred,builder.blocked,builder.dug=0,0,0,0,0
        local rev=builder.rev
        local itemId=chosen
        local startWorld=refs.worldKey()
        local W=world.w
        local gy=math.floor(s0.y-0.475)
        print("[DIRT FARM] START | material",itemId,"| first gap row",gy,
            "| floor",gy+1,"| width 0 ..",W-1)
        tell("Dirt Farm ON | mulai baris Y"..gy)
        task.spawn(function()
            local ok,err=pcall(function()
                local function live()
                    return builder.active and builder.rev==rev
                        and refs.worldKey()==startWorld
                end
                local function waitPause()
                    while live() and (guardPaused or dropPause) do task.wait(0.3) end
                end
                local function meta(id) return id and id~=0 and db[id] or nil end
                local function diggable(id)
                    local m=meta(id)
                    if not m or m.lock or m.area or m.guildLock or m.vend or m.display then
                        return false
                    end
                    local hits=m.kind=="seed" and 20 or tonumber(m.hits)
                    return hits~=nil and hits>0
                end
                local function solidFloor(id)
                    local m=meta(id)
                    return m~=nil and m.solid==true and m.kind~="seed"
                        and not m.deadly and not m.hurts and not m.laser
                end
                local function here()
                    local b=getState()
                    if not b or b.dead then return nil end
                    return math.floor(b.x),math.floor(b.y-0.475),b
                end
                local function reach(x,y)
                    local b=getState()
                    return b~=nil and inRange(b,x,y)
                end
                local function hit(x,y,layer)
                    local before=tileAt(layer,x,y)
                    if not before or before==0 then return true end
                    local n,changedAt=0,nil
                    local deadline=os.clock()+10
                    while live() and os.clock()<deadline do
                        waitPause()
                        if not live() then return false end
                        local current=tileAt(layer,x,y)
                        if current~=nil and current~=before then
                            changedAt=changedAt or os.clock()
                            -- A local prediction can briefly disappear then roll back.
                            -- Hold all further hits until the change stays visible.
                            if os.clock()-changedAt>=builder.breakConfirmMs/1000 then
                                builder.dug+=1
                                return true
                            end
                            task.wait(0.05)
                        else
                            changedAt=nil
                            if n>=30 or not reach(x,y) then return false end
                            local okHit=pcall(punchFn,x,y,true,nil)
                            if not okHit then return false end
                            n+=1
                            task.wait(builder.breakIntervalMs/1000)
                        end
                    end
                    return false
                end
                -- Walk-through objects (Main Door, signs, ...) that cannot
                -- be punched are kept: they don't block the gap row.
                local function passable(id)
                    if not id or id==0 then return true end
                    local m=meta(id)
                    return m~=nil and m.solid~=true and m.kind~="seed"
                        and not m.deadly and not m.hurts and not m.laser
                end
                builder.keptTiles={}
                local function clearGap(x,y)
                    if x<0 or x>=W then return false end
                    local id=tileAt("fg",x,y)
                    if id and id~=0 then
                        if not diggable(id) then
                            if passable(id) then
                                local key=x..","..y
                                if not builder.keptTiles[key] then
                                    builder.keptTiles[key]=true
                                    print("[DIRT FARM] keep walk-through",x,y,
                                        "|",tostring(meta(id) and meta(id).name or id))
                                end
                                return true
                            end
                            builder.blocked+=1
                            return false
                        end
                        if not hit(x,y,"fg") then return false end
                    end
                    local bg=tileAt("bg",x,y)
                    if bg and bg~=0 and diggable(bg) and not hit(x,y,"bg") then return false end
                    return passable(tileAt("fg",x,y))
                end

                builder.ensureMaterial=function(floorY,force)
                    if not force and countItem(itemId)>0 and not (builder.progress and builder.progress.production) then return true end
                    if force and countItem(itemId)>=200 then
                        return false,"Place gagal tetapi inventory terbaca penuh; perlu verifikasi stok material"
                    end
                    local farm=env.Fian792FarmRuntime
                    if not farm or type(farm.produceMaterial)~="function" then
                        return false,"Mesin produksi material belum tersedia"
                    end
                    local function baseName(item)
                        return tostring(item and item.name or ""):lower()
                            :gsub("%s+seeds?$",""):gsub("%s+blocks?$",""):gsub("[^%w]","")
                    end
                    local seed=itemId+1
                    if not db[seed] or db[seed].kind~="seed"
                        or baseName(db[seed])~=baseName(db[itemId]) then
                        return false,"Seed pasangan material belum ditemukan"
                    end
                    local record=builder.progress and builder.progress.production
                    if not record then
                        local x,y=here()
                        if not x then return false,"Posisi produksi tidak tersedia" end
                        local needed=1
                        if builder.dirtRows then
                            for _,fy in ipairs(builder.dirtRows) do
                                if fy==floorY then
                                    needed=0
                                    for cx=0,W-1 do
                                        if not (builder.dirtHole and builder.dirtHole(cx,fy))
                                            and not solidFloor(tileAt("fg",cx,fy)) then needed+=1 end
                                    end
                                    break
                                end
                            end
                        end
                        record={home={x=x,y=y},floorY=floorY,row=builder.progress and builder.progress.materialRow,
                            cycle=builder.progress and builder.progress.materialCycle,
                            target=math.clamp(needed+(force and countItem(itemId) or 0),1,200)}
                        if not builder.progress then
                            builder.progress={version=2,world=tostring(startWorld),w=W,h=world.h,
                                material=itemId,top=builder.dirtTop,stairPhase=builder.dirtPhase,buildStyle="ceiling-1",
                                row=(y-builder.dirtTop)/2,left=x<=W-1-x,phase="down",entered=false}
                            env.Fian792DirtProgress[startWorld]=builder.progress
                        end
                        builder.progress.production=record
                    end
                    local function saveProduction()
                        if builder.progressSave then
                            builder.progressSave(true)
                        elseif builder.saveTemplate and builder.template then
                            builder.template.progress=builder.progress
                            builder.saveTemplate(builder.progress.left)
                        end
                    end
                    saveProduction()
                    tell("Dirt Farm PRODUKSI | lantai Y"..record.floorY..
                        " | ambil drop -> seed 50 -> tanam stok tas, cadangan 10")
                    local untilFree=os.clock()+2
                    while env.Fian792DirtProduction and not env.Fian792DirtProduction.live()
                        and live() and os.clock()<untilFree do task.wait(0.05) end
                    if not live() then return false,"stopped" end
                    local success,why=farm.produceMaterial({
                        material=itemId,seedId=seed,target=record.target,row=record.row,cycle=record.cycle,force=force,
                        setCycle=function(cycle,force)
                            record.cycle=cycle
                            if force then saveProduction() elseif builder.progressSave then builder.progressSave(false) end
                        end,
                        punch=punchFn,live=live,wait=waitPause,status=tell,
                        setRow=function(y)
                            record.row=y
                            saveProduction()
                        end})
                    if not success then return false,why end
                    waitPause()
                    if not live() then return false,"stopped" end
                    local returned,reason=nav.walk(record.home.x,record.home.y,true)
                    if not returned then return false,"Produksi selesai; belum kembali: "..tostring(reason) end
                    if builder.progress then
                        builder.progress.materialRow=record.row
                        builder.progress.materialCycle=record.cycle
                        builder.progress.production=nil
                    end
                    saveProduction()
                    tell("Dirt Farm LANJUT PASANG | Y"..record.floorY..
                        " | stock "..countItem(itemId))
                    return countItem(itemId)>0,"Produksi belum menambah block"
                end
                local function makeFloor(x,y,allowProduction)
                    if x<0 or x>=W then return false end
                    if builder.dirtHole and builder.dirtHole(x,y) then
                        return false,"lubang tangga dipertahankan"
                    end
                    local id=tileAt("fg",x,y)
                    if id==nil then return false end
                    if id~=0 and solidFloor(id) then return true end
                    if id~=0 then
                        if not diggable(id) then builder.blocked+=1;return false end
                        hit(x,y,"fg")
                        if (tileAt("fg",x,y) or 0)~=0 then return false end
                    end
                    if not canBuild(x,y) then builder.blocked+=1;return false end
                    if countItem(itemId)<=0 then
                        if allowProduction==false then return false,"empty" end
                        local stocked,why=builder.ensureMaterial(y)
                        if not stocked then return false,why end
                        if not live() then return false,"stopped" end
                        id=tileAt("fg",x,y)
                        if id~=0 then return solidFloor(id),"Tile target berubah saat produksi" end
                        if not canBuild(x,y) then return false,"Tile tidak dapat dipasang setelah produksi" end
                    end
                    -- v1.0.131: while sweeping a row, place WITHOUT waiting
                    -- for confirmation (no standing still); the row end
                    -- re-checks every tile and repairs what did not land.
                    if builder.fastPlace and countItem(itemId)-(builder.fastSent or 0)>0 then
                        builder.fastPending=builder.fastPending or {}
                        if not builder.fastStart then builder.fastStart={id=itemId,count=countItem(itemId)} end
                        pcall(refs.place,"fg",x,y,itemId,false,false)
                        if not builder.fastPending[y*W+x] then builder.fastSent=(builder.fastSent or 0)+1 end
                        builder.fastPending[y*W+x]={x=x,y=y,id=itemId}
                        return true
                    end
                    for supplyAttempt=1,(allowProduction==false and 1 or 2) do
                            for attempt=1,(allowProduction==false and 1 or 3) do
                            if not live() then return false end
                            local before=countItem(itemId)
                            pcall(refs.place,"fg",x,y,itemId,false,false)
                            task.wait(0.22)
                            if tileAt("fg",x,y)==itemId then
                                -- Native place may update FG without consuming the bag.
                                -- Debit once for this confirmed placement only.
                                if countItem(itemId)==before then
                                    local bag=getGameInventory()
                                    if not bag or type(bag.remove)~="function" then
                                        return false,"Inventory material tidak dapat disinkronkan"
                                    end
                                    local removed=pcall(function() bag:remove(itemId,1) end)
                                    if not removed then return false,"Pengurangan material gagal" end
                                    refreshInventoryGui(bag)
                                end
                                builder.placed+=1
                                return true
                            end
                    end
                        if allowProduction~=false and supplyAttempt==1 then
                            if not reach(x,y) then return false,"Target place di luar jangkauan" end
                            getGameInventory(true)
                            print("[DIRT FARM] PLACE UNCONFIRMED | X",x,"Y",y,
                                "| stock hint",countItem(itemId),"| refresh + production retry")
                            local supplied,why=builder.ensureMaterial(y,true)
                            if not supplied then return false,why end
                            if not live() then return false,"stopped" end
                            local current=tileAt("fg",x,y)
                            if current~=0 then return solidFloor(current),"Tile berubah saat produksi" end
                            if not canBuild(x,y) then return false,"Tile tidak dapat dipasang setelah produksi" end
                        end
                    end
                    builder.deferred+=1
                    return false,"place-unconfirmed"
                end
                local function isLava(id)
                    local m=meta(id)
                    return m~=nil and tostring(m.name or ""):lower()=="lava"
                end
                -- Lava first (like Clear World): break every Lava tile in
                -- reach around the player before any dig/place/step.
                -- Returns true when Lava still remains in reach.
                local function lavaFirst()
                    local px,py=here()
                    if not px then return false end
                    local left=false
                    for dy=-1,2 do
                        for dx=-2,2 do
                            local x,y=px+dx,py+dy
                            if x>=0 and x<W and y>=0 and y<world.h
                                and isLava(tileAt("fg",x,y)) then
                                if reach(x,y) and diggable(tileAt("fg",x,y)) then
                                    print("[DIRT FARM LAVA] break",x,y)
                                    hit(x,y,"fg")
                                    -- broken Lava in a floor row leaves a hole:
                                    -- close it with Dirt (not a stair hole)
                                    local g0=builder.dirtTop
                                    if g0 and y>g0 and (y-g0)%2==1
                                        and not (builder.dirtHole and builder.dirtHole(x,y))
                                        and (tileAt("fg",x,y) or 0)==0 then
                                        print("[DIRT FARM LAVA] refill floor",x,y)
                                        makeFloor(x,y)
                                    end
                                end
                                if isLava(tileAt("fg",x,y)) then left=true end
                            end
                        end
                    end
                    return left
                end
                -- Never step into a column with Lava in the body, ceiling or
                -- floor tile.
                local function lavaAt(x,y)
                    return isLava(tileAt("fg",x,y)) or isLava(tileAt("fg",x,y-1))
                        or isLava(tileAt("fg",x,y+1))
                end
                local function hardRow(y)
                    if y>=world.h-1 then return true end
                    local hard=0
                    for x=0,W-1 do
                        local id=tileAt("fg",x,y)
                        if id and id~=0 and solidFloor(id) and not diggable(id) then
                            hard+=1
                        end
                    end
                    return hard*2>W
                end
                local function walk(x,y)
                    waitPause()
                    -- Tiles changed since the last move -> fresh nav map.
                    local fresh=builder.dug+builder.placed~=(builder.navMark or -1)
                    builder.navMark=builder.dug+builder.placed
                    local okW,reached,why=pcall(nav.walk,x,y,fresh)
                    local px,py=here()
                    if px~=x or py~=y then
                        local function nm(id)
                            if id==nil then return "nil" end
                            if id==0 then return "0" end
                            local m=meta(id)
                            return tostring(m and m.name or id)..
                                (m and (" s="..tostring(m.solid).." k="..tostring(m.kind)) or "")
                        end
                        print("[DIRT FARM WALK FAIL]",px,py,"->",x,y,"| ok",okW,
                            "| reached",tostring(reached),"| why",tostring(why),
                            "| fresh",fresh,
                            "| head",nm(tileAt("fg",x,y-1)),
                            "| body",nm(tileAt("fg",x,y)),"bg",nm(tileAt("bg",x,y)),
                            "| floor",nm(tileAt("fg",x,y+1)))
                    end
                    return px==x and py==y, okW and why or tostring(reached)
                end
                -- Sweep the gap row `y` up to column `toX` (inclusive):
                -- prepare 0..1 columns ahead (gap clear + floor solid), step.
                -- Stair holes (n4th landCols pattern, row k from the top):
                -- even k -> columns 0 and W-1 open; odd k -> 1 and W-2 open.
                local gy0=nil
                local function stairHole(x,fy)
                    if not gy0 then return false end
                    local k=(fy-1-gy0)/2
                    if k<0 or k%1~=0 then return false end
                    if (k+(builder.dirtPhase or 0))%2==0 then return x==0 or x==W-1 end
                    return x==1 or x==W-2
                end
                -- mode "dig": clear the gap row; place a floor ONLY as a
                -- bridge where the next step has no floor.
                -- mode "place": fill every missing floor (not stair holes).
                builder.dirtHole=stairHole
                local function sweep(y,toX,mode)
                    mode=mode or "dig"
                    local fy=y+1
                    local fails=0
                    while live() do
                        waitPause()
                        local px,py=here()
                        if not px then return false,"karakter tidak tersedia" end
                        if py~=y then return false,"keluar dari baris Y"..y.." (sekarang Y"..py..")" end
                        local d=(toX>px and 1) or (toX<px and -1) or 0
                        if builder.progress then
                            builder.progress.targetX=toX
                            if builder.progressSave then builder.progressSave(false) end
                        end
                        lavaFirst()
                        local tr=mode=="triple" and builder.triple
                        if tr and tr.place and d~=0 and countItem(itemId)>0
                            and env.Fian792FarmRuntime and env.Fian792FarmRuntime.withBuildSpeed then
                            local function clearForStream(cx)
                                if cx<2 or cx>W-3 or lavaAt(cx,y)
                                    or not passable(tileAt("fg",cx,y))
                                    or not solidFloor(tileAt("fg",cx,y+1)) then return false end
                                if tr.up and (not passable(tileAt("fg",cx,y-2))
                                    or (tileAt("bg",cx,y-2) or 0)~=0) then return false end
                                local roof=tileAt("fg",cx,y-1)
                                return roof~=nil and (roof==0 or solidFloor(roof))
                            end
                            local endpoint=px
                            for cx=px,toX,d do
                                if not clearForStream(cx) then break end
                                endpoint=cx
                                if math.abs(endpoint-px)>=10 then break end
                            end
                            if math.abs(endpoint-px)>=3 then
                                local pending
                                local moved,why=env.Fian792FarmRuntime.withBuildSpeed(function(setSlow)
                                    local function updateSpeed(cx)
                                        local missing=false
                                        for k=0,2 do
                                            local tx=cx+d*k
                                            if (tx-endpoint)*d<=0 and not stairHole(tx,y-1)
                                                and tileAt("fg",tx,y-1)==0 then
                                                missing=true;break
                                            end
                                        end
                                        setSlow(missing)
                                    end
                                    updateSpeed(px)
                                    return nav.walk(endpoint,y,true,function()
                                        if not live() then return false end
                                        local cx,cy=here()
                                        if cy~=y then return false end
                                        updateSpeed(cx)
                                        for k=0,1 do
                                            local tx=cx+d*k
                                            if (tx-endpoint)*d<=0 and not stairHole(tx,y-1)
                                                and tileAt("fg",tx,y-1)==0 then
                                                if not reach(tx,y-1) then return true end
                                                -- This callback never takes over navigation for production.
                                                local built,reason=makeFloor(tx,y-1,false)
                                                if not built then pending={x=tx,y=y-1,why=reason};return false end
                                                break
                                            end
                                        end
                                        return true
                                    end)
                                end)
                                if not live() then return false,"stopped" end
                                if pending then
                                    local built,reason=makeFloor(pending.x,pending.y)
                                    if not built then return false,reason end
                                    continue
                                elseif moved then
                                    continue
                                elseif why~="build speed unavailable" then
                                    return false,why or "jalur pemasangan terhenti"
                                end
                            end
                        end
                        if tr then
                            -- Retry the upper tile from directly underneath it.
                            -- A diagonal upper target may leave reach while walking.
                            if tr.place and not stairHole(px,y-1) then
                                local built,why=makeFloor(px,y-1)
                                if not built then return false,why or "lantai atas belum terpasang" end
                            end
                            if tr.up then
                                local key=px..":"..(y-2)
                                if not clearGap(px,y-2) then
                                    if not walk(px,y) or not clearGap(px,y-2) then
                                        return false,"tile atas belum selesai X"..px.." Y"..(y-2)
                                    end
                                end
                                if builder.pendingUpper then builder.pendingUpper[key]=nil end
                            end
                            -- Collect every tile to dig in reach (Y and Y-2,
                            -- 1 column ahead) and punch them ALTERNATELY:
                            -- one hit each per round until all are gone.
                            local list={}
                            for k=1,1 do
                                local tx=px+d*k
                                if tx<0 or tx>=W or (d~=0 and (tx-toX)*d>0) then break end
                                for _,ry in ipairs(tr.up and {y,y-2} or {y}) do
                                    if not (k==0 and ry==y) and (reach(tx,ry) or (tr.up and ry==y-2)) then
                                        local f,b=tileAt("fg",tx,ry),tileAt("bg",tx,ry)
                                        if (f and f~=0 and diggable(f) and not passable(f))
                                            or (b and b~=0 and diggable(b)) then
                                            list[#list+1]={x=tx,y=ry}
                                        end
                                    end
                                end
                                if d==0 then break end
                            end
                            local function done(t)
                                local f,b=tileAt("fg",t.x,t.y),tileAt("bg",t.x,t.y)
                                local fOk=f~=nil and (f==0 or passable(f) or not diggable(f))
                                local bOk=b~=nil and (b==0 or not diggable(b))
                                return fOk and bOk
                            end
                            for _=1,40 do
                                if not live() then break end
                                waitPause()
                                local any=false
                                for _,t in ipairs(list) do
                                    local cleared=done(t)
                                    if not cleared then
                                        t.ok=false
                                        t.clearAt=nil
                                    end
                                    if not t.ok then
                                        if cleared then
                                            t.clearAt=t.clearAt or os.clock()
                                            if os.clock()-t.clearAt>=builder.breakConfirmMs/1000 then
                                                t.ok=true
                                                builder.dug+=1
                                            else
                                                any=true
                                            end
                                        elseif reach(t.x,t.y) then
                                            any=true
                                            pcall(punchFn,t.x,t.y,true,nil)
                                            task.wait(builder.breakIntervalMs/1000)
                                        end
                                    end
                                end
                                if not any then break end
                                task.wait(0.05)
                            end
                            -- Never move/place on an unconfirmed batch.
                            for _,t in ipairs(list) do
                                if not t.ok or not done(t) then
                                    if tr.up and t.y==y-2 then
                                        builder.pendingUpper=builder.pendingUpper or {}
                                        builder.pendingUpper[t.x..":"..t.y]={x=t.x,y=t.y}
                                    else
                                        return false,"tile depan belum stabil X"..t.x.." Y"..t.y
                                    end
                                elseif builder.pendingUpper then
                                    builder.pendingUpper[t.x..":"..t.y]=nil
                                end
                            end
                            -- floors: close the floor BELOW (no stair hole is
                            -- needed under a finished row); keep the climb
                            -- hole in the floor above.
                            for k=1,1 do
                                local tx=px+d*k
                                if tx<0 or tx>=W or (d~=0 and (tx-toX)*d>0) then break end
                                local buildY=tr.place and y-1 or fy
                                if not stairHole(tx,buildY) and reach(tx,buildY) then
                                    local fixed,w=makeFloor(tx,buildY)
                                    if not fixed then return false,w or ("lantai belum siap X"..tx.." Y"..buildY) end
                                end
                                if d==0 then break end
                            end
                        end
                        for k=0,1 do
                            if tr then break end
                            local tx=px+d*k
                            if tx<0 or tx>=W or (d~=0 and (tx-toX)*d>0) then break end
                            if k>0 and reach(tx,y) then clearGap(tx,y) end
                            local wantFloor
                            if mode=="place" or mode=="triple" then
                                wantFloor=not stairHole(tx,fy)
                            else
                                wantFloor=k==1 and not solidFloor(tileAt("fg",tx,fy))
                            end
                            if wantFloor and reach(tx,fy) then
                                local _,why=makeFloor(tx,fy)
                                if why=="empty" then return false,"empty" end
                            end
                            if d==0 then break end
                        end
                        if d==0 then return true end
                        local nx=px+d
                        if lavaAt(nx,y) then
                            print("[DIRT FARM] lava next to path X",nx,"Y",y)
                            -- Lava next to the path is out of reach or not
                            -- broken yet: wait/retry, do not walk into it.
                            fails+=1
                            task.wait(0.2)
                        elseif passable(tileAt("fg",nx,y))
                            and solidFloor(tileAt("fg",nx,fy)) then
                            -- Columns that need no work are crossed in ONE
                            -- move (up to 12), instead of a navigator call per
                            -- column: no stop-go on prepared/natural floor.
                            local function ready(cx)
                                if cx<0 or cx>=W or lavaAt(cx,y) then return false end
                                if not passable(tileAt("fg",cx,y)) then return false end
                                if not solidFloor(tileAt("fg",cx,fy)) then return false end
                                if tr and tr.place and not stairHole(cx,y-1)
                                    and not solidFloor(tileAt("fg",cx,y-1)) then return false end
                                if tr and tr.up then
                                    local upper=tileAt("fg",cx,y-2)
                                    local upperBg=tileAt("bg",cx,y-2)
                                    if upper==nil or not passable(upper) or upperBg==nil
                                        or (upperBg~=0 and diggable(upperBg)) then return false end
                                end
                                local bg=tileAt("bg",cx,y)
                                return bg~=nil and (bg==0 or not diggable(bg))
                            end
                            local target=nx
                            -- Single-row passes can cross an entire prepared run.
                            if ready(nx) and (not tr or not tr.down) then
                                for step=2,12 do
                                    local cx=px+d*step
                                    if (cx-toX)*d>0 or not ready(cx) then break end
                                    -- keep 1 column of look-ahead work in reach:
                                    -- stop before an unprepared column
                                    if not ready(cx+d) and (cx+d-toX)*d<=0 then
                                        target=cx;break
                                    end
                                    target=cx
                                end
                            end
                            local reached=walk(target,y)
                            if not reached then
                                local qx,qy=here()
                                reached=qy==y and qx~=px
                            end
                            if reached then fails=0 else fails+=1 end
                        else
                            fails+=1
                            task.wait(0.15)
                        end
                        if fails>=8 then
                            local gapId,floorId=tileAt("fg",nx,y),tileAt("fg",nx,fy)
                            local function nm(id)
                                return id==0 and "kosong" or tostring(meta(id) and meta(id).name or id)
                            end
                            return false,"tertahan di X"..nx.." Y"..y..
                                " | celah: "..nm(gapId).." | lantai: "..nm(floorId)
                        end
                        if os.clock()-builder.progressAt>=2.5 then
                            builder.progressAt=os.clock()
                            tell("Dirt Farm Y"..y.." X"..px.." | placed "..builder.placed..
                                " | dug "..builder.dug.." | Dirt "..countItem(itemId))
                        end
                    end
                    return false,"berhenti"
                end
                local function finish(msg)
                    if not live() then return end
                    print("[DIRT FARM]",msg,"| placed",builder.placed,"dug",builder.dug,
                        "blocked",builder.blocked,"deferred",builder.deferred)
                    stopBuilder(msg)
                end
                -- Plan (like the references): floor rows every 2 tiles from
                -- the start row down to bedrock; dig ALL first, then place
                -- the missing floors from the BOTTOM row up.
                -- Resume: the top row + side of a farm started earlier in this
                -- world are remembered; starting lower inside it continues
                -- that farm instead of making a new, smaller one.
                local tops=env.Fian792DirtTop or {}
                env.Fian792DirtTop=tops
                -- Load the compact geometry template for this world.
                builder.templateFile="Fian792/dirt_template_"..
                    tostring(startWorld):gsub(".",function(c) return string.format("%02x",string.byte(c)) end)..".json"
                builder.savedTemplate=nil
                if type(readfile)=="function" and type(isfile)=="function" then
                    local ok,data=pcall(function()
                        if not isfile(builder.templateFile) then return nil end
                        return game:GetService("HttpService"):JSONDecode(readfile(builder.templateFile))
                    end)
                    if ok and type(data)=="table" and data.schema==1
                        and data.world==tostring(startWorld) and data.w==W and data.h==world.h
                        and type(data.topGap)=="number" and data.topGap>=0 and data.topGap<world.h-1
                        and type(data.phase)=="number" and type(data.left)=="boolean" then
                        builder.savedTemplate=data
                        if not tops[startWorld] then
                            tops[startWorld]={y=data.topGap,left=data.left,phase=data.phase}
                        end
                    end
                end
                env.Fian792DirtProgress=env.Fian792DirtProgress or {}
                builder.progress=env.Fian792DirtProgress[startWorld]
                    or (builder.savedTemplate and builder.savedTemplate.progress)
                if type(builder.progress)=="table" and builder.progress.version==1 then
                    builder.progress.version=2
                    if builder.progress.phase=="sweep" then
                        builder.progress.phase="down"
                        builder.progress.entered=false
                        builder.progress.left=(math.floor(s0.x)<=W-1-math.floor(s0.x))
                        builder.progress.targetX=nil
                        print("[DIRT FARM] MIGRATE | old sweep -> descend to bottom first")
                    end
                end
                if type(builder.progress)~="table" or builder.progress.version~=2
                    or builder.progress.material~=itemId or builder.progress.world~=tostring(startWorld)
                    or builder.progress.w~=W or builder.progress.h~=world.h
                    or type(builder.progress.row)~="number" or builder.progress.row%1~=0
                    or type(builder.progress.top)~="number" or builder.progress.top%1~=0
                    or builder.progress.row<0 or builder.progress.top<0
                    or builder.progress.top+builder.progress.row*2>=world.h-1
                    or (builder.progress.stairPhase~=0 and builder.progress.stairPhase~=1)
                    or type(builder.progress.left)~="boolean"
                    or not ({down=true,place=true,climb=true,paircheck=true})[builder.progress.phase] then
                    builder.progress=nil
                end
                if builder.progress then
                    local p=builder.progress
                    if p.buildStyle~="ceiling-1" then
                        p.buildStyle="ceiling-1"
                        p.entered=false
                        p.targetX=nil
                    end
                    p.paired=false
                    if p.phase=="paircheck" then
                        p.phase="place"
                        p.entered=false
                    end
                    if p.production and p.phase=="place" then
                        p.production.floorY=p.top+p.row*2-1
                    end
                    local expected=p.top+p.row*2
                    local actual=math.floor(s0.y-0.475)
                    local transitional=(p.phase=="down" and (actual==expected+1 or actual==expected+2))
                        or (p.phase=="climb" and (actual==expected-1 or actual==expected-2))
                    if actual~=expected and not transitional and not p.production then
                        local actualRow=(actual-p.top)/2
                        if actualRow>=0 and actualRow%1==0 and actual<world.h-1 then
                            print("[DIRT FARM RESYNC] expected Y",expected,"| actual Y",actual,
                                "| resume row",actualRow)
                            p.row=actualRow
                            p.entered=false
                            p.targetX=nil
                            if p.phase=="climb" then p.phase="place" end
                            p.left=math.floor(s0.x)<=W-1-math.floor(s0.x)
                        else
                            finish("posisi tidak berada pada baris template; berdiri di lantai farm dulu")
                            return
                        end
                    end
                    gy=builder.progress.top+builder.progress.row*2
                    tops[startWorld]={y=builder.progress.top,left=builder.progress.left,phase=builder.progress.stairPhase}
                    print("[DIRT FARM RESUME]",builder.progress.phase,"| row",builder.progress.row,
                        "| direction",builder.progress.left and "RIGHT" or "LEFT",
                        "| target",builder.progress.targetX)
                end
                local saved=tops[startWorld]
                local startIdx,savedLeft=0,nil
                gy0=gy
                builder.dirtTop=nil
                if type(saved)=="table" and saved.y and saved.y<=gy and (gy-saved.y)%2==0 then
                    gy0=saved.y
                    startIdx=(gy-saved.y)/2
                    savedLeft=saved.left
                    print("[DIRT FARM] RESUME | farm top Y",gy0,"| now row",startIdx,
                        "| side",savedLeft and "LEFT" or "RIGHT")
                end
                -- Extend upward while preserving the existing two-tile grid.
                builder.dirtPhase=type(saved)=="table" and (tonumber(saved.phase) or 0) or 0
                local requestedGap=math.min(gy0,math.max(0,builder.topFloorY-1))
                -- v1.0.149: round UP (toward the sky), not down. Slider Y2 on an
                -- odd floor pattern gave top floor Y3 -> one row missing at the
                -- top. Now it becomes Y1 (gap Y0) when that row exists.
                if (gy0-requestedGap)%2~=0 then
                    if requestedGap>0 then requestedGap-=1 else requestedGap+=1 end
                end
                builder.dirtPhase=(builder.dirtPhase+(gy0-requestedGap)/2)%2
                gy0=requestedGap
                startIdx=(gy-gy0)/2
                if builder.progress and (builder.progress.top~=gy0
                    or builder.progress.stairPhase~=builder.dirtPhase) then
                    finish("batas template berubah; kembalikan pengaturan untuk melanjutkan")
                    return
                end
                builder.dirtTop=gy0
                print("[DIRT FARM] FULL HEIGHT | top floor",gy0+1,
                    "| current gap",gy,"| stair phase",builder.dirtPhase)
                do
                    local rows,need={},0
                    local y=gy0+1
                    while y<world.h-1 do
                        -- Check the walking gap BEFORE accepting its floor.
                        -- A hard floor itself is retained as the final row.
                        if hardRow(y-1) then
                            print("[DIRT FARM] PLAN BOTTOM | blocked gap Y",y-1,
                                "| last floor",rows[#rows])
                            break
                        end
                        rows[#rows+1]=y
                        for x=0,W-1 do
                            if not stairHole(x,y) and not solidFloor(tileAt("fg",x,y)) then
                                need+=1
                            end
                        end
                        if hardRow(y) or y+2>=world.h-1 then break end
                        y+=2
                    end
                    -- Reuse the saved geometry only when its bounds/phase match.
                    local template=builder.savedTemplate
                    if template and template.topGap==gy0 and template.phase==builder.dirtPhase
                        and type(template.floors)=="table" and #template.floors>0 then
                        local valid=true
                        for j,fy in ipairs(template.floors) do
                            if type(fy)~="number" or fy%1~=0 or fy<1 or fy>=world.h-1
                                or fy~=gy0+1+(j-1)*2 then valid=false;break end
                        end
                        if valid then
                            rows=template.floors
                            need=0
                            for _,fy in ipairs(rows) do
                                for x=0,W-1 do
                                    if not stairHole(x,fy) and not solidFloor(tileAt("fg",x,fy)) then need+=1 end
                                end
                            end
                            print("[DIRT TEMPLATE] LOADED | floors",#rows)
                        end
                    end
                    builder.dirtNeed=need
                    builder.dirtRows=rows
                    if #rows==0 or startIdx>=#rows then
                        finish("tidak ada baris aman di atas batas bawah")
                        return
                    end
                    print("[DIRT FARM] PLAN | floors",#rows,"| Y",rows[1],"..",rows[#rows],
                        "| Dirt needed ~",need,"| have",countItem(itemId))
                    tell("Dirt Farm: "..#rows.." lantai | butuh ~"..need..
                        " Dirt | punya "..countItem(itemId))
                end
                -- The template describes every floor, walking gap and stair hole.
                -- Existing safe solid floors are accepted; material is used for repairs.
                builder.template={schema=1,world=tostring(startWorld),w=W,h=world.h,
                    topGap=gy0,phase=builder.dirtPhase,left=savedLeft,
                    floors=builder.dirtRows,material=itemId}
                builder.auditTemplate=function(floorY)
                    local missing,blocked=0,0
                    for _,fy in ipairs(builder.dirtRows) do
                        if not floorY or fy==floorY then
                            for x=0,W-1 do
                                local f=tileAt("fg",x,fy)
                                local gap=tileAt("fg",x,fy-1)
                                local bg=tileAt("bg",x,fy-1)
                                if stairHole(x,fy) then
                                    if f~=0 then
                                        missing+=1
                                        if f and not diggable(f) then blocked+=1 end
                                    end
                                elseif not solidFloor(f) then missing+=1 end
                                if gap==nil or not passable(gap) then
                                    missing+=1
                                    if gap and not diggable(gap) then blocked+=1 end
                                end
                                if bg==nil or (bg~=0 and diggable(bg)) then missing+=1 end
                            end
                        end
                    end
                    return missing,blocked
                end
                builder.saveTemplate=function(left)
                    builder.template.left=left
                    if type(writefile)~="function" then
                        print("[DIRT TEMPLATE] memory only | writefile unavailable")
                        return
                    end
                    local ok,why=pcall(function()
                        if type(makefolder)=="function" then
                            if type(isfolder)~="function" or not isfolder("Fian792") then
                                pcall(makefolder,"Fian792")
                            end
                        end
                        writefile(builder.templateFile,game:GetService("HttpService"):JSONEncode(builder.template))
                    end)
                    print("[DIRT TEMPLATE]",ok and "SAVED" or "SAVE FAILED",ok and builder.templateFile or tostring(why))
                end
                do
                    local missing,blocked=builder.auditTemplate()
                    print("[DIRT TEMPLATE] CHECK | differences",missing,"| protected/unknown",blocked)
                    if missing==0 then
                        builder.progress=nil
                        env.Fian792DirtProgress[startWorld]=nil
                        builder.saveTemplate(savedLeft==nil and true or savedLeft)
                        finish("world sudah sesuai template")
                        return
                    end
                end
                -- Level 0: nearest edge first (inclusive), then the far side.
                local px=here()
                local dir
                local nearLeftSide=true
                if not px then finish("karakter tidak tersedia");return end
                if not builder.progress then
                    local nearLeft=px<=W-1-px
                    -- A fresh start chooses the nearest edge, not the old sweep side.
                    tops[startWorld]={y=gy0,left=nearLeft,phase=builder.dirtPhase}
                    builder.saveTemplate(nearLeft)
                    local nearEdge=nearLeft and 2 or W-3
                    -- Like Clear World: walk STRAIGHT to the edge first (one
                    -- navigator move, no work on the way), then build in ONE
                    -- direction. Only if that walk fails, prepare the way.
                    local okS,why=true,nil
                    -- Scan the world row first: straight walk only if every
                    -- column to the edge has an open gap (or walk-through
                    -- object), a solid floor and no Lava around it.
                    local clearPath,badX,badWhy=true,nil,nil
                    local sd=nearEdge<px and -1 or 1
                    for cx=px+sd,nearEdge,sd do
                        if lavaAt(cx,gy) then badWhy="lava"
                        elseif not passable(tileAt("fg",cx,gy)) then badWhy="blok di celah"
                        elseif not solidFloor(tileAt("fg",cx,gy+1)) then badWhy="lantai bolong"
                        end
                        if badWhy then clearPath,badX=false,cx;break end
                    end
                    if px~=nearEdge and not clearPath then
                        print("[DIRT FARM] edge path X",badX,"Y",gy,"|",badWhy,
                            "-> prepare path while walking")
                        okS,why=sweep(gy,nearEdge)
                    elseif px~=nearEdge then
                        print("[DIRT FARM] go to edge X",nearEdge,"Y",gy,"| path checked OK")
                        local atEdge=walk(nearEdge,gy)
                        if not atEdge then
                            print("[DIRT FARM] edge walk failed -> prepare path")
                            okS,why=sweep(gy,nearEdge)
                        end
                    end
                    if not okS then
                        finish(why=="empty" and "Dirt habis" or ("Dirt Farm berhenti: "..tostring(why)))
                        return
                    end
                    dir=nearLeft and 1 or -1
                    nearLeftSide=nearLeft
                end
                if builder.progress then nearLeftSide=builder.progress.left end
                -- v1.0.78: DOWN FIRST, then work from the BOTTOM up.
                -- 1) Zigzag stair shaft at the start edge straight down.
                -- 2) Bottom-up passes dig Y and Y-2 (at most two gap rows),
                --    preparing two columns per batch; floors stay intact.
                local rows=builder.dirtRows
                local n=#rows
                local side=nearLeftSide and 0 or W-1
                local inward=nearLeftSide and 1 or -1
                local far=W-1-side
                local function stairCol(k) return (k+builder.dirtPhase)%2==0 and side or side+inward end
                local function gapY(j) return rows[j+1]-1 end
                local function fail(msg)
                    finish(msg=="empty" and ("Dirt habis | kurang ~"..
                        math.max(0,builder.dirtNeed-builder.placed))
                        or ("Dirt Farm berhenti: "..tostring(msg)))
                end
                local function landOn(sx,ty)
                    local t0=os.clock()
                    while live() and os.clock()-t0<3 do
                        local b=getState()
                        if b and not b.dead and b.grounded
                            and math.floor(b.y-0.475)>=ty then break end
                        task.wait(0.05)
                    end
                    local _,qy=here()
                    return qy==ty
                end
                -- Reference flow: snake DIG downward, then PLACE upward.
                local function edgeWork(y,left,buildAbove)
                    local edge=left and 0 or W-1
                    local step=left and 1 or -1
                    for j=0,1 do
                        local x=edge+step*j
                        if not reach(x,y) or not clearGap(x,y) then
                            return false,"celah tepi belum bersih X"..x.." Y"..y
                        end
                        local bg=tileAt("bg",x,y)
                        if bg and bg~=0 and diggable(bg) then
                            return false,"background tepi belum bersih X"..x.." Y"..y
                        end
                        local currentFloor=y+1
                        if stairHole(x,currentFloor) and not clearGap(x,currentFloor) then
                            return false,"lubang tangga bawah belum terbuka X"..x
                        end
                        local fy=buildAbove and y-1 or y+1
                        if not reach(x,fy) then return false,"lantai tepi di luar jangkauan" end
                        if stairHole(x,fy) then
                            if not clearGap(x,fy) or (tileAt("fg",x,fy) or 0)~=0 then
                                return false,"lubang tangga belum terbuka X"..x.." Y"..fy
                            end
                        else
                            local fixed,why=makeFloor(x,fy)
                            if not fixed then return false,why or ("lantai tepi belum terpasang X"..x.." Y"..fy) end
                        end
                    end
                    return true
                end

                -- Clear contact hazards around a stair landing before movement.
                local function stairLavaSafe(x,y)
                    for dx=-1,1 do
                        for dy=-1,1 do
                            local tx,ty=x+dx,y+dy
                            if tx>=0 and tx<W and ty>=0 and ty<world.h
                                and isLava(tileAt("fg",tx,ty)) then
                                if not reach(tx,ty) then
                                    return false,"Lava dekat tangga belum terjangkau X"..tx.." Y"..ty
                                end
                                print("[DIRT FARM LAVA] stair break",tx,ty)
                                if not hit(tx,ty,"fg") or isLava(tileAt("fg",tx,ty)) then
                                    return false,"Lava tangga belum pecah X"..tx.." Y"..ty
                                end
                                local k=(ty-1-gy0)/2
                                if k>=0 and k%1==0 and not stairHole(tx,ty) then
                                    local fixed,why=makeFloor(tx,ty)
                                    if not fixed then return false,why or "pijakan bekas Lava belum siap" end
                                end
                            end
                        end
                    end
                    return true
                end
                local function workRow(k,left,placing)
                    local y=gapY(k)
                    local fromX=left and 2 or W-3
                    local toX=left and W-3 or 2
                    if not live() then return false,"stopped" end
                    local qx,qy=here()
                    if qy~=y then return false,"posisi bukan baris Y"..y end
                    if builder.progress and builder.progress.entered and qx>=2 and qx<=W-3 then
                        print("[DIRT FARM] CONTINUE ROW | Y",y,"| X",qx)
                    else
                    -- Distant entry tiles must be approached before range checks.
                    if math.abs(fromX-qx)>2 then
                        local approached=walk(fromX,y)
                        if not live() then return false,"stopped" end
                        if not approached then
                            local prepared,why=sweep(y,fromX,"place")
                            if not prepared then return false,why or "jalur menuju awal baris belum siap" end
                        end
                        qx,qy=here()
                        if not qx or qy~=y or math.abs(fromX-qx)>2 then
                            return false,"belum mendekati awal baris X"..fromX.." Y"..y
                        end
                    end
                    -- Prepare only the nearby entrance and stair column.
                    local entryDir=fromX>=qx and 1 or -1
                    for tx=qx,fromX,entryDir do
                        if not reach(tx,y) or not clearGap(tx,y) then
                            return false,"celah masuk belum siap X"..tx.." Y"..y
                        end
                        if tileAt("fg",tx,y)==nil then
                            return false,"data celah masuk belum tersedia X"..tx
                        end
                    end
                    if not solidFloor(tileAt("fg",fromX,y+1)) then
                        return false,"pijakan masuk belum tersedia; lantai perlu dibangun dari baris bawah"
                    end
                    if not walk(fromX,y) then return false,"gagal masuk lintasan X"..fromX end
                    local ready,reason=edgeWork(y,left,placing)
                    if not ready then return false,reason end
                    builder.progress.entered=true
                    if builder.progressSave then builder.progressSave(true) end
                    end
                    print("[DIRT FARM] PHASE",placing and "PLACE UP" or "DIG DOWN",
                        "| Y",y,"| direction",left and "RIGHT" or "LEFT")
                    -- Include the upper gap at the entry column too.
                    if k>0 and reach(fromX,y-2) and not clearGap(fromX,y-2) then
                        return false,"celah atas awal belum bersih"
                    end
                    builder.triple={up=k>0,down=false,place=placing}
                    builder.fastPlace=placing and env.Fian792DirtFastPlace~=false
                    builder.fastPending={};builder.fastStart=nil;builder.fastSent=0
                    local ok,err=sweep(y,toX,"triple")
                    builder.triple=nil
                    builder.fastPlace=false
                    if not ok then return false,err end
                    -- End of row: verify every fire-and-forget placement and
                    -- the whole floor under the row; repair with the normal
                    -- (confirming) place.
                    if placing then
                        task.wait(0.35)
                        local fix={}
                        for x=0,W-1 do
                            if not stairHole(x,y+1) and not solidFloor(tileAt("fg",x,y+1)) then
                                fix[#fix+1]=x
                            end
                        end
                        local okCount=0
                        for _ in pairs(builder.fastPending) do okCount+=1 end
                        -- v1.0.137: native place updates FG but does not
                        -- consume the bag client-side; the slow path debits
                        -- per tile, fastPlace skipped it. Debit what landed.
                        if builder.fastStart then
                            local fid=builder.fastStart.id
                            local landed=0
                            for _,t in pairs(builder.fastPending) do
                                if tileAt("fg",t.x,t.y)==fid then landed+=1 end
                            end
                            local consumed=math.max(0,builder.fastStart.count-countItem(fid))
                            local debt=landed-consumed
                            if debt>0 then
                                local bag=getGameInventory()
                                if bag and type(bag.remove)=="function" then
                                    for _=1,debt do pcall(function() bag:remove(fid,1) end) end
                                    refreshInventoryGui(bag)
                                end
                            end
                            print("[DIRT FARM] ROW SYNC | landed",landed,"| bag already -",consumed,
                                "| debited",math.max(0,debt),"| left",countItem(fid))
                        end
                        builder.fastStart=nil;builder.fastSent=0
                        print("[DIRT FARM] ROW VERIFY | floor",y+1,"| quick placed",okCount,
                            "| still missing",#fix)
                        local origin=here() or 0
                        table.sort(fix,function(a,b) return math.abs(a-origin)<math.abs(b-origin) end)
                        for _,fx in ipairs(fix) do
                            if not live() then return false,"stopped" end
                            if not solidFloor(tileAt("fg",fx,y+1)) then
                                if not reach(fx,y+1) then walk(fx,y) end
                                local placed,why=makeFloor(fx,y+1)
                                if why=="empty" then return false,"empty" end
                                print("[DIRT FARM] ROW REPAIR | X",fx,"Y",y+1,"|",placed and "ok" or tostring(why))
                            end
                        end
                        builder.fastPending={}
                    end
                    -- Repair any remaining deferred upper tiles before leaving the row.
                    if builder.pendingUpper then
                        local repair={}
                        for key,t in pairs(builder.pendingUpper) do
                            if t.y==y-2 and t.x>=2 and t.x<=W-3 then
                                repair[#repair+1]={key=key,x=t.x,y=t.y}
                            end
                        end
                        local repairOrigin=here()
                        table.sort(repair,function(a,b)
                            return math.abs(a.x-repairOrigin)<math.abs(b.x-repairOrigin)
                        end)
                        for _,t in ipairs(repair) do
                            if not live() then return false,"stopped" end
                            local fixed=false
                            for attempt=1,2 do
                                if walk(t.x,y) and clearGap(t.x,t.y) then fixed=true;break end
                            end
                            if not fixed then return false,"sisa tile atas belum terjangkau X"..t.x.." Y"..t.y end
                            builder.pendingUpper[t.key]=nil
                            if builder.progressSave then builder.progressSave(true) end
                        end
                        if #repair>0 and not walk(toX,y) then
                            return false,"gagal kembali ke ujung setelah memperbaiki sisa tile"
                        end
                    end
                    local ready,reason=edgeWork(y,not left,placing)
                    if not ready then return false,reason end
                    local remaining,blocked=builder.auditTemplate(y+1)
                    print("[DIRT TEMPLATE] ROW CHECK | floor",y+1,"| differences",remaining,"| blocked",blocked)
                    if remaining>0 then return false,"baris belum sesuai Y"..(y+1).." | sisa "..remaining end
                    if placing then
                        -- v1.0.130: list the ceiling tiles that are still
                        -- wrong and REPAIR them (walk under, place/clear)
                        -- before giving up on the row.
                        local function ceilingLeft()
                            local list={}
                            for x=0,W-1 do
                                local id=tileAt("fg",x,y-1)
                                if stairHole(x,y-1) then
                                    if id~=0 then list[#list+1]={x=x,hole=true,id=id} end
                                elseif not solidFloor(id) then
                                    list[#list+1]={x=x,hole=false,id=id}
                                end
                            end
                            return list
                        end
                        local left0=ceilingLeft()
                        for _,t in ipairs(left0) do
                            print("[DIRT FARM] CEILING MISSING | X",t.x,"Y",y-1,
                                "| tile",tostring(t.id),"|",t.hole and "stair hole must be empty" or "needs Dirt")
                        end
                        for _,t in ipairs(left0) do
                            if not live() then return false,"stopped" end
                            for attempt=1,2 do
                                local qx=here()
                                if not qx or not reach(t.x,y-1) then walk(t.x,y) end
                                if t.hole then
                                    clearGap(t.x,y-1)
                                else
                                    local _,why=makeFloor(t.x,y-1)
                                    if why=="empty" then return false,"empty" end
                                end
                                local id=tileAt("fg",t.x,y-1)
                                if (t.hole and id==0) or (not t.hole and solidFloor(id)) then
                                    print("[DIRT FARM] CEILING REPAIRED | X",t.x,"Y",y-1)
                                    break
                                end
                            end
                        end
                        local missing=#ceilingLeft()
                        print("[DIRT FARM] CEILING CHECK | floor",y-1,"| remaining",missing)
                        if missing>0 then return false,"lantai di atas kepala belum selesai Y"..(y-1) end
                    end
                    return true
                end
                builder.progress=builder.progress or {version=2,world=tostring(startWorld),w=W,h=world.h,
                    material=itemId,top=gy0,stairPhase=builder.dirtPhase,buildStyle="ceiling-1",row=startIdx,left=nearLeftSide,
                    phase="down",entered=false}
                builder.pendingUpper=type(builder.progress.pending)=="table" and builder.progress.pending or {}
                builder.progress.pending=builder.pendingUpper
                builder.progressSave=function(force)
                    local p=builder.progress
                    if not p then return end
                    p.x,p.y=here()
                    env.Fian792DirtProgress[startWorld]=p
                    if not force and os.clock()-(builder.progressSavedAt or 0)<2 then return end
                    builder.progressSavedAt=os.clock()
                    builder.template.progress=p
                    if type(writefile)=="function" then
                        local ok,err=pcall(function()
                            writefile(builder.templateFile,game:GetService("HttpService"):JSONEncode(builder.template))
                        end)
                        if not ok and force then warn("[DIRT FARM] progress save failed",err) end
                    end
                end
                if builder.progress.production then
                    local continued,why=builder.ensureMaterial(builder.progress.production.floorY)
                    if not continued then fail(why);return end
                end
                local function setPhase(phase,row,left)
                    builder.progress.phase=phase
                    builder.progress.row=row
                    builder.progress.left=left
                    builder.progress.entered=false
                    builder.progress.targetX=(phase=="down" or phase=="climb") and (left and 2 or W-3) or (left and W-3 or 2)
                    builder.progressSave(true)
                end
                while live() do
                    local p=builder.progress
                    local c,left=p.row,p.left
                    local y=gapY(c)
                    if p.phase=="down" then
                        if c>=n-1 then
                            setPhase("place",c,left)
                        else
                            -- Descend FIRST at the current edge, then sweep.
                            local ny=gapY(c+1)
                            local edge=left and 0 or W-1
                            local step=left and 1 or -1
                            local hole=(c+builder.dirtPhase)%2==0 and edge or edge+step
                            local standing=hole==edge and edge+step or edge
                            local _,qy=here()
                            if qy~=ny then
                                if qy==y then
                                    local qx=here()
                                    local inner=left and 2 or W-3
                                    if math.abs(qx-standing)>2 then
                                        if not walk(inner,y) then fail("tidak bisa kembali ke tangga terdekat");return end
                                    end
                                    if not clearGap(standing,y) then fail("celah tangga turun belum siap");return end
                                    local fixed,w=makeFloor(standing,y+1)
                                    if not fixed then fail(w or "pijakan awal tangga belum siap");return end
                                    local safe,why=stairLavaSafe(standing,y)
                                    if not safe then fail(why);return end
                                    if not walk(standing,y) then fail("gagal mendekati tangga turun");return end
                                    if not solidFloor(tileAt("fg",hole,ny)) then
                                        fixed,w=makeFloor(hole,ny)
                                        if not fixed then fail(w or "anak tangga sementara belum siap");return end
                                    end
                                    -- Open the entry cell as well as the cell below:
                                    -- a diagonal fall cannot cross solid Dirt at (hole,y).
                                    if not clearGap(hole,y) then fail("tile masuk tangga belum terbuka");return end
                                    if not clearGap(hole,y+1) then fail("lubang turun belum terbuka");return end
                                    if not passable(tileAt("fg",hole,y)) or not passable(tileAt("fg",hole,y+1)) then
                                        fail("jalur masuk tangga belum terkonfirmasi");return
                                    end
                                    safe,why=stairLavaSafe(hole,y+1)
                                    if not safe then fail(why);return end
                                    if not walk(hole,y+1) then fail("belum turun satu tile");return end
                                elseif qy~=y+1 then
                                    fail("posisi resume tangga tidak sesuai Y"..tostring(qy));return
                                end
                                local fixed,w=makeFloor(hole,ny+1)
                                if not fixed then fail(w or "pijakan bawah belum siap");return end
                                if not clearGap(hole,ny) then fail("celah bawah belum terbuka");return end
                                local safe,why=stairLavaSafe(hole,ny)
                                if not safe then fail(why);return end
                                if not walk(hole,ny) then fail("belum mendarat di Y"..ny);return end
                            end
                            if not live() then return end
                            print("[DIRT FARM] DESCEND | landed Y",ny,"| bottom Y",gapY(n-1))
                            setPhase("down",c+1,left)
                        end
                    elseif p.phase=="sweep" or p.phase=="place" then
                        local placing=p.phase=="place"
                        if placing and c==0 then break end
                        local ok,why=workRow(c,left,placing)
                        if not live() then return end
                        if not ok then fail(why);return end
                        if placing then
                            if c==0 then break end
                            builder.progress.paired=false
                            setPhase("climb",c,not left)
                        else
                            setPhase(c>=n-1 and "place" or "down",c,not left)
                        end
                    elseif p.phase=="paircheck" then
                        -- This upper row was already worked by the previous sweep.
                        -- Only visit mismatches; never run another full sweep.
                        local missing=builder.auditTemplate(y+1)
                        print("[DIRT FARM] PAIR CHECK | Y",y,"| remaining",missing)
                        if missing>0 then
                            local missingFloor=false
                            for x=2,W-3 do
                                if not stairHole(x,y+1) and not solidFloor(tileAt("fg",x,y+1)) then
                                    missingFloor=true;break
                                end
                            end
                            if missingFloor then
                                builder.progress.paired=false
                                local atX=here()
                                setPhase("place",c,atX<=W-1-atX)
                                continue
                            end
                            local repairs={}
                            for x=0,W-1 do
                                local f=tileAt("fg",x,y+1)
                                local g=tileAt("fg",x,y)
                                local bg=tileAt("bg",x,y)
                                local badFloor=stairHole(x,y+1) and f~=0
                                    or (not stairHole(x,y+1) and not solidFloor(f))
                                if badFloor or g==nil or not passable(g)
                                    or bg==nil or (bg~=0 and diggable(bg)) then
                                    repairs[#repairs+1]=x
                                end
                            end
                            local origin=here()
                            table.sort(repairs,function(a,b) return math.abs(a-origin)<math.abs(b-origin) end)
                            for _,x in ipairs(repairs) do
                                if not live() then return end
                                local standX=math.clamp(x,2,W-3)
                                if not walk(standX,y) then fail("sisa pasangan belum terjangkau X"..x.." Y"..y);return end
                                local safe,why=stairLavaSafe(x,y)
                                if not safe then fail(why);return end
                                if not clearGap(x,y) then fail("sisa celah pasangan belum bersih X"..x);return end
                                if stairHole(x,y+1) then
                                    if not clearGap(x,y+1) then fail("sisa lubang tangga belum terbuka X"..x);return end
                                else
                                    local fixed,w=makeFloor(x,y+1)
                                    if not fixed then fail(w or "sisa lantai pasangan belum terpasang");return end
                                end
                            end
                            if builder.auditTemplate(y+1)>0 then fail("pasangan belum sesuai template");return end
                        end
                        if c==0 then break end
                        builder.progress.paired=false
                        local actualX=here()
                        print("[DIRT FARM] PAIR DONE | skip resweep Y",y,"| next pair Y",gapY(c-1))
                        setPhase("climb",c,actualX<=W-1-actualX)
                    elseif p.phase=="climb" then
                        local upperY=gapY(c-1)
                        local edge=left and 0 or W-1
                        local step=left and 1 or -1
                        local hole=(c-1+builder.dirtPhase)%2==0 and edge or edge+step
                        local landing=hole==edge and edge+step or edge
                        local _,qy=here()
                        if qy~=upperY then
                            if not walk(hole,y) then fail("gagal mendekati tangga naik");return end
                            -- Clear the takeoff column at BOTH heights.
                            -- The upper walking gap is needed by the stair edge.
                            if not clearGap(hole,upperY+1) or not clearGap(hole,upperY)
                                or not clearGap(landing,upperY) then
                                fail("jalur naik belum terbuka");return
                            end
                            -- The native tight-stair route only needs the takeoff
                            -- gap. Landing headroom is opened AFTER landing in reach.
                            local fixed,w=makeFloor(landing,upperY+1)
                            if not fixed then fail(w or "pijakan naik belum siap");return end
                            local safe,why=stairLavaSafe(landing,upperY)
                            if not safe then fail(why);return end
                            if not walk(landing,upperY) then fail("gagal naik ke Y"..upperY);return end
                        end
                        if not live() then return end
                        if stairHole(landing,upperY-1) then
                            if not reach(landing,upperY-1) or not clearGap(landing,upperY-1) then
                                fail("lubang tangga atas belum terbuka setelah mendarat");return
                            end
                        end
                        setPhase(p.paired and "paircheck" or "place",c-1,left)
                    end
                end
                if not live() then return end
                local remaining=builder.auditTemplate()
                if remaining>0 then fail("template belum selesai | sisa "..remaining);return end
                builder.progress=nil
                builder.template.progress=nil
                env.Fian792DirtProgress[startWorld]=nil
                builder.saveTemplate(nearLeftSide)
                finish("Dirt Farm selesai sesuai template ("..n.." lantai)")
            end)
            if builder.active and builder.rev==rev then
                stopBuilder((not ok and ("error: "..tostring(err)))
                    or (refs.worldKey()~=startWorld and "world berubah")
                    or "selesai")
            end
        end)
    end
    builder.toggle=builderSection:Toggle({Title="Auto Dirt Farm",Value=false,
        Desc="Bangun lantai di atas kepala per baris. Bahan kurang diproduksi dari seed. OFF menyimpan progres.",
        Callback=function(on)
            if builder.syncing then return end
            if on then
                builder.dirtRun()
                if not builder.active then
                    -- Start refused (material, other automation, not grounded)
                    builder.syncing=true
                    pcall(function() builder.toggle:Set(false) end)
                    builder.syncing=false
                end
            elseif builder.active then
                stopBuilder("manual")
            end
        end})
    group:Button({Title="Arm Clear World",Callback=function()
        if mode~="Clear World" then tell("Pilih Clear World dulu");return end
        armed=true
        tell("Clear World ARMED | FG lalu BG, kecuali protected tiles")
    end})
    occupied=function()
        local farm=env.Fian792FarmRuntime
        return running or breakRunning or dropPause or guardPaused
            or env.Fian792MovementOwner~=nil
            or (farm and type(farm.running)=="function" and farm.running())
    end
    local function safe(x,y,state)
        return x>=0 and y>=0 and x<world.w and y<world.h
            and canBuild(x,y) and inRange(state,x,y)
    end
    local function lavaId(id)
        local item=id and db[id]
        return type(item)=="table" and tostring(item.name or ""):lower()=="lava"
    end
    local function breakable(id)
        local v=id and db[id]
        if type(v)~="table" then return false end
        if v.lock or v.area or v.guildLock or v.vend or v.display then return false end
        -- Lava may be deadly/hurt on contact, but can be punched from safety.
        -- ALL other hazardous blocks keep their original protection.
        if (v.deadly or v.hurts or v.laser) and not lavaId(id) then return false end
        local hits=v.kind=="seed" and 20 or tonumber(v.hits)
        return hits~=nil and hits>0
    end
    local clearIncludeBg=true
    group:Toggle({Title="Clear Background",Value=true,
        Desc="FG dulu, kemudian BG bila FG sudah kosong",
        Callback=function(v) clearIncludeBg=v==true end})
    -- A world-wide pass selects one top-down FG/BG target at a time. A
    -- bounded skip cache prevents oscillation around impossible corridors.
    -- Clear World: two HIGH rows per horizontal band. At the far edge
    -- open two tiles below, turn once, then sweep back.
    -- Periodic band audits retry missed tiles before descending again.
    -- PNB native punch/speed are reused; its saved grid is independent.
    local function clearWorldLoop(run,originalWorld)
        local nav=env.Fian792WorldBuilderNav
        local sweep={round=0,focus=nil,waitingX=nil,waitingAt=0,
            navFailures=0,lastMissed=math.huge,stalled=0,lavaBusy=false}
        local progress=0
        -- Anchor the band at the actual player's tile, never at map Y=0.
        local initialState=getState()
        if not initialState or initialState.dead then stop("Clear World: posisi karakter tidak tersedia");return end
        local bandTop=math.max(0,math.min(world.h-1,math.floor(initialState.y-0.475)))
        -- ALWAYS navigate LEFT before the first lane. The initial run only
        -- positions and digs the 2-tile shaft; it does NOT sweep to the right
        -- from the player's spawn column.
        local direction=-1
        local cursor=0
        local audit=0
        local phase="edge"
        local firstDescent=true
        local descentStep=1
        local descentRetries=0
        local landingRetries=0
        local landingStarted=nil
        local descentOriginY=nil
        local landingAssistAttempted=false
        local shaftWaitAt=nil
        local shaftWaitY=nil
        local shaftAssistUsed=false
        local edgeX=nil
        print("[WORLD CLEAR START LEFT] from",math.floor(initialState.x),
            math.floor(initialState.y-0.475),
            "| navigate to LEFT edge, dig 1 tile -> LAND -> dig next tile -> LAND")
        local lavaTiles={} -- coordinate cache, built once at Clear World startup
        local function live()
            return active and revision==run and world==originalWorld
        end
        local function candidate(x,y)
            if x<0 or x>=world.w or y<0 or y>=world.h then return nil end
            local spawn=rawget(world,"spawn")
            if spawn and spawn.X==x and spawn.Y==y then return nil end
            if not canBuild(x,y) then return nil end
            local fg=tileAt("fg",x,y)
            if breakable(fg) then return "fg",fg end
            if fg==0 and clearIncludeBg then
                local bg=tileAt("bg",x,y)
                if breakable(bg) then return "bg",bg end
            end
            return nil
        end
        local function workAt(x,y)
            local layer,id=candidate(x,y)
            if layer=="fg" and lavaId(id) then
                lavaTiles[y*world.w+x]={x=x,y=y}
            end
            if not layer then return nil end
            return {x=x,y=y,idx=y*world.w+x,layer=layer,id=id}
        end
        -- Sweep ONLY the two tiles just opened by the last edge shaft:
        -- Y+1 and Y+2. Never touch the Y+3 floor during horizontal clearing.
        -- Include BG only after the live FG at each tile is gone.
        local function countBand()
            local n,firstX,firstY=0,nil,nil
            local scanned=0
            -- Return the exact leftover coordinate. The audit must aim at
            -- this tile, not blindly go to the opposite world edge.
            for x=0,world.w-1 do
                for y=bandTop,math.min(world.h-1,bandTop+1) do
                    if workAt(x,y) then
                        n+=1
                        if firstX==nil then firstX,firstY=x,y end
                    end
                    scanned+=1
                    if scanned%160==0 then task.wait() end
                    if not live() then return n,firstX,firstY end
                end
            end
            return n,firstX,firstY
        end
        -- Scan Lava coordinates ONE time; the live tile is rechecked before
        -- each pickup/punch, so destroyed lava is removed from this cache.
        local lavaInitial=0
        for y=0,world.h-1 do
            for x=0,world.w-1 do
                if lavaId(tileAt("fg",x,y)) then
                    lavaTiles[y*world.w+x]={x=x,y=y}
                    lavaInitial+=1
                end
            end
            if y%12==11 then task.wait() end
            if not live() then return end
        end
        print("[WORLD CLEAR LAVA SCAN]",lavaInitial,"tiles cached")
        local function liveLava()
            -- Only entries discovered by the initial scan (or workAt) are
            -- considered. Do not rescan 6,000 world tiles every farm tick.
            for index,t in pairs(lavaTiles) do
                if not lavaId(tileAt("fg",t.x,t.y)) then
                    lavaTiles[index]=nil
                end
            end
        end
        local function closestLavaInRange(body)
            local chosen,score=nil,math.huge
            if not body then return nil end
            for index,t in pairs(lavaTiles) do
                if not lavaId(tileAt("fg",t.x,t.y)) then
                    lavaTiles[index]=nil
                elseif inRange(body,t.x,t.y) then
                    local dx=t.x+0.5-body.x
                    local dy=t.y+0.5-(body.y-0.475)
                    local d=dx*dx+dy*dy
                    if d<score then chosen,score=t,d end
                end
            end
            return chosen
        end
        local function punchLava(t)
            if not live() then return false end
            if not canBuild(t.x,t.y) or not breakable(tileAt("fg",t.x,t.y)) then
                stop("Lava X"..t.x.." Y"..t.y.." protected / not breakable")
                return false
            end
            print("[WORLD CLEAR LAVA FIRST] x",t.x,"y",t.y)
            for attempt=1,32 do
                if not live() or guardPaused or dropPause then return false end
                local id=tileAt("fg",t.x,t.y)
                if not lavaId(id) then
                    lavaTiles[t.y*world.w+t.x]=nil
                    print("[WORLD CLEAR LAVA CLEARED]",t.x,t.y,
                        "| attempts",attempt-1)
                    return true
                end
                local body=getState()
                if not body or body.dead or not inRange(body,t.x,t.y) then
                    stop("Lava not in safe punch range X"..t.x.." Y"..t.y)
                    return false
                end
                local ok,err=pcall(punch,t.x,t.y,true,nil)
                if not ok then
                    stop("Lava native punch failed: "..tostring(err))
                    return false
                end
                task.wait(math.max(0.14,breakSpeed/1000))
                if tileAt("fg",t.x,t.y)==0 then
                    cleared+=1;progress+=1
                end
            end
            stop("Lava X"..t.x.." Y"..t.y..
                " not destroyed; Clear World stopped before movement")
            return false
        end
        local function interceptLava(goalX,goalY)
            -- Check only cached hazards between the player and the next
            -- horizontal destination. Never navigate THROUGH a lava tile.
            local state=getState()
            if not state or state.dead or not state.grounded then return false end
            local sx=math.floor(state.x)
            local sy=math.floor(state.y-0.475)
            local dir=goalX>sx and 1 or (goalX<sx and -1 or 0)
            if dir==0 then return false end
            local nearest,distance=nil,math.huge
            for index,t in pairs(lavaTiles) do
                if not lavaId(tileAt("fg",t.x,t.y)) then
                    lavaTiles[index]=nil
                elseif (t.x-sx)*dir>=0 and (goalX-t.x)*dir>=0
                    and math.abs(t.y-sy)<=2
                    and math.abs(t.y-goalY)<=3 then
                    local d=math.abs(t.x-sx)
                    if d<distance then nearest,distance=t,d end
                end
            end
            if not nearest then return false end
            if inRange(state,nearest.x,nearest.y) then
                punchLava(nearest)
                return true
            end
            -- Pick a safe stand approximately 2 columns before Lava. The
            -- native navigator also rejects deadly/unsafe body & support.
            local standX,standY=nil,nil
            for gap=2,4 do
                local x=nearest.x-dir*gap
                for delta=-1,1 do
                    local y=sy+delta
                    if x>=0 and x<world.w and y>=1 and y<world.h-1
                        and builderWalkable(x,y) and canBuild(x,y) then
                        local fg=tileAt("fg",x,y)
                        local item=fg and db[fg]
                        local hx=x+0.5-(nearest.x+0.5)
                        local hy=y+0.524-(nearest.y+0.5)
                        if not (item and (item.deadly or item.hurts or item.laser))
                            and hx*hx+hy*hy <= MAX_RANGE*MAX_RANGE then
                            standX,standY=x,y
                            break
                        end
                    end
                end
                if standX then break end
            end
            if not standX or not nav or type(nav.walk)~="function" then
                stop("Lava ahead X"..nearest.x.." Y"..nearest.y..
                    " | no safe approach tile")
                return true
            end
            print("[WORLD CLEAR LAVA APPROACH]",nearest.x,nearest.y,
                "| staging",standX,standY)
            local ok,reached,reason=pcall(nav.walk,standX,standY)
            if not live() then return true end
            local arrived=getState()
            if not ok or not reached or not arrived or arrived.dead
                or not inRange(arrived,nearest.x,nearest.y) then
                stop("Lava safe approach failed X"..nearest.x..
                    " Y"..nearest.y.." | "..tostring(reason or reached))
                return true
            end
            punchLava(nearest)
            return true
        end
        -- One punch coroutine; movement is handled independently below.
        -- The worker targets ONLY the current two-row band.
        local function punchInBand(x,y,body)
            if x<0 or x>=world.w or y<bandTop or y>bandTop+1 then return false end
            if not inRange(body,x,y) then return false end
            local layer,id=candidate(x,y)
            if not layer then return false end
            local px=math.floor(body.x)
            local py=math.floor(body.y-0.475)
            -- Do not punch a supporting floor while the avatar stands on it.
            if layer=="fg" and y==py+1 and x==px then return false end
            local ok,ret=pcall(punch,x,y,true,nil)
            if not ok or ret==false then return false end
            task.wait(math.max(0.14,breakSpeed/1000))
            local nextLayer,nextId=candidate(x,y)
            if nextLayer~=layer or nextId~=id then
                cleared+=1
                progress+=1
            end
            return true
        end
        local function punchNear()
            local body=getState()
            if not body or body.dead or not body.grounded then return false end
            local px=math.floor(body.x)
            local left=math.max(0,px-2)
            local right=math.min(world.w-1,px+2)
            local width=right-left+1
            if width<=0 then return false end
            -- Prioritise the corridor in front, then round-robin both layers
            -- to avoid starving BG or repeatedly punching the same tile.
            if sweep.focus and math.abs(sweep.focus-px)<=2 then
                if punchInBand(sweep.focus,bandTop,body) then return true end
                if punchInBand(sweep.focus,bandTop+1,body) then return true end
            end
            for step=0,width*2-1 do
                local slot=(sweep.round+step)%(width*2)
                local x=direction==1 and left+(slot%width)
                    or right-(slot%width)
                local y=bandTop+math.floor(slot/width)
                if punchInBand(x,y,body) then
                    sweep.round=(slot+1)%(width*2)
                    return true
                end
            end
            return false
        end
        -- Sequential punch: no background punch worker during navigation.
        while live() do
            if guardPaused or dropPause then task.wait(0.35);continue end
            if running or breakRunning
                or (env.Fian792FarmRuntime and env.Fian792FarmRuntime.running()) then
                stop("other automation started");break
            end
            if bandTop>=world.h then
                -- Full-world verification, including tiles previously skipped.
                -- Do not claim success if inaccessible tiles remain.
                local remaining=0
                local visited=0
                for y=0,world.h-1 do
                    for x=0,world.w-1 do
                        if workAt(x,y) then remaining+=1 end
                        visited+=1
                        if visited%250==0 then task.wait() end
                        if not live() then break end
                    end
                    if not live() then break end
                end
                stop(remaining==0 and "world clear verified: no eligible blocks remain"
                    or ("clear scan finished | remaining "..remaining..
                        " unreachable/protected or not yet cleared"))
                break
            end
            -- Lava takes precedence whenever it comes into native punch range.
            -- Do not move to another block until that Lava is verified gone.
            if phase=="sweep" or phase=="edge" then
                local state=getState()
                local nearbyLava=closestLavaInRange(state)
                if nearbyLava then
                    sweep.lavaBusy=true
                    punchLava(nearbyLava)
                    sweep.lavaBusy=false
                    task.wait(0.08)
                    continue
                end
            end
            -- At the edge, open the vertical shaft one tile at a time:
            -- only then reverse direction for the next two-row band.
            if phase=="edge" then
                local edgeLimit=direction==1 and world.w-1 or 0
                -- Prefer bottom lane for every descent after the first.
                -- It guarantees the new band aligns exactly two rows lower.
                local standingY=firstDescent and bandTop or bandTop+1
                if bandTop+2>=world.h then
                    bandTop=world.h
                    continue
                end
                local function shaftReady(x)
                    if x<0 or x>=world.w or standingY+3>=world.h then return false end
                    if not builderWalkable(x,standingY)
                        or not canBuild(x,standingY) then return false end
                    for step=1,2 do
                        local yy=standingY+step
                        local fg=tileAt("fg",x,yy)
                        if fg==nil or not canBuild(x,yy)
                            or (fg~=0 and not breakable(fg)) then return false end
                    end
                    local floorId=tileAt("fg",x,standingY+3)
                    local floorMeta=floorId and db[floorId]
                    return type(floorMeta)=="table"
                        and (floorMeta.solid==true or floorMeta.platform==true)
                        and not floorMeta.deadly and not floorMeta.hurts
                        and not floorMeta.laser
                end
                local body=getState()
                if not body or body.dead then
                    stop("Clear World: karakter tidak tersedia di ujung");break
                end
                local bx=math.floor(body.x)
                local by=math.floor(body.y-0.475)
                local goalX=nil
                -- An edge sweep can end at X2: do not force a move onto
                -- X0 after its supporting floor has already been removed.
                if body.grounded and by==standingY
                    and math.abs(bx-edgeLimit)<=4 and shaftReady(bx) then
                    goalX=bx
                else
                    for offset=0,math.min(8,world.w-1) do
                        local x=edgeLimit-direction*offset
                        if shaftReady(x) then
                            if bx==x and body.grounded and by==standingY then
                                goalX=x;break
                            end
                            if interceptLava(x,standingY) then
                                if not live() then break end
                                body=getState()
                                bx=body and math.floor(body.x) or bx
                                by=body and math.floor(body.y-0.475) or by
                            end
                            if nav and type(nav.walk)=="function" then
                                local ok,reached,reason=pcall(nav.walk,x,standingY)
                                if not live() then break end
                                body=getState()
                                bx=body and math.floor(body.x) or -1
                                by=body and math.floor(body.y-0.475) or -1
                                if ok and reached and body and body.grounded
                                    and bx==x and by==standingY
                                    and shaftReady(x) then
                                    goalX=x
                                    break
                                end
                                print("[WORLD CLEAR EDGE FALLBACK]",x,standingY,
                                    "| navigation",ok,reached,reason)
                            end
                        end
                    end
                end
                if not live() then break end
                if not goalX and firstDescent then
                    -- A previous clear may have removed the left-edge
                    -- standing floor. Prefer the player's verified position
                    -- rather than requiring X0, then audit both sides.
                    body=getState()
                    bx=body and math.floor(body.x) or -1
                    by=body and math.floor(body.y-0.475) or -1
                    if body and body.grounded and by==standingY
                        and shaftReady(bx) then
                        goalX=bx
                        print("[WORLD CLEAR INITIAL SHAFT FALLBACK]",
                            "current X",bx,"Y",standingY,
                            "| left-edge floor unavailable")
                    end
                    -- Search other standing tiles on the same row.
                    -- Bounds prevent the nav from retrying the entire map.
                    if not goalX then
                        local tries=0
                        for x=0,world.w-1 do
                            if shaftReady(x) then
                                tries+=1
                                local ok,reached,reason=false,false,nil
                                if nav and type(nav.walk)=="function" then
                                    ok,reached,reason=pcall(nav.walk,x,standingY)
                                end
                                body=getState()
                                if ok and reached and body and body.grounded
                                    and math.floor(body.x)==x
                                    and math.floor(body.y-0.475)==standingY then
                                    goalX=x
                                    print("[WORLD CLEAR INITIAL SHAFT FALLBACK]",
                                        "mapped X",x,"Y",standingY)
                                    break
                                end
                                if tries>=4 then break end
                            end
                            if x%24==23 then task.wait() end
                            if not live() then break end
                        end
                    end
                end
                if not live() then break end
                if not goalX then
                    stop("Clear World: tidak ada shaft 2-tile aman pada Y"..
                        standingY.." | perlu lantai pijakan di Y"..(standingY+3)..
                        " dan dua tile yang bisa dibuka | tidak pindah band")
                    break
                end
                edgeX=goalX
                descentOriginY=standingY
                descentStep=1
                descentRetries=0
                phase="descend"
                tell((firstDescent and "CLEAR INITIAL LEFT EDGE" or "CLEAR EDGE REACHED")..
                    " | X "..edgeX.." Y "..descentOriginY..
                    " | FIRST floor -> LAND -> SECOND floor -> LAND")
                task.wait(0.08)
                continue
            end
            if phase=="descend" then
                -- ONE tile at a time, and NEVER move to the next tile
                -- until the player has physically landed one tile lower.
                -- Foreground holds the floor; background never holds physics.
                if descentStep>2 then
                    phase="land"
                    landingStarted=os.clock()
                    landingAssistAttempted=false
                    continue
                end
                local downY=descentOriginY+descentStep
                if downY>=world.h then
                    stop("Clear World: shaft melewati dasar world");break
                end
                local fg=tileAt("fg",edgeX,downY)
                if fg==nil then
                    stop("Clear World: data tile shaft kosong/tidak tersedia X"..
                        edgeX.." Y"..downY)
                    break
                end
                if fg~=0 and (not canBuild(edgeX,downY) or not breakable(fg)) then
                    stop("Clear World: protected floor at shaft X"..edgeX..
                        " Y"..downY)
                    break
                end
                local body=getState()
                if not body or body.dead or math.floor(body.x)~=edgeX then
                    stop("Clear World: player tidak tepat di atas shaft X"..edgeX)
                    break
                end
                local atY=math.floor(body.y-0.475)
                -- Do not punch a floor ABOVE a character that already fell.
                if atY>downY then
                    stop("Clear World: karakter sudah melewati shaft target Y"..
                        downY.." | playerY "..atY)
                    break
                end
                if fg==0 then
                    shaftWaitAt=os.clock()
                    shaftWaitY=downY
                    shaftAssistUsed=false
                    phase="shaftWait"
                    print("[WORLD CLEAR SHAFT TILE CLEAR]",descentStep,
                        "/2 | X",edgeX,"Y",downY,
                        "| wait for the character to LAND before next break")
                    continue
                end
                if not inRange(body,edgeX,downY) then
                    descentRetries+=1
                    if descentRetries>=18 then
                        stop("Clear World: shaft target out of range X"..edgeX..
                            " Y"..downY)
                        break
                    end
                    task.wait(0.14)
                    continue
                end
                local ok,err=pcall(punch,edgeX,downY,true,nil)
                if not ok then
                    stop("Clear World: native shaft punch error: "..tostring(err))
                    break
                end
                task.wait(math.max(0.14,breakSpeed/1000))
                if tileAt("fg",edgeX,downY)==0 then
                    cleared+=1
                    progress+=1
                    shaftWaitAt=os.clock()
                    shaftWaitY=downY
                    shaftAssistUsed=false
                    descentRetries=0
                    phase="shaftWait"
                    print("[WORLD CLEAR SHAFT BREAK]",descentStep,
                        "/2 | X",edgeX,"Y",downY,
                        "| successful | WAIT DOWN")
                else
                    descentRetries+=1
                    if descentRetries%8==0 then
                        print("[WORLD CLEAR SHAFT RETRY]",descentStep,
                            "/2 | X",edgeX,"Y",downY,"attempt",descentRetries)
                    end
                    if descentRetries>=32 then
                        stop("Clear World: shaft tile not broken X"..edgeX..
                            " Y"..downY)
                        break
                    end
                end
                task.wait(0.08)
                continue
            end
            if phase=="shaftWait" then
                -- The previous floor is already EMPTY. Do not even look at
                -- the next floor until the actual player moved down.
                local body=getState()
                local px=body and math.floor(body.x) or -1
                local py=body and math.floor(body.y-0.475) or -1
                if not body or body.dead or px~=edgeX then
                    stop("Clear World: posisi karakter bergeser saat turun shaft")
                    break
                end
                if body.grounded and py>=shaftWaitY then
                    if py>shaftWaitY+1 then
                        stop("Clear World: jatuh terlalu jauh di shaft | Y"..py..
                            " expected "..shaftWaitY)
                        break
                    end
                    print("[WORLD CLEAR SHAFT LANDED]",descentStep,
                        "/2 | player X",px,"Y",py,
                        "| floor broken Y",shaftWaitY)
                    if descentStep==1 then
                        descentStep=2
                        descentRetries=0
                        shaftWaitAt=nil
                        shaftWaitY=nil
                        phase="descend"
                        -- This is the FIRST time the second tile may be hit.
                        task.wait(0.12)
                    else
                        phase="land"
                        landingStarted=os.clock()
                        landingAssistAttempted=false
                        shaftWaitAt=nil
                        shaftWaitY=nil
                    end
                    continue
                end
                if os.clock()-(shaftWaitAt or os.clock())>2
                    and not shaftAssistUsed and body.grounded
                    and nav and type(nav.walk)=="function"
                    and builderWalkable(edgeX,shaftWaitY) then
                    shaftAssistUsed=true
                    local ok,moved,reason=pcall(nav.walk,edgeX,shaftWaitY)
                    print("[WORLD CLEAR SHAFT ALIGN]",descentStep,
                        "/2 | nav",ok,moved,reason)
                end
                if os.clock()-(shaftWaitAt or os.clock())>9 then
                    stop("Clear World: floor sudah pecah tapi belum turun ke Y"..
                        shaftWaitY.." | player X"..px.." Y"..py)
                    break
                end
                task.wait(0.13)
                continue
            end
            if phase=="land" then
                if guardPaused or dropPause then
                    landingStarted=os.clock()
                    task.wait(0.35)
                    continue
                end
                local body=getState()
                local playerY=body and math.floor(body.y-0.475) or -1
                local playerX=body and math.floor(body.x) or -1
                local targetY=descentOriginY+2
                -- Two shaft blocks are Y+1 and Y+2. The subsequent
                -- 2-row sweep MUST be on those exact two rows, not Y+2
                -- and Y+3 (which accidentally cleared a THIRD row).
                -- Later bands advance by two because the shaft begins
                -- under the previous lane's standing row.
                local nextTop=firstDescent and (descentOriginY+1)
                    or (bandTop+2)
                if body and body.grounded and playerY==targetY
                    and playerY==nextTop+1
                    and math.abs(playerX-edgeX)<=1 then
                    print("[WORLD CLEAR DESCENT CONFIRMED]",
                        "fromY",descentOriginY,"playerY",playerY,
                        "targetY",targetY,"edgeX",edgeX)
                    bandTop=nextTop
                    direction=-direction
                    if firstDescent then
                        firstDescent=false
                        -- If the start shaft fell back away from X0,
                        -- sweep LEFT first, then RIGHT during band audit.
                        -- Starting from X0 still sweeps RIGHT directly.
                        direction=playerX<=1 and 1 or -1
                    end
                    -- Begin the return sweep from the actual landing column,
                    -- not the opposite map edge or an invented cursor.
                    cursor=playerX
                    phase="sweep"
                    audit=0
                    descentStep=1
                    descentRetries=0
                    landingStarted=nil
                    descentOriginY=nil
                    landingAssistAttempted=false
                    shaftWaitAt=nil
                    shaftWaitY=nil
                    shaftAssistUsed=false
                    edgeX=nil
                    sweep.round=0
                    sweep.focus=nil
                    sweep.waitingX=nil
                    sweep.lastMissed=math.huge
                    sweep.stalled=0
                    tell("CLEAR LANDED | X"..playerX.." Y"..playerY..
                        " | sweep "..(direction==1 and "RIGHT" or "LEFT")..
                        " | ONLY rows "..bandTop.."-"..(bandTop+1)..
                        " FG then BG (no third row)")
                else
                    if landingStarted and os.clock()-landingStarted>12 then
                        stop("Clear World: belum turun 2 tile | player X"..playerX..
                            " Y"..playerY.." target Y"..targetY..
                            " | sweep dibatalkan")
                        break
                    end
                    -- One optional targeted nudge if the player's collision
                    -- box remains on an adjacent floor after both shaft tiles
                    -- have been verified empty. Never wander across the row.
                    if body and body.grounded and not landingAssistAttempted
                        and os.clock()-(landingStarted or os.clock())>1.5
                        and nav and type(nav.walk)=="function"
                        and targetY<world.h-1
                        and builderWalkable(edgeX,targetY) then
                        landingAssistAttempted=true
                        local ok,moved,why=pcall(nav.walk,edgeX,targetY)
                        print("[WORLD CLEAR SHAFT NUDGE]",ok,moved,why)
                    end
                    task.wait(0.18)
                end
                continue
            end
            -- Punch all nearby work while stopped before any horizontal move.
            -- Descent still requires two confirmed landings.
            if cursor<0 or cursor>=world.w then
                sweep.focus=nil
                local missed,missX,missY=countBand()
                if not live() then break end
                if missed>0 then
                    if missed>=sweep.lastMissed then
                        sweep.stalled+=1
                    else
                        sweep.stalled=0
                    end
                    sweep.lastMissed=missed
                    audit+=1
                    if sweep.stalled>=3 or audit>=12 then
                        stop("Clear World: "..missed..
                            " tiles tersisa di Y"..bandTop.."-"..(bandTop+1)..
                            " | STOP agar tidak melewatkan band")
                        break
                    end
                    local state=getState()
                    local atX=state and math.floor(state.x) or missX
                    direction=missX>=atX and 1 or -1
                    cursor=missX
                    sweep.focus=missX
                    sweep.round=0
                    sweep.waitingX=nil
                    tell("CLEAR VERIFY BAND | remaining "..missed..
                        " | first missed X"..missX.." Y"..missY..
                        " | pass "..audit)
                else
                    phase="edge"
                    sweep.waitingX=nil
                    tell("CLEAR BAND VERIFIED | Y"..bandTop.."-"..(bandTop+1)..
                        " FG/BG selesai | cari shaft 2 tile berikutnya")
                end
                task.wait(0.10)
                continue
            end
            local body=getState()
            if not body or body.dead then
                stop("Clear World: player hilang saat sweep")
                break
            end
            local px=math.floor(body.x)
            -- Punch without moving; keep the target column LOCKED until
            -- its FG and BG candidates are both gone.
            sweep.focus=cursor
            if punchNear() then
                task.wait(0.04)
                continue
            end
            local needed=workAt(cursor,bandTop)
                or workAt(cursor,math.min(world.h-1,bandTop+1))
            if not needed and px==cursor then
                cursor+=direction
                sweep.waitingX=nil
                task.wait(0.04)
                continue
            end
            if sweep.waitingX~=cursor then
                sweep.waitingX=cursor
                sweep.waitingAt=os.clock()
                sweep.navFailures=0
            end
            local waited=os.clock()-sweep.waitingAt
            local goalX,goalY=nil,nil
            -- If target column has blocks or unsafe footing, stand next
            -- to it instead of walking through it / skipping it.
            -- Scan max 5 nearby columns, not the whole map each tick.
            for offset=0,2 do
                for side=-1,1,2 do
                    local tx=cursor+(offset==0 and 0 or side*offset)
                    if tx>=0 and tx<world.w then
                        for y=math.min(world.h-2,bandTop+1),
                            math.max(1,bandTop-2),-1 do
                            if builderWalkable(tx,y) and canBuild(tx,y)
                                and (tx~=px or math.floor(body.y-0.475)~=y)
                                then
                                goalX,goalY=tx,y
                                break
                            end
                        end
                    end
                    if goalX then break end
                end
                if goalX then break end
            end
            if not goalX then
                if needed and waited>12 then
                    stop("Clear World: tile di X"..cursor.." Y"..
                        needed.y.." masih ada, tidak ada pijakan aman | band tidak dilewati")
                    break
                end
                if not needed then
                    -- Already empty column with no standable floor: skip
                    -- only this EMPTY column; never a live FG/BG target.
                    cursor+=direction
                    sweep.waitingX=nil
                end
                task.wait(0.12)
                continue
            end
            sweep.lavaBusy=true
            local lavaHandled=interceptLava(goalX,goalY)
            sweep.lavaBusy=false
            if lavaHandled then
                if not live() then break end
                task.wait(0.10)
                continue
            end
            if not nav or type(nav.walk)~="function" then
                stop("Clear World: navigator unavailable");break
            end
            local ok,reached,reason=pcall(nav.walk,goalX,goalY)
            if not live() then break end
            local landed=getState()
            if landed and not landed.dead and landed.grounded then
                local actualX=math.floor(landed.x)
                local actualY=math.floor(landed.y-0.475)
                if actualX==goalX and actualY==goalY then
                    -- NEVER set cursor from character position: the navigator
                    -- can cross multiple columns while target still exists.
                    sweep.navFailures=0
                    sweep.waitingX=nil
                    if not workAt(cursor,bandTop)
                        and not workAt(cursor,math.min(world.h-1,bandTop+1)) then
                        cursor+=direction
                    end
                else
                    sweep.navFailures+=1
                end
            else
                sweep.navFailures+=1
            end
            if sweep.navFailures>=5 then
                stop("Clear World: nav gagal X"..goalX.." | "..
                    tostring(reason or reached)..
                    " | band dipertahankan")
                break
            end
            if os.clock()-(builder.worldStatusAt or 0)>2.5 then
                builder.worldStatusAt=os.clock()
                tell("CLEAR STOP-PUNCH-WALK | Y"..bandTop.."-"..
                    (bandTop+1).." | "..(direction==1 and "RIGHT" or "LEFT")..
                    " | broken "..cleared)
            end
            task.wait(0.06)
        end
    end
