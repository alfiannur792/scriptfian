    local function directMoveTo(tx,ty,run,limit,harvest,goalNeeded)
        if not directPhysics or not directBox or not touchLive(run) then return false end
        local p=directPhysics
        if not directClear(tx,ty) then return false end
        local path=directPath(p.px,p.py,tx,ty)
        if not path then return false end
        touchRelease()
        directOldGravity,directOldShort=p.GRAV,p.SHORT_JUMP_GRAV
        p.GRAV=0;p.SHORT_JUMP_GRAV=0
        p.vx=0;p.vy=0
