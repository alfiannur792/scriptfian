-- The 2026-11-18 standalone test verified the actual exit signal:
-- PlayerGui.MenuGui.WorldPicker.Visible becomes true at the world picker.
-- Use this stable UI path rather than relying on stale world references.
local function worldPickerVisible()
    local menuGui=playerGui and playerGui:FindFirstChild("MenuGui")
    if not menuGui or (menuGui:IsA("ScreenGui") and not menuGui.Enabled) then
        return false
    end
    local picker=menuGui:FindFirstChild("WorldPicker")
    return picker~=nil and picker:IsA("GuiObject") and picker.Visible==true
end
