                and not guardPaused and not dropPause and seedId then
                local body,bx=touchPosition()
                local closest,nearestDist,remaining=nil,math.huge,0
                for xx=0,world.w-1 do
                    if tileAt("fg",xx,y)==seedId
                        and readyTree(xx,y) and canBuild(xx,y) then
                        remaining+=1
