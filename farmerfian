-- Identify the game's character arm renderer.

local function isArmFn(fn)
    if type(fn) ~= "function" then
        return false
    end

    -- GrowBlox renderer constants are version/case-sensitive.
    -- Scanner verified "Forearm" and "punchReach" on RenderStepped.
    local forearm,punch=false,false
    for _, c in pairs(constantsOf(fn)) do
        if type(c)=="string" then
            local low=string.lower(c)
            if string.find(low,"forearm",1,true) then forearm=true end
            if string.find(low,"punchreach",1,true) then punch=true end
        end
    end
    return forearm and punch
end

local function readUpvalues(fn)
    if type(getUpvalues) ~= "function" then
        return {}
    end

    local ok, values = pcall(getUpvalues, fn)

    return ok and type(values) == "table"
        and values or {}
end

-- Find a plausible action-state upvalue without
-- replacing an unrelated non-nil object.

local armDiagAt=0
local armFindAt=-10
local function bindArm(fn)
    if type(getUpvalue)~="function"
        or type(setUpvalue)~="function" then return false end
    local candidates={}
    local seenTables=0
    -- debug.getupvalue returns (name,value); some executors return
    -- only value. Read both return conventions without guessing.
    for i=1,32 do
        local ok,first,second=pcall(getUpvalue,fn,i)
        if not ok then break end
        local value=second~=nil and second or first
        if type(value)=="table" then
            seenTables+=1
            -- 2026-11 renderer: ONE shared state table; the arm swing is
            -- driven by state.lastPunchAt (os.clock) + lastPunchKey (tile key).
            -- Verified with ArmDiag2 (manual punch: lastPunchAt == os.clock).
            if type(rawget(value,"lastPunchAt"))=="number"
                and rawget(value,"lastPunchKey")~=nil then
                Anim.state=value
                Anim.fn=fn
                print("[Animation] Arm bound to state.lastPunchAt")
                return true
            end
            local t=rawget(value,"t")
            local facing=rawget(value,"facing")
            if (type(t)=="number" or t==nil)
                and (type(facing)=="number" or facing==nil)
                and (t~=nil or facing~=nil)
                and (rawget(value,"x")~=nil or rawget(value,"y")~=nil
                    or (t~=nil and facing~=nil)) then
                candidates[#candidates+1]=i
            end
        end
    end
    if #candidates~=1 then
        if os.clock()-armDiagAt>12 then
            armDiagAt=os.clock()
            print("[Animation] Renderer found; action-state candidates",
                #candidates,"tables",seenTables,
                "| no unsafe upvalue replacement")
        end
        return false
    end
    Anim.fn=fn
    Anim.idx=candidates[1]
    Anim.set=setUpvalue
    print("[Animation] Arm bound at upvalue",Anim.idx)
    return true
end

local function findArm()
    if Anim.fn then return true end
    -- Avoid scanning every renderer callback on each placement.
    if os.clock()-armFindAt<5 then return false end
    armFindAt=os.clock()

    -- First inspect render connections.
    if type(getconnections) == "function" then

        local signals = {
            "RenderStepped",
            "Heartbeat",
            "PreRender",
            "Stepped"
        }

        for _, name in ipairs(signals) do
            local okSignal, signal = pcall(function()
                return RunService[name]
            end)

            if okSignal and signal then
                local ok, connections =
                    pcall(getconnections, signal)

                if ok and type(connections) == "table" then
                    for _, connection in ipairs(connections) do

                        local okFn, renderFn = pcall(function()
                            return connection.Function
                        end)

                        if okFn
                            and type(renderFn) == "function" then

                            -- Renderer itself may be the RenderStepped handler.
                            if isArmFn(renderFn) and bindArm(renderFn) then
                                return true
                            end
                            for _,fn in pairs(readUpvalues(renderFn)) do
                                if isArmFn(fn) and bindArm(fn) then
                                    return true
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    -- Fallback: find matching renderer in the cached GC snapshot.
    for _, fn in pairs(gcObjects) do
        if isArmFn(fn) and bindArm(fn) then return true end
    end
    if os.clock()-armDiagAt>12 then
        armDiagAt=os.clock()
        print("[Animation] Arm not bound | renderer/state not verified")
    end
    return false
end

local function findParticles()
    local found = {}

    for _, obj in pairs(gcObjects) do
        if type(obj) == "table" then
            local mt = getmetatable(obj)

            local place =
                rawget(obj, "place")
                or (
                    type(mt) == "table"
                    and rawget(mt, "place")
                )

            if type(place) == "function"
                and type(rawget(obj, "live")) == "table"
