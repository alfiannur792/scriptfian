local function detectNativePunch()
    -- V60: identify the native `hit` function, not its remoteHit helper.
    -- Observed signature: 4 parameters, newCrack, punchEvent, and the
    -- vending-machine public-area restriction text.
    if type(getConsts) ~= "function" then
        return nil, 0, "debug.getconstants unavailable"
    end
    local found, n = nil, 0
    local objects = gcObjects
    if type(getgc) == "function" then
        local ok, live = pcall(getgc, true)
        if ok and type(live) == "table" then objects = live end
    end
    for _, obj in pairs(objects) do
        if type(obj) == "function" then
            local consts = constantsOf(obj)
            local crack, event, vending = false, false, false
            for _, c in pairs(consts) do
                if c == "newCrack" then crack = true end
                if c == "punchEvent" then event = true end
                if c == "You can't break a Vending Machine in a public area." then
                    vending = true
                end
            end
            if crack and event and vending then
                local params = nil
                pcall(function()
                    local info = debug.getinfo(obj)
                    params = info and info.numparams
                end)
                if params == nil or params == 4 then
                    n += 1
                    found = obj
                end
            end
        end
    end
    if n == 1 then return found, n, nil end
    return nil, n, n == 0 and "Native hit not found" or "Ambiguous native hit candidates"
end

local function breakTileAt(x, y)
    local fg = tileAt("fg", x, y)
    local bg = tileAt("bg", x, y)
    return fg, bg
end

local function breakableId(id)
    -- Match the behavior in k.lua canBreak(): missing DB entries
    -- are not automatically rejected; seeds use the seed hit rule.
    if type(id) ~= "number" or id == 0 then return false end
    local it = db and db[id]
    if type(it) ~= "table" then return true end
    if it.lock or it.area or it.vend or it.display then return false end
    local hits = (it.kind == "seed") and 20 or it.hits
    return hits == nil or tonumber(hits) == nil or tonumber(hits) > 0
end

local function breakLayerAt(x, y)
    local fg, bg = breakTileAt(x, y)
    if breakableId(fg) then return "fg", fg end
    if (fg == 0 or fg == nil) and breakableId(bg) then
        return "bg", bg
    end
    return nil, nil
end

local function breakWithinRange(x, y)
    local state = getState()
    return state and inRange(state, x, y)
end

-- Match Auto Place's integer player-tile anchoring. Rebuild only when the
-- player crosses a tile boundary; the selected 5x5 offsets are preserved.
local function setBreakAnchor()
    local state = getState()
    if not state then return false, false end
    local x, y = math.floor(state.x), math.floor(state.y - 0.475)
    local worldKey = refs.worldKey()
    local moved = not breakAnchor or breakAnchorWorld ~= worldKey
        or breakAnchor.x ~= x or breakAnchor.y ~= y
    if moved then
        breakAnchor = {x = x, y = y}
        breakAnchorWorld = worldKey
        print("[AUTO BREAK GRID FOLLOW PLAYER]", x, y)
        if breakRunning and running then
            setPNBPhase("PLACE", "player moved to another tile")
        end
    end
    return true, moved
end

local function breakList()
    if not setBreakAnchor() then return {} end
    local out = {}
    for _, o in pairs(breakSelected) do
        local x, y = breakAnchor.x + o.dx, breakAnchor.y + o.dy
        if tileAt("fg", x, y) ~= nil then
            table.insert(out, {x = x, y = y})
        end
    end
    table.sort(out, function(a, b)
        return a.y == b.y and a.x < b.x or a.y < b.y
    end)
    return out
end

