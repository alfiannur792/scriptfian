local function getUpvaluesSafe(fn)
    local result = {}
    if type(fn) ~= "function" then return result end
    local all = debug and debug.getupvalues
    if type(all) == "function" then
        local ok, uv = pcall(all, fn)
        if ok and type(uv) == "table" then
            for _, v in pairs(uv) do result[#result + 1] = v end
            return result
        end
    end
    local one = (debug and debug.getupvalue) or getupvalue
    if type(one) ~= "function" then return result end
    for i = 1, 48 do
        local ok, v = pcall(one, fn, i)
        if not ok then break end
        if v ~= nil then result[#result + 1] = v end
    end
    return result
end

