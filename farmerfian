            end
            if now<nextAction then return false end
            local pick=nil
            if harvestSweep.active and inMotion then
                -- Local 5-tile reach probe, not a 100x60 scan or movement
                -- decision. Prioritize nearby trees in travel direction.
                local mid=math.floor(state.x)
                local y=harvestSweep.row
                local dir=harvestSweep.dir
