    end

    if #found > 0 then
        Anim.particles = found[1]
        print("[Animation] Particle pool found")
        return true
    end

    return false
end

local function swing(x, y)
    local S=Anim.state
    if S then
        local ok=pcall(function()
            local w=tonumber(world.w) or 100
            local now=os.clock()
            local st=getState()
            local facing=(st and x+0.5<st.x) and -1 or 1
            -- ArmDiag3 (manual punch): the game writes S.action =
            -- {t,x,y,facing,kind="punch"} + lastPunchAt/Key + facing.
            -- The renderer draws the arm from S.action.
            S.action={t=now,x=x+0.5,y=y+0.5,facing=facing,kind="punch"}
            S.lastPunchAt=now
            S.lastPunchKey=y*w+x
            S.facing=facing
        end)
        if ok then Anim.swings+=1 return true end
        Anim.state=nil
        return false
    end
    if not (
        Anim.fn and Anim.idx and Anim.set
    ) then
        return false
    end

    local s = getState()

    if not s then
        return false
    end

    local facing =
        (x + 0.5 < s.x) and -1 or 1

    local action = {
        t = os.clock(),
        x = x + 0.5,
        y = y + 0.5,
        facing = facing,
        kind = "build"
    }

    local ok,result=pcall(Anim.set,Anim.fn,Anim.idx,action)
    if ok and result~=false then
        Anim.swings+=1
        return true
    end
    -- Some executors reject debug.setupvalue for protected callbacks.
    -- Do not keep a stale binding that can never animate.
    Anim.fn,Anim.idx,Anim.set=nil,nil,nil
    if os.clock()-armDiagAt>12 then
        armDiagAt=os.clock()
        warn("[Animation] Arm write failed:",tostring(result))
    end
    return false
end

local function puff(x, y)
