                                or (ty<by-1 and "too high")
                                or (math.abs(tx-bx)>20 and ">20 tiles")
                                or (not touchGround(tx,by) and "no ground")
                                or "missed"
                            why[r]=(why[r] or 0)+1
                        end
                    end
                end
                if left>0 then
                    local parts={}
                    for k,v in pairs(why) do parts[#parts+1]=k.."="..v end
                    print("[AUTO FARM HARVEST COLLECT LEFT] row",y,"| drops",left,
                        "| at",bx,by,"|",table.concat(parts," "))
                end
            end)
            if swept or touchCount>touchBefore then
                print("[AUTO FARM HARVEST COLLECT REVISIT] row",y,
                    "| sweep",swept,"| confirmed",touchCount-touchBefore)
            end
        end
        if moved then
            -- Do not overwrite the audit's direction toward missed trees.
            if phase~="harvest" or not orderedHarvestGoal then
                preferredDir=direction
            end
            return true
        end
        return false
    end

    local harvestUnreachableUntil=0
    local function roamStep(run,plantTarget,specialGoal)
        -- Refill/return has a verified exact destination: prioritize its
        -- retry over ordinary Farm path discovery, without busy polling.
        local trip=specialGoal and (specialGoal.kind=="refill"
            or specialGoal.kind=="return")
        local retryWindow=trip and 0.22 or (rotation.enabled and 0.95 or 1.05)
        if not roamOn or os.clock()-roamLast<retryWindow then
            return false,"cooldown"
        end
        roamLast=os.clock()
        local route,target,counts=roamPath(run,plantTarget,specialGoal)
        if not route or #route==0 or not target then
            -- An empty Plant route is a normal no-work check. Retry in about
            -- one second; keep longer cooldown for other path searches.
            roamLast=os.clock()+
                ((trip and 0.45) or (phase=="plant" and 0 or 2.3))
            if os.clock()-touchLast>5 then
                touchLast=os.clock()
                print("[AUTO FARM WORLD]",phase,"Scan:",tostring(target or "unknown"),
                    "| world",world.w,world.h)
            end
            if phase=="harvest" and type(target)=="string"
                and (target:find("no standable goals",1,true)
                    or target:find("no traversable route",1,true)) then
                harvestUnreachableUntil=os.clock()+18
            end
            if type(target)=="string" and
                (target:find("no standable goals",1,true)
                or target:find("no traversable route",1,true)) then
                return false,"empty"
            end
            return false,"unavailable"
        end
        local ok,reason=touchHook()
        if not ok then
            if os.clock()-touchLast>5 then
                touchLast=os.clock()
                print("[AUTO FARM ROAM] Movement blocked:",reason)
            end
            return false,"busy"
        end
        print("[AUTO FARM WORLD] FULL SCAN | selected seed",seedId or "-",
            "| selected trees",counts.selected,"| all trees",counts.trees,
            "| harvest ready",counts.harvest,"plant",counts.plant,
            "drop",counts.drop,"| tree map",treeData~=nil)
        print("[AUTO FARM ROAM] Phase",phase,"| goal",target.kind,target.tx,target.ty,
            "| route",#route,"steps | world",world.w,world.h)
        local success=true
        local _,startX,startY=touchPosition()
        -- Use the same goal predicate during both physical and direct
        -- navigation, so neither keeps chasing a finished crop.
        local function stillNeeded()
            if target.kind=="harvest" then
                return harvestOn and readyTree(target.tx,target.ty)
            elseif target.kind=="return" then
                -- Every Rotation travel mode (incl. goSeed) and the
                -- standalone directTest keep a return goal alive.
                return (refill~=nil and refill.mode=="return")
                    or (rotation.enabled and (rotation.mode=="goBreak"
                        or rotation.mode=="goHome" or rotation.mode=="goSeed"))
                    or env.Fian792DirectTestRun~=nil
                    or (env.Fian792BuilderTravel and env.Fian792BuilderTravel.live())
            elseif target.kind=="refill" then
                local uid=tonumber(target.key:match(":(%d+)$"))
                return refill~=nil and uid and touchDropPresent({uid=uid})
            elseif target.kind=="plant" then
                return plantOn and seedId and countItem(seedId)>0
                    and plantSpot(target.tx,target.ty)
            end
            local uid=tonumber(target.key:match(":(%d+)$"))
            return collectOn and uid and touchDropPresent({uid=uid})
        end
        -- Direct mode does not replay legacy walk/jump/fall instructions:
        -- old fall edges caused hundreds of false failures and route rescan loops.
        -- Refill and return MUST follow standable world-path edges (walk,
        -- jump, fall, gaps). Direct physics waypoint travel is allowed for
        -- ordinary farm only: it can look like a wall bypass or oscillate
        -- near solid rows during trips to/from the stored seed pile.
        -- Rotation travel may use the native collision-aware direct route.
        -- Seed refill retains the original physical-only route. For one-way
        -- Platform sections, platformRoute below still forces physical steps.
        local rotationTravel = (rotation.enabled
            and (rotation.mode=="goBreak" or rotation.mode=="goHome"
                or rotation.mode=="goSeed"))
            or env.Fian792DirectTestRun~=nil
            or env.Fian792BuilderTravel~=nil
        local safeRefillTrip = specialGoal
            and (specialGoal.kind=="refill" or specialGoal.kind=="return")
            and (specialGoal.physicalOnly==true or not rotationTravel)
        -- One-way Platforms are safe ground for Farm movement, but native
        -- boxHits used by Direct Movement can treat their collision surface
        -- as an obstruction. Keep the planned route and replay physical
        -- walk/jump/fall steps whenever any waypoint stands on Platform.
        -- No extra world scan: inspect only the route already calculated.
        local platformRoute=false
        local function supportedByPlatform(tx,ty)
            if tx<0 or tx>=world.w or ty+1>=world.h then return false end
            local floor=db[tileAt("fg",tx,ty+1) or 0]
            return type(floor)=="table" and floor.platform==true
                and not floor.deadly and not floor.hurts and not floor.laser
        end
        if startX and startY and supportedByPlatform(startX,startY) then
            platformRoute=true
        else
            for _,waypoint in ipairs(route) do
                if supportedByPlatform(waypoint.x,waypoint.y) then
                    platformRoute=true
                    break
                end
            end
        end
        if platformRoute then
            print("[AUTO FARM PLATFORM SUPPORT] Physical movement selected |",
                target.kind,"| route",#route)
        end
        if directPhysics and not safeRefillTrip and not platformRoute then
            -- Long-range goals are approached through bounded corridor chunks.
            -- Trying to find a full 70-tile path at once caused instant BLOCKED
            -- and incorrectly advanced the planting cursor each time.
            local cursor=1
            success=#route>0
            local failureAt=nil
            local completedEarly=false
            while success and cursor<=#route and touchLive(run) do
                if not stillNeeded() then
                    completedEarly=true
                    break
                end
                local px,py=directPhysics.px,directPhysics.py
                local chosen=nil
                -- Look ahead only along an actual clear segment. Selecting
                -- the farthest waypoint based on endpoint collision alone
                -- skipped intervening walls and caused long U-turns.
                local maxIndex=math.min(#route,cursor+6)
                for j=cursor,maxIndex do
                    local e=route[j]
                    local tx,ty=e.x+0.5,e.y+0.999
                    local dx,dy=tx-px,ty-py
                    if dx*dx+dy*dy>144 then break end
                    if directClear(tx,ty) and directSegment(px,py,tx,ty) then
                        chosen=j
                    else
                        break
                    end
                end
                -- An immediate route edge might require a local detour;
                -- preserve directPath's safe fallback for that edge only.
                if not chosen then chosen=cursor end
                local reached=false
                local j=chosen
                for attempt=1,3 do
                    if j<cursor then break end
                    local e=route[j]
                    if directClear(e.x+0.5,e.y+0.999) then
                        local moved,reason=directMoveTo(
                            e.x+0.5,e.y+0.999,run,nil,false,stillNeeded)
                        if moved then
                            reached=true
                            cursor=j+1
                            if not stillNeeded() then completedEarly=true end
                            break
                        end
                    end
                    if j==cursor then break end
                    j=math.max(cursor,j-3)
                end
                if not reached then
                    failureAt=cursor
                    success=false
                    break
                end
                if completedEarly then break end
            end
            if not touchLive(run) then success=false end
            touchUnhook()
            -- Direct is OFF now (gravity restored): wait to land before the
            -- plant/harvest work loop takes over.
            do
                local t0=os.clock()
                while os.clock()-t0<0.8 do
                    local st=touchPosition()
                    if st and st.grounded then break end
                    task.wait(0.03)
                end
                -- The FIRST plant/harvest right after Direct was still
                -- rejected (UNCONFIRMED) even when grounded: give the server
                -- time to accept the new position before acting.
                local settle=tonumber(env.Fian792DirectSettle) or 0.4
                if success and settle>0 then task.wait(settle) end
                if success then plantSweep.nearOnlyUntil=os.clock()+1.0 end
            end
            if not success then
                if dropPause or guardPaused or not alive() or ownRun~=run then
                    return false,"interrupted"
                end
                -- Never mark a target planted/harvested merely because direct
                -- navigation could not reach it. Retry later, same cursor.
                roamCooldown[target.key]=os.clock()+12
                navFailures[target.key]=nil
                if target.kind=="harvest" then
                    harvestUnreachableUntil=os.clock()+12
                end
                idleUntil=os.clock()+8
                print("[AUTO FARM DIRECT ROAM] PATH WAIT",target.kind,
                    target.tx,target.ty,"| step",failureAt or cursor,
                    "/",#route,"| preserve work cursor")
                return false,"path-wait"
            end
            navFailures[target.key]=nil
            local dest=route[#route]
            if completedEarly then
                local _,ax,ay=touchPosition()
                print("[AUTO FARM DIRECT GOAL COMPLETE] Replan from",ax,ay,
                    "| previous",target.kind,target.tx,target.ty)
            else
                print("[AUTO FARM DIRECT ROAM] ARRIVED",target.kind,
                    "| work tile",dest.x,dest.y)
            end
            -- Direct motion reaches the WORK POSITION, not proof of harvest,
            -- planting, or item pickup. The regular native work loop validates
            -- world FG / drop UID and performs contact actions after arrival.
            return true,"arrived"
        end
        
        local i=1
        while i<=#route do
            if not touchLive(run) or not roamOn then
                success=false
                break
            end
            local e=route[i]
            if (i==1 or i%8==0) and not stillNeeded() then
                -- Farming actions can complete the intended target while
                -- traversing the route. This is success, NOT a broken edge.
                print("[AUTO FARM ROAM] Goal completed during movement; replan")
                success=true
                break
            end
            -- Merge continuous straight walking steps into one movement.
            -- This avoids braking/accelerating at EVERY individual tile.
            local last=i
            if e.kind=="walk" then
                local direction=e.x-e.fx
                while last<#route and last-i<12 do
                    local n=route[last+1]
                    local p=route[last]
                    if not n or n.kind~="walk" or n.y~=e.y
                        or n.fy~=e.y or n.fx~=p.x
                        or n.x-n.fx~=direction then break end
                    last+=1
                end
            end
            local okStep
            if last>i then
                local targetStep=route[last]
                okStep=touchMoveTo(targetStep.x+0.5,targetStep.y,run,
                    math.min(9,2+0.45*math.abs(targetStep.x-e.fx)))
            else
                okStep=roamStepExec(e,run,safeRefillTrip or platformRoute)
            end
            if not okStep and
                (e.kind=="jump" or e.kind=="stair" or e.kind=="fall"
                    or e.kind=="gap" or e.kind=="longjump") then
                -- Observe a short landing settle before rejecting an edge.
                touchRelease()
                local settleAt=os.clock()
                local dest=(last>i) and route[last] or e
                while touchLive(run) and os.clock()-settleAt<0.22 do
                    local live,lx,ly=touchPosition()
                    if live and live.grounded
                        and lx==dest.x and ly==dest.y then
                        okStep=true
                        print("[AUTO FARM NAV] Landing confirmed",e.kind,lx,ly)
                        break
                    end
                    task.wait(0.035)
                end
            end
            if not okStep then
                success=false
                local _,actualX,actualY=touchPosition()
                local fromX,fromY=e.fx,e.fy
                if actualX and actualY and actualY==e.fy then
                    fromX,fromY=actualX,actualY
                end
                local direction=e.x>e.fx and 1 or -1
                local toX=(last>i) and (fromX+direction) or e.x
                local toY=(last>i) and fromY or e.y
                if e.kind=="walkGap" then
                    fromX,fromY=e.fx,e.fy
                    toX,toY=e.x,e.y
                end
                -- Record the actual planned edge. A long merged walk
                -- may fail near the destination; estimating fromX +/- 1
                -- fabricated invalid edges such as X0 -> X-1.
                if fromX<0 or fromX>=world.w or fromY<0
                    or fromY>=world.h or toX<0 or toX>=world.w
                    or toY<0 or toY>=world.h then
                    fromX,fromY=e.fx,e.fy
                    toX,toY=e.x,e.y
                end
                if active and not dropPause and not guardPaused then
                    local key=tostring(fromY*world.w+fromX)..">"
                        ..tostring(toY*world.w+toX)..":"..e.kind
                    edgeFailures[key]=(edgeFailures[key] or 0)+1
                    if edgeFailures[key]>=2 then
                        failedEdges[key]=os.clock()+
                            ((e.kind=="jump" or e.kind=="stair") and 8 or 20)
                        edgeFailures[key]=0
                        print("[AUTO FARM NAV] Edge failed twice; pause edge",
                            e.kind,fromX,fromY,"->",toX,toY)
                    else
                        print("[AUTO FARM NAV] Keeping edge for retry",
                            e.kind,fromX,fromY,"->",toX,toY)
                    end
                end
                print("[AUTO FARM ROAM] Failed",e.kind,fromX,fromY,
                    "->",toX,toY,"at step",i,"/",#route)
                break
            end
            touchRelease()
            i=last+1
        end
        touchUnhook()
        if success and startX and target.tx~=startX
            and phase~="plant" and phase~="harvest" then
            preferredDir=target.tx>startX and 1 or -1
        end
        if not success then
            if dropPause or guardPaused or not alive() or ownRun~=run then
                return false,"interrupted"
            end
            navFailures[target.key]=(navFailures[target.key] or 0)+1
            if navFailures[target.key]>=3 then
                roamCooldown[target.key]=os.clock()+12
                navFailures[target.key]=nil
                print("[AUTO FARM ROAM] Route retry exhausted; cool target 12s")
                return false,"blocked"
            end
            print("[AUTO FARM ROAM] Same target retry",
                navFailures[target.key],"/3")
            return false,"retry"
        elseif alive() and ownRun==run then
            navFailures[target.key]=nil
            print("[AUTO FARM ROAM] Arrived for",target.kind,target.tx,target.ty)
        end
        return success,success and "arrived" or "blocked"
    end
    -- Small dropList pass, not a world-grid scan. Used to avoid repeated
    -- Harvest <-> Collect transitions when no immediately useful loot exists.
    local function anyFarmLoot()
        if not collectOn then return false end
        local fn=rawget(world,"dropList")
        if type(fn)~="function" then return false end
        local ok,drops=pcall(fn)
        if not ok or type(drops)~="table" then return false end
        for _,d in pairs(drops) do
            if type(d)=="table" and type(d.uid)=="number"
                and type(d.x)=="number" and type(d.y)=="number"
                and type(d.id)=="number" and (tonumber(d.n) or 0)>0
                and not d.pending and not d.taking and not d.display
                and (touchCooldown[d.uid] or 0)<=os.clock()
                and not reservedAutoDropPile(d) and cropDrop(d)
                and (d.id==112 or countItem(d.id)<200) then
                return true
            end
        end
        return false
    end
    local function nextPhase(reason)
        if farmBlockOnly and not rotation.enabled then
            phase="collect"
            nextAction=os.clock()+0.5
            return
        end
        local order={"plant","harvest","collect"}
        local original=phase
        local idx=1
        for j,v in ipairs(order) do if v==original then idx=j;break end end
        for step=1,3 do
            local candidate=order[(idx+step-1)%3+1]
            local permitted=(candidate=="plant" and plantOn and seedId
                    and db[seedId] and db[seedId].kind=="seed"
                    and (countItem(seedId)>0 or
                        -- Rotation low soil: the dropped pile is NOT a refill
                        -- source (refill is disabled), so it can't enable Plant.
                        (not (rotation.enabled and rotation.lowSoil)
                            and os.clock()>=refillRetryAt and seedStashDrop()~=nil))
                    and hasPlantWork(true))
                or (candidate=="harvest" and harvestOn
                    and os.clock()>=harvestUnreachableUntil
                    and (treeData or next(observedTrees)~=nil)
                    and type(punch)=="function")
                or (candidate=="collect" and collectOn
                    and type(rawget(world,"dropList"))=="function")
            if permitted then
                if original=="harvest" and candidate~="harvest" then
                    tractor.unequip("Harvest -> "..candidate)
                end
                phase=candidate
                plantPending=nil
                plantSweep.pending={};plantSweep.inflight={}
                harvestPending=nil
                if phase=="plant" then resetPlantSweep() end
                if phase~=original then
                    print("[AUTO FARM PHASE]",original,"->",phase,
                        "|",tostring(reason))
                end
                nextAction=os.clock()+((original=="plant" and phase=="harvest") and 0.15 or 0.45)
                status("Phase: "..phase)
                return
            end
        end
        -- All enabled phases are temporarily unavailable; keep Farm ON
        -- and let the recovery scanner discover inventory/tree references.
        phase=original
        nextAction=os.clock()+2
        status("ON (WAIT) | seed/tree/punch/drop data not yet ready")
    end

    -- Rotation controller is serviced from the ONE Farm coroutine. No competing
    -- player movement task and no independent full-map scan.
    -- A Rotation wait that repeats without interruption for longer than
    -- `limit` seconds stops Rotation with a visible reason. A gap of more
    -- than 3s between calls (Farm work resumed, pause) restarts the timer.
    -- Stored on `rotation` to avoid new locals in this large Farm proto.
    rotation.waitLimit=15
    function rotation.waitExpired(reason)
        local now=os.clock()
        if rotation.waitReason~=reason
            or now-(rotation.waitLast or 0)>3 then
            rotation.waitReason=reason
            rotation.waitSince=now
        end
        rotation.waitLast=now
        if now-rotation.waitSince<rotation.waitLimit then return false end
        warn("[ROTATION] Timeout",rotation.waitLimit,"s |",reason)
        rotationRequestStop("Rotation timeout: "..reason)
        status("ROTATION STOP | timeout: "..reason)
        return true
    end
    function rotation.waitStatus(reason)
        local left=math.max(0,rotation.waitLimit-
            (os.clock()-(rotation.waitSince or os.clock())))
        status("ROTATION WAIT | "..reason.." | stop in "..math.ceil(left).."s")
    end
    local function rotationStep(run)
        hitchMark("rotationStep")
        if not rotation.enabled then return false end
        -- The native world table is reused across worlds: a world switch
        -- during travel/PNB must cancel, never reuse saved coordinates.
        if rotation.mode~="farm" and rotation.world
            and rotation.world~=refs.worldKey() then
            warn("[ROTATION] World changed during",rotation.mode)
            if rotation.mode=="breaking" then
                local pnb=env.Fian792RotationPNB
                if pnb then pnb.stopPlace();pnb.stopBreak();pnb.stopCollect() end
            end
            rotationRequestStop("World changed during Rotation")
            status("ROTATION STOP | world changed")
            return true
        end
        -- Saved Seed/Block drop tiles (+ observed landing tiles) are never
        -- taken by the PNB collector while Rotation runs.
        do
            local reserved=env.Fian792ReservedDropTiles
            if type(reserved)~="table" then
                reserved={}
                env.Fian792ReservedDropTiles=reserved
            end
            local saved=env.Fian792SavedAutoDrop
            if type(saved)=="table" and saved.world==refs.worldKey()
                and type(saved.points)=="table" then
                for _,name in ipairs({"seed","block"}) do
                    local p=saved.points[name]
                    if type(p)=="table" and type(p.dropX)=="number"
                        and type(p.dropY)=="number" then
                        reserved[p.dropX..","..p.dropY]=true
                    end
                end
            end
        end
        if rotation.mode=="farm" then
            -- Rotation drops full seed only when the WHOLE world lacks
            -- a physical planting spot. Failed navigation is not proof
            -- that an empty valid planting tile has been filled.
            local drop=env.Fian792DropRuntime
            local returning=drop and type(drop.rotationSeedReturning)=="function"
                and drop.rotationSeedReturning(seedId)
            local seedOK=seedId and rotation.selectedSeed==seedId
            local fullSeed=seedOK and countItem(seedId)>=200
            -- A successful refill must finish its return path before
            -- Rotation evaluates any new planting/drop trip.
            if phase=="refill" then return false end
            -- Throttled full-world audit of remaining planting spots.
            local freshAudit=false
            if seedOK and not returning
                and os.clock()>=(rotation.seedPlantCheckAt or 0) then
                rotation.seedPlantCheckAt=os.clock()+2
                local spots=rotation.countPlantSpots(rotation.lowSoilSpots)
                rotation.plantSpotsLeft=spots
                rotation.lowSoil=spots<=rotation.lowSoilSpots
                rotation.seedPlantAvailable=spots>0
                freshAudit=true
            end
            -- Drop the seed above what the remaining spots can use and come
            -- back to `home`. `keep` seeds stay in the inventory.
            local function seedTrip(keep,label)
                -- Long trips use the Farm's Direct route (fast, reliable);
                -- the V68 drop navigator then only covers the stand tile.
                if label~="return" then
                    local saved=env.Fian792SavedAutoDrop
                    local sp=type(saved)=="table" and saved.world==refs.worldKey()
                        and type(saved.points)=="table" and saved.points.seed or nil
                    local s1,px,py=touchPosition()
                    if type(sp)=="table" and type(sp.dropX)=="number"
                        and type(sp.dropY)=="number" and s1 and px then
                        local tx,ty=sp.dropX,sp.dropY
                        local face=(px>tx and -1) or (px<tx and 1)
                            or (sp.facing==-1 and -1 or 1)
                        local sx=tx-face
                        if not (px==sx and py==ty) and touchGround(sx,ty) then
                            rotation.mode="goSeed"
                            rotation.seedStand={x=sx,y=ty}
                            rotation.seedKeep=keep
                            rotation.seedLabel=label
                            rotation.world=refs.worldKey()
                            rotation.navFails=0
                            rotation.settleStarted=nil
                            touchUnhook()
                            print("[ROTATION SEED DROP]",label,"| travel (Direct) to stand",
                                sx,ty,"| drop tile",tx,ty)
                            nextAction=os.clock()+0.10
                            return true
                        end
                    end
                end
                touchUnhook()
                local s,x,y=touchPosition()
                if not s or not s.grounded then
                    nextAction=os.clock()+0.25
                    return true
                end
                if not drop or type(drop.rotationSeedTrip)~="function" then
                    status("ROTATION SEED DROP WAIT | bridge belum siap")
                    nextAction=os.clock()+1
                    return true
                end
                print("[ROTATION SEED DROP]",label,"| stock",countItem(seedId),
                    "| keep",keep,"| spots left",rotation.plantSpotsLeft or "-")
                local ok,done,why=pcall(drop.rotationSeedTrip,seedId,{x=x,y=y},keep)
                if not ok or not done then
                    rotation.seedDropRetryAt=os.clock()+5
                    warn("[ROTATION SEED DROP RETRY]",tostring(ok and why or done))
                    status("ROTATION SEED DROP RETRY | "..tostring(ok and why or done))
                else
                    rotation.seedDropRetryAt=0
                    print("[ROTATION SEED DROP] completed | stock",countItem(seedId))
                end
                nextAction=os.clock()+0.25
                return true
            end
            if fullSeed and not returning and freshAudit
                and not rotation.lowSoil then
                if rotation.seedPlantAvailable then
                    -- Revisit previously completed lower rows if newly
                    -- emptied soil is present there. Throttle the audit
                    -- instead of resetting the sweep every Farm tick.
                    if phase~="plant" or not plantSweep.row then
                        local previous=phase
                        resetPlantSweep()
                        plantPending=nil
                        phase="plant"
                        rotationPlantExhausted=false
                        rotationPlantCheckAt=0
                        nextAction=os.clock()+0.10
                        print("[ROTATION SEED FULL -> PLANT]",
                            "stock",countItem(seedId),
                            "| before",previous,
                            "| full-world planting spot found")
                        status("ROTATION PLANT PRIORITY | seed full, soil available")
                        return true
                    end
                    -- An active Plant sweep must continue uninterrupted.
                    return false
                end
            end
            -- Low soil (<= lowSoilSpots left in the whole world): drop the
            -- WHOLE seed stack once it reaches seedDropMinExcess. The last
            -- spots are replanted from harvest seeds (refill is disabled).
            -- A confirmed drop whose return trip failed resumes the return.
            -- Low soil drops only AFTER planting: while the Plant phase still
            -- has spots to fill, the seeds in the bag are used first.
            local plantDone=phase~="plant" or (rotation.plantSpotsLeft or 0)==0
            local lowStock=seedOK and rotation.lowSoil and plantDone
                and countItem(seedId) or 0
            if seedOK and (returning or lowStock>=rotation.seedDropMinExcess)
                and os.clock()>=(rotation.seedDropRetryAt or 0) then
                return seedTrip(0,returning and "return" or "low soil")
            end
            local blockId=rotation.selectedBlock
            if not blockId then return false end
            local stock=countItem(blockId)
            if stock<=0 then return false end
            local full=stock>=rotation.threshold
            -- If a partial PNB stock could not be placed, avoid cycling
            -- Farm -> Break -> Farm every frame while keeping it intact.
            if not full and os.clock()<(rotation.partialBreakRetryAt or 0)
                then return false end
            local exhausted=false
            if not full then
                -- Partial stock is only eligible after Plant has switched to
                -- Harvest/Collect. A full stack can interrupt Plant immediately.
                if phase~="harvest" and phase~="collect" then return false end
                local now=os.clock()
                if now>=rotationPlantCheckAt then
                    rotationPlantCheckAt=now+1
                    local emptySpots=not hasPlantWork(true)
                    local noSeed=seedId and countItem(seedId)<=0
                    -- Low soil: the dropped pile is not a refill source.
                    local stash=noSeed and not emptySpots
                        and not rotation.lowSoil and seedStashDrop() or nil
                    rotationPlantExhausted=emptySpots or (noSeed and not stash)
                end
                exhausted=rotationPlantExhausted
                if not exhausted then return false end
                -- Refresh readiness before every partial-stock Break. Harvest
                -- MUST win if any selected crop is mature anywhere in world.
                -- Avoid redundant full scans while target remains locked.
                if not orderedHarvestGoal or not readyTree(
                    orderedHarvestGoal.x,orderedHarvestGoal.y) then
                    harvestScanAt=0
                end
                local ready=(harvestOn and now>=harvestUnreachableUntil)
                    and orderedHarvestTarget() or nil
                if ready then
                    if phase~="harvest" then
                        phase="harvest"
                        nextAction=now+0.10
                        print("[ROTATION] HARVEST PRIORITY | ready at",ready.x,ready.y,
                            "| block",stock,"<",rotation.threshold)
                    end
                    return false
                end
            end
            local saved=env.Fian792SavedAutoDrop
            local p=saved and saved.points and saved.points.breakPoint
            local s,x,y=touchPosition()
            if not p or not p.x or not p.y or not s or not s.grounded
                or not roamOn or saved.world~=refs.worldKey() then
                local why="simpan Posisi Break pada world ini + Auto Roam ON"
                if rotation.waitExpired(why) then return true end
                rotation.waitStatus(why)
                nextAction=os.clock()+2
                return true
            end
            -- Rotation only needs a cheap support test. Both Dirt (solid)
            -- and Platform (one-way) count as stable ground, using the
            -- same verified Farm collision-aware predicate.
            if not touchGround(x,y)
                or not touchGround(math.floor(p.x),math.floor(p.y)) then
                local why="posisi Farm/Break belum punya support (Dirt/Platform)"
                if rotation.waitExpired(why) then return true end
                rotation.waitStatus(why)
                nextAction=os.clock()+1
                return true
            end
            -- Tractor slows down long routes and must not stay equipped
            -- while travelling to the Break point.
            if not tractor.unequip("Rotation -> Break") and tractor.active then
                local why="cannot unequip tractor"
                if rotation.waitExpired(why) then return true end
                rotation.waitStatus(why)
                nextAction=os.clock()+1
                return true
            end
            -- Make room for the seeds PNB will drop (1 per broken block):
            -- with low soil, drop the stack first (same minimum, so no
            -- 1-3 seed trips). A failed trip sets a 5s retry gate, so PNB
            -- still starts on the next tick.
            if seedOK and rotation.lowSoil
                and (phase~="plant" or (rotation.plantSpotsLeft or 0)==0)
                and countItem(seedId)>=rotation.seedDropMinExcess
                and os.clock()>=(rotation.seedDropRetryAt or 0) then
                return seedTrip(0,"before PNB")
            end
            rotation.waitReason=nil
            rotation.world=refs.worldKey()
            rotation.blockId=blockId
            rotation.home={x=x,y=y}
            rotation.mode="goBreak"
            rotation.navFails=0
            rotation.settleStarted=nil
            rotation.started=os.clock()
            touchUnhook()
            print("[ROTATION] BREAK TRIGGER",full and "FULL 200" or "PLANT EXHAUSTED",
                "| block",blockId,"stock",stock,
                "| break",p.x,p.y,"| home",x,y)
            return true
        end
        if rotation.mode=="goBreak" or rotation.mode=="goHome"
            or rotation.mode=="goSeed" then
            if running or breakRunning then
                status("ROTATION WAIT | PNB still stopping")
                nextAction=os.clock()+0.2
                return true
            end
            local dest
            if rotation.mode=="goBreak" then
                local saved=env.Fian792SavedAutoDrop
                dest=saved and saved.world==refs.worldKey()
                    and saved.points and saved.points.breakPoint or nil
            elseif rotation.mode=="goSeed" then
                dest=rotation.seedStand
            else
                dest=rotation.home
            end
            if not dest or not dest.x or not dest.y then
                warn("[ROTATION] Missing destination; cancelled")
                rotationRequestStop("Rotation destination missing")
                return true
            end
            -- Do not rescan the world or attempt an unsupported endpoint.
            -- Platform and ordinary solid floors both pass touchGround().
            if not touchGround(math.floor(dest.x),math.floor(dest.y)) then
                local why=rotation.mode.." destination support missing at "..
                    math.floor(dest.x)..","..math.floor(dest.y)
                if rotation.waitExpired(why) then return true end
                rotation.waitStatus(why)
                nextAction=os.clock()+1
                return true
            end
            rotation.waitReason=nil
            local s,x,y=touchPosition()
            if not s or s.dead then
                rotation.settleStarted=nil
                nextAction=os.clock()+0.25
                return true
            end
            local targetX,targetY=math.floor(dest.x),math.floor(dest.y)
            if x~=targetX or y~=targetY then
                -- Movement may still be completing a jump/fall or coasting
                -- after navigation. Do not treat transient airborne state as
                -- an invalid destination or count it as a route failure.
                rotation.settleStarted=nil
                if not s.grounded then
                    touchRelease()
                    nextAction=os.clock()+0.20
                    return true
                end
                local moved,why=roamStep(run,nil,{
                    kind="return",x=targetX,y=targetY})
                local arrived,ax,ay=touchPosition()
                if arrived and arrived.grounded
                    and ax==targetX and ay==targetY then
                    touchUnhook()
                    rotation.navFails=0
                    rotation.settleStarted=os.clock()
                    print("[ROTATION NAV ARRIVED]",rotation.mode,
                        "X",ax,"Y",ay,"| settling 1 second")
                    return true
                end
                if why=="blocked" or why=="empty" then
                    rotation.navFails+=1
                    print("[ROTATION NAV RETRY]",rotation.mode,
                        rotation.navFails,"/5 |",tostring(why),
                        "| current",ax or "-",ay or "-",
                        "| target",targetX,targetY)
                    if rotation.navFails>=5 and rotation.mode=="goSeed" then
                        -- A seed trip is optional: back to Farm, retry later.
                        warn("[ROTATION SEED DROP] stand unreachable",targetX,targetY,
                            "| retry in 30s")
                        rotation.mode="farm"
                        rotation.seedStand=nil
                        rotation.seedDropRetryAt=os.clock()+30
                        rotation.navFails=0
                    elseif rotation.navFails>=5 then
                        warn("[ROTATION] Navigation unreachable at",
                            targetX,targetY)
                        rotationRequestStop("Rotation path failed after retries")
                    end
                elseif moved then
                    rotation.navFails=0
                end
                return true
            end
            if not s.grounded then
                -- The tile matches but landing has not finished.
                rotation.settleStarted=nil
                touchRelease()
                nextAction=os.clock()+0.15
                return true
            end
            -- Neutralize all simulated keys and release the Farm movement
            -- controller BEFORE the 1-second arrival confirmation. Native
            -- coasting is tolerated while the avatar stays on target tile.
            touchUnhook()
            if not rotation.settleStarted then
                rotation.settleStarted=os.clock()
                print("[ROTATION NAV ARRIVED]",rotation.mode,
                    "X",x,"Y",y,"| settling 1 second")
            end
            local stableFor=os.clock()-rotation.settleStarted
            if stableFor<1 then
                status("ROTATION SETTLE | "..rotation.mode..
                    " X"..x.." Y"..y.." | "..tostring(math.ceil((1-stableFor)*10)/10).."s")
                nextAction=os.clock()+0.10
                return true
            end
            rotation.settleStarted=nil
            rotation.navFails=0
            print("[ROTATION NAV READY]",rotation.mode,
                "X",x,"Y",y,"| 1 second verified")
            if rotation.mode=="goSeed" then
                -- At the stand tile: drop (V68 covers only facing/last step)
                -- and stay here; Farm continues from this position.
                local dropRt=env.Fian792DropRuntime
                local keep,label=rotation.seedKeep or 0,rotation.seedLabel or "trip"
                rotation.mode="farm"
                rotation.seedStand=nil
                if seedId and dropRt and type(dropRt.rotationSeedTrip)=="function" then
                    print("[ROTATION SEED DROP]",label,"| at stand",x,y,
                        "| stock",countItem(seedId),"| keep",keep)
                    local ok,done,why=pcall(dropRt.rotationSeedTrip,seedId,
                        {x=x,y=y},keep)
                    if not ok or not done then
                        -- Retry RIGHT HERE (already at the stand) instead
                        -- of walking off to Harvest and coming back.
                        rotation.seedRetryN=(rotation.seedRetryN or 0)+1
                        if rotation.seedRetryN<=3 then
                            rotation.mode="goSeed"
                            rotation.seedStand={x=x,y=y}
                            rotation.seedKeep=keep
                            rotation.seedLabel=label
                            warn("[ROTATION SEED DROP RETRY] in place",rotation.seedRetryN,"/3 |",
                                tostring(ok and why or done))
                            status("ROTATION SEED DROP RETRY (here) | "..tostring(ok and why or done))
                            nextAction=os.clock()+0.6
                            return true
                        end
                        rotation.seedRetryN=0
                        rotation.seedDropRetryAt=os.clock()+5
                        warn("[ROTATION SEED DROP RETRY]",tostring(ok and why or done))
                        status("ROTATION SEED DROP RETRY | "..tostring(ok and why or done))
                    else
                        rotation.seedRetryN=0
                        rotation.seedDropRetryAt=0
                        print("[ROTATION SEED DROP] completed | stock",countItem(seedId))
                    end
                end
                nextAction=os.clock()+0.20
                return true
            end
            if rotation.mode=="goHome" then
                rotation.mode="farm"
                rotation.blockId=nil
                rotation.home=nil
                -- After Break: seeds in the bag (incl. those collected during
                -- PNB) are planted FIRST when empty soil exists; then Harvest.
                -- Otherwise Harvest and its touch-collect follow Break.
                local canPlant=plantOn and seedId and countItem(seedId)>0
                    and hasPlantWork(true)
                phase=(canPlant and "plant")
                    or (harvestOn and "harvest")
                    or (plantOn and "plant" or "collect")
                harvestScanAt=0
                harvestUnreachableUntil=0
                orderedHarvestGoal=nil
                rotationPlantCheckAt=0
                rotationPlantExhausted=false
                if phase=="plant" then resetPlantSweep() end
                nextAction=os.clock()+0.12
                print("[ROTATION] BACK HOME ->",phase,
                    "| after 1s settle / post-PNB loot check")
                return true
            end
            -- Reuse the SAVED Place/Break grids and delays without touching
            -- either manual UI toggle. The block being broken is the chosen crop.
            if selectedCount()==0 or #breakList()==0 then
                warn("[ROTATION] Configure Place grid and Break grid first")
                rotationRequestStop("Rotation grids missing")
                return true
            end
            rotation.previousPlaceId=selectedId
            selectedId=rotation.blockId
            local pnb=env.Fian792RotationPNB
            if not pnb then
                rotationRequestStop("PNB bridge missing")
                return true
            end
            local okCollect,collectStarted=pcall(pnb.startCollect)
            local okBreak,breakStarted=pcall(pnb.startBreak)
            local okPlace,placeStarted=pcall(pnb.startPlace)
            print("[ROTATION PNB] collect",okCollect,collectStarted,
                "| break",okBreak,breakStarted,
                "| place",okPlace,placeStarted,
                "| block",rotation.blockId)
            if not okCollect or not collectStarted or not okBreak
                or not breakStarted or not okPlace or not placeStarted then
                warn("[ROTATION] PNB start failed; check native punch and grids")
                pnb.stopPlace();pnb.stopBreak();pnb.stopCollect()
                selectedId=rotation.previousPlaceId
                rotationRequestStop("Rotation PNB start failed")
                return true
            end
            rotation.mode="breaking"
            rotation.lastSupervise=nil
            rotation.started=os.clock()
            rotation.lastProgress=rotation.started
            rotation.lastReport=0
            rotation.lastStock=nil
            rotation.lastGrid=nil
            rotation.lastLoot=nil
            rotation.lastRestart=rotation.started
            rotation.recoverPlaceAt=nil
            rotation.recoverPlaceCount=0
            rotation.quietSince=nil
            rotation.lastLootScanAt=0
            rotation.cachedLoot=nil
            rotation.cachedNearby=nil
            print("[ROTATION] PNB LOOP | block",rotation.blockId,
                "| Place -> Break -> Collect until selected block exhausted")
            return true
        end
        if rotation.mode=="breaking" then
            -- Use the SAME PNB engines as manual mode. This state only
            -- supervises and restarts Place after Collect refills inventory.
            local pnb=env.Fian792RotationPNB
            if not pnb then
                rotationRequestStop("PNB bridge disappeared")
                return true
            end
            local now=os.clock()
            -- The supervisor runs every ~0.5s. A longer gap means Farm was
            -- paused (Penjaga / Auto Drop): shift every stall timer by the
            -- paused time so a pause is never mistaken for a PNB deadlock.
            local gap=now-(rotation.lastSupervise or now)
            if gap>2 then
                rotation.lastProgress=(rotation.lastProgress or now)+gap
                rotation.lastRestart=(rotation.lastRestart or now)+gap
                if rotation.recoverPlaceAt then
                    rotation.recoverPlaceAt+=gap
                end
                rotation.quietSince=nil
                rotation.lastLootScanAt=0
                print("[ROTATION PNB RESUME] paused",math.floor(gap),
                    "s | stall timers shifted")
            end
            rotation.lastSupervise=now
            local blockId=rotation.blockId
            local stock=countItem(blockId)
            local gridCount=pnb.gridBlocks(blockId)
            -- DropList may contain thousands of items. The Collect engine
            -- already runs its own pickup checks; Rotation only needs a
            -- periodic completion snapshot. Scan max ~1.4 Hz.
            if now-(rotation.lastLootScanAt or 0)>=1.25
                or rotation.cachedLoot==nil then
                rotation.lastLootScanAt=now
                rotation.cachedLoot,rotation.cachedNearby=
                    pnb.actionableLoot(blockId)
            end
            local loot=rotation.cachedLoot
            local nearbyLoot=rotation.cachedNearby
            local lootKnown=type(loot)=="number"
            loot=lootKnown and loot or 0
            nearbyLoot=type(nearbyLoot)=="number" and nearbyLoot or -1
            -- Nearby drops outside the selected priority / range / capacity
            -- cannot be taken here and must not block returning to Plant.
            local changed=rotation.lastStock~=stock or rotation.lastGrid~=gridCount
                or (lootKnown and rotation.lastLoot~=loot)
            if changed then rotation.lastProgress=now end
            rotation.lastStock=stock
            rotation.lastGrid=gridCount
            if lootKnown then rotation.lastLoot=loot end
            local placeLive=pnb.placeRunning()
            local breakLive=pnb.breakRunning()
            local collectLive=pnb.collectRunning()
            -- Native Auto Place stops on zero stock. A subsequent native
            -- Collect may put more blocks back in inventory. Restart Place
            -- without resetting Break or Collect; PNB phase remains shared.
            if stock>0 and not placeLive and breakLive and collectLive
                and now-rotation.lastRestart>0.8 then
                rotation.lastRestart=now
                local ok,started=pcall(pnb.startPlace)
                print("[ROTATION PNB RESTART PLACE] stock",stock,
                    "| ok",ok,"started",started)
                if ok and started then
                    rotation.lastProgress=now
                    placeLive=true
                end
            end
            -- If Break/Collect unexpectedly exit, preserve inventory and
            -- report the actual engine failure instead of a false timeout.
            if not breakLive or not collectLive then
                warn("[ROTATION PNB] Engine stopped unexpectedly | place",placeLive,
                    "break",breakLive,"collect",collectLive,"stock",stock,
                    "grid",gridCount,"loot",loot)
                rotationRequestStop("Rotation PNB engine exited")
                return true
            end
            -- The avatar must stay ON the saved Break tile: the Place/Break
            -- grids follow the player, so any drift moves the whole PNB (and
            -- can walk it onto the seed pile). Re-enter through goBreak.
            do
                local saved=env.Fian792SavedAutoDrop
                local bp=type(saved)=="table" and saved.world==refs.worldKey()
                    and type(saved.points)=="table" and saved.points.breakPoint or nil
                local s2,qx,qy=touchPosition()
                if type(bp)=="table" and s2 and qx
                    and (qx~=math.floor(bp.x) or qy~=math.floor(bp.y)) then
                    rotation.offTileSince=rotation.offTileSince or now
                    if now-rotation.offTileSince>=0.4 then
                        rotation.offTileSince=nil
                        warn("[ROTATION PNB] player left Break tile | at",qx,qy,
                            "| break",bp.x,bp.y,"| pause PNB and return")
                        pnb.stopPlace();pnb.stopBreak();pnb.stopCollect()
                        if rotation.previousPlaceId then
                            selectedId=rotation.previousPlaceId
                        end
                        touchRelease()
                        rotation.mode="goBreak"
                        rotation.navFails=0
                        rotation.settleStarted=nil
                        rotation.cachedLoot=nil
                        rotation.cachedNearby=nil
                        nextAction=os.clock()+0.15
                        return true
                    end
                else
                    rotation.offTileSince=nil
                end
            end
            -- Seed FULL during PNB: every broken block drops a seed that can
            -- no longer be collected; those drops cover the Place tiles and
            -- PNB stops placing. Drop the seed stack at Posisi Drop Seed and
            -- come back to this exact Break tile, then restart PNB via the
            -- normal goBreak arrival/settle path.
            if seedId and rotation.selectedSeed==seedId
                and countItem(seedId)>=200 and stock>0
                and nearbyLoot>loot
                and now>=(rotation.seedDropRetryAt or 0) then
                local dropRt=env.Fian792DropRuntime
                local s0,bx,by=touchPosition()
                -- Come back to the SAVED Break tile, never to wherever the
                -- avatar happens to be (it may have drifted onto the pile).
                local savedBp=env.Fian792SavedAutoDrop
                savedBp=type(savedBp)=="table" and type(savedBp.points)=="table"
                    and savedBp.points.breakPoint or nil
                if type(savedBp)=="table" and type(savedBp.x)=="number" then
                    bx,by=math.floor(savedBp.x),math.floor(savedBp.y)
                end
                if dropRt and type(dropRt.rotationSeedTrip)=="function"
                    and s0 and s0.grounded then
                    print("[ROTATION PNB SEED FULL] seed",countItem(seedId),
                        "| uncollectable drops",nearbyLoot-loot,
                        "| pause PNB -> drop seed -> back to",bx,by)
                    status("PNB PAUSE | seed 200 penuh -> drop seed")
                    pnb.stopPlace();pnb.stopBreak();pnb.stopCollect()
                    local ok,done,why=pcall(dropRt.rotationSeedTrip,seedId,
                        {x=bx,y=by},0)
                    if not ok or not done then
                        rotation.seedDropRetryAt=os.clock()+30
                        warn("[ROTATION PNB SEED FULL] drop failed:",
                            tostring(ok and why or done),
                            "| PNB continues; seed drops stay on the grid")
                        status("PNB | seed penuh, drop gagal: "..
                            tostring(ok and why or done))
                    else
                        rotation.seedDropRetryAt=0
                        print("[ROTATION PNB SEED FULL] dropped | seed",
                            countItem(seedId),"| resume PNB")
                    end
                    -- Re-enter through goBreak: verifies the tile, settles
                    -- 1s and restarts Collect/Break/Place cleanly.
                    if rotation.previousPlaceId then
                        selectedId=rotation.previousPlaceId
                    end
                    rotation.mode="goBreak"
                    rotation.navFails=0
                    rotation.settleStarted=nil
                    rotation.cachedLoot=nil
                    rotation.cachedNearby=nil
                    nextAction=os.clock()+0.15
                    return true
                end
            end
            -- Detect a REAL deadlock: positive stock, empty place grid,
            -- no actionable loot, and no stock/grid progress for 12s.
            -- Nearby uncollectable drops do not block this recovery.
            if stock>0 and gridCount==0 and lootKnown and loot==0
                and now-(rotation.lastProgress or now)>=12 then
                if not rotation.recoverPlaceAt
                    or now-rotation.recoverPlaceAt>=7 then
                    rotation.recoverPlaceAt=now
                    rotation.recoverPlaceCount=(rotation.recoverPlaceCount or 0)+1
                    if rotation.recoverPlaceCount<=2 then
                        pnb.stopPlace()
                        task.wait(0.12)
                        local fresh,started=pcall(pnb.startPlace)
                        print("[ROTATION PNB RECOVER PLACE]",
                            rotation.recoverPlaceCount,"/2 | stock",stock,
                            "| started",fresh and started)
                        -- Recovery is NOT proof of progress. Preserve
                        -- lastProgress until stock or grid really changes.
                        rotation.lastRestart=now
                        return true
                    end
                    print("[ROTATION PNB STALLED] stock",stock,
                        "| empty grid | no actionable loot",
                        "| preserve inventory and return to Farm")
                    pnb.stopPlace();pnb.stopBreak();pnb.stopCollect()
                    if rotation.previousPlaceId then
                        selectedId=rotation.previousPlaceId
                        rotation.previousPlaceId=nil
                    end
                    rotation.partialBreakRetryAt=now+60
                    rotation.mode="goHome"
                    rotation.navFails=0
                    rotation.settleStarted=nil
                    rotation.cachedLoot=nil
                    rotation.cachedNearby=nil
                    rotation.lastLootScanAt=0
                    nextAction=now+0.15
                    return true
                end
            elseif changed and (stock>0 or gridCount>0) then
                rotation.recoverPlaceAt=nil
                rotation.recoverPlaceCount=0
            end
            if now-rotation.lastReport>=5 then
                rotation.lastReport=now
                print("[ROTATION PNB STATUS] block",blockId,
                    "| stock",stock,"| grid",gridCount,
                    "| collectable loot",loot,"| nearby total",nearbyLoot,
                    "| Place",placeLive,"Break",breakLive,"Collect",collectLive,
                    "| no progress",math.floor(now-rotation.lastProgress),"s")
            end
            -- Do not finish just because Place stopped; first finish breaking
            -- the existing grid and collecting the resulting loot.
            -- A quiet confirmation window absorbs delayed native inventory/drop updates.
            local finished=stock<=0 and gridCount==0 and lootKnown and loot==0
            if finished then
                rotation.quietSince=rotation.quietSince or now
            else
                rotation.quietSince=nil
            end
            if rotation.quietSince and now-rotation.quietSince>=2.5 then
                -- Final FRESH drop check, bypassing the 1.25s status cache.
                -- The PNB collector keeps running under the EXISTING priority
                -- grid (including the strict last-slot <=50 stock rule).
                -- Do not declare PNB complete while a reachable drop remains.
                local finalLoot,finalNearby=pnb.actionableLoot(blockId)
                local freshStock=countItem(blockId)
                local freshGrid=pnb.gridBlocks(blockId)
                if type(finalLoot)~="number"
                    or finalLoot>0 or freshStock>0 or freshGrid>0 then
                    rotation.quietSince=nil
                    rotation.cachedLoot=finalLoot
                    rotation.cachedNearby=finalNearby
                    rotation.lastLootScanAt=0
                    print("[ROTATION PNB FINISH CHECK] stay | stock",
                        freshStock,"grid",freshGrid,
                        "| collectible drops",finalLoot or "unknown")
                    if freshStock>0 and not pnb.placeRunning() then
                        -- A freshly collected block stack has capacity to be
                        -- placed and broken again, including when it hit 200.
                        local ok,start=pcall(pnb.startPlace)
                        print("[ROTATION PNB REBREAK]",freshStock,
                            "| full",freshStock>=rotation.threshold,
                            "| started",ok and start)
                    end
                    return true
                end
                -- Nearby uncollectable or outside priority drops are reported,
                -- never silently counted as collected or used to bypass
                -- the user's last-priority rule / inventory capacity.
                if type(finalNearby)=="number" and finalNearby>0 then
                    print("[ROTATION PNB DROPS UNAVAILABLE]",finalNearby,
                        "| out of selected priority/range or inventory full")
                end
                pnb.stopPlace();pnb.stopBreak();pnb.stopCollect()
                selectedId=rotation.previousPlaceId
                rotation.previousPlaceId=nil
                -- Return to saved Farm position, wait the existing 1s
                -- arrival gate, then resume Harvest before Plant.
                rotation.mode="goHome"
                rotation.navFails=0
                rotation.settleStarted=nil
                nextAction=now+0.15
                print("[ROTATION PNB LOOT VERIFIED] clear -> return for Harvest",
                    "| home",rotation.home and rotation.home.x or "-",
                    rotation.home and rotation.home.y or "-")
            elseif now-rotation.lastProgress>=30
                and now-rotation.lastReport<0.25 then
                -- Warn, never force-stop based on elapsed time alone.
                warn("[ROTATION PNB WAIT] No stock/grid/loot changes for",
                    math.floor(now-rotation.lastProgress),
                    "s | inspect [BREAK SKIP], [COLLECT PRIORITY], [Fian792]")
                status("PNB WAIT | stock "..stock.." grid "..gridCount..
                    " loot "..loot.." | check break/collect grids")
            end
            return true
        end
        return false
    end
    -- Refill uses the same world route executor (walk/jump/fall/stair)
    -- from path planning through movement, never direct physics flight.
    -- Route scan cooldown/no-goal is not a physical navigation failure.
    -- State machine: Plant -> optional one refill at saved seed pile -> Plant,
    -- or Harvest when the pile is empty / all eligible soil was planted.
    local function startSeedRefill()
        if not plantOn or not seedId or not roamOn
            or os.clock()<refillRetryAt then return false,"cooldown or disabled" end
        -- With low soil Rotation deliberately drops the seed excess; a
        -- refill would pick the pile back up and loop drop <-> refill.
        -- Harvest (1 seed per tree) supplies the last few spots instead.
        if rotation.enabled and rotation.lowSoil then
            return false,"rotation low soil: refill disabled"
        end
        if not hasPlantWork(true) then return false,"no empty planting spots" end
        local drop,why=seedStashDrop()
        if not drop then return false,why end
        local state,x,y=touchPosition()
        if not state or not state.grounded then return false,"not grounded" end
        -- Preserve the ACTUAL last plant position and locked row cursor;
        -- don't force a return to an old, currently non-standable tile.
        local home=lastPlantLocation and
            touchGround(lastPlantLocation.x,lastPlantLocation.y)
            and lastPlantLocation or {x=x,y=y}
        -- A tile-verified pile must exist BEFORE changing phase or moving.
        refill={mode="pickup",home={x=home.x,y=home.y},
            started=os.clock(),attempts=0,uid=drop.uid,seed=seedId}
        phase="refill"
        print("[AUTO FARM REFILL] START | seed",seedId,
            "| pile",math.floor(drop.x),math.floor(drop.y),
            "| home",home.x,home.y,
            "| row",plantSweep.row or "-", "cursor",plantSweep.cursor or "-")
        status("REFILL | collecting saved seed, Plant cursor preserved")
        return true
    end
    local function cancelRefill(why)
        refillRetryAt=os.clock()+60
        refill=nil
        phase="plant"
        print("[AUTO FARM REFILL] Unavailable |",tostring(why),
            "| transition to Harvest/Collect")
        nextPhase("refill unavailable: "..tostring(why))
    end
    local function processRefill(run)
        if phase~="refill" or not refill then return false end
        local taskState=refill
        if taskState.seed~=seedId then
            cancelRefill("seed selection changed")
            return true
        end
        local state,x,y=touchPosition()
        if not state or not state.grounded then
            task.wait(0.2)
            return true
        end
        if taskState.mode=="pickup" and countItem(seedId)>0 then
            taskState.mode="return"
            print("[AUTO FARM REFILL] Seed received | bag",countItem(seedId),
                "| returning",taskState.home.x,taskState.home.y)
        end
        if taskState.mode=="return" then
            if not roamOn then
                print("[AUTO FARM REFILL] Roam OFF: resume Plant from current tile")
                refill=nil
                phase="plant"
                return true
            end
            if countItem(seedId)<=0 then
                cancelRefill("refill not in inventory")
                return true
            end
            if x==taskState.home.x and y==taskState.home.y then
                refill=nil
                phase="plant" -- preserve locked row and cursor
                nextAction=os.clock()+0.15
                print("[AUTO FARM REFILL] RESUME Plant | last position",x,y,
                    "| row",plantSweep.row or "-","cursor",plantSweep.cursor or "-")
                status("Plant resumed after seed refill")
                return true
            end
            local moved,why=roamStep(run,nil,{
                kind="return",x=taskState.home.x,y=taskState.home.y
            })
            if moved then return true end
            if why=="blocked" then
                taskState.attempts+=1
                if taskState.attempts>=3 then
                    -- The cursor is never reset; regular Plant navigation can
                    -- still reach it from the current position.
                    print("[AUTO FARM REFILL] Return path failed; resume by route")
                    refill=nil
                    phase="plant"
                    nextAction=os.clock()+0.5
                end
            end
            return true
        end
        local drop,why=seedStashDrop()
        if not drop then
            if countItem(seedId)>0 then
                taskState.mode="return"
            else
                cancelRefill(why or "seed pile empty")
            end
            return true
        end
        if os.clock()-taskState.started>85 then
            cancelRefill("refill travel timeout")
            return true
        end
        local dx,dy=math.floor(drop.x),math.floor(drop.y)
        if math.abs(dx-x)<=2 and (dy==y or dy==y-1)
            and touchPathClear(x,dx,y) then
            local before=countItem(seedId)
            local touched=touchOne(run,drop)
            if touched or countItem(seedId)>before then
                if countItem(seedId)>0 then
                    taskState.mode="return"
                    print("[AUTO FARM REFILL] PICKED |",before,"->",countItem(seedId))
                end
            else
                taskState.attempts+=1
            end
        else
            local moved,reason=roamStep(run,nil,{
                kind="refill",x=drop.x,y=drop.y,uid=drop.uid
            })
            if reason=="blocked" then
                taskState.attempts+=1
                print("[AUTO FARM REFILL] Navigation retry",taskState.attempts,
                    "|",reason)
            end
        end
        if taskState.attempts>=4 then
            cancelRefill("seed pile unreachable / pickup refused")
        end
        return true
    end
    local function stop(reason)
        -- Stop asynchronous navigation before cleaning up PNB services.
        active=false
        ownRun+=1
        tractor.unequip("farm stopped")
        harvestSweep.active=false
        harvestSweep.row=nil
        touchUnhook()
        if rotation.mode=="breaking" then
            local pnb=env.Fian792RotationPNB
            if pnb then pnb.stopPlace();pnb.stopBreak();pnb.stopCollect() end
        end
        if rotation.previousPlaceId then selectedId=rotation.previousPlaceId end
        if rotation.tookOver then
            seedId=rotation.savedFarmSeed
            farmBlockOnly=rotation.savedFarmBlockOnly==true
            farmBlockId=rotation.savedFarmBlock
            plantOn=rotation.savedPlantOn
            harvestOn=rotation.savedHarvestOn
            collectOn=rotation.savedCollectOn
            roamOn=rotation.savedRoamOn~=false
            rotation.savedRoamOn=nil
            rotation.tookOver=false
        end
        rotation.enabled=false
        rotation.mode="farm"
        rotation.blockId=nil
        rotation.seedDropRetryAt=0
        rotation.partialBreakRetryAt=0
        rotation.seedPlantCheckAt=0
        rotation.seedPlantAvailable=nil
        rotation.previousPlaceId=nil
        rotation.home=nil
        rotation.settleStarted=nil
        rotation.emptySince=nil
        rotation.world=nil
        rotation.waitReason=nil
        rotation.lastSupervise=nil
        rotation.lowSoil=nil
        rotation.plantSpotsLeft=nil
        rotation.seedStand=nil
        rotation.offTileSince=nil
        env.Fian792ReservedDropTiles=nil
        rotationPlantCheckAt=0
        rotationPlantExhausted=false
        refill=nil
        nextAction=0
        if rotationToggle then
            rotationSwitching=true
            pcall(function() rotationToggle:Set(false) end)
            rotationSwitching=false
        end
        if toggle then
            switching=true
            pcall(function() toggle:Set(false) end)
            switching=false
        end
        print("[AUTO FARM] Stop reason:",tostring(reason or "requested"))
        status("OFF")
    end
    rotationRequestStop=stop
    local harvestDiscoveryBusy=false
    local function harvestDiscovery()
        if harvestDiscoveryBusy or not harvestOn then return end
        if treeData and type(punch)=="function" then return end
        harvestDiscoveryBusy=true
        task.spawn(function()
            if not treeData then
                local ok,err=pcall(findTrees)
                if not ok then warn("[FAST START] Tree:",err) end
            end
            if type(punch)~="function" then
                local ok,fn=pcall(detectNativePunch)
                if ok and type(fn)=="function" then punch=fn end
                if not ok then warn("[FAST START] Punch:",fn) end
            end
            harvestDiscoveryBusy=false
        end)
    end
    local function start()
        if env.Fian792DirtProduction then
            status("Dirt Farm sedang memproduksi material")
            return false
        end
        if active then return true end
        if (farmBlockOnly and not collectOn)
            or (not farmBlockOnly and not plantOn and not harvestOn and not collectOn) then
            status("Cannot start: required Farm action is OFF")
            print("[AUTO FARM START] All feature toggles OFF")
            return false
        end
        -- In v1.0.30 missing tree metadata, native punch, or seed selection
        -- immediately reset the UI toggle. These are recoverable, so the
        -- scheduler now starts in WAIT mode and retries acquisition.
        if plantOn and not farmBlockOnly and (not seedId or not db[seedId]
            or db[seedId].kind~="seed") then
            local available=seedInventory()
            if #available>0 then
                local candidate=tonumber(available[1]:match("%[(%d+)%]$"))
                if candidate and db[candidate] and db[candidate].kind=="seed" then
                    seedId=candidate
                end
            end
        end
        harvestDiscovery() -- scan separately; Plant need not wait
        local hasDrops=type(rawget(world,"dropList"))=="function"
        print("[AUTO FARM START] Ready to run | seed",seedId or "WAIT",
            "stock",seedId and countItem(seedId) or "unknown",
            "| tree metadata",treeData~=nil,
            "| native punch",type(punch)=="function",
            "| drops",hasDrops,
            "| PNB busy",running or breakRunning,
            "| Auto Drop pause",dropPause)
        if not seedId and plantOn then
            print("[AUTO FARM START] Plant waiting: select a seed or refresh inventory")
        end
        if harvestOn and (not treeData or type(punch)~="function") then
            print("[AUTO FARM START] Harvest waiting: retry tree/punch discovery")
        end
        if collectOn and not hasDrops then
            print("[AUTO FARM START] Collect waiting: dropList unavailable")
        end
        -- Snapshot only the chosen crop already present BEFORE Farm starts.
        -- This distinguishes old trees from newly planted ones in diagnostics.
        existingCropAtStart={}
        local existingCount=0
        if seedId then
            for y=0,world.h-1 do
                local row=world.fg[y]
                if type(row)=="table" then
                    for x=0,world.w-1 do
                        if row[x]==seedId then
                            existingCropAtStart[y*world.w+x]=true
                            existingCount+=1
                        end
                    end
                end
            end
        end
        print("[AUTO FARM EXISTING CROP] seed",seedId or "-",
            "| same-seed trees before Plant",existingCount,
            "| block",cropBlockId() or "unknown")
        active=true
        ownRun+=1
        local run=ownRun
        phase=farmBlockOnly and "collect"
            or ((plantOn and seedId) and "plant"
            or (harvestOn and "harvest" or (collectOn and "collect" or "plant")))
        refill=nil
        refillRetryAt=0
        harvestScanAt=0
        harvestUnreachableUntil=0
        harvestScanSeed=seedId
        harvestReadyFound=false
        orderedHarvestGoal=nil
        lastPlantLocation=nil
        nextSeedLookup=0
        nextHarvestLookup=0
        plantPending=nil
        plantSweep.pending={};plantSweep.inflight={}
        harvestPending=nil
        harvestSweep.active=false
        harvestSweep.row=nil
        plantRetries={}
        resetPlantSweep()
        preferredDir=1
        idleUntil=0
        planted,harvested=0,0
        touchCount=0
        nextAction=0
        print("[AUTO FARM ROW SWEEP v1.0.30] Active | Plant Y-row sweep | Roam",roamOn,"| session",run)
        status("ON | Full-world phase "..phase)
        task.spawn(function()
            local ok,err=pcall(function()
                local pnbPriorityReported=false
                while alive() and ownRun==run do
                    -- PNB gets exclusive CPU priority while active.
                    -- Rotation PNB requires only its low-rate supervisor;
                    -- manual Place/Break/Collect entirely suspend Farm work.
                    task.wait(rotation.enabled and 0.08 or 0.12)
                    if not alive() or ownRun~=run then break end
                    if guardPaused or dropPause then
                        -- Return/Guard must fully release the shared movement
                        -- owner before the return navigator takes over.
                        touchUnhook()
                        task.wait(0.5)
                        continue
                    end
                    if rotation.enabled and rotation.mode=="breaking" then
                        if not pnbPriorityReported then
                            pnbPriorityReported=true
                            print("[PNB PRIORITY] ROTATION | Farm/Roam/scan suspended")
                        end
                        rotationStep(run)
                        task.wait(0.50)
                        continue
                    end
                    if running or breakRunning or collectEnabled then
                        if not pnbPriorityReported then
                            pnbPriorityReported=true
                            print("[PNB PRIORITY] MANUAL | Farm/Roam/scan suspended")
                            status("ON (PNB PRIORITY) | Farm paused")
                        end
                        touchRelease()
                        task.wait(0.65)
                        continue
                    end
                    if pnbPriorityReported then
                        pnbPriorityReported=false
                        print("[PNB PRIORITY] RELEASED | Farm continues from saved cursor")
                    end
                    -- Retry prerequisites only when no PNB is working.
                    -- Nothing below runs during manual or Rotation PNB.
                    local now=os.clock()
                    if plantOn and not farmBlockOnly and (not seedId or not db[seedId]
                        or db[seedId].kind~="seed") and now>=nextSeedLookup then
                        nextSeedLookup=now+4
                        local options=seedInventory()
                        for _,label in ipairs(options) do
                            local candidate=tonumber(label:match("%[(%d+)%]$"))
                            if candidate and db[candidate] and db[candidate].kind=="seed" then
                                seedId=candidate
                                print("[AUTO FARM RECOVERY] Seed selected",seedId)
                                if refreshSeedChoices then
                                    pcall(refreshSeedChoices,options)
                                end
                                break
                            end
                        end
                    end
                    if harvestOn and not farmBlockOnly and (not treeData or type(punch)~="function")
                        and now>=nextHarvestLookup then
                        nextHarvestLookup=now+7
                        harvestDiscovery()
                    end
                    -- Never delay a FULL stack Rotation trigger behind
                    -- a Farm/Harvest action cooldown.
                    if rotation.enabled and rotation.mode=="farm"
                        and rotation.selectedBlock
                        and countItem(rotation.selectedBlock)>=rotation.threshold then
                        if rotationStep(run) then continue end
                    end
                    if os.clock()<nextAction then
                        touchUnhook()
                        task.wait(math.min(0.8,math.max(0.04,nextAction-os.clock())))
                        continue
                    end
                    if phase=="harvest" and (type(punch)~="function"
                        or (not treeData and next(observedTrees)==nil)) then
                        nextPhase("harvest reference not ready")
                        continue
                    end
                    if phase=="collect" and
                        type(rawget(world,"dropList"))~="function" then
                        nextPhase("dropList not ready")
                        continue
                    end
                    if rotationStep(run) then continue end
                    if phase=="refill" then
                        processRefill(run)
                        continue
                    end
                    local acted=false
                    local plantGoal=nil
                    -- Plant and Harvest share the same action pump that runs
                    -- while walking. The main loop also services it when idle.
                    if phase=="plant" and plantOn then
                        -- Do not advance row/cursor while the previous native
                        -- placement is still awaiting confirmation.
                        plantGoal=plantPending and {
                            x=plantPending.x,y=plantPending.y,key=plantPending.key
                        } or nextPlantTarget()
                        if not plantGoal and not plantPending
                            and (not seedId or countItem(seedId)>0) then
                            if plantSweep.row then
                                -- Row audit found missed spots. Stop movement
                                -- completely while waiting for retry window.
                                touchUnhook()
                                nextAction=math.max(os.clock()+0.15,
                                    plantSweep.auditWait or 0)
                                status("PLANT ROW WAIT | Y "..plantSweep.row..
                                    " | retry remaining spots")
                            else
                                nextPhase("every planting row audited complete")
                            end
                            acted=true
                        else
                            acted=farmStraightSweep(run,plantGoal)
                            if not acted then
                                acted=moveFarmAction(run,false)
                            end
                        end
                    elseif phase=="harvest" and harvestOn then
                        if not treeData or treeWorld~=world then findTrees() end
                        -- Row cut off by a PNB handoff: once standing on it
                        -- again, do its missed end-of-row loot sweep first.
                        local pr=harvestSweep.pendingRow
                        if pr and collectOn then
                            local _,_,hy=touchPosition()
                            if hy==pr then
                                harvestSweep.pendingRow=nil
                                local sw=collectRowSweep(run)
                                if sw and ownRun==run then sw=collectRowSweep(run) or sw end
                                print("[AUTO FARM HARVEST RESUME SWEEP] row",pr,"| swept",sw)
                            end
                        elseif pr and not collectOn then
                            harvestSweep.pendingRow=nil
                        end
                        acted=farmStraightSweep(run,nil)
                        if not acted then
                            acted=moveFarmAction(run,false)
                        end
                    elseif phase=="collect" and collectOn then
                        -- Prefer uninterrupted multi-drop walking instead of
                        -- stopping/hooking again for every single UID.
                        acted=collectRowSweep(run)
                        if not acted then acted=touchOne(run) end
                    end
                    if not acted and alive() and ownRun==run then
                        if phase=="plant" and not plantOn then
                            nextPhase("plant disabled")
                            acted=true
                        elseif phase=="plant" and seedId
                            and countItem(seedId)<=0 then
                            local more=hasPlantWork()
                            if not more then
                                print("[AUTO FARM REFILL] SKIP | no more planting spots")
                                nextPhase("all plantable world spots complete")
                            else
                                local started,why=startSeedRefill()
                                if not started then
                                    if why=="not grounded" then
                                        status("ON (WAIT) | land before seed refill")
                                        nextAction=os.clock()+0.3
                                    else
                                        print("[AUTO FARM REFILL] SKIP |",tostring(why))
                                        nextPhase("no seed refill: "..tostring(why))
                                    end
                                end
                            end
                            acted=true
                        elseif phase=="plant" and not seedId then
                            nextPhase("no seed selected")
                            acted=true
                        elseif phase=="harvest" and not harvestOn then
                            nextPhase("harvest disabled")
                            acted=true
                        elseif phase=="collect" and not collectOn then
                            nextPhase("collect disabled")
                            acted=true
                        elseif roamOn and os.clock()>=idleUntil then
                            local moved,reason=roamStep(run,plantGoal)
                            acted=moved
                            if reason=="empty" then
                                if phase=="plant" and plantGoal then
                                    finishPlantTarget(plantGoal,"no safe reachable standing path")
                                elseif (phase=="harvest" or phase=="collect")
                                    and not anyFarmLoot()
                                    and (not seedId or countItem(seedId)<=0)
                                    and (phase~="harvest" or not harvestReadyFound) then
                                    -- Nothing to do yet: wait for tree maturity,
                                    -- inventory refill or periodic outside edits.
                                    -- No full-world route planning while idle.
                                    touchUnhook()
                                    phase=farmBlockOnly and "collect" or "harvest"
                                    nextAction=math.max(os.clock()+0.8,
                                        math.min(harvestScanAt>os.clock()
                                            and harvestScanAt or os.clock()+2.5,
                                            os.clock()+5))
                                    status("WAIT | next tree check in "..
                                        math.ceil(nextAction-os.clock()).."s")
                                else
                                    nextPhase("no reachable "..phase.." work")
                                end
                                acted=true
                            elseif reason=="blocked" and phase=="plant" and plantGoal then
                                -- Skip this tile only after the same destination
                                -- has received several safe path retries.
                                finishPlantTarget(plantGoal,"route retries exhausted")
                                acted=true
                            elseif reason=="retry" then
                                -- Keep plantSweep.cursor unchanged. The next
                                -- path search must target the SAME planting tile.
                                nextAction=os.clock()+0.25
                                acted=true
                            end
                        elseif not roamOn then
                            -- Local-only mode cannot finish a world phase.
                            status("Phase "..phase.." | Roam OFF (nearby only)")
                            task.wait(0.7)
                        end
                    end
                    if not acted and alive() and ownRun==run then
                        -- No work is executing: release all movement controls,
                        -- not just the horizontal input booleans.
                        touchUnhook()
                        status("Phase "..phase.." | searching valid work / route")
                        task.wait(0.5)
                    end
                end
            end)
            if ownRun==run then touchUnhook() end
            if not ok then warn("[AUTO FARM ERROR]",err) end
            if active and ownRun==run then
                stop(not ok and "loop error" or
                    (env.Fian792FarmGeneration~=gen and "replaced by another hub"
                        or "loop ended"))
            end
        end)
        return true
    end
    -- Register guard: Build Farm + Rotation UI in its OWN function proto.
    -- A do-block still shares a function's peak register allocation;
    -- this separate function gives its 17 UI locals a separate budget.
    -- WindUI event callbacks retain their captured selection controls.
    local function buildFarmRotationUI()
    local tab=Window:Tab({Title="Auto Farm",Icon="sprout"})
    local group=tab:Section({Title="Plant / Harvest / Collect",Box=true,Opened=true})
    statusUI=group:Paragraph({Title="Status Auto Farm",Desc="OFF"})
    local choices=itemChoices(true,true,seedId)
    -- Prefer a seed at first load. Blocks are available but never selected
    -- silently instead of an existing seed.
    table.sort(choices,function(a,b)
        local ia=tonumber(tostring(a):match("%[(%d+)%]$"))
        local ib=tonumber(tostring(b):match("%[(%d+)%]$"))
        local sa=ia and db[ia] and db[ia].kind=="seed" or false
        local sb=ib and db[ib] and db[ib].kind=="seed" or false
        if sa~=sb then return sa end
        return a<b
    end)
    local seedRefreshing=false
    local function parseSeedChoice(v)
        local value=v
        if type(v)=="table" then
            value=v.Value or v[1] or v.Selected
        end
        local id=tonumber(tostring(value or ""):match("%[(%d+)%]$"))
        return id and db[id] and id or nil
    end
    local function makeSeedDropdown(values)
        return group:Dropdown({
            Title="Item Auto Farm (Seed / Block)",
            Desc="Seed = Plant + Harvest + Collect; Block = Collect only",
            Values=#values>0 and values or {"(refresh items)"},
            Value=(function()
                local wanted=farmBlockOnly and farmBlockId or seedId
                for _,entry in ipairs(values) do
                    if parseSeedChoice(entry)==wanted then return entry end
                end
                return values[1] or "(refresh items)"
            end)(),
            Callback=function(v)
                if seedRefreshing then return end
                local id=parseSeedChoice(v)
                if id then
                    farmBlockOnly=db[id].kind~="seed"
                    farmBlockId=farmBlockOnly and id or nil
                    seedId=farmBlockOnly and nil or id
                    config.Farm.seedId=seedId
                    config.Farm.blockId=farmBlockId
                    config.Farm.blockOnly=farmBlockOnly
                    print("[AUTO FARM ITEM]",id,farmBlockOnly and "BLOCK COLLECT" or "SEED FARM")
                end
            end
        })
    end
    seedDropdown=makeSeedDropdown(choices)
    if choices[1] then
        local wanted=farmBlockOnly and farmBlockId or seedId
        local found=false
        for _,entry in ipairs(choices) do
            if parseSeedChoice(entry)==wanted then found=true;break end
        end
        if not found then
            local id=parseSeedChoice(choices[1])
            farmBlockOnly=id and db[id].kind~="seed" or false
            farmBlockId=farmBlockOnly and id or nil
            seedId=not farmBlockOnly and id or nil
        end
    end
    refreshSeedChoices=function(precomputed)
        local list=precomputed or itemChoices(true,true,seedId or farmBlockId)
        table.sort(list,function(a,b)
            local ia=tonumber(tostring(a):match("%[(%d+)%]$"))
            local ib=tonumber(tostring(b):match("%[(%d+)%]$"))
            local sa=ia and db[ia] and db[ia].kind=="seed" or false
            local sb=ib and db[ib] and db[ib].kind=="seed" or false
            if sa~=sb then return sa end
            return a<b
        end)
        -- Preserve the selected crop if it remains available.
        local chosen=nil
        for _,entry in ipairs(list) do
            if parseSeedChoice(entry)==(farmBlockOnly and farmBlockId or seedId) then chosen=entry;break end
        end
        if not chosen then
            chosen=list[1]
            local id=chosen and parseSeedChoice(chosen) or nil
            farmBlockOnly=id and db[id].kind~="seed" or false
            farmBlockId=farmBlockOnly and id or nil
            seedId=not farmBlockOnly and id or nil
        end
        local shown=#list>0 and list or {"(refresh seed)"}
        seedRefreshing=true
        local updated=false
        if seedDropdown then
            -- WindUI builds expose different Refresh signatures.
            updated=pcall(function()
                seedDropdown:Refresh({Values=shown,Value=chosen or shown[1]})
            end)
            if not updated then
                updated=pcall(function() seedDropdown:Refresh(shown) end)
            end
            if updated and chosen then
                pcall(function() seedDropdown:Set(chosen) end)
            end
        end
        if not updated then
            -- Some WindUI builds do not support Refresh at all.
            -- Recreate the selector instead of silently doing nothing.
            if seedDropdown then
                pcall(function() seedDropdown:Destroy() end)
            end
            local ok,newDropdown=pcall(makeSeedDropdown,list)
            if ok then
                seedDropdown=newDropdown
                updated=true
            else
                warn("[AUTO FARM SEEDS] Dropdown rebuild failed:",newDropdown)
