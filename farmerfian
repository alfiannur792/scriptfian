    local function touchDropPresent(drop)
        local fn=rawget(world,"dropList")
        if type(fn)~="function" then return false end
        local ok,list=pcall(fn)
        if not ok or type(list)~="table" then return false end
        for _,d in pairs(list) do
            if type(d)=="table" and d.uid==drop.uid
                and (tonumber(d.n) or 0)>0 then return true end
        end
