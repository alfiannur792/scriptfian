-- FIAN792 V57 - PLAYER-RELATIVE AUTO COLLECT
-- Auto Collect: 5x5 player-relative priority grid, slider radius 1..6, native cap 2.
-- Native takeDrop request; no direct ByteNet, no spoofing.
--==================================================

-- V67 DELTA FIX: isolate 40 collect locals from the main chunk
-- The UI callbacks retain these variables through closures.
do

local collectToken = 0
local collectTiles = 2 -- 5x5 player-relative grid, same footprint as Place/Break
local collectRadius = math.clamp(math.floor(tonumber(config.PNB.collectRadius) or 2),1,6) -- saved config
local collectNativeCap = 2 -- observed working radius, never fabricate pickup above this
-- PNB collector check cadence (milliseconds); adjustable in its own UI.
-- Default stays 250ms for existing users, and the selection/last priority
-- rules and native request cooldowns are not modified by this setting.
local collectIntervalMs = math.clamp(math.floor(tonumber(config.PNB.collectIntervalMs) or 250),50,500)
-- V68 ordered priority on a PLAYER-RELATIVE 5x5 grid.
-- Empty priority selection = scan all 25 tiles; no final-priority bypass.
local collectOrder = {}
-- Restore selected priority across re-execute within the same executor session.
-- The previously selected order is preserved only if every offset is valid.
do
    local previous = env.Fian792SavedCollectPriority
    if type(previous) == "table" then
        local seen = {}
        for _, tile in ipairs(previous) do
            if type(tile) == "table" and type(tile.dx) == "number"
                and type(tile.dy) == "number" and tile.dx % 1 == 0 and tile.dy % 1 == 0
                and math.abs(tile.dx) <= 2 and math.abs(tile.dy) <= 2
                and not (tile.dx == 0 and tile.dy == 0) then
                local mark = tostring(tile.dx) .. "," .. tostring(tile.dy)
                if not seen[mark] then
                    seen[mark] = true
                    collectOrder[#collectOrder+1] = {dx=tile.dx, dy=tile.dy}
                end
            end
        end
    end
end
-- No explicit priority means no final-tile exemption (safe default).
env.Fian792CollectLastPriorityOffset = nil
local function publishFinalCollectPriority()
    local saved = {}
    for _, tile in ipairs(collectOrder) do
        saved[#saved+1] = {dx=tile.dx, dy=tile.dy}
    end
    env.Fian792SavedCollectPriority = saved
    local last = collectOrder[#collectOrder]
    if last then
        env.Fian792CollectLastPriorityOffset = {dx=last.dx, dy=last.dy}
        print("[COLLECT LAST PRIORITY]", last.dx, last.dy,
            "| Place allowed with remaining drop only on this tile")
    else
        env.Fian792CollectLastPriorityOffset = nil
        print("[COLLECT LAST PRIORITY] None; all tiles keep drop guard")
    end
end
local collectCursor = 1
local collectHoldLogAt = 0 -- rate limit messages for a stubborn tile
local collectLastSkipLogAt = 0
local collectOutOfReachLogAt = 0
local COLLECT_LAST_STOCK_THRESHOLD = 50 -- collect final selected tile only at/below this stock

local function collectOffsetKey(dx, dy)
    return tostring(dx) .. "," .. tostring(dy)
end
local function collectPrioritySlots()
    if #collectOrder > 0 then return collectOrder end
    local defaults = {}
    for dy = -2, 2 do
        for dx = -2, 2 do
            defaults[#defaults+1] = {dx=dx, dy=dy}
        end
    end
    return defaults
end
local function collectTileOffset(drop, state)
    if not state or type(drop.x) ~= "number" or type(drop.y) ~= "number" then return nil end
    local dx = math.floor(drop.x) - math.floor(state.x)
    local dy = math.floor(drop.y) - math.floor(state.y - 0.475)
    if math.abs(dx) > collectTiles or math.abs(dy) > collectTiles then return nil end
    return collectOffsetKey(dx, dy)
end

local collectFilter = {Gems=true, Seed=true, Block=true}
local collectCooldowns = {}
local collectPending = {}
-- Concurrent requests only for distinct Gems UIDs in the active priority tile.
local gemsBatchInflight = {}
local gemsBatchActive = 0
local GEMS_BATCH_LIMIT = 5
local collectStats = {requests=0, observed=0, unconfirmed=0, gemsObserved=0,
