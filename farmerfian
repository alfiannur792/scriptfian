    -- Never collect a saved Auto Drop pile as ordinary Farm loot.
    -- Prior versions protected only the SEED point, allowing the Farm
    -- collector to re-take dropped BLOCK stacks and trigger 200/200 again.
    -- Explicit seedStashDrop() refill bypasses this ordinary collect guard.
    local function reservedAutoDropPile(d)
        if type(d)~="table" or type(d.id)~="number"
            or type(d.x)~="number" or type(d.y)~="number"
            or d.id==112 then return false end
        local item=db[d.id]
        if type(item)~="table" then return false end
        local kind=item.kind=="seed" and "seed" or
            (cropBlockId() and d.id==cropBlockId() and "block" or nil)
        if not kind then return false end
        local cfg=env.Fian792SavedAutoDrop
        if type(cfg)~="table" or cfg.world~=refs.worldKey()
            or type(cfg.points)~="table" then return false end
        -- Only the pile itself is protected: the exact saved Seed/Block drop
        -- tile, plus landing tiles Rotation observed after a drop. The old
        -- 2.5-tile radius also hid normal harvest loot next to the point.
        local tx,ty=math.floor(d.x),math.floor(d.y)
        local reserved=env.Fian792ReservedDropTiles
        if type(reserved)=="table" and reserved[tx..","..ty] then return true end
        for _,name in ipairs({"seed","block"}) do
            local point=cfg.points[name]
            if type(point)=="table" then
                local x,y=point.dropX or point.x,point.dropY or point.y
                if type(x)=="number" and type(y)=="number"
                    and tx==math.floor(x) and ty==math.floor(y) then
                    return true
                end
            end
        end
        return false
    end
    local function touchFind()
        local state,homeX,homeY=touchPosition()
        if not state or not state.grounded then return nil end
        local fn=rawget(world,"dropList")
        if type(fn)~="function" then return nil end
        local ok,drops=pcall(fn)
        if not ok or type(drops)~="table" then return nil end
        local best,bestDistance,bestRow=nil,math.huge,-1
        for _,d in pairs(drops) do
            if type(d)=="table" and type(d.uid)=="number"
                and type(d.x)=="number" and type(d.y)=="number"
                and type(d.id)=="number" and (tonumber(d.n) or 0)>0
                and d.armed~=false and not d.taking and not d.pending
                and not d.display and (touchCooldown[d.uid] or 0)<=os.clock() then
                local dx,dy=math.floor(d.x),math.floor(d.y)
                local item=db[d.id]
                local wanted=not reservedAutoDropPile(d) and cropDrop(d)
                -- Same-row contact, or one row above with a safe short hop.
                local above=dy==homeY-1
                local upper=db[tileAt("fg",dx,dy) or 0]
                local headClear=not (upper and (upper.solid or upper.deadly
                    or upper.hurts or upper.laser))
                if wanted and (dy==homeY or (above and headClear))
                    and touchPathClear(homeX,dx,homeY) then
                    local distance=math.abs((dx+0.5)-state.x)
                        +(above and 0.3 or 0)
                    if distance<=2.5 and
                        (d.id==112 or countItem(d.id)<200)
                        and (dy>bestRow or
                            (dy==bestRow and distance<bestDistance)) then
                        -- Start with lowest available drops (larger Y).
                        -- Only use proximity to choose within that row.
                        best,bestDistance,bestRow=d,distance,dy
                    end
                end
            end
        end
        return best,homeX,homeY
    end
    -- Batch same-row pickups into ONE continuous walk. The native game
