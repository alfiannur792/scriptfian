-- Matches ANCH's optimistic client reconciliation. This changes the
-- local drop list and/or inventory presentation; it is NOT a server receipt.
local function reconcileLocal(drop, amount, initialDropCount, initialInventoryCount)
    local localInvOk = false
    if drop.id == 112 then
        local gems = locateGemUi()
        if gems then
            localInvOk = pcall(gems.addGems, amount)
        end
    else
        local active, source = getGameInventory()
        if not active then active, source = getGameInventory(true) end
        if active and type(active.add) == "function" then
            local before
            if type(active.count) == "function" then
                pcall(function() before = active:count(drop.id) end)
            end
            -- The game callback may already have credited some/all of the item.
            -- Only reconcile the still-missing delta, never add the award twice.
            local toAdd = amount
            if type(initialInventoryCount) == "number" and type(before) == "number" then
                toAdd = math.max(0, amount - math.max(0, before - initialInventoryCount))
            end
            if toAdd > 0 then
                localInvOk = pcall(function() active:add(drop.id, toAdd) end)
            else
                localInvOk = true
            end
            -- Inventory:add() applies ANCH-style optimistic LOCAL state;
            -- notify UI listeners after a successful local operation.
            if localInvOk then
                local after
                if type(active.count) == "function" then
                    pcall(function() after = active:count(drop.id) end)
                end
                local notified = refreshInventoryGui(active)
                print("[INV V51]", itemName(drop.id),
                    "source", source, "count", tostring(before), "->",
                    tostring(after), "refresh", notified, "LOCAL ONLY / RELOG TO VERIFY")
            end
        else
            warn("[INV V51] No live inventory supporting add(); client add skipped")
        end
    end

    local list = getDrops()
    local updated = false
    if list then
        for i, entry in pairs(list) do
            if entry == drop then
                -- If World.dropTaken already touched n, trust its latest state:
                -- subtracting again would make a partially taken stack vanish.
                local liveCount = tonumber(entry.n) or 0
                local rest
                if type(initialDropCount) == "number" and liveCount ~= initialDropCount then
                    rest = math.max(0, liveCount)
                else
                    rest = math.max(0, (initialDropCount or liveCount) - amount)
                end
                -- Update through the native callback when the game has not
                -- already changed the drop. That callback also updates the
                -- visible stack-count label; assigning entry.n alone does not.
                local nativeApplied = false
                if liveCount == initialDropCount then
                    local nativeUpdate = findNativeDropUpdater(list)
                    if nativeUpdate then
                        nativeApplied = pcall(nativeUpdate, entry, rest)
                    end
                end
                if not nativeApplied then
                    if rest > 0 then
                        entry.n = rest
                        refreshDropCountLabel(entry, rest)
                    else
                        -- The server/game callback may have removed the entry
                        -- while takeDrop was pending. Do not remove twice.
                        if type(i) == "number" then
                            table.remove(list, i)
                        else
                            list[i] = nil
                        end
                        if typeof(entry.frame) == "Instance" then
                            pcall(function() entry.frame:Destroy() end)
                        end
                    end
                else
                    -- Native callback may leave the label stale on some clients.
                    refreshDropCountLabel(entry, rest)
                end
                if rest > 0 then
                    entry.flown = nil
                    if typeof(entry.frame) == "Instance" then
                        pcall(function() entry.frame.Visible = not entry.culled end)
                    end
                end
                print("[COLLECT DROP REMAINING]", "UID", tostring(entry.uid),
                    "before", tostring(initialDropCount),
                    "taken", tostring(amount),
                    "remaining", tostring(rest), "nativeUI", nativeApplied)
                updated = true
                break
            end
        end
    end
    return localInvOk, updated
end

local function collectOne(drop, token, generation)
    if dropPause or guardPaused or not liveCollect(token, generation) then return end
    if type(drop) ~= "table" or type(drop.uid) ~= "number"
        or type(drop.id) ~= "number" or type(drop.n) ~= "number"
        or drop.n <= 0 then return end
    local category = categoryOf(drop)
    if not category or collectFilter[category] ~= true
        or drop.taking or drop.pending or drop.display
        or (drop.armed == false and drop.id ~= 112)
        or not onCollectArea(drop) or not nearPlayer(drop) then return end

    local uid, id = drop.uid, drop.id
    if collectPending[uid] or os.clock() < (collectCooldowns[uid] or 0) then return end
    local takeDrop = rawget(world, "takeDrop")
    local remote = getTakeDropRemote()
    if type(takeDrop) ~= "function" and not remote then
        warn("[COLLECT] No native takeDrop or TakeDrop remote")
        stopCollect(); resetCollectToggle(); return
    end
    local current = findDrop(uid)
    if not current or current.id ~= id or type(current.n) ~= "number"
        or current.n <= 0 or current.taking or current.pending
        or current.display or not onCollectArea(current)
        or not nearPlayer(current) then return end

    if dropPause or guardPaused then return end
    -- ANCH behavior: request the whole drop (capped by inventory room).
    local amount = math.min(math.floor(current.n), roomFor(id, math.floor(current.n)))
    if amount <= 0 then
        collectCooldowns[uid] = os.clock() + 1
        return
    end
    local s = getState()
    if not s then return end
    local dx, dy = current.x - s.x, current.y - (s.y - 0.475)
    local dist = math.sqrt(dx * dx + dy * dy)
    if dist > math.min(collectRadius, collectNativeCap) then return end

    -- Snapshot before yielding to World.takeDrop / InvokeServer.
    local initialDropCount = math.floor(current.n)
    local initialInventoryCount
    if id ~= 112 then
        local active = getGameInventory()
        if active and type(active.count) == "function" then
            pcall(function() initialInventoryCount = active:count(id) end)
        end
    end

    local counter = collectStats.category[category]
    collectPending[uid] = true
    current.taking = true -- ANCH hides drop while the request is pending
    if typeof(current.frame) == "Instance" then
        pcall(function() current.frame.Visible = false end)
    end
    collectStats.requests += 1
    counter.requests += 1
    print("[COLLECT REQUEST ANCH]", category, itemName(id), "UID", uid,
        "want", amount, "distance", math.floor(dist*1000)/1000)

    local ok, response
    if type(takeDrop) == "function" then
        ok, response = pcall(takeDrop, uid, amount)
    else
        ok, response = pcall(function() return remote:InvokeServer(uid, amount) end)
    end
    current.taking = false

    if not liveCollect(token, generation) then
        if typeof(current.frame) == "Instance" then
            pcall(function() current.frame.Visible = not current.culled end)
        end
        collectPending[uid] = nil
        return
    end
    if not ok or type(response) ~= "number" or response <= 0 then
        collectStats.unconfirmed += 1
        counter.unconfirmed += 1
        consecutiveFailures += 1
        current.refused = os.clock()
        current.failN = (current.failN or 0) + 1
        collectCooldowns[uid] = os.clock() + math.min(8, current.failN)
        if current.failN >= 3 then
            collectDead[uid] = os.clock() + 30
            print("[COLLECT SKIP] UID", uid, itemName(id), "refused", current.failN, "x -> skip 30s")
        end
        current.flown = nil
        if typeof(current.frame) == "Instance" then
            pcall(function() current.frame.Visible = not current.culled end)
        end
        warn("[COLLECT REFUSED]", category, itemName(id), "UID", uid,
            "ok", ok, "response", tostring(response))
    else
        -- Follow ANCH: treat a numeric positive response as awarded quantity
        -- for *local presentation*. We explicitly do not call it server verified.
        local awarded = math.max(0, math.floor(math.min(response, amount, initialDropCount)))
        local invApplied, dropApplied = reconcileLocal(current, awarded, initialDropCount, initialInventoryCount)
        collectStats.localApplied += 1
        counter.changed += dropApplied and 1 or 0
        if dropApplied then collectStats.observed += 1 end
        if id == 112 and dropApplied then collectStats.gemsObserved += 1 end
        if not dropApplied then collectStats.localFailed += 1 end
        consecutiveFailures = 0
        collectCooldowns[uid] = os.clock() + 0.3
        print("[COLLECT LOCAL APPLIED / SERVER UNVERIFIED]", category,
            itemName(id), "UID", uid, "response", response,
            "localInventoryUpdated", invApplied,
            "localDropUpdated", dropApplied)
    end
    collectPending[uid] = nil
    -- V57: failures must NOT advance to the next priority slot.
    -- Existing per-UID cooldown grows to 8s, so repeating a rejected pickup
    -- does not spam requests. Manual OFF always cancels the loop.
    if consecutiveFailures >= 3 and liveCollect(token, generation) then
        if os.clock() - collectHoldLogAt >= 2 then
            collectHoldLogAt = os.clock()
            warn("[COLLECT PRIORITY HOLD] Repeated request refusals; keep current tile, retry after UID cooldown")
        end
    end
end

local function startCollect()
    if collectEnabled then return end
    if (type(rawget(world, "takeDrop")) ~= "function" and not getTakeDropRemote())
        or type(rawget(world, "dropList")) ~= "function" then
        warn("[COLLECT] World functions unavailable")
        resetCollectToggle()
        return
    end

    collectEnabled = true
    collectCursor = 1
    consecutiveFailures = 0
    collectToken += 1
    local token = collectToken
    local generation = env.Fian792CollectGeneration
    print("[COLLECT] ON | ANCH-style remote | area:", (2 * collectTiles + 1) .. "x" .. (2 * collectTiles + 1), "| tiles:", collectTiles, "| physical radius:", collectRadius)

    task.spawn(function()
        local ok, err = pcall(function()
            while liveCollect(token, generation) do
                if dropPause or guardPaused then
                    task.wait(0.07)
                    continue
                end
                local drops = getDrops()
                if drops then
                    -- V57 STRICT PRIORITY: process one selected TILE until
                    -- there are no remaining eligible drops in reach.
                    -- A rejected/pending/cooling-down drop HOLDS the cursor.
                    -- Never move to another tile because a request merely returned.
                    local slots = collectPrioritySlots()
                    local state = getState()
                    if state and #slots > 0 then
                        local idx = ((collectCursor - 1) % #slots) + 1
                        -- The LAST explicitly selected priority is a reserve pickup tile.
                        -- While selected Place block stock is above 50, skip it immediately.
                        -- This must NEVER stall Auto Collect or the independent Place/Break loop.
                        if #collectOrder > 0 and idx == #slots then
                            local stock = nil
                            if type(selectedId) == "number" then
                                local active = getGameInventory()
                                if active then
                                    if type(active.count) == "function" then
                                        local okCount, observed = pcall(function()
                                            return active:count(selectedId)
                                        end)
                                        if okCount and type(observed) == "number" then
                                            stock = observed
                                        end
                                    end
                                    if stock == nil then
                                        stock = slotItemCount(active.slots, selectedId)
                                    end
                                end
                            end
                            -- Unknown stock must NEVER trigger last-priority collect.
                            -- Only explicit, readable stock <= 50 permits collection.
                            if stock == nil or stock > COLLECT_LAST_STOCK_THRESHOLD then
                                collectCursor = 1
                                local nowSkip = os.clock()
                                if nowSkip - collectLastSkipLogAt >= 3 then
                                    collectLastSkipLogAt = nowSkip
                                    print("[COLLECT LAST SKIP]", "slot", idx, "/", #slots,
                                        "item", selectedId, "stock", stock or "unavailable",
                                        "| only collect when stock <= 50")
                                end
                                task.wait(0.1)
                                continue
                            end
                        end
                        local tile = slots[idx]
                        local tx = math.floor(state.x) + tile.dx
                        local ty = math.floor(state.y - 0.475) + tile.dy
                        local best, bestDistance, blockingUid
                        local gemBatch, gemSeen = {}, {}
                        local now = os.clock()
                        local unreachableCount=0

                        for _, drop in pairs(drops) do
                            if type(drop) == "table"
                                and type(drop.x) == "number" and type(drop.y) == "number"
                                and type(drop.uid) == "number"
                                and math.floor(drop.x) == tx
                                and math.floor(drop.y) == ty
                                and not (type(env.Fian792ReservedDropTiles) == "table"
                                    and env.Fian792ReservedDropTiles[tx .. "," .. ty])
                                and collectFilter[categoryOf(drop)] == true
                                and type(drop.n) == "number" and drop.n > 0
                                and (drop.armed ~= false or drop.id == 112)
                                and os.clock() >= (collectDead[drop.uid] or 0) then
                                if not nearPlayer(drop) then
                                    unreachableCount+=1
                                    continue
                                end

                                -- Do not hold the priority cursor for an item
                                -- whose inventory stack is full. Leave its remaining
                                -- drop in the world and process other collectible items.
                                local hasRoom = drop.id == 112
                                    or roomFor(drop.id, math.floor(drop.n)) > 0
                                if hasRoom then
                                    if not blockingUid then blockingUid = drop.uid end
                                    if not drop.taking and not drop.pending and not drop.display
                                        and not collectPending[drop.uid]
                                        and not gemsBatchInflight[drop.uid]
                                        and now >= (collectCooldowns[drop.uid] or 0) then
                                        if drop.id == 112 then
                                        if not gemSeen[drop.uid]
                                            and #gemBatch < math.max(0, GEMS_BATCH_LIMIT - gemsBatchActive) then
                                            gemSeen[drop.uid] = true
                                            gemBatch[#gemBatch + 1] = drop
                                        end
                                    else
                                        local dx = drop.x - state.x
                                        local dy = drop.y - (state.y - 0.475)
                                        local distance2 = dx * dx + dy * dy
                                        if not bestDistance or distance2 < bestDistance then
                                            best, bestDistance = drop, distance2
                                        end
                                    end
                                end
                                end -- hasRoom: full stacks never block collect priority
                            end
                        end

                        if #gemBatch > 0 then
                            print("[COLLECT GEMS BATCH]", "slot", idx, "/", #slots,
                                "tile", tx, ty, "concurrent", #gemBatch)
                            for _, gem in ipairs(gemBatch) do
                                -- Reserve UID before spawning; never schedule it twice.
                                local uid = gem.uid
                                gemsBatchInflight[uid] = true
                                gemsBatchActive += 1
                                task.spawn(function()
                                    local okBatch, errBatch = pcall(collectOne, gem, token, generation)
                                    gemsBatchInflight[uid] = nil
                                    gemsBatchActive = math.max(0, gemsBatchActive - 1)
                                    if not okBatch then
                                        collectCooldowns[uid] = os.clock() + 2
                                        warn("[COLLECT GEMS BATCH ERROR]", uid, errBatch)
                                    end
                                end)
                            end
                            -- Never advance priority before these UID pickups settle.
                        elseif best then
                            print("[COLLECT PRIORITY TRY]", "slot", idx, "/", #slots,
                                "tile", tx, ty, "UID", best.uid)
                            collectOne(best, token, generation)
                            -- Do not advance here. On the next tick, re-read
                            -- native dropList: advance ONLY when tile is empty.
                        elseif blockingUid then
                            if now - collectHoldLogAt >= 2 then
                                collectHoldLogAt = now
                                print("[COLLECT PRIORITY WAIT]", "slot", idx,
                                    "tile", tx, ty, "UID", blockingUid,
                                    "pending/cooldown; not advancing")
                            end
                        else
                            -- If a tile cannot be reached at this standing
                            -- position, report it and revisit on the next
                            -- priority cycle. Never mark it as collected.
                            if unreachableCount>0 and now-collectOutOfReachLogAt>=3 then
                                collectOutOfReachLogAt=now
                                print("[COLLECT PRIORITY OUT OF RANGE] slot",idx,
                                    "tile",tx,ty,"drops",unreachableCount,
                                    "| native cap",math.min(collectRadius,collectNativeCap))
                            end
                            collectCursor = (idx % #slots) + 1
                            if #slots > 1 and now - collectHoldLogAt >= 2 then
                                collectHoldLogAt = now
                                print("[COLLECT PRIORITY NEXT]", idx, "->", collectCursor,
                                    "tile clear / no reachable drop")
                            end
                        end
                    end
                end
                -- UI-adjustable PNB scan cadence. Native pickup and per-UID
                -- cooldowns remain intact; no changes to priority-last logic.
                task.wait(collectIntervalMs / 1000)
            end
        end)
        if not ok then warn("[COLLECT LOOP ERROR]", err) end
        if collectToken == token then
            collectEnabled = false
            resetCollectToggle()
        end
        print("[COLLECT] OFF")
    end)
end

