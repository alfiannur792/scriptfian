        -- the whole stack back up -> endless drop/pickup loop).
        for _,d in pairs(drops) do
            if type(d)=="table" and type(d.x)=="number" and type(d.y)=="number"
                and (tonumber(d.n) or 0)>0 and reservedAutoDropPile(d)
                and (math.floor(d.y)==py or math.floor(d.y)==py-1) then
                local pxp=math.floor(d.x)
