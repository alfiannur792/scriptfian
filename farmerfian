end

local function refreshGrid()
    -- V62: same selection UI logic as Break; tile occupancy does not
    -- affect whether a tile can be selected.
    for _, cell in ipairs(cells) do
        local chosen = selectedOffsets[key(cell.dx, cell.dy)]
        if cell.dx == 0 and cell.dy == 0 then
            cell.button.Text = "C"
            cell.button.BackgroundColor3 = Color3.fromRGB(100,105,120)
        elseif chosen then
            cell.button.Text = "X"
            cell.button.BackgroundColor3 = Color3.fromRGB(40,130,225)
        else
            cell.button.Text = "-"
            cell.button.BackgroundColor3 = Color3.fromRGB(45,50,67)
        end
    end
end

